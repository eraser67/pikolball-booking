@page "/Player/{userId?}"
@model PickleBallBooking.Pages.Player.ProfileModel
@using PickleBallBooking.Models
@functions {
    static string PrivacyBadge(MatchHistoryPrivacyLevel level) => level switch
    {
        MatchHistoryPrivacyLevel.Public => "🌐 Public",
        MatchHistoryPrivacyLevel.FollowersOnly => "👥 Members Only",
        MatchHistoryPrivacyLevel.Private => "🔒 Private",
        _ => "Public"
    };
}
@{
    var stats = Model.PlayerStats;
    ViewData["Title"] = stats != null ? $"{stats.DisplayName} - Player Profile & Stats" : "Player Profile";
}

<div class="pb-profile-container py-3 py-md-4">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-4 shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (stats == null)
    {
        <div class="alert alert-warning shadow-sm border-0">
            <i class="bi bi-exclamation-triangle me-2"></i>Player profile not found.
        </div>
    }
    else
    {
        <!-- Breadcrumb navigation -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-page="/Activities/Leaderboard" class="text-decoration-none">Leaderboard</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@stats.DisplayName</li>
            </ol>
        </nav>

        <!-- Player Profile Hero Header -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden pb-profile-hero">
            <div class="card-body p-3 p-sm-4 p-lg-5 text-white">
                <div class="row align-items-center g-4">
                    <!-- Left: Avatar + Details -->
                    <div class="col-12 col-lg-8">
                        <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start text-center text-sm-start gap-3 gap-md-4">
                            @if (!string.IsNullOrEmpty(stats.AvatarUrl))
                            {
                                <img src="@stats.AvatarUrl" alt="@stats.DisplayName"
                                     class="rounded-circle border border-3 border-white shadow pb-profile-avatar" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center shadow fw-bold border border-3 border-white pb-profile-avatar pb-avatar-fallback">
                                    @(stats.DisplayName.Length > 0 ? stats.DisplayName[0].ToString().ToUpper() : "P")
                                </div>
                            }

                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-center justify-content-sm-start gap-2 flex-wrap mb-1">
                                    <h1 class="h2 fw-bold mb-0">@stats.DisplayName</h1>
                                    @if (stats.FullName != stats.DisplayName)
                                    {
                                        <span class="text-white-50 small">(@stats.FullName)</span>
                                    }
                                    @if (Model.IsSelf)
                                    {
                                        <span class="badge bg-white text-dark rounded-pill px-2 py-1 small fw-semibold shadow-sm">You</span>
                                    }
                                    @if (stats.IsGuest)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small fw-semibold shadow-sm">
                                            <i class="bi bi-person-walking me-1"></i>Walk-in
                                        </span>
                                    }
                                </div>

                                <!-- Quick Tags / Badges -->
                                <div class="d-flex align-items-center justify-content-center justify-content-sm-start gap-2 flex-wrap my-2">
                                    @if (!string.IsNullOrEmpty(stats.Location))
                                    {
                                        <span class="pb-hero-chip">
                                            <i class="bi bi-geo-alt-fill me-1 text-warning"></i>@stats.Location
                                        </span>
                                    }
                                    <span class="pb-hero-chip">
                                        <i class="bi bi-trophy-fill me-1 text-warning"></i>@stats.SkillLevel
                                    </span>
                                    <span class="pb-hero-chip">
                                        <i class="bi bi-hand-index-thumb-fill me-1 text-info"></i>@stats.PlayingHand Handed
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(stats.Bio))
                                {
                                    <p class="mt-2 mb-0 text-white-50 small fst-italic pb-hero-bio mx-auto mx-sm-0">
                                        &ldquo;@stats.Bio&rdquo;
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Quick Stats Panel / Action Widget -->
                    <div class="col-12 col-lg-4">
                        <div class="pb-hero-glass-panel p-3 p-md-4 rounded-4 d-flex flex-column gap-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small text-white-50"><i class="bi bi-shield-lock me-1"></i>Visibility</span>
                                <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-2 py-1">
                                    @PrivacyBadge(stats.PrivacyMatchHistory)
                                </span>
                            </div>

                            @if (stats.CanViewHistory)
                            {
                                <div class="row g-2 text-center">
                                    <div class="col-4">
                                        <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                            <div class="fs-5 fw-bold text-white mb-0">@stats.Overall.MatchesPlayed</div>
                                            <div class="text-white-50" style="font-size: 0.65rem; text-transform: uppercase;">Matches</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                            <div class="fs-5 fw-bold text-white mb-0">@stats.Overall.WinPercentage.ToString("F0")%</div>
                                            <div class="text-white-50" style="font-size: 0.65rem; text-transform: uppercase;">Win Rate</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded-3 bg-white bg-opacity-10">
                                            <div class="fs-5 fw-bold text-white mb-0">@(stats.Overall.PointDifferential >= 0 ? "+" : "")@stats.Overall.PointDifferential</div>
                                            <div class="text-white-50" style="font-size: 0.65rem; text-transform: uppercase;">+/- Diff</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.IsSelf)
                            {
                                <a asp-page="/Customer/Profile" class="btn btn-light btn-sm fw-semibold shadow-sm w-100 rounded-pill py-2">
                                    <i class="bi bi-pencil-square me-1 text-success"></i>Edit Profile & Privacy
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!stats.CanViewHistory)
        {
            <!-- Privacy Restricted Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center my-4 mx-auto" style="max-width: 580px;">
                <div class="mb-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-light text-secondary fs-1 shadow-sm">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-2">Match History is Private</h4>
                <p class="text-muted mx-auto mb-3" style="max-width: 440px;">
                    @(stats.PrivacyMessage ?? "This player has chosen to keep their statistics and match history private.")
                </p>
                @if (stats.PrivacyMatchHistory == MatchHistoryPrivacyLevel.FollowersOnly && string.IsNullOrEmpty(Model.CurrentUserId))
                {
                    <div>
                        <a asp-page="/Account/Login" asp-route-returnUrl="@Request.Path" class="btn btn-success px-4 rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In to View
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Filter Bar: Platform vs Venue -->
            @if (Model.CurrentOrgId.HasValue)
            {
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="small text-muted d-flex align-items-center gap-1">
                        <i class="bi bi-funnel text-success"></i>
                        <span>Showing:</span>
                        <span class="fw-bold text-dark">@(Model.Filter == "tenant" ? "This Venue Only" : "All Match Records")</span>
                    </div>
                    <div class="pb-filter-pill-group p-1 bg-light rounded-pill border d-inline-flex gap-1" role="group">
                        <a asp-page="/Player/Profile" asp-route-userId="@stats.UserId"
                           class="btn btn-sm rounded-pill px-3 py-1 @(Model.Filter != "tenant" ? "btn-success shadow-sm fw-semibold" : "btn-light text-muted border-0")">
                            <i class="bi bi-globe me-1"></i>All Venues
                        </a>
                        <a asp-page="/Player/Profile" asp-route-userId="@stats.UserId" asp-route-filter="tenant"
                           class="btn btn-sm rounded-pill px-3 py-1 @(Model.Filter == "tenant" ? "btn-success shadow-sm fw-semibold" : "btn-light text-muted border-0")">
                            <i class="bi bi-building me-1"></i>This Venue
                        </a>
                    </div>
                </div>
            }

            <!-- Overall Performance Cards -->
            <div class="row g-3 g-lg-4 mb-4">
                <!-- Matches & Record -->
                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 pb-stat-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Matches</span>
                            <div class="pb-stat-icon-wrap bg-primary-subtle text-primary">
                                <i class="bi bi-controller fs-5"></i>
                            </div>
                        </div>
                        <div class="h2 fw-bold text-dark mb-1">@stats.Overall.MatchesPlayed</div>
                        <div class="d-flex align-items-center gap-1 flex-wrap small text-muted">
                            <span class="badge bg-success-subtle text-success fw-bold">@stats.Overall.Wins W</span>
                            <span class="badge bg-danger-subtle text-danger fw-bold">@stats.Overall.Losses L</span>
                            <span class="badge bg-secondary-subtle text-secondary fw-bold">@stats.Overall.Draws D</span>
                        </div>
                    </div>
                </div>

                <!-- Win Rate -->
                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 pb-stat-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Win Rate</span>
                            <div class="pb-stat-icon-wrap bg-success-subtle text-success">
                                <i class="bi bi-pie-chart-fill fs-5"></i>
                            </div>
                        </div>
                        <div class="h2 fw-bold text-success mb-1">@stats.Overall.WinPercentage.ToString("F1")%</div>
                        <div class="small text-muted d-flex align-items-center gap-2">
                            <span>Streak:</span>
                            <span class="badge @(stats.Overall.CurrentStreak.StartsWith("W") ? "bg-success" : stats.Overall.CurrentStreak.StartsWith("L") ? "bg-danger" : "bg-secondary") rounded-pill px-2">
                                @stats.Overall.CurrentStreak
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Point Differential (+/-) -->
                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 pb-stat-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Differential</span>
                            <div class="pb-stat-icon-wrap bg-info-subtle text-info">
                                <i class="bi bi-graph-up-arrow fs-5"></i>
                            </div>
                        </div>
                        <div class="h2 fw-bold @(stats.Overall.PointDifferential > 0 ? "text-success" : stats.Overall.PointDifferential < 0 ? "text-danger" : "text-dark") mb-1">
                            @(stats.Overall.PointDifferential >= 0 ? "+" : "")@stats.Overall.PointDifferential
                        </div>
                        <div class="small text-muted">
                            <span class="fw-semibold text-dark">@stats.Overall.PointsScored</span> PF &bull; <span class="fw-semibold text-dark">@stats.Overall.PointsConceded</span> PA
                        </div>
                    </div>
                </div>

                <!-- Form / Last 5 -->
                <div class="col-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-3 p-lg-4 pb-stat-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase tracking-wider">Recent Form</span>
                            <div class="pb-stat-icon-wrap bg-warning-subtle text-warning">
                                <i class="bi bi-activity fs-5"></i>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1 my-1">
                            @if (stats.Overall.RecentForm.Count > 0)
                            {
                                @foreach (var f in stats.Overall.RecentForm)
                                {
                                    <span class="badge @(f == "W" ? "bg-success" : f == "L" ? "bg-danger" : "bg-secondary") rounded-circle"
                                          style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                        @f
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No matches yet</span>
                            }
                        </div>
                        <div class="small text-muted mt-1">
                            Avg: <span class="fw-semibold text-dark">@stats.Overall.AveragePointsScored.ToString("F1")</span> pts/match
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabbed Navigation: Match History, Partner History, Opponent History -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom p-0">
                    <ul class="nav nav-tabs card-header-tabs pb-profile-tabs m-0 px-2 px-md-3 border-0" id="statsTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="matches-tab" data-bs-toggle="tab" data-bs-target="#matches" type="button" role="tab">
                                <i class="bi bi-clock-history me-1 text-success"></i>Match History
                                <span class="badge rounded-pill ms-1">@stats.Matches.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="partners-tab" data-bs-toggle="tab" data-bs-target="#partners" type="button" role="tab">
                                <i class="bi bi-people me-1 text-primary"></i>Partner History
                                <span class="badge rounded-pill ms-1">@stats.Partners.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="opponents-tab" data-bs-toggle="tab" data-bs-target="#opponents" type="button" role="tab">
                                <i class="bi bi-swords me-1 text-danger"></i>Opponent History
                                <span class="badge rounded-pill ms-1">@stats.Opponents.Count</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-0">
                    <div class="tab-content" id="statsTabContent">

                        <!-- TAB 1: FULL MATCH HISTORY -->
                        <div class="tab-pane fade show active" id="matches" role="tabpanel">
                            @if (stats.Matches.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <div class="text-muted fs-1 mb-2"><i class="bi bi-trophy"></i></div>
                                    <h5 class="fw-bold text-dark">No Finalized Matches Found</h5>
                                    <p class="text-muted small">Matches will appear here as soon as round robin scores are submitted and finalized.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 pb-stats-table">
                                        <thead class="table-light text-uppercase small text-muted">
                                            <tr>
                                                <th class="ps-3 ps-md-4 text-center" style="width: 80px;">Result</th>
                                                <th style="min-width: 180px;">Event / Activity</th>
                                                <th style="min-width: 110px;">Score</th>
                                                <th style="min-width: 150px;">Partner</th>
                                                <th style="min-width: 170px;">Opponents</th>
                                                <th style="min-width: 130px;">Round & Court</th>
                                                <th class="pe-3 pe-md-4 text-end" style="min-width: 110px;">Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in stats.Matches)
                                            {
                                                <tr>
                                                    <!-- Result badge -->
                                                    <td class="ps-3 ps-md-4 text-center">
                                                        <span class="badge @(m.Result == "W" ? "bg-success" : m.Result == "L" ? "bg-danger" : "bg-secondary") rounded-pill px-3 py-1 fw-bold">
                                                            @m.Result
                                                        </span>
                                                    </td>

                                                    <!-- Activity / Event -->
                                                    <td>
                                                        <div class="fw-bold text-dark text-truncate" style="max-width: 260px;" title="@m.ActivityName">@m.ActivityName</div>
                                                        <div class="small text-muted">
                                                            @m.EventFormat
                                                            @if (!string.IsNullOrEmpty(m.OrganizationName))
                                                            {
                                                                <span>&bull; @m.OrganizationName</span>
                                                            }
                                                        </div>
                                                    </td>

                                                    <!-- Score -->
                                                    <td>
                                                        <div class="fs-6 fw-bold @(m.Result == "W" ? "text-success" : m.Result == "L" ? "text-danger" : "text-dark")">
                                                            @m.ScoreDisplay
                                                        </div>
                                                        <div class="small text-muted">
                                                            @(m.PointDifferential >= 0 ? "+" : "")@m.PointDifferential diff
                                                        </div>
                                                    </td>

                                                    <!-- Partner -->
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(m.PartnerName))
                                                        {
                                                            <div class="d-flex align-items-center gap-2">
                                                                @if (!string.IsNullOrEmpty(m.PartnerAvatarUrl))
                                                                {
                                                                    <img src="@m.PartnerAvatarUrl" class="rounded-circle border" style="width:28px;height:28px;object-fit:cover;" alt="" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="rounded-circle bg-light text-primary border d-flex align-items-center justify-content-center small fw-bold" style="width:28px;height:28px;font-size:0.75rem;">
                                                                        @m.PartnerName[0]
                                                                    </div>
                                                                }
                                                                <div class="text-truncate" style="max-width: 140px;">
                                                                    @if (!string.IsNullOrEmpty(m.PartnerUserId))
                                                                    {
                                                                        <a asp-page="/Player/Profile" asp-route-userId="@m.PartnerUserId" class="text-decoration-none text-dark fw-semibold small text-truncate d-inline-block">
                                                                            @m.PartnerName
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-dark small">@m.PartnerName</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small fst-italic">—</span>
                                                        }
                                                    </td>

                                                    <!-- Opponents -->
                                                    <td>
                                                        @if (m.Opponents.Count > 0)
                                                        {
                                                            <div class="d-flex flex-column gap-1">
                                                                @foreach (var opp in m.Opponents)
                                                                {
                                                                    <div class="d-flex align-items-center gap-2">
                                                                        @if (!string.IsNullOrEmpty(opp.AvatarUrl))
                                                                        {
                                                                            <img src="@opp.AvatarUrl" class="rounded-circle border" style="width:24px;height:24px;object-fit:cover;" alt="" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="rounded-circle bg-light text-secondary border d-flex align-items-center justify-content-center small fw-bold" style="width:24px;height:24px;font-size:0.7rem;">
                                                                                @(opp.Name.Length > 0 ? opp.Name[0].ToString().ToUpper() : "O")
                                                                            </div>
                                                                        }
                                                                        <div class="text-truncate" style="max-width: 140px;">
                                                                            @if (!string.IsNullOrEmpty(opp.UserId))
                                                                            {
                                                                                <a asp-page="/Player/Profile" asp-route-userId="@opp.UserId" class="text-decoration-none text-dark small fw-medium">
                                                                                    @opp.Name
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-dark small">@opp.Name</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>

                                                    <!-- Round & Court -->
                                                    <td>
                                                        <div class="small fw-semibold text-dark">Round @m.RoundNumber</div>
                                                        @if (!string.IsNullOrEmpty(m.CourtName))
                                                        {
                                                            <div class="small text-muted text-truncate" style="max-width: 130px;" title="@m.CourtName">@m.CourtName</div>
                                                        }
                                                    </td>

                                                    <!-- Date -->
                                                    <td class="pe-3 pe-md-4 text-end">
                                                        <div class="small fw-semibold text-dark text-nowrap">@m.MatchDate.ToString("MMM d, yyyy")</div>
                                                        @if (m.EstimatedStartTime.HasValue)
                                                        {
                                                            <div class="small text-muted text-nowrap">@PickleBallBooking.Services.AppClock.To12Hour(m.EstimatedStartTime.Value)</div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- TAB 2: PARTNER HISTORY -->
                        <div class="tab-pane fade" id="partners" role="tabpanel">
                            @if (stats.Partners.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <div class="text-muted fs-1 mb-2"><i class="bi bi-people"></i></div>
                                    <h5 class="fw-bold text-dark">No Partner History</h5>
                                    <p class="text-muted small">Partners you team up with in doubles matches will appear here.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 pb-stats-table">
                                        <thead class="table-light text-uppercase small text-muted">
                                            <tr>
                                                <th class="ps-3 ps-md-4" style="min-width: 180px;">Partner</th>
                                                <th class="text-center" style="min-width: 100px;">Skill Level</th>
                                                <th class="text-center" style="min-width: 80px;">Matches</th>
                                                <th class="text-center" style="min-width: 120px;">Record (W-L-D)</th>
                                                <th class="text-center" style="min-width: 120px;">Win Rate</th>
                                                <th class="text-center" style="min-width: 110px;">Points (PF / PA)</th>
                                                <th class="pe-3 pe-md-4 text-end" style="min-width: 90px;">Differential</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in stats.Partners)
                                            {
                                                <tr>
                                                    <td class="ps-3 ps-md-4">
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (!string.IsNullOrEmpty(p.PartnerAvatarUrl))
                                                            {
                                                                <img src="@p.PartnerAvatarUrl" class="rounded-circle border" style="width:34px;height:34px;object-fit:cover;" alt="" />
                                                            }
                                                            else
                                                            {
                                                                <div class="rounded-circle bg-light text-primary border d-flex align-items-center justify-content-center fw-bold" style="width:34px;height:34px;">
                                                                    @(p.PartnerName.Length > 0 ? p.PartnerName[0].ToString().ToUpper() : "P")
                                                                </div>
                                                            }
                                                            <div class="text-truncate" style="max-width: 160px;">
                                                                @if (!string.IsNullOrEmpty(p.PartnerUserId))
                                                                {
                                                                    <a asp-page="/Player/Profile" asp-route-userId="@p.PartnerUserId" class="fw-bold text-dark text-decoration-none text-truncate d-inline-block">
                                                                        @p.PartnerName
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <div class="fw-bold text-dark text-truncate">@p.PartnerName</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (p.PartnerSkillLevel.HasValue)
                                                        {
                                                            <span class="badge bg-light text-muted border small">@p.PartnerSkillLevel</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="fw-bold text-dark">@p.MatchesTogether</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border">
                                                            <span class="text-success fw-bold">@p.Wins</span> -
                                                            <span class="text-danger fw-bold">@p.Losses</span> -
                                                            <span class="text-secondary fw-bold">@p.Draws</span>
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fw-bold @(p.WinPercentage >= 50 ? "text-success" : "text-muted")">
                                                            @p.WinPercentage.ToString("F1")%
                                                        </div>
                                                        <div class="progress mx-auto mt-1" style="height: 4px; width: 60px;">
                                                            <div class="progress-bar @(p.WinPercentage >= 50 ? "bg-success" : "bg-secondary")" role="progressbar" style="width: @p.WinPercentage%;" aria-valuenow="@p.WinPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="text-dark small">@p.PointsScored / @p.PointsConceded</span>
                                                    </td>
                                                    <td class="pe-3 pe-md-4 text-end">
                                                        <span class="fw-bold @(p.PointDifferential > 0 ? "text-success" : p.PointDifferential < 0 ? "text-danger" : "text-muted")">
                                                            @(p.PointDifferential >= 0 ? "+" : "")@p.PointDifferential
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- TAB 3: OPPONENT HISTORY -->
                        <div class="tab-pane fade" id="opponents" role="tabpanel">
                            @if (stats.Opponents.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <div class="text-muted fs-1 mb-2"><i class="bi bi-swords"></i></div>
                                    <h5 class="fw-bold text-dark">No Opponent Records</h5>
                                    <p class="text-muted small">Head-to-head records against opponents you play against will appear here.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 pb-stats-table">
                                        <thead class="table-light text-uppercase small text-muted">
                                            <tr>
                                                <th class="ps-3 ps-md-4" style="min-width: 180px;">Opponent</th>
                                                <th class="text-center" style="min-width: 100px;">Skill Level</th>
                                                <th class="text-center" style="min-width: 80px;">Matches</th>
                                                <th class="text-center" style="min-width: 120px;">Head-to-Head</th>
                                                <th class="text-center" style="min-width: 120px;">Win Rate</th>
                                                <th class="text-center" style="min-width: 110px;">Points (PF / PA)</th>
                                                <th class="pe-3 pe-md-4 text-end" style="min-width: 90px;">Differential</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var o in stats.Opponents)
                                            {
                                                <tr>
                                                    <td class="ps-3 ps-md-4">
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (!string.IsNullOrEmpty(o.OpponentAvatarUrl))
                                                            {
                                                                <img src="@o.OpponentAvatarUrl" class="rounded-circle border" style="width:34px;height:34px;object-fit:cover;" alt="" />
                                                            }
                                                            else
                                                            {
                                                                <div class="rounded-circle bg-light text-danger border d-flex align-items-center justify-content-center fw-bold" style="width:34px;height:34px;">
                                                                    @(o.OpponentName.Length > 0 ? o.OpponentName[0].ToString().ToUpper() : "O")
                                                                </div>
                                                            }
                                                            <div class="text-truncate" style="max-width: 160px;">
                                                                @if (!string.IsNullOrEmpty(o.OpponentUserId))
                                                                {
                                                                    <a asp-page="/Player/Profile" asp-route-userId="@o.OpponentUserId" class="fw-bold text-dark text-decoration-none text-truncate d-inline-block">
                                                                        @o.OpponentName
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <div class="fw-bold text-dark text-truncate">@o.OpponentName</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (o.OpponentSkillLevel.HasValue)
                                                        {
                                                            <span class="badge bg-light text-muted border small">@o.OpponentSkillLevel</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="fw-bold text-dark">@o.MatchesAgainst</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border">
                                                            <span class="text-success fw-bold">@o.WinsAgainst</span> -
                                                            <span class="text-danger fw-bold">@o.LossesAgainst</span> -
                                                            <span class="text-secondary fw-bold">@o.DrawsAgainst</span>
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fw-bold @(o.WinPercentageAgainst >= 50 ? "text-success" : "text-muted")">
                                                            @o.WinPercentageAgainst.ToString("F1")%
                                                        </div>
                                                        <div class="progress mx-auto mt-1" style="height: 4px; width: 60px;">
                                                            <div class="progress-bar @(o.WinPercentageAgainst >= 50 ? "bg-success" : "bg-secondary")" role="progressbar" style="width: @o.WinPercentageAgainst%;" aria-valuenow="@o.WinPercentageAgainst" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="text-dark small">@o.PointsScored / @o.PointsConceded</span>
                                                    </td>
                                                    <td class="pe-3 pe-md-4 text-end">
                                                        <span class="fw-bold @(o.PointDifferential > 0 ? "text-success" : o.PointDifferential < 0 ? "text-danger" : "text-muted")">
                                                            @(o.PointDifferential >= 0 ? "+" : "")@o.PointDifferential
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    }

</div>
