@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@section Scripts {
<script>
// Lightweight scroll-reveal using IntersectionObserver
(function () {
    if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.pb-reveal').forEach(function (el) {
            el.classList.add('is-visible');
        });
        return;
    }
    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.pb-reveal').forEach(function (el) {
        observer.observe(el);
    });
})();
</script>
}

<!-- ===================== HERO ===================== -->
<section class="pb-hero" aria-label="Hero">
    <div class="row align-items-center g-4 g-lg-5">
        <!-- Left: text -->
        <div class="col-lg-6 pb-hero-content">
            <span class="pb-hero-eyebrow" aria-label="Premium Pickleball Club">
                <i class="bi bi-dribbble" aria-hidden="true"></i>
                Premium Pickleball Club
            </span>
            <h1>PLAY MORE.<br /><span class="pb-hero-accent">BOOK EASIER.</span></h1>
            <p class="pb-hero-tagline mb-1">@(Model.Tagline ?? "Your court. Your time. Your game.")</p>
            <p class="pb-hero-lead mb-4">
                Reserve your pickleball court in just a few clicks. Real-time availability,
                flexible time slots, and instant confirmation &mdash; no fuss.
            </p>
            <div class="d-flex flex-wrap gap-3 mb-4">
                <a asp-page="/Booking/Index" class="btn btn-lime btn-lg" id="hero-book-btn">
                    <i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>Book a Court
                </a>
                <a asp-page="/Availability/Index" class="btn btn-ghost btn-lg" id="hero-avail-btn">
                    <i class="bi bi-calendar3 me-2" aria-hidden="true"></i>View Availability
                </a>
            </div>
            <ul class="pb-hero-benefits list-unstyled mb-0" aria-label="Key benefits">
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Real-time availability</li>
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>No account required</li>
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Pick your court &amp; time</li>
            </ul>
        </div>
        <!-- Right: 3D image frame -->
        <div class="col-lg-6">
            <div class="pb-hero-art" role="img" aria-label="Pickleball court at @Model.OrgName">
                <div class="pb-hero-img-frame">
                    @if (!string.IsNullOrEmpty(Model.HeroImageUrl))
                    {
                        <img src="@Model.HeroImageUrl" alt="@Model.OrgName pickleball court" />
                    }
                    else
                    {
                        <img src="~/images/hero-player.png" asp-append-version="true" alt="Pickleball player ready to serve" />
                    }
            </div>
        </div>
    </div>
</section>

<!-- ===================== OUR COURTS ===================== -->
<section class="pb-section" id="courts" aria-labelledby="courts-heading">
    <div class="text-center mb-2">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-grid-3x3-gap"></i> Our Courts
        </span>
        <h2 class="pb-section-title" id="courts-heading">BOOK YOUR COURT</h2>
        <p class="pb-section-subtitle mx-auto">Choose a court and check its live availability for today.</p>
    </div>

    @if (Model.Courts.Count == 0)
    {
        <div class="pb-empty-state text-center" role="status">
            <i class="bi bi-info-circle display-5 d-block mb-2" aria-hidden="true"></i>
            <p class="mb-0">No courts are available right now. Please check back soon.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model.Courts)
            {
                var slotsLabel = c.AvailableSlots == 1 ? "slot" : "slots";
                var isLimited = c.HasAvailabilityData && c.HasLiveAvailability && c.AvailableSlots <= 3;
                <div class="col-md-6 col-lg-4 pb-reveal">
                    <article class="pb-court-card h-100" aria-label="@c.Court.Name">
                        <div class="pb-court-card-img">
                            <img src="@c.ImageUrl"
                                 alt="@c.Court.Name court at @Model.OrgName"
                                 loading="lazy" />
                            @if (c.HasAvailabilityData)
                            {
                                if (c.HasLiveAvailability && isLimited)
                                {
                                    <span class="pb-court-badge pb-badge-limited" role="status" aria-label="@c.AvailableSlots @slotsLabel open, limited availability">
                                        <span class="pb-dot" aria-hidden="true"></span>@c.AvailableSlots @slotsLabel &mdash; Limited
                                    </span>
                                }
                                else if (c.HasLiveAvailability)
                                {
                                    <span class="pb-court-badge pb-badge-open" role="status" aria-label="@c.AvailableSlots @slotsLabel open today">
                                        <span class="pb-dot" aria-hidden="true"></span>@c.AvailableSlots @slotsLabel open today
                                    </span>
                                }
                                else
                                {
                                    <span class="pb-court-badge pb-badge-closed" role="status" aria-label="Fully booked today">
                                        <span class="pb-dot" aria-hidden="true"></span>Fully booked today
                                    </span>
                                }
                            }
                        </div>
                        <div class="pb-court-card-body">
                            <h3 class="pb-court-name">
                                <i class="bi bi-dribbble me-1" aria-hidden="true"></i>@c.Court.Name
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(c.Court.Description))
                            {
                                <p class="pb-court-desc">@c.Court.Description</p>
                            }
                            else
                            {
                                <p class="pb-court-desc text-muted">Quality court ready for your next game.</p>
                            }

                            @if (c.HasAvailabilityData)
                            {
                                <p class="pb-court-preview">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    Preview for @Model.PreviewDate.ToString("MMM d") &mdash; check exact slots below.
                                </p>
                            }

                            <div class="d-grid gap-2 mt-auto">
                                <a asp-page="/Availability/Index"
                                   class="btn btn-outline-primary"
                                   aria-label="View availability for @c.Court.Name">
                                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>View Availability
                                </a>
                                <a asp-page="/Booking/Index"
                                   asp-route-courtId="@c.Court.Id"
                                   class="btn btn-primary"
                                   aria-label="Book @c.Court.Name now">
                                    <i class="bi bi-lightning-charge-fill me-1" aria-hidden="true"></i>Book Now
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

@* ── ABOUT SECTION (shown when admin set an AboutText) ────────────── *@
@if (!string.IsNullOrWhiteSpace(Model.AboutText))
{
    <section class="pb-section pb-section-alt" id="about" aria-labelledby="about-heading">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center pb-reveal">
                <span class="pb-section-label" aria-hidden="true">
                    <i class="bi bi-building"></i> About Us
                </span>
                <h2 class="pb-section-title" id="about-heading">ABOUT @Model.OrgName.ToUpperInvariant()</h2>
                <p class="pb-section-subtitle mx-auto" style="max-width:680px;">@Model.AboutText</p>
                <a asp-page="/Booking/Index" class="btn btn-primary mt-3" id="about-book-btn">
                    <i class="bi bi-lightning-charge-fill me-1"></i>Book a Court
                </a>
            </div>
        </div>
    </section>
}

@* ── UPCOMING ACTIVITIES (shown when tenant enables it) ────────────── *@
@if (Model.ShowActivitiesOnHome && Model.UpcomingActivities.Any())
{
    <section class="pb-section" id="home-activities" aria-labelledby="home-act-heading">
        <div class="text-center mb-4">
            <span class="pb-section-label" aria-hidden="true">
                <i class="bi bi-calendar-event"></i> Activities
            </span>
            <h2 class="pb-section-title" id="home-act-heading">UPCOMING ACTIVITIES</h2>
            <p class="pb-section-subtitle mx-auto">Join a session and play with the community.</p>
        </div>
        <div class="row g-4">
            @foreach (var act in Model.UpcomingActivities)
            {
                <div class="col-md-6 col-lg-4 pb-reveal">
                    <article class="pb-court-card h-100">
                        <div class="pb-court-card-body">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success">@act.Format</span>
                                <span class="badge bg-secondary">@act.SkillLevel</span>
                            </div>
                            <h3 class="pb-court-name">@act.Name</h3>
                            <ul class="list-unstyled small text-muted mb-3">
                                <li><i class="bi bi-calendar3 me-2"></i>@act.Date.ToString("MMM d, yyyy (ddd)")</li>
                                <li><i class="bi bi-clock me-2"></i>@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)</li>
                                @if (act.MaxCapacity > 0)
                                {
                                    <li><i class="bi bi-people me-2"></i>Up to @act.MaxCapacity players</li>
                                }
                                <li>
                                    <i class="bi bi-cash me-2"></i>
                                    @(act.PricePerPlayer == 0 ? "Free" : $"₱{act.PricePerPlayer:N0} / player")
                                </li>
                            </ul>
                            <a asp-page="/Activities/Index" class="btn btn-outline-primary w-100" id="home-act-@act.Id">
                                <i class="bi bi-arrow-right me-1"></i>View Details
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-page="/Activities/Index" class="btn btn-ghost" id="home-all-activities-btn">
                <i class="bi bi-calendar-event me-1"></i>See All Activities
            </a>
        </div>
    </section>
}

