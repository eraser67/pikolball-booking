@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@section Scripts {
<script>
(function () {
    // 1. Lightweight scroll-reveal using IntersectionObserver
    if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.pb-reveal').forEach(function (el) {
            observer.observe(el);
        });
    } else {
        document.querySelectorAll('.pb-reveal').forEach(function (el) {
            el.classList.add('is-visible');
        });
    }

    // 2. Interactive Quick-Reserve Button
    var btnQuickReserve = document.getElementById('btnQuickReserve');
    if (btnQuickReserve) {
        btnQuickReserve.addEventListener('click', function () {
            var dateInput = document.getElementById('qrDate');
            var courtSelect = document.getElementById('qrCourt');
            var timePrefSelect = document.getElementById('qrTimePref');
            var selectedDate = dateInput ? dateInput.value : '';
            var selectedCourt = courtSelect ? courtSelect.value : '';
            var selectedTime = timePrefSelect ? timePrefSelect.value : '';

            var url = '/Booking';
            var params = [];
            if (selectedDate) params.push('date=' + encodeURIComponent(selectedDate));
            if (selectedCourt) params.push('courtId=' + encodeURIComponent(selectedCourt));
            if (selectedTime && selectedTime !== 'any') params.push('timeFilter=' + encodeURIComponent(selectedTime));
            if (params.length > 0) url += '?' + params.join('&');

            window.location.href = url;
        });
    }

    // 3. Mobile Sticky Action Bar on Scroll
    var mobileSticky = document.getElementById('mobileHomeSticky');
    if (mobileSticky) {
        var handleScroll = function () {
            if (window.scrollY > 380) {
                mobileSticky.classList.add('is-active');
            } else {
                mobileSticky.classList.remove('is-active');
            }
        };
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
    }

    // 4. One-Tap Copy Address
    var btnCopyAddress = document.getElementById('btnCopyAddress');
    if (btnCopyAddress) {
        btnCopyAddress.addEventListener('click', function () {
            var addr = btnCopyAddress.getAttribute('data-address');
            if (addr && navigator.clipboard) {
                navigator.clipboard.writeText(addr).then(function () {
                    var originalHtml = btnCopyAddress.innerHTML;
                    btnCopyAddress.innerHTML = '<i class="bi bi-check2 text-success"></i> Copied!';
                    setTimeout(function () {
                        btnCopyAddress.innerHTML = originalHtml;
                    }, 2000);
                });
            }
        });
    }
})();
</script>
}

<!-- ===================== HERO ===================== -->
<section class="pb-hero" aria-label="Hero">
    <div class="row align-items-center g-4 g-lg-5">
        <!-- Left: text -->
        <div class="col-lg-6 pb-hero-content">
            <div class="pb-hero-live-pill" role="status">
                <span class="pulse-dot" aria-hidden="true"></span>
                <span class="pb-live-pill-status">OPEN TODAY</span>
                <span class="pb-hero-live-pill-sep">&bull;</span>
                <span class="pb-live-pill-hours">@(string.IsNullOrWhiteSpace(Model.OpeningHours) ? "6:00 AM – 10:00 PM" : Model.OpeningHours)</span>
                @if (Model.TotalAvailableSlotsToday > 0)
                {
                    <span class="pb-live-pill-slots d-none d-sm-inline">
                        <span class="pb-hero-live-pill-sep">&bull;</span>
                        <span class="text-lime fw-bold">@Model.TotalAvailableSlotsToday SLOTS OPEN</span>
                    </span>
                }
            </div>
            <h1>PLAY MORE.<br /><span class="pb-hero-accent">BOOK EASIER.</span></h1>
            <p class="pb-hero-tagline mb-1">@(Model.Tagline ?? "Your court. Your time. Your game.")</p>
            <p class="pb-hero-lead mb-3">
                Reserve your tournament-grade pickleball court in real time. Fast online scheduling,
                instant digital passes, and zero membership hassle.
            </p>

            <!-- Hero Live Stats Strip -->
            <div class="pb-hero-quick-stats mb-4">
                <div class="pb-hqs-item">
                    <span class="pb-hqs-label"><i class="bi bi-grid-3x3-gap-fill text-lime me-1"></i>Active Court</span>
                    <span class="pb-hqs-val">@Model.Courts.Count(c => c.Court.Status == PickleBallBooking.Models.CourtStatus.Active) Available</span>
                </div>
                <div class="pb-hqs-divider"></div>
                <div class="pb-hqs-item">
                    <span class="pb-hqs-label"><i class="bi bi-tag-fill text-lime me-1"></i>Starting Price</span>
                    <span class="pb-hqs-val">₱@Model.StartingPrice.ToString("N0")<small>/hr</small></span>
                </div>
                <div class="pb-hqs-divider"></div>
                <div class="pb-hqs-item">
                    <span class="pb-hqs-label"><i class="bi bi-qr-code text-lime me-1"></i>Pass</span>
                    <span class="pb-hqs-val">Instant QR</span>
                </div>
            </div>

            <!-- CTA Action Buttons -->
            <div class="d-flex flex-wrap gap-3 mb-2">
                <a asp-page="/Booking/Index" class="btn btn-lime btn-lg" id="hero-book-btn">
                    <i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>Book a Court
                </a>
                <a href="#courts" class="btn btn-ghost btn-lg" id="hero-avail-btn">
                    <i class="bi bi-grid-3x3-gap me-2" aria-hidden="true"></i>Explore Courts
                </a>
            </div>
        </div>
        <!-- Right: 3D image frame (unobstructed full view) -->
        <div class="col-lg-6">
            <div class="pb-hero-art" role="img" aria-label="Pickleball court at @Model.OrgName">
                <div class="pb-hero-img-frame">
                    @if (!string.IsNullOrEmpty(Model.HeroImageUrl))
                    {
                        <img src="@Model.HeroImageUrl" alt="@Model.OrgName pickleball court" />
                    }
                    else
                    {
                        <img src="~/images/hero-player.png" asp-append-version="true" alt="Pickleball player ready to serve" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== QUICK RESERVE DOCKED BAR ===================== -->
<div class="pb-quick-reserve-wrap">
    <div class="pb-quick-reserve-bar">
        <div class="pb-qr-field">
            <label for="qrDate"><i class="bi bi-calendar-event text-success me-1"></i>Date</label>
            <input type="date" id="qrDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="pb-qr-divider"></div>
        <div class="pb-qr-field">
            <label for="qrCourt"><i class="bi bi-grid-3x3-gap text-success me-1"></i>Court</label>
            <select id="qrCourt" class="form-select">
                <option value="">Any Available Court</option>
                @foreach (var c in Model.Courts.Where(x => x.Court.Status == PickleBallBooking.Models.CourtStatus.Active))
                {
                    <option value="@c.Court.Id">@c.Court.Name</option>
                }
            </select>
        </div>
        <div class="pb-qr-divider"></div>
        <div class="pb-qr-field">
            <label for="qrTimePref"><i class="bi bi-clock-history text-success me-1"></i>Time of Day</label>
            <select id="qrTimePref" class="form-select">
                <option value="any">Any Time</option>
                <option value="morning">Morning (6 AM - 12 PM)</option>
                <option value="afternoon">Afternoon (12 PM - 5 PM)</option>
                <option value="evening">Evening (5 PM - 10 PM)</option>
            </select>
        </div>
        <div class="pb-qr-action ms-lg-auto w-100 w-lg-auto mt-2 mt-lg-0">
            <button type="button" id="btnQuickReserve" class="btn btn-lime w-100">
                <i class="bi bi-lightning-charge-fill me-1"></i>Check Slots
            </button>
        </div>
    </div>
</div>

<!-- ===================== CLUB STAT METRICS ===================== -->
<div class="pb-stat-strip pb-reveal">
    <div class="pb-stat-item">
        <span class="pb-stat-val">@Model.Courts.Count(c => c.Court.Status == PickleBallBooking.Models.CourtStatus.Active)</span>
        <span class="pb-stat-lbl">Tournament Courts</span>
    </div>
    <div class="pb-stat-item">
        <span class="pb-stat-val">@(Model.TotalAvailableSlotsToday > 0 ? Model.TotalAvailableSlotsToday.ToString() : "7 Days")</span>
        <span class="pb-stat-lbl">@(Model.TotalAvailableSlotsToday > 0 ? "Open Slots Today" : "Weekly Access")</span>
    </div>
    <div class="pb-stat-item">
        <span class="pb-stat-val">⚡ Fast</span>
        <span class="pb-stat-lbl">Instant QR Check-In</span>
    </div>
    <div class="pb-stat-item">
        <span class="pb-stat-val">₱@Model.StartingPrice.ToString("N0")</span>
        <span class="pb-stat-lbl">Starting Price</span>
    </div>
</div>

<!-- ===================== OUR COURTS ===================== -->
<section class="pb-section" id="courts" aria-labelledby="courts-heading">
    <div class="text-center mb-4">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-grid-3x3-gap"></i> Our Courts
        </span>
        <h2 class="pb-section-title" id="courts-heading">PREMIUM PICKLEBALL COURTS</h2>
        <p class="pb-section-subtitle mx-auto">Browse our dedicated, fully maintained courts with live slot availability.</p>
    </div>

    @if (Model.Courts.Count == 0)
    {
        <div class="pb-empty-state text-center" role="status">
            <i class="bi bi-info-circle display-5 d-block mb-2" aria-hidden="true"></i>
            <p class="mb-0">No courts are available right now. Please check back soon.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model.Courts)
            {
                var slotsLabel = c.AvailableSlots == 1 ? "slot" : "slots";
                var isLimited = c.HasAvailabilityData && c.HasLiveAvailability && c.AvailableSlots <= 3;
                <div class="col-md-6 col-lg-4 pb-reveal">
                    <article class="pb-court-card h-100 d-flex flex-column" aria-label="@c.Court.Name">
                        <div class="pb-court-card-img position-relative">
                            <img src="@c.ImageUrl"
                                 alt="@c.Court.Name court at @Model.OrgName"
                                 loading="lazy" />

                            @if (c.Court.Status == PickleBallBooking.Models.CourtStatus.Inactive)
                            {
                                <span class="pb-court-badge" style="background: rgba(108, 117, 125, 0.9); color: #fff;" role="status" aria-label="Under Maintenance">
                                    <span class="pb-dot" style="background:#ffc107;" aria-hidden="true"></span>Under Maintenance
                                </span>
                            }
                            else if (c.HasAvailabilityData)
                            {
                                if (c.HasLiveAvailability && isLimited)
                                {
                                    <span class="pb-court-badge pb-badge-limited" role="status" aria-label="@c.AvailableSlots @slotsLabel open, limited availability">
                                        <span class="pb-dot" aria-hidden="true"></span>@c.AvailableSlots @slotsLabel &mdash; Limited
                                    </span>
                                }
                                else if (c.HasLiveAvailability)
                                {
                                    <span class="pb-court-badge pb-badge-open" role="status" aria-label="@c.AvailableSlots @slotsLabel open today">
                                        <span class="pb-dot" aria-hidden="true"></span>@c.AvailableSlots @slotsLabel open today
                                    </span>
                                }
                                else
                                {
                                    <span class="pb-court-badge pb-badge-closed" role="status" aria-label="Fully booked today">
                                        <span class="pb-dot" aria-hidden="true"></span>Fully booked today
                                    </span>
                                }
                            }
                        </div>
                        <div class="pb-court-card-body d-flex flex-column flex-grow-1 p-3 p-md-4">
                            <h3 class="pb-court-name mb-1">
                                <i class="bi bi-dribbble me-1" aria-hidden="true"></i>@c.Court.Name
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(c.Court.Features))
                            {
                                <!-- Court Surface & Feature Chips (Dynamic from Manage Court) -->
                                <div class="pb-court-specs">
                                    @{
                                        var specs = c.Court.Features.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                        foreach (var spec in specs)
                                        {
                                            var icon = "bi-check2";
                                            var iconColor = "text-primary";
                                            var lower = spec.ToLowerInvariant();
                                            if (lower.Contains("acrylic") || lower.Contains("cushion") || lower.Contains("surface"))
                                            {
                                                icon = "bi-shield-check";
                                                iconColor = "text-success";
                                            }
                                            else if (lower.Contains("light") || lower.Contains("led"))
                                            {
                                                icon = "bi-lightbulb";
                                                iconColor = "text-warning";
                                            }
                                            else if (lower.Contains("cover") || lower.Contains("indoor") || lower.Contains("ac") || lower.Contains("air"))
                                            {
                                                icon = "bi-building-check";
                                                iconColor = "text-info";
                                            }
                                            <span class="pb-court-spec-chip"><i class="bi @icon @iconColor me-1"></i>@spec</span>
                                        }
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(c.Court.Description))
                            {
                                <p class="pb-court-desc mb-2">@c.Court.Description</p>
                            }
                            else
                            {
                                <p class="pb-court-desc text-muted mb-2">Dedicated court engineered for optimal ball bounce, traction, and comfortable play.</p>
                            }

                            @if (c.Court.Status == PickleBallBooking.Models.CourtStatus.Inactive)
                            {
                                <div class="alert alert-secondary py-2 px-3 small my-2 d-flex align-items-start gap-2" role="status">
                                    <i class="bi bi-tools text-warning fs-6 flex-shrink-0 mt-1"></i>
                                    <div>
                                        <strong class="d-block text-dark">Temporarily Unavailable</strong>
                                        <span class="text-muted">
                                            @(string.IsNullOrWhiteSpace(c.Court.MaintenanceNote)
                                                ? "This court is temporarily closed for maintenance or improvements."
                                                : c.Court.MaintenanceNote)
                                        </span>
                                    </div>
                                </div>
                                <div class="mt-auto pt-2">
                                    <button type="button" class="btn btn-outline-secondary w-100 disabled" disabled aria-disabled="true">
                                        <i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Unavailable for Booking
                                    </button>
                                </div>
                            }
                            else
                            {
                                <!-- Today's Time-of-Day Mini Slot Heatstrip -->
                                <div class="pb-slot-heatstrip" title="Today's slot availability breakdown">
                                    <a href="/Booking?courtId=@c.Court.Id&timeFilter=morning" class="pb-heat-block text-decoration-none @(c.MorningSlots > 0 ? "is-open" : "is-full")" title="Filter Morning Slots">
                                        <span class="pb-heat-lbl">🌅 Morning</span>
                                        <span class="pb-heat-val">@(c.MorningSlots > 0 ? $"{c.MorningSlots} open" : "Full")</span>
                                    </a>
                                    <a href="/Booking?courtId=@c.Court.Id&timeFilter=afternoon" class="pb-heat-block text-decoration-none @(c.AfternoonSlots > 0 ? "is-open" : "is-full")" title="Filter Afternoon Slots">
                                        <span class="pb-heat-lbl">☀️ Afternoon</span>
                                        <span class="pb-heat-val">@(c.AfternoonSlots > 0 ? $"{c.AfternoonSlots} open" : "Full")</span>
                                    </a>
                                    <a href="/Booking?courtId=@c.Court.Id&timeFilter=evening" class="pb-heat-block text-decoration-none @(c.EveningSlots > 0 ? "is-open" : "is-full")" title="Filter Evening Slots">
                                        <span class="pb-heat-lbl">🌙 Evening</span>
                                        <span class="pb-heat-val">@(c.EveningSlots > 0 ? $"{c.EveningSlots} open" : "Full")</span>
                                    </a>
                                </div>

                                <div class="mt-auto">
                                    <a asp-page="/Booking/Index"
                                       asp-route-courtId="@c.Court.Id"
                                       class="btn btn-primary w-100 pb-btn-reserve"
                                       aria-label="Reserve @c.Court.Name now">
                                        <span>Reserve Court</span>
                                        <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                                    </a>
                                    <a asp-page="/Availability/Index"
                                       class="pb-btn-schedule-link"
                                       aria-label="View availability for @c.Court.Name">
                                        <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>View Full Schedule
                                    </a>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

@* ── ABOUT SECTION (shown when admin set an AboutText) ────────────── *@
@if (!string.IsNullOrWhiteSpace(Model.AboutText))
{
    <section class="pb-section pb-section-alt" id="about" aria-labelledby="about-heading">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center pb-reveal">
                <span class="pb-section-label" aria-hidden="true">
                    <i class="bi bi-building"></i> About Us
                </span>
                <h2 class="pb-section-title" id="about-heading">ABOUT @Model.OrgName.ToUpperInvariant()</h2>
                <p class="pb-section-subtitle mx-auto" style="max-width:680px;">@Model.AboutText</p>
                <a asp-page="/Booking/Index" class="btn btn-primary" id="about-book-btn">
                    <i class="bi bi-lightning-charge-fill me-1"></i>Book a Court
                </a>
            </div>
        </div>
    </section>
}

@* ── UPCOMING ACTIVITIES (shown when tenant enables it) ────────────── *@
@if (Model.ShowActivitiesOnHome && Model.UpcomingActivities.Any())
{
    <section class="pb-section pb-section-alt" id="home-activities" aria-labelledby="home-act-heading">
        <div class="text-center mb-4">
            <span class="pb-section-label" aria-hidden="true">
                <i class="bi bi-calendar-event"></i> Community Play
            </span>
            <h2 class="pb-section-title" id="home-act-heading">UPCOMING ACTIVITIES</h2>
            <p class="pb-section-subtitle mx-auto">Join a session, improve your skills, and play with the community.</p>
        </div>
        <div class="row g-4 justify-content-center">
            @foreach (var act in Model.UpcomingActivities)
            {
                <div class="col-sm-10 col-md-6 col-lg-4 pb-reveal">
                    <article class="pb-activity-card h-100 d-flex flex-column" aria-label="@act.Name activity">
                        <div class="pb-activity-card-accent"></div>
                        <div class="pb-activity-card-body d-flex flex-column flex-grow-1">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex flex-wrap gap-1">
                                    <span class="badge pb-activity-badge-format">@act.Format</span>
                                    <span class="badge pb-activity-badge-skill">@act.SkillLevel</span>
                                </div>
                                @if (act.PricePerPlayer == 0)
                                {
                                    <span class="pb-activity-free-badge">FREE</span>
                                }
                                else
                                {
                                    <span class="pb-activity-price-badge">₱@act.PricePerPlayer.ToString("N0")<small>/player</small></span>
                                }
                            </div>

                            <h3 class="pb-activity-name">@act.Name</h3>

                            <ul class="pb-activity-meta">
                                <li>
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span>@act.Date.ToString("MMM d, yyyy") <span class="text-muted">(@act.Date.ToString("ddd"))</span></span>
                                </li>
                                <li>
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    <span>@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)</span>
                                </li>
                                @if (act.MaxCapacity > 0)
                                {
                                    <li>
                                        <i class="bi bi-people" aria-hidden="true"></i>
                                        <span>Max @act.MaxCapacity players</span>
                                    </li>
                                }
                            </ul>

                            @if (act.Status == PickleBallBooking.Models.ActivityStatus.Full)
                            {
                                <div class="mt-auto pt-2">
                                    <span class="badge bg-danger text-white w-100 py-2 mb-2">Registration Full &bull; Waitlist Open</span>
                                    <a asp-page="/Activities/Index" class="btn btn-outline-secondary w-100 btn-sm">
                                        View Waitlist <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="mt-auto pt-2">
                                    <a asp-page="/Activities/Index" class="pb-activity-cta" id="home-act-@act.Id">
                                        Join Session <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-page="/Activities/Index" class="btn btn-outline-primary px-4" id="home-all-activities-btn"
               style="border-radius:.75rem;">
                <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>See All Activities
            </a>
        </div>
    </section>
}

@* ── AMENITIES (shown only when enabled and amenities are set) ─ *@
@if (Model.ShowAmenitiesSection && Model.Amenities.Any())
{
    <section class="pb-section pb-section-alt" id="amenities" aria-labelledby="amenities-heading">
        <div class="text-center mb-4">
            <span class="pb-section-label" aria-hidden="true">
                <i class="bi bi-stars"></i> Venue Amenities
            </span>
            <h2 class="pb-section-title" id="amenities-heading">VENUE & PLAYER AMENITIES</h2>
            <p class="pb-section-subtitle mx-auto">Everything you need for a premium, hassle-free pickleball experience.</p>
        </div>
        <div class="pb-amenity-grid-luxury pb-reveal">
            @foreach (var amenity in Model.Amenities)
            {
                <div class="pb-amenity-tile">
                    <i class="bi @amenity.Icon tile-icon" aria-hidden="true"></i>
                    <p class="tile-title">@amenity.Label</p>
                </div>
            }
        </div>
    </section>
}

@* ── THE CLUB EXPERIENCE (Why Choose Us) ──────────────────── *@
@if (Model.ShowWhyUsSection)
{
<section class="pb-section" id="why-punit-bola" aria-labelledby="why-heading">
    <div class="text-center mb-4">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-star-fill"></i> Why Play With Us
        </span>
        <h2 class="pb-section-title" id="why-heading">THE CLUB EXPERIENCE</h2>
        <p class="pb-section-subtitle mx-auto">Engineered for players who appreciate quality, convenience, and community.</p>
    </div>

    <div class="pb-why-grid">
        <!-- Card 1: Tournament Surfaces -->
        <div class="pb-why-card pb-reveal" role="article" aria-label="Tournament Surfaces">
            <div class="pb-why-icon" aria-hidden="true">
                <i class="bi bi-dribbble"></i>
            </div>
            <h3 class="pb-why-title">Cushioned Courts</h3>
            <p class="pb-why-desc">Multi-layer tournament-grade cushioned acrylic reduces joint impact and offers true ball bounce.</p>
        </div>

        <!-- Card 2: Prime Location -->
        <div class="pb-why-card pb-reveal" style="transition-delay:0.08s" role="article" aria-label="Prime Location">
            <div class="pb-why-icon" aria-hidden="true">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <h3 class="pb-why-title">Convenient Access</h3>
            <p class="pb-why-desc">Central location with dedicated on-site parking, safe access, and full player amenities.</p>
        </div>

        <!-- Card 3: Seamless Scheduling -->
        <div class="pb-why-card pb-reveal" style="transition-delay:0.16s" role="article" aria-label="Seamless Scheduling">
            <div class="pb-why-icon" aria-hidden="true">
                <i class="bi bi-calendar-check"></i>
            </div>
            <h3 class="pb-why-title">Real-Time Booking</h3>
            <p class="pb-why-desc">Live slot calendar with instant mobile confirmation, flexible single or consecutive hour reservations.</p>
        </div>

        <!-- Card 4: Built for Community -->
        <div class="pb-why-card pb-reveal" style="transition-delay:0.24s" role="article" aria-label="Built for Community">
            <div class="pb-why-icon" aria-hidden="true">
                <i class="bi bi-people-fill"></i>
            </div>
            <h3 class="pb-why-title">Vibrant Community</h3>
            <p class="pb-why-desc">Regular open-play sessions, social tournaments, and skill clinics for beginners and competitive players alike.</p>
        </div>
    </div>
</section>
}

@* ── HOW IT WORKS (toggleable) ────────────────────────────── *@
@if (Model.ShowHowItWorksSection)
{
<!-- ===================== HOW IT WORKS ===================== -->
<section class="pb-section pb-section-alt" id="how-it-works" aria-labelledby="hiw-heading">
    <div class="text-center mb-4">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-lightning"></i> Simple 3-Step Process
        </span>
        <h2 class="pb-section-title" id="hiw-heading">HOW TO RESERVE</h2>
        <p class="pb-section-subtitle mx-auto mb-0">Three effortless steps to your next match.</p>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-4 pb-reveal">
            <div class="pb-feature-card pb-card-hover h-100">
                <span class="pb-step-number" aria-label="Step 1">01</span>
                <h3 class="h5 mb-2 fw-bold">Select Date & Court</h3>
                <p class="mb-0 text-muted">Pick your preferred play date and browse real-time court availability.</p>
            </div>
        </div>
        <div class="col-md-4 pb-reveal" style="transition-delay:0.1s">
            <div class="pb-feature-card pb-card-hover h-100">
                <span class="pb-step-number" aria-label="Step 2">02</span>
                <h3 class="h5 mb-2 fw-bold">Pick Your Time Slots</h3>
                <p class="mb-0 text-muted">Choose one or more consecutive slots that fit your game schedule.</p>
            </div>
        </div>
        <div class="col-md-4 pb-reveal" style="transition-delay:0.2s">
            <div class="pb-feature-card pb-card-hover h-100">
                <span class="pb-step-number" aria-label="Step 3">03</span>
                <h3 class="h5 mb-2 fw-bold">Instant Digital Pass</h3>
                <p class="mb-0 text-muted">Receive your booking confirmation with an instant QR check-in pass right to your email.</p>
            </div>
        </div>
    </div>
    <div class="text-center mt-3 pb-reveal" style="transition-delay:0.3s">
        <a asp-page="/Booking/Index" class="btn btn-primary btn-lg px-5" style="border-radius:0.75rem;" id="hiw-book-btn">
            <i class="bi bi-lightning-charge-fill me-1" aria-hidden="true"></i>Book Now
        </a>
    </div>
</section>
}

@* ── LOCATION (toggleable) ─────────────────────────────────── *@
@if (Model.ShowLocationSection)
{
<!-- ===================== LOCATION ===================== -->
<section class="pb-section" id="location" aria-labelledby="location-heading">
    <div class="row g-4 g-lg-5 align-items-center">
        <div class="col-lg-5 pb-reveal">
            <span class="pb-section-label" aria-hidden="true">
                <i class="bi bi-geo-alt"></i> Location & Access
            </span>
            <h2 class="pb-section-title" id="location-heading">FIND OUR VENUE</h2>
            <p class="pb-section-subtitle">Convenient location with dedicated on-site parking.</p>
            <ul class="list-unstyled pb-contact-list">
                <li>
                    <i class="bi bi-building text-success" aria-hidden="true"></i>
                    <strong>@Model.OrgName</strong>
                </li>
                @if (!string.IsNullOrWhiteSpace(Model.OrgAddress))
                {
                    <li>
                        <i class="bi bi-geo-alt text-success" aria-hidden="true"></i>
                        <span>@Model.OrgAddress</span>
                    </li>
                }
                <li>
                    <i class="bi bi-clock text-success" aria-hidden="true"></i>
                    <span>@(string.IsNullOrWhiteSpace(Model.OpeningHours) ? "Open daily — 6:00 AM – 10:00 PM" : Model.OpeningHours)</span>
                </li>
                <li>
                    <i class="bi bi-shield-check text-success" aria-hidden="true"></i>
                    <span>Dedicated parking & player lounge</span>
                </li>
            </ul>

            <!-- 1-Tap Navigation Shortcuts -->
            <div class="pb-nav-chips">
                <a href="https://www.google.com/maps/search/?api=1&query=@Model.OrgLatitude,@Model.OrgLongitude"
                   target="_blank" rel="noopener noreferrer" class="pb-nav-chip">
                    <i class="bi bi-geo-alt-fill text-danger"></i> Google Maps
                </a>
                <a href="https://waze.com/ul?ll=@Model.OrgLatitude,@Model.OrgLongitude&navigate=yes"
                   target="_blank" rel="noopener noreferrer" class="pb-nav-chip">
                    <i class="bi bi-compass-fill text-primary"></i> Open in Waze
                </a>
                @if (!string.IsNullOrWhiteSpace(Model.OrgAddress))
                {
                    <button type="button" id="btnCopyAddress" class="pb-nav-chip" data-address="@Model.OrgAddress">
                        <i class="bi bi-clipboard"></i> Copy Address
                    </button>
                }
            </div>
        </div>
        <div class="col-lg-7 pb-reveal" style="transition-delay:0.15s">
            <div class="pb-map-wrap shadow-sm">
                <a class="pb-map-link"
                   href="https://www.google.com/maps/search/?api=1&query=@Model.OrgLatitude,@Model.OrgLongitude"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Open @Model.OrgName location in Google Maps (opens in new tab)">
                    <iframe
                        src="https://www.google.com/maps?q=@Model.OrgLatitude,@Model.OrgLongitude&z=17&output=embed"
                        title="Map showing @Model.OrgName location"
                        width="100%"
                        height="420"
                        style="border:0; border-radius:16px;"
                        allowfullscreen=""
                        loading="lazy">
                    </iframe>
                    <span class="pb-map-overlay">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Tap to open in Google Maps
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>
}

@* ── FAQ (toggleable) ──────────────────────────────────────── *@
@if (Model.ShowFaqSection)
{
<!-- ===================== FAQ ===================== -->
<section class="pb-section pb-section-alt" id="faq" aria-labelledby="faq-heading">
    <div class="text-center mb-4">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-patch-question"></i> Frequently Asked Questions
        </span>
        <h2 class="pb-section-title" id="faq-heading">FREQUENTLY ASKED QUESTIONS</h2>
        <p class="pb-section-subtitle mx-auto">Everything you need to know before you hit the court.</p>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8 pb-reveal">
            <div class="accordion pb-accordion" id="homeFaq">
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading1">
                        <button class="accordion-button" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq1"
                                aria-expanded="true" aria-controls="faq1">
                            How do I book a court?
                        </button>
                    </h3>
                    <div id="faq1" class="accordion-collapse collapse show"
                         aria-labelledby="faqHeading1" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Pick a date and court on the booking page, choose one or more consecutive available time slots,
                            enter your details, and submit payment. You&rsquo;ll receive a booking reference and instant digital QR pass.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading2">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq2"
                                aria-expanded="false" aria-controls="faq2">
                            Do I need an account to play?
                        </button>
                    </h3>
                    <div id="faq2" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading2" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            No. You can book directly as a guest without creating an account &mdash; just provide your name, phone number, and email
                            so we can confirm and issue your check-in pass.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading3">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq3"
                                aria-expanded="false" aria-controls="faq3">
                            Can I book multiple consecutive hours?
                        </button>
                    </h3>
                    <div id="faq3" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading3" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Yes. You can select multiple consecutive fixed time slots back-to-back without interruption.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading4">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq4"
                                aria-expanded="false" aria-controls="faq4">
                            How do I check in upon arrival at the venue?
                        </button>
                    </h3>
                    <div id="faq4" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading4" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Your confirmation email includes a digital Court Check-In QR Pass. Simply present the QR code to the staff at the front desk for fast, 1-tap check-in.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading5">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq5"
                                aria-expanded="false" aria-controls="faq5">
                            What payment methods are supported?
                        </button>
                    </h3>
                    <div id="faq5" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading5" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            We accept manual mobile wallet transfers such as GCash, Maya, and online bank transfers with fast verification.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
}

