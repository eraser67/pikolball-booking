<!-- ===================== FAQ ===================== -->
<section class="pb-section" id="faq" aria-labelledby="faq-heading">
    <div class="text-center mb-2">
        <span class="pb-section-label" aria-hidden="true">
            <i class="bi bi-patch-question"></i> FAQ
        </span>
        <h2 class="pb-section-title" id="faq-heading">FREQUENTLY ASKED QUESTIONS</h2>
        <p class="pb-section-subtitle mx-auto">Everything you need to know before you play.</p>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8 pb-reveal">
            <div class="accordion pb-accordion" id="homeFaq">
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading1">
                        <button class="accordion-button" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq1"
                                aria-expanded="true" aria-controls="faq1">
                            How do I book a court?
                        </button>
                    </h3>
                    <div id="faq1" class="accordion-collapse collapse show"
                         aria-labelledby="faqHeading1" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Pick a date and court on the booking page, choose one or more consecutive available time slots,
                            enter your details, and confirm. You&rsquo;ll receive a booking reference to manage your reservation.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading2">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq2"
                                aria-expanded="false" aria-controls="faq2">
                            Do I need an account?
                        </button>
                    </h3>
                    <div id="faq2" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading2" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            No. You can book without creating an account &mdash; just provide your name, phone number and email
                            so we can confirm and help you manage your booking.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading3">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq3"
                                aria-expanded="false" aria-controls="faq3">
                            Can I book multiple hours?
                        </button>
                    </h3>
                    <div id="faq3" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading3" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Yes. You can select multiple consecutive fixed time slots back-to-back. Slots must be continuous
                            (no gaps) so your session forms one uninterrupted booking.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading4">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq4"
                                aria-expanded="false" aria-controls="faq4">
                            Can I cancel my booking?
                        </button>
                    </h3>
                    <div id="faq4" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading4" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            Bookings can be cancelled and the reserved time slots are released, making them available to others
                            again. Look up your booking with your reference to manage it.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h3 class="accordion-header" id="faqHeading5">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#faq5"
                                aria-expanded="false" aria-controls="faq5">
                            How do I know my booking is confirmed?
                        </button>
                    </h3>
                    <div id="faq5" class="accordion-collapse collapse"
                         aria-labelledby="faqHeading5" data-bs-parent="#homeFaq">
                        <div class="accordion-body">
                            After confirming, you&rsquo;ll see a confirmation page with a unique booking reference. Keep it safe &mdash;
                            you can use it anytime on the &ldquo;My Booking&rdquo; lookup page to view its status.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

