@page
@model PickleBallBooking.Pages.NotificationsModel
@using PickleBallBooking.Services
@{
    ViewData["Title"] = "Notifications";
    Layout = "_Layout";
    var isCustomer = User.IsInRole(PlatformRoles.Customer);
    var homeUrl = isCustomer ? "/Customer/Dashboard" : "/Admin";
    var homeText = isCustomer ? "Back to Dashboard" : "Back to Admin";
}

<div class="container py-4" style="max-width:760px;">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">
                <i class="bi bi-bell-fill me-2 text-primary"></i>Notifications
                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-danger ms-2" style="font-size:.65rem;">@Model.UnreadCount</span>
                }
            </h1>
            <p class="text-muted small mb-0">Your activity updates and alerts.</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form method="post" asp-page-handler="MarkAllRead">
                @Html.AntiForgeryToken()
                <button type="submit" id="btn-mark-all-read" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-check2-all me-1"></i>Mark all as read
                </button>
            </form>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Notifications.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bell-slash display-4 text-muted"></i>
            <p class="text-muted mt-3">You have no notifications yet.</p>
            <a href="@homeUrl" class="btn btn-outline-primary btn-sm mt-2">
                <i class="bi bi-house me-1"></i>@homeText
            </a>
        </div>
    }
    else
    {
        <div class="notification-feed d-flex flex-column gap-2">
            @foreach (var n in Model.Notifications)
            {
                var bgClass  = n.IsRead ? "bg-white" : "bg-primary bg-opacity-10";
                var borderClass = n.IsRead ? "border-light" : "border-primary border-opacity-25";
                var icon     = AppNotificationService.GetIcon(n.Type);
                <div class="card shadow-sm border @borderClass @bgClass" style="border-radius:12px;">
                    <div class="card-body py-3 px-4 d-flex align-items-start gap-3">
                        <div class="flex-shrink-0 mt-1" style="font-size:1.3rem;">
                            <i class="bi @icon"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div>
                                    <p class="mb-1 fw-semibold @(n.IsRead ? "text-muted" : "")">@n.Title</p>
                                    @if (!string.IsNullOrEmpty(n.Body))
                                    {
                                        <p class="mb-1 small text-muted">@n.Body</p>
                                    }
                                    <p class="mb-0 text-muted" style="font-size:.75rem;">
                                        <i class="bi bi-clock me-1"></i>@n.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge bg-primary ms-2" style="font-size:.65rem;">New</span>
                                        }
                                    </p>
                                </div>
                                <div class="d-flex gap-2 flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(n.ActionUrl))
                                    {
                                        <a href="@n.ActionUrl" class="btn btn-sm btn-outline-primary" style="font-size:.8rem;">
                                            View
                                        </a>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <form method="post" asp-page-handler="MarkRead" asp-route-id="@n.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-link text-muted p-0" title="Mark as read" style="font-size:.8rem;">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a href="@homeUrl" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-house me-1"></i>@homeText
            </a>
        </div>
    }
</div>
