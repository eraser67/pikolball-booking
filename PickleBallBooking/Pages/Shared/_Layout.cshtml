@using PickleBallBooking.Services
@inject ITenantContext TenantCtx
@inject IOrganizationService OrgSvc
@inject ICourtImageStorage ImageStorage
@inject PlatformSettingsService PlatformSettingsSvc
@inject AppNotificationService NotificationSvc
@{
    var currentPath = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string NavActive(params string[] prefixes)
    {
        foreach (var p in prefixes)
        {
            if (p == "/" && currentPath == "/") { return "active"; }
            if (p != "/" && currentPath.StartsWith(p)) { return "active"; }
        }
        return string.Empty;
    }
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    // Phase 31: distinguish customer/player accounts from admin/staff accounts
    var isCustomer = isAuthenticated && User.IsInRole(PlatformRoles.Customer);
    var isAdmin = isAuthenticated && !isCustomer;

    // Phase 36: unread notification count for the bell badge (all authenticated users)
    int unreadNotifications = 0;
    if (isAuthenticated)
    {
        var userId = Context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            unreadNotifications = await NotificationSvc.GetUnreadCountAsync(userId);
        }
    }

    // Org-aware display name & custom logo: on tenant subdomains show the org's name & logo; elsewhere show platform brand.
    Models.Organization? tenantOrg = TenantCtx.IsResolved ? await OrgSvc.GetCurrentAsync() : null;
    var displayName = tenantOrg?.Name ?? "Punit Bola Booking";
    var platformBrand = "Punit Bola Booking";
    var tenantLogoUrl = !string.IsNullOrEmpty(tenantOrg?.LogoPath) ? ImageStorage.GetPublicUrl(tenantOrg.LogoPath) : null;
    var primaryColor  = tenantOrg?.PrimaryColorHex;
    var facebookUrl   = tenantOrg?.FacebookUrl;
    var instagramUrl  = tenantOrg?.InstagramUrl;
    var twitterUrl    = tenantOrg?.TwitterUrl;

    // Platform registration toggle (shown in navbar when enabled)
    var platformSettings = await PlatformSettingsSvc.GetAsync();
    var allowTenantReg   = platformSettings.AllowTenantRegistration;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@displayName — book pickleball courts online. Check live availability, choose your court and time, and reserve in minutes." />
    <title>@ViewData["Title"] - @displayName</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PickleBallBooking.styles.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(primaryColor))
    {
        <style>
        :root {
            /* Tenant brand color overrides all green scale variables */
            --pb-green-600: @primaryColor;
            --pb-green-700: color-mix(in srgb, @primaryColor 80%, #000);
            --pb-green-900: color-mix(in srgb, @primaryColor 55%, #000);
            --pb-green-500: color-mix(in srgb, @primaryColor 85%, #fff);
            --pb-green-100: color-mix(in srgb, @primaryColor 18%, #fff);
            /* Keep pb-primary aliases for our own components */
            --pb-primary:      @primaryColor;
            --pb-primary-dark: color-mix(in srgb, @primaryColor 80%, #000);
        }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="pb-skip-link" href="#main-content">Skip to main content</a>

    @* ── Tenant Announcement Banner ───────────────────────────────── *@
    @if (tenantOrg?.ShowAnnouncementBanner == true && !string.IsNullOrWhiteSpace(tenantOrg?.AnnouncementText))
    {
        <div class="pb-announcement-banner alert alert-success alert-dismissible mb-0 rounded-0 border-0 text-center py-2" role="alert" id="pb-announcement">
            <i class="bi bi-megaphone-fill me-2" aria-hidden="true"></i>
            @tenantOrg!.AnnouncementText
            <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Dismiss announcement"></button>
        </div>
    }

    <header>
        <nav class="navbar navbar-expand-lg pb-navbar sticky-top" aria-label="Main navigation">
            <div class="container-fluid px-3 px-lg-4 px-xl-5">
                <a class="navbar-brand pb-brand" asp-area="" asp-page="/Index">
                    @if (!string.IsNullOrEmpty(tenantLogoUrl))
                    {
                        <img src="@tenantLogoUrl" alt="@displayName" class="pb-brand-logo" />
                    }
                    else
                    {
                        <img src="~/images/pickleball.png" alt="Pikolball" class="pb-brand-logo" />
                    }
                    <span class="pb-brand-text">
                        @displayName
                        @if (tenantOrg is not null)
                        {
                            <small>Punit Bola Booking</small>
                        }
                        else
                        {
                            <small>Court Reservations</small>
                        }
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/")" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/availability")" asp-area="" asp-page="/Availability/Index">
                                <i class="bi bi-calendar3 me-1"></i>Courts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/booking/lookup")" asp-area="" asp-page="/Booking/Lookup">
                                <i class="bi bi-search me-1"></i>My Booking
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/activities")" asp-area="" asp-page="/Activities/Index">
                                <i class="bi bi-calendar-event me-1"></i>Activities
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/activities/leaderboard")" asp-area="" asp-page="/Activities/Leaderboard">
                                <i class="bi bi-trophy me-1"></i>Leaderboard
                            </a>
                        </li>
                        @if (isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("/customer")" asp-area="" asp-page="/Customer/Dashboard">
                                    <i class="bi bi-person-circle me-1"></i>My Dashboard
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @NavActive("/admin")" href="#" id="adminDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    @if (User.IsInRole(PickleBallBooking.Services.PlatformRoles.PlatformAdmin))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Organizations/Index"><i class="bi bi-buildings me-2"></i>Organizations</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Organizations/PlatformSettings"><i class="bi bi-sliders me-2"></i>Platform Settings</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Subscriptions/Index"><i class="bi bi-credit-card-2-front me-2"></i>Subscriptions</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Subscriptions/Plans/Index"><i class="bi bi-stack me-2"></i>Subscription Plans</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/OrgSettings/Index"><i class="bi bi-gear me-2"></i>Organization</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Users/Index"><i class="bi bi-people me-2"></i>Users</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Bookings/Index"><i class="bi bi-journal-text me-2"></i>Manage Bookings</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Payments/Index"><i class="bi bi-credit-card me-2"></i>Payments</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Courts/Index"><i class="bi bi-grid-3x3-gap me-2"></i>Manage Courts</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/TimeSlots/Index"><i class="bi bi-clock-history me-2"></i>Manage Time Slots</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Pricing/Index"><i class="bi bi-tags me-2"></i>Manage Pricing</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Activities/Index"><i class="bi bi-calendar-event me-2"></i>Activities</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Players/Index"><i class="bi bi-people me-2 text-info"></i>Venue Players</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/CheckIn/Index"><i class="bi bi-qr-code-scan me-2 text-primary"></i>Player Check-In</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Activities/Leaderboard"><i class="bi bi-trophy me-2 text-warning"></i>Leaderboard</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Schedule/Index"><i class="bi bi-calendar-week me-2"></i>Schedule</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                                        <ul class="navbar-nav pb-nav-actions">
                        <li class="nav-item">
                            <a class="nav-link pb-nav-cta @NavActive("/booking/index")" asp-area="" asp-page="/Booking/Index">
                                <i class="bi bi-lightning-charge-fill me-1"></i>Book a Court
                            </a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link pb-nav-notif-link @NavActive("/notifications")" asp-page="/Notifications"
                                   title="Notifications" aria-label="Notifications">
                                    <span class="pb-notif-icon-wrap position-relative d-inline-flex align-items-center justify-content-center">
                                        <i class="bi bi-bell-fill"></i>
                                        @if (unreadNotifications > 0)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                                  style="font-size:.6rem;min-width:16px;line-height:1.2;padding:2px 4px;z-index:2;">
                                                @(unreadNotifications > 9 ? "9+" : unreadNotifications.ToString())
                                                <span class="visually-hidden">unread notifications</span>
                                            </span>
                                        }
                                    </span>
                                    <span class="d-lg-none ms-2">Notifications</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-flex pb-nav-action-form">
                                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            @if (allowTenantReg)
                            {
                                <li class="nav-item">
                                    <a class="btn btn-outline-success btn-sm rounded-3" asp-area="" asp-page="/JoinUs">
                                        <i class="bi bi-building-add me-1"></i>Register Your Venue
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm rounded-3" asp-area="" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success btn-sm rounded-3" asp-area="" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3" id="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="pb-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (!string.IsNullOrEmpty(tenantLogoUrl))
                        {
                            <img src="@tenantLogoUrl" alt="@displayName" height="30" width="30" class="rounded object-fit-contain" />
                        }
                        else
                        {
                            <img src="~/images/pickleball.png" alt="Pikolball" height="30" width="30" />
                        }
                        <span class="pb-footer-brand">@displayName</span>
                    </div>
                    @if (tenantOrg is not null)
                    {
                        <p class="mb-1">@(tenantOrg.Tagline ?? "Your court. Your time. Your game.")</p>
                        @if (!string.IsNullOrEmpty(facebookUrl) || !string.IsNullOrEmpty(instagramUrl) || !string.IsNullOrEmpty(twitterUrl))
                        {
                            <div class="d-flex gap-3 mt-2 mb-1">
                                @if (!string.IsNullOrEmpty(facebookUrl))
                                {
                                    <a href="@facebookUrl" target="_blank" rel="noopener noreferrer" class="pb-social-link" aria-label="Facebook">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(instagramUrl))
                                {
                                    <a href="@instagramUrl" target="_blank" rel="noopener noreferrer" class="pb-social-link" aria-label="Instagram">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(twitterUrl))
                                {
                                    <a href="@twitterUrl" target="_blank" rel="noopener noreferrer" class="pb-social-link" aria-label="X / Twitter">
                                        <i class="bi bi-twitter-x"></i>
                                    </a>
                                }
                            </div>
                        }
                        <p class="mb-0 small text-white" style="color:#fff;">Powered by <strong>@platformBrand</strong></p>
                    }
                    else
                    {
                        <p class="mb-0">Your court. Your time. Your game. Book a pickleball court in just a few clicks.</p>
                    }
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="pb-footer-heading">Quick Links</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-area="" asp-page="/Index">Home</a></li>
                        <li><a asp-area="" asp-page="/Availability/Index">Courts</a></li>
                        <li><a asp-area="" asp-page="/Booking/Index">Book a Court</a></li>
                        <li><a asp-area="" asp-page="/Booking/Lookup">My Booking</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="pb-footer-heading">Visit Us</h6>
                    @if (tenantOrg?.Address is not null)
                    {
                        <p class="mb-1"><i class="bi bi-geo-alt me-1"></i>@tenantOrg.Address</p>
                    }
                    else
                    {
                        <p class="mb-1"><i class="bi bi-geo-alt me-1"></i>@displayName</p>
                    }
                    <p class="mb-0"><i class="bi bi-clock me-1"></i>Open daily for online booking</p>
                </div>
            </div>
            <hr class="pb-footer-divider" />
            <div class="text-center small">
                &copy; 2026 @displayName &mdash; All rights reserved.
            </div>
        </div>
    </footer>

                <div class="pb-loading-overlay" id="pbLoadingOverlay" role="status" aria-live="polite">
        <div class="spinner-border text-success" aria-hidden="true"></div>
        <span data-pb-loading-text>Loading&hellip;</span>
    </div>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

