@using PickleBallBooking.Services
@inject ITenantContext TenantCtx
@inject IOrganizationService OrgSvc
@{
    var currentPath = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string NavActive(params string[] prefixes)
    {
        foreach (var p in prefixes)
        {
            if (p == "/" && currentPath == "/") { return "active"; }
            if (p != "/" && currentPath.StartsWith(p)) { return "active"; }
        }
        return string.Empty;
    }
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Org-aware display name: on tenant subdomains show the org's name; elsewhere show platform brand.
    Models.Organization? tenantOrg = TenantCtx.IsResolved ? await OrgSvc.GetCurrentAsync() : null;
    var displayName = tenantOrg?.Name ?? "Punit Bola Booking";
    var platformBrand = "Punit Bola Booking";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@displayName — book pickleball courts online. Check live availability, choose your court and time, and reserve in minutes." />
    <title>@ViewData["Title"] - @displayName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PickleBallBooking.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="pb-skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg pb-navbar sticky-top" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand pb-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/pickleball.png" alt="" class="pb-brand-logo" />
                    <span class="pb-brand-text">
                        @displayName
                        @if (tenantOrg is not null)
                        {
                            <small>Punit Bola Booking</small>
                        }
                        else
                        {
                            <small>Court Reservations</small>
                        }
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/")" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/availability")" asp-area="" asp-page="/Availability/Index">
                                <i class="bi bi-calendar3 me-1"></i>Courts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("/booking/lookup")" asp-area="" asp-page="/Booking/Lookup">
                                <i class="bi bi-search me-1"></i>My Booking
                            </a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @NavActive("/admin")" href="#" id="adminDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    @if (User.IsInRole(PickleBallBooking.Services.PlatformRoles.PlatformAdmin))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Organizations/Index"><i class="bi bi-buildings me-2"></i>Organizations</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Subscriptions/Index"><i class="bi bi-credit-card-2-front me-2"></i>Subscriptions</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Subscriptions/Plans/Index"><i class="bi bi-stack me-2"></i>Subscription Plans</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/OrgSettings/Index"><i class="bi bi-gear me-2"></i>Organization</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Users/Index"><i class="bi bi-people me-2"></i>Users</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Bookings/Index"><i class="bi bi-journal-text me-2"></i>Manage Bookings</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Payments/Index"><i class="bi bi-credit-card me-2"></i>Payments</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Courts/Index"><i class="bi bi-grid-3x3-gap me-2"></i>Manage Courts</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/TimeSlots/Index"><i class="bi bi-clock-history me-2"></i>Manage Time Slots</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Pricing/Index"><i class="bi bi-tags me-2"></i>Manage Pricing</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Schedule/Index"><i class="bi bi-calendar-week me-2"></i>Schedule</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                                        <ul class="navbar-nav pb-nav-actions">
                        <li class="nav-item">
                            <a class="nav-link pb-nav-cta @NavActive("/booking/index")" asp-area="" asp-page="/Booking/Index">
                                <i class="bi bi-lightning-charge-fill me-1"></i>Book a Court
                            </a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-flex pb-nav-action-form">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-area="" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Admin Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3" id="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="pb-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="~/images/pickleball.png" alt="" height="30" width="30" />
                        <span class="pb-footer-brand">@displayName</span>
                    </div>
                    @if (tenantOrg is not null)
                    {
                        <p class="mb-1">Your court. Your time. Your game.</p>
                        <p class="mb-0 small text-muted">Powered by <strong>@platformBrand</strong></p>
                    }
                    else
                    {
                        <p class="mb-0">Your court. Your time. Your game. Book a pickleball court in just a few clicks.</p>
                    }
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="pb-footer-heading">Quick Links</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-area="" asp-page="/Index">Home</a></li>
                        <li><a asp-area="" asp-page="/Availability/Index">Courts</a></li>
                        <li><a asp-area="" asp-page="/Booking/Index">Book a Court</a></li>
                        <li><a asp-area="" asp-page="/Booking/Lookup">My Booking</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="pb-footer-heading">Visit Us</h6>
                    @if (tenantOrg?.Address is not null)
                    {
                        <p class="mb-1"><i class="bi bi-geo-alt me-1"></i>@tenantOrg.Address</p>
                    }
                    else
                    {
                        <p class="mb-1"><i class="bi bi-geo-alt me-1"></i>@displayName</p>
                    }
                    <p class="mb-1"><i class="bi bi-clock me-1"></i>Open daily for online booking</p>
                    <p class="mb-0"><i class="bi bi-shield-check me-1"></i><a asp-area="" asp-page="/Privacy">Privacy Policy</a></p>
                </div>
            </div>
            <hr class="pb-footer-divider" />
            <div class="text-center small">
                &copy; 2026 @displayName &mdash; All rights reserved.
            </div>
        </div>
    </footer>

                <div class="pb-loading-overlay" id="pbLoadingOverlay" role="status" aria-live="polite">
        <div class="spinner-border text-success" aria-hidden="true"></div>
        <span data-pb-loading-text>Loading&hellip;</span>
    </div>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

