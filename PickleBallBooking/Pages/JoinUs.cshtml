@page
@model PickleBallBooking.Pages.JoinUsModel
@{
    ViewData["Title"] = "Register Your Venue – Punit Bola";
    ViewData["MetaDescription"] = "Register your pickleball venue on Punit Bola. Start accepting bookings in minutes.";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width:540px;">

    @if (Model.Success)
    {
        <!-- Success -->
        <div class="text-center py-4">
            <div class="mb-3" style="font-size:3rem;color:var(--pb-green-600,#198754);">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h1 class="h4 fw-bold mb-2">You're registered! 🎉</h1>
            <p class="text-muted mb-1">
                We sent an activation email to <strong>@Model.Input.OwnerEmail</strong>.
            </p>
            <p class="text-muted mb-4">
                Click the link in that email to set your password and access your dashboard.
            </p>

            <!-- Venue link copy chip -->
            <div class="mb-4">
                <p class="text-muted small fw-semibold mb-1">
                    <i class="bi bi-globe me-1"></i>Your Venue Link (share this with your players)
                </p>
                <button type="button"
                        id="copyVenueLink"
                        class="btn btn-outline-success font-monospace fw-semibold"
                        onclick="copyVenueUrl()"
                        title="Click to copy">
                    <i class="bi bi-link-45deg me-1"></i>@Model.Input.Subdomain.@Model.PlatformDomain
                    <i class="bi bi-clipboard ms-2" id="copyIcon"></i>
                </button>
                <div id="copyToast" class="text-success small mt-1" style="display:none;">
                    <i class="bi bi-check-circle me-1"></i>Copied to clipboard!
                </div>
            </div>
            <div class="d-grid gap-2">
                <a asp-page="/Account/Login" class="btn btn-success btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Go to Login
                </a>
                <a asp-page="/Index" class="btn btn-outline-secondary">Back to Home</a>
            </div>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="mb-4">
            <h1 class="h3 fw-bold mb-1">Register Your Venue</h1>
            <p class="text-muted mb-0">Free to start. Your venue goes live immediately after registration.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.RegistrationMessage))
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-info-circle me-2"></i>@Model.RegistrationMessage
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>Please fix the errors below.
            </div>
        }

        <form method="post" novalidate>

            <!-- Venue Name -->
            <div class="mb-3">
                <label asp-for="Input.VenueName" class="form-label fw-semibold"></label>
                <input asp-for="Input.VenueName" class="form-control form-control-lg"
                       placeholder="e.g. Cebu Pickleball Club" autofocus />
                <span asp-validation-for="Input.VenueName" class="text-danger small"></span>
            </div>

            <!-- Subdomain -->
            <div class="mb-3">
                <label asp-for="Input.Subdomain" class="form-label fw-semibold"></label>
                <div class="input-group input-group-lg">
                    <input asp-for="Input.Subdomain"
                           class="form-control"
                           placeholder="myvenue"
                           id="subdomainInput"
                           autocomplete="off"
                           style="font-family:monospace;"
                           oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9\-]/g,'');updatePreview()" />
                    <span class="input-group-text text-muted">.<strong>@Model.PlatformDomain</strong></span>
                </div>
                <div class="form-text font-monospace" id="subdomainPreview" style="color:var(--pb-green-700,#146c43);">
                </div>
                <span asp-validation-for="Input.Subdomain" class="text-danger small"></span>
            </div>

            <hr class="my-4" />

            <!-- Owner Name -->
            <div class="mb-3">
                <label asp-for="Input.OwnerName" class="form-label fw-semibold"></label>
                <input asp-for="Input.OwnerName" class="form-control form-control-lg"
                       placeholder="Juan dela Cruz" />
                <span asp-validation-for="Input.OwnerName" class="text-danger small"></span>
            </div>

            <!-- Owner Email -->
            <div class="mb-4">
                <label asp-for="Input.OwnerEmail" class="form-label fw-semibold"></label>
                <input asp-for="Input.OwnerEmail" class="form-control form-control-lg"
                       type="email" placeholder="juan@example.com" />
                <div class="form-text">An activation link will be sent to this email.</div>
                <span asp-validation-for="Input.OwnerEmail" class="text-danger small"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-success btn-lg fw-semibold">
                    <i class="bi bi-lightning-charge-fill me-2"></i>Register My Venue
                </button>
            </div>

            <p class="text-center text-muted small mb-0">
                Already have an account? <a asp-page="/Account/Login" class="fw-semibold">Sign in</a>
            </p>

        </form>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updatePreview() {
            const slug = document.getElementById('subdomainInput')?.value.trim() ?? '';
            const preview = document.getElementById('subdomainPreview');
            if (!preview) return;
            const domain = '@Html.Raw(Model.PlatformDomain)';
            preview.textContent = slug ? `Your URL: ${slug}.${domain}` : '';
        }
        updatePreview();

        function copyVenueUrl() {
            const btn = document.getElementById('copyVenueLink');
            const icon = document.getElementById('copyIcon');
            const toast = document.getElementById('copyToast');
            if (!btn) return;
            const url = btn.textContent.trim().replace(/\s+/g, '').replace('', '');
            // grab just the domain text from the button
            const venueUrl = '@(Model.Success ? Model.Input.Subdomain + "." + Model.PlatformDomain : "")';
            navigator.clipboard.writeText(venueUrl).then(() => {
                if (icon) { icon.className = 'bi bi-clipboard-check ms-2 text-success'; }
                if (toast) { toast.style.display = 'block'; }
                setTimeout(() => {
                    if (icon) { icon.className = 'bi bi-clipboard ms-2'; }
                    if (toast) { toast.style.display = 'none'; }
                }, 2500);
            });
        }
    </script>
}
