@page "/Admin/Activities/{id:int}/RoundRobin"
@model PickleBallBooking.Pages.Admin.Activities.RoundRobinModel
@using PickleBallBooking.Models
@{
    var ov = Model.Overview;
    ViewData["Title"] = $"Round Robin — {ov.ActivityName}";
}

@functions {
    static string FormatBadgeClass(RoundRobinFormat fmt) => fmt switch
    {
        RoundRobinFormat.RotatingPartners => "bg-primary-subtle text-primary border border-primary-subtle",
        RoundRobinFormat.FixedPartners    => "bg-success-subtle text-success border border-success-subtle",
        RoundRobinFormat.Singles          => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _                                 => "bg-light text-dark border"
    };

    static string FormatTitle(RoundRobinFormat fmt) => fmt switch
    {
        RoundRobinFormat.RotatingPartners => "Rotating Partners (Social Doubles)",
        RoundRobinFormat.FixedPartners    => "Fixed Partners (Doubles)",
        RoundRobinFormat.Singles          => "Singles (1 vs 1)",
        _                                 => fmt.ToString()
    };
}

<div class="container-fluid py-3 py-md-4 px-2 px-sm-3 px-md-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="Index">Activities</a></li>
            <li class="breadcrumb-item"><a asp-page="Detail" asp-route-id="@ov.ActivityId" class="text-truncate d-inline-block" style="max-width:180px;">@ov.ActivityName</a></li>
            <li class="breadcrumb-item active">Round Robin</li>
        </ol>
    </nav>

    <!-- Header & Action Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h4 fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-diagram-3-fill text-success me-2"></i>Round Robin Engine
                </h1>
                @if (ov.EventId > 0)
                {
                    <span class="badge @FormatBadgeClass(ov.Format) rounded-pill px-2 py-1 small">
                        @FormatTitle(ov.Format)
                    </span>
                    @if (ov.IsLocked)
                    {
                        <span class="badge bg-danger rounded-pill px-2 py-1 small">
                            <i class="bi bi-lock-fill me-1"></i>Locked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border rounded-pill px-2 py-1 small">
                            <i class="bi bi-unlock-fill me-1"></i>Editable
                        </span>
                    }
                }
            </div>
            <p class="text-muted small mt-1 mb-0">
                <strong>@ov.ActivityName</strong> &bull; @ov.Date.ToString("ddd, MMM d, yyyy") &bull; @PickleBallBooking.Services.AppClock.To12HourRange(ov.StartTime, ov.EndTime)
                <span class="ms-1 badge bg-light text-dark border">@ov.Participants.Count Players &bull; @ov.AvailableCourts.Count Courts</span>
            </p>
        </div>

        <div class="d-flex gap-2 w-100 w-md-auto flex-wrap">
            @if (ov.EventId > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center shadow-sm" onclick="window.print();">
                    <i class="bi bi-printer me-1"></i>Print Score Sheets
                </button>
            }
            <a asp-page="Detail" asp-route-id="@ov.ActivityId" class="btn btn-outline-primary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Activity
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3 border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3 border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ov.EventId == 0)
    {
        <!-- Configuration & Generation Panel -->
        <div class="row g-4">
            <div class="col-lg-7 col-xl-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom p-3 p-sm-4">
                        <h5 class="fw-bold mb-1 d-flex align-items-center">
                            <i class="bi bi-gear-wide-connected me-2 text-success"></i>Configure Round Robin Schedule
                        </h5>
                        <p class="text-muted small mb-0">Set up your play format, number of rounds, and match duration rules to generate match pairings.</p>
                    </div>
                    <div class="card-body p-3 p-sm-4">
                        <form method="post" asp-page-handler="Generate">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Play Format</label>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtRotating" value="@((int)RoundRobinFormat.RotatingPartners)" @(Model.Config.Format == RoundRobinFormat.RotatingPartners ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtRotating">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-shuffle me-2 text-primary"></i>Rotating Partners
                                                </div>
                                                <div class="small text-muted">Players rearrange into new doubles pairs each round (social mixer).</div>
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtFixed" value="@((int)RoundRobinFormat.FixedPartners)" @(Model.Config.Format == RoundRobinFormat.FixedPartners ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtFixed">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-people-fill me-2 text-success"></i>Fixed Partners
                                                </div>
                                                <div class="small text-muted">Doubles teams remain constant; play different opponent pairs.</div>
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtSingles" value="@((int)RoundRobinFormat.Singles)" @(Model.Config.Format == RoundRobinFormat.Singles ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtSingles">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-person-fill me-2 text-info"></i>Singles
                                                </div>
                                                <div class="small text-muted">Individual players rotate opponents (1 vs 1).</div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Start Time</label>
                                    <input type="time" name="Config.StartTime" value="@(Model.Config.StartTime.HasValue ? Model.Config.StartTime.Value.ToString(@"hh\:mm") : ov.StartTime.ToString(@"hh\:mm"))" class="form-control form-control-sm" />
                                    <div class="form-text small">Default: @PickleBallBooking.Services.AppClock.To12Hour(ov.StartTime)</div>
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Number of Rounds</label>
                                    <input type="number" name="Config.NumberOfRounds" value="@Model.Config.NumberOfRounds" min="1" max="15" class="form-control form-control-sm" required />
                                    <div class="form-text small">Recommended: 3 to 6 rounds.</div>
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Match Duration (Mins)</label>
                                    <input type="number" name="Config.MatchDurationMinutes" value="@Model.Config.MatchDurationMinutes" min="5" max="60" class="form-control form-control-sm" required />
                                    <div class="form-text small">Playing time per match.</div>
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Break Between Rounds (Mins)</label>
                                    <input type="number" name="Config.BreakDurationMinutes" value="@Model.Config.BreakDurationMinutes" min="0" max="30" class="form-control form-control-sm" required />
                                    <div class="form-text small">Rotation transition buffer.</div>
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Scoring Style</label>
                                    <select name="Config.ScoringType" class="form-select form-select-sm">
                                        <option value="@((int)ScoringType.RallyScoring)" selected="@(Model.Config.ScoringType == ScoringType.RallyScoring)">Rally Scoring</option>
                                        <option value="@((int)ScoringType.TraditionalSideOut)" selected="@(Model.Config.ScoringType == ScoringType.TraditionalSideOut)">Traditional Side-Out</option>
                                        <option value="@((int)ScoringType.Timed)" selected="@(Model.Config.ScoringType == ScoringType.Timed)">Timed</option>
                                    </select>
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Points to Win</label>
                                    <input type="number" name="Config.PointsToWin" value="@Model.Config.PointsToWin" min="1" max="30" class="form-control form-control-sm" />
                                </div>

                                <div class="col-sm-6 col-md-4 d-flex align-items-center">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" name="Config.WinByTwo" value="true" id="chkWinByTwo" @(Model.Config.WinByTwo ? "checked" : "") />
                                        <label class="form-check-label small fw-semibold" for="chkWinByTwo">
                                            Win By Two Points
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4 border-top mt-4 d-flex justify-content-end">
                                <button type="submit" class="btn btn-success px-4 py-2 fw-semibold shadow-sm d-flex align-items-center">
                                    <i class="bi bi-play-circle-fill me-2 fs-5"></i>Generate Schedule
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Pre-generation Overview Sidebar -->
            <div class="col-lg-5 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-success"></i>Confirmed Players</h6>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">@ov.Participants.Count Players</span>
                    </div>
                    <div class="card-body p-3" style="max-height: 280px; overflow-y: auto;">
                        @if (ov.Participants.Count == 0)
                        {
                            <div class="text-center text-muted py-3 small">No confirmed players yet. Players must RSVP first.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush small">
                                @for (int i = 0; i < ov.Participants.Count; i++)
                                {
                                    var p = ov.Participants[i];
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <span><strong>@(i + 1).</strong> @p.PlayerName</span>
                                        @if (p.IsCheckedIn)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border py-0 px-1" style="font-size:0.65rem;">Checked In</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-grid-3x3 me-2 text-success"></i>Allocated Courts</h6>
                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1">@ov.AvailableCourts.Count Courts</span>
                    </div>
                    <div class="card-body p-3">
                        @if (ov.AvailableCourts.Count == 0)
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>No active courts allocated. Please allocate courts in activity settings.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var c in ov.AvailableCourts)
                                {
                                    <span class="badge bg-light text-dark border p-2">
                                        <i class="bi bi-grid-3x3 me-1 text-success"></i>@c.CourtName
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Tab Navigation for Schedule and Standings -->
        <ul class="nav nav-pills mb-3 gap-2" id="roundRobinTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill fw-semibold py-1 px-3 d-flex align-items-center" id="schedule-tab" data-bs-toggle="pill" data-bs-target="#schedulePane" type="button" role="tab" aria-controls="schedulePane" aria-selected="true">
                    <i class="bi bi-grid-3x3-gap me-2"></i>Match Schedule
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-semibold py-1 px-3 d-flex align-items-center" id="standings-tab" data-bs-toggle="pill" data-bs-target="#standingsPane" type="button" role="tab" aria-controls="standingsPane" aria-selected="false">
                    <i class="bi bi-trophy-fill text-warning me-2"></i>Standings &amp; Rankings
                    @if (Model.Standings != null && Model.Standings.FinalizedMatches > 0)
                    {
                        <span class="badge bg-success rounded-pill ms-2" style="font-size:0.7rem;">@Model.Standings.FinalizedMatches/@Model.Standings.TotalMatches Finalized</span>
                    }
                </button>
            </li>
        </ul>

        <div class="tab-content" id="roundRobinTabsContent">
            <!-- Tab Pane 1: Schedule -->
            <div class="tab-pane fade show active" id="schedulePane" role="tabpanel" aria-labelledby="schedule-tab">
                <!-- Action Toolbar for Generated Schedule -->
                <div class="card border-0 shadow-sm mb-3 mb-md-4 bg-light rounded-3">
            <div class="card-body p-2 p-sm-3">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small fw-semibold text-uppercase me-1 d-none d-sm-inline">Actions:</span>

                        @if (!ov.IsLocked)
                        {
                            <form method="post" asp-page-handler="ToggleLock" class="d-inline">
                                <input type="hidden" name="lockSchedule" value="true" />
                                <button type="submit" class="btn btn-sm btn-dark fw-semibold py-1 px-3 shadow-sm" title="Lock schedule to prevent modifications">
                                    <i class="bi bi-lock me-1"></i>Lock Schedule
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="ToggleLock" class="d-inline">
                                <input type="hidden" name="lockSchedule" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-dark fw-semibold py-1 px-3" title="Unlock schedule to allow edits">
                                    <i class="bi bi-unlock me-1"></i>Unlock Schedule
                                </button>
                            </form>
                        }

                        @if (!ov.IsLocked)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold py-1 px-3 shadow-sm" data-bs-toggle="collapse" data-bs-target="#reconfigurePanel" aria-expanded="false" aria-controls="reconfigurePanel">
                                <i class="bi bi-sliders me-1"></i>Adjust Settings &amp; Regenerate
                            </button>

                            <form method="post" asp-page-handler="Clear" class="d-inline" onsubmit="return confirm('Clear round robin schedule and all match pairings?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Clear schedule">
                                    <i class="bi bi-trash3 me-1"></i>Clear
                                </button>
                            </form>
                        }
                    </div>

                    <!-- Round Navigation Filter Pills -->
                    <div class="d-flex align-items-center gap-1 overflow-x-auto py-1">
                        <button type="button" class="btn btn-sm btn-success py-1 px-2 rounded-pill round-filter-btn active" data-round="all">
                            All Rounds
                        </button>
                        @foreach (var r in ov.Rounds)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill round-filter-btn" data-round="@r.RoundNumber">
                                Round @r.RoundNumber
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!ov.IsLocked)
        {
            <div class="collapse mb-4" id="reconfigurePanel">
                <div class="card border-0 shadow-sm rounded-3 border-top border-4 border-primary">
                    <div class="card-header bg-white border-bottom p-3">
                        <h6 class="fw-bold mb-1 d-flex align-items-center text-primary">
                            <i class="bi bi-sliders me-2"></i>Adjust Round Robin Settings &amp; Regenerate
                        </h6>
                        <p class="text-muted small mb-0">Change match duration, break time, start time, or rounds. Clicking regenerate will rebuild match pairings with the new settings.</p>
                    </div>
                    <div class="card-body p-3 p-sm-4">
                        <form method="post" asp-page-handler="Generate">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Play Format</label>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtRotatingRe" value="@((int)RoundRobinFormat.RotatingPartners)" @(Model.Config.Format == RoundRobinFormat.RotatingPartners ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtRotatingRe">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-shuffle me-2 text-primary"></i>Rotating Partners
                                                </div>
                                                <div class="small text-muted">New doubles pairs each round.</div>
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtFixedRe" value="@((int)RoundRobinFormat.FixedPartners)" @(Model.Config.Format == RoundRobinFormat.FixedPartners ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtFixedRe">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-people-fill me-2 text-success"></i>Fixed Partners
                                                </div>
                                                <div class="small text-muted">Fixed doubles pairs.</div>
                                            </label>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="radio" class="btn-check" name="Config.Format" id="fmtSinglesRe" value="@((int)RoundRobinFormat.Singles)" @(Model.Config.Format == RoundRobinFormat.Singles ? "checked" : "") />
                                            <label class="btn btn-outline-secondary w-100 p-3 text-start h-100 rounded-3 format-option-label" for="fmtSinglesRe">
                                                <div class="fw-bold text-dark d-flex align-items-center mb-1">
                                                    <i class="bi bi-person-fill me-2 text-info"></i>Singles
                                                </div>
                                                <div class="small text-muted">Individual players (1 vs 1).</div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Start Time</label>
                                    <input type="time" name="Config.StartTime" value="@(Model.Config.StartTime.HasValue ? Model.Config.StartTime.Value.ToString(@"hh\:mm") : ov.StartTime.ToString(@"hh\:mm"))" class="form-control form-control-sm" required />
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Number of Rounds</label>
                                    <input type="number" name="Config.NumberOfRounds" value="@Model.Config.NumberOfRounds" min="1" max="15" class="form-control form-control-sm" required />
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Match Duration (Mins)</label>
                                    <input type="number" name="Config.MatchDurationMinutes" value="@Model.Config.MatchDurationMinutes" min="5" max="60" class="form-control form-control-sm" required />
                                </div>

                                <div class="col-sm-6 col-md-3">
                                    <label class="form-label fw-semibold small">Break Between (Mins)</label>
                                    <input type="number" name="Config.BreakDurationMinutes" value="@Model.Config.BreakDurationMinutes" min="0" max="30" class="form-control form-control-sm" required />
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Scoring Style</label>
                                    <select name="Config.ScoringType" class="form-select form-select-sm">
                                        <option value="@((int)ScoringType.RallyScoring)" selected="@(Model.Config.ScoringType == ScoringType.RallyScoring)">Rally Scoring</option>
                                        <option value="@((int)ScoringType.TraditionalSideOut)" selected="@(Model.Config.ScoringType == ScoringType.TraditionalSideOut)">Traditional Side-Out</option>
                                        <option value="@((int)ScoringType.Timed)" selected="@(Model.Config.ScoringType == ScoringType.Timed)">Timed</option>
                                    </select>
                                </div>

                                <div class="col-sm-6 col-md-4">
                                    <label class="form-label fw-semibold small">Points to Win</label>
                                    <input type="number" name="Config.PointsToWin" value="@Model.Config.PointsToWin" min="1" max="30" class="form-control form-control-sm" />
                                </div>

                                <div class="col-sm-6 col-md-4 d-flex align-items-center">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" name="Config.WinByTwo" value="true" id="chkWinByTwoRe" @(Model.Config.WinByTwo ? "checked" : "") />
                                        <label class="form-check-label small fw-semibold" for="chkWinByTwoRe">
                                            Win By Two Points
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-top mt-3 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#reconfigurePanel">Cancel</button>
                                <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold shadow-sm" onclick="return confirm('Regenerate round robin schedule with these settings? Current matches will be replaced.');">
                                    <i class="bi bi-arrow-repeat me-1"></i>Regenerate Schedule
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <!-- Schedule Board: Grouped by Round -->
        <div class="d-flex flex-column gap-4" id="roundsContainer">
            @foreach (var round in ov.Rounds)
            {
                <div class="round-block" data-round-num="@round.RoundNumber">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-dark rounded-pill px-3 py-1">Round @round.RoundNumber</span>
                            @if (round.EstimatedStartTime.HasValue)
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-clock me-1 text-success"></i>@PickleBallBooking.Services.AppClock.To12Hour(round.EstimatedStartTime.Value)
                                    @if (round.EstimatedEndTime.HasValue)
                                    {
                                        <span>– @PickleBallBooking.Services.AppClock.To12Hour(round.EstimatedEndTime.Value)</span>
                                    }
                                </span>
                                @if (!ov.IsLocked)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill ms-1" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#editRoundTimeModal_@round.RoundNumber" title="Edit Round @round.RoundNumber Time">
                                        <i class="bi bi-pencil me-1"></i>Edit Time
                                    </button>
                                }
                            }
                        </div>
                        <div class="small text-muted">
                            @round.Matches.Count Matches @(round.Byes.Count > 0 ? $"&bull; {round.Byes.Count} Byes" : "")
                        </div>
                    </div>

                    <div class="row g-3">
                        @foreach (var m in round.Matches)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card border-0 shadow-sm h-100 rounded-3 rr-match-card @(m.IsFinalized ? "border-start border-3 border-dark" : (m.Status == MatchStatus.InProgress ? "border-start border-3 border-primary" : (m.Status == MatchStatus.Completed ? "border-start border-3 border-success" : "")))">
                                    <div class="card-header bg-white border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
                                        <div class="fw-bold text-success small d-flex align-items-center min-w-0">
                                            <i class="bi bi-grid-3x3 me-1"></i>
                                            <span class="text-truncate">@m.CourtName</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            @if (m.AuditCount > 0)
                                            {
                                                <button type="button" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 text-decoration-none btn p-0" style="font-size:0.7rem;" data-bs-toggle="modal" data-bs-target="#scoreAuditModal_@m.MatchId" title="@m.AuditCount score correction(s) recorded">
                                                    <i class="bi bi-clock-history me-1"></i>@m.AuditCount Edited
                                                </button>
                                            }
                                            @if (m.IsFinalized)
                                            {
                                                <span class="badge bg-dark rounded-pill px-2 py-1" style="font-size:0.7rem;" title="Score locked and finalized">
                                                    <i class="bi bi-lock-fill me-1 text-warning"></i>Finalized
                                                </span>
                                            }
                                            else if (m.Status == MatchStatus.InProgress)
                                            {
                                                <span class="badge bg-primary rounded-pill px-2 py-1" style="font-size:0.7rem;">
                                                    <span class="spinner-grow spinner-grow-sm me-1" style="width: 0.4rem; height: 0.4rem;" role="status"></span>Live
                                                </span>
                                            }
                                            else if (m.Status == MatchStatus.Completed)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size:0.7rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Completed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size:0.7rem;">
                                                    <i class="bi bi-clock me-1"></i>Scheduled
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div class="d-flex align-items-center justify-content-between gap-2 py-2">
                                            <!-- Team 1 -->
                                            <div class="flex-fill text-center min-w-0 p-2 rounded-2 border @(m.WinningSide == "Team1" ? "border-success bg-success-subtle" : "bg-light-subtle")">
                                                <div class="fw-bold small text-truncate">@m.Team1Player1Name</div>
                                                @if (!string.IsNullOrEmpty(m.Team1Player2Name))
                                                {
                                                    <div class="fw-bold small text-truncate text-primary">&amp; @m.Team1Player2Name</div>
                                                }
                                                @if (m.Team1Score.HasValue)
                                                {
                                                    <div class="fs-4 fw-bold @(m.WinningSide == "Team1" ? "text-success" : "text-dark") mt-1">@m.Team1Score</div>
                                                }
                                                @if (m.WinningSide == "Team1")
                                                {
                                                    <span class="badge bg-warning text-dark py-0 px-2 mt-1 small" style="font-size:0.65rem;"><i class="bi bi-trophy-fill me-1"></i>Winner</span>
                                                }
                                            </div>

                                            <div class="fw-bold text-muted px-1 small">VS</div>

                                            <!-- Team 2 -->
                                            <div class="flex-fill text-center min-w-0 p-2 rounded-2 border @(m.WinningSide == "Team2" ? "border-success bg-success-subtle" : "bg-light-subtle")">
                                                <div class="fw-bold small text-truncate">@m.Team2Player1Name</div>
                                                @if (!string.IsNullOrEmpty(m.Team2Player2Name))
                                                {
                                                    <div class="fw-bold small text-truncate text-primary">&amp; @m.Team2Player2Name</div>
                                                }
                                                @if (m.Team2Score.HasValue)
                                                {
                                                    <div class="fs-4 fw-bold @(m.WinningSide == "Team2" ? "text-success" : "text-dark") mt-1">@m.Team2Score</div>
                                                }
                                                @if (m.WinningSide == "Team2")
                                                {
                                                    <span class="badge bg-warning text-dark py-0 px-2 mt-1 small" style="font-size:0.65rem;"><i class="bi bi-trophy-fill me-1"></i>Winner</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Match Action Toolbar -->
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 pt-2 border-top mt-2">
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                @if (!m.IsFinalized)
                                                {
                                                    @if (m.Status == MatchStatus.Scheduled)
                                                    {
                                                        <form method="post" asp-page-handler="StartMatch" class="d-inline">
                                                            <input type="hidden" name="matchId" value="@m.MatchId" />
                                                            <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size:0.75rem;" title="Mark match In Progress">
                                                                <i class="bi bi-play-fill me-1"></i>Start
                                                            </button>
                                                        </form>
                                                    }

                                                    <button type="button" class="btn btn-@(m.Status == MatchStatus.Completed ? "outline-secondary" : "success") btn-sm py-0 px-2 fw-semibold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#scoreEntryModal_@m.MatchId">
                                                        <i class="bi bi-pencil-square me-1"></i>@(m.Status == MatchStatus.Completed ? "Edit Score" : (m.Status == MatchStatus.InProgress ? "Update Score" : "Enter Score"))
                                                    </button>

                                                    @if (m.Status == MatchStatus.Completed && m.Team1Score.HasValue && m.Team2Score.HasValue)
                                                    {
                                                        <form method="post" asp-page-handler="FinalizeMatch" class="d-inline" onsubmit="return confirm('Officially finalize match score? This will lock the score against accidental changes.');">
                                                            <input type="hidden" name="matchId" value="@m.MatchId" />
                                                            <button type="submit" class="btn btn-dark btn-sm py-0 px-2 fw-semibold" style="font-size:0.75rem;" title="Lock official score">
                                                                <i class="bi bi-lock-fill me-1 text-warning"></i>Finalize
                                                            </button>
                                                        </form>
                                                    }
                                                }
                                                else
                                                {
                                                    <!-- Finalized Actions: Score Correction Override -->
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#scoreCorrectionModal_@m.MatchId" title="Admin score correction override">
                                                        <i class="bi bi-shield-exclamation me-1"></i>Correct Score
                                                    </button>

                                                    @if (m.AuditCount > 0)
                                                    {
                                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#scoreAuditModal_@m.MatchId" title="View Audit Trail">
                                                            <i class="bi bi-clock-history me-1"></i>History
                                                        </button>
                                                    }
                                                }
                                            </div>

                                            @if (!ov.IsLocked && ov.AvailableCourts.Count > 1 && !m.IsFinalized)
                                            {
                                                <div class="dropdown">
                                                    <button class="btn btn-outline-secondary btn-sm py-0 px-2 dropdown-toggle" style="font-size:0.75rem;" type="button" data-bs-toggle="dropdown" title="Change Court">
                                                        <i class="bi bi-arrow-left-right me-1 small"></i>Court
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                        <li class="dropdown-header small">Select Court:</li>
                                                        @foreach (var c in ov.AvailableCourts.Where(c => c.CourtId != m.CourtId))
                                                        {
                                                            <li>
                                                                <form method="post" asp-page-handler="ChangeCourt">
                                                                    <input type="hidden" name="matchId" value="@m.MatchId" />
                                                                    <input type="hidden" name="newCourtId" value="@c.CourtId" />
                                                                    <button type="submit" class="dropdown-item small py-1">
                                                                        <i class="bi bi-grid-3x3 text-success me-1"></i>@c.CourtName
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Score Entry Modal -->
                                <div class="modal fade" id="scoreEntryModal_@m.MatchId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-3 shadow">
                                            <form method="post" asp-page-handler="RecordScore">
                                                <input type="hidden" name="matchId" value="@m.MatchId" />
                                                <div class="modal-header py-2 px-3 border-bottom bg-light">
                                                    <div>
                                                        <h6 class="modal-title fw-bold mb-0">Record Match Score</h6>
                                                        <span class="text-muted small">Round @round.RoundNumber &bull; @m.CourtName</span>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-3">
                                                    <div class="alert alert-light border small p-2 mb-3">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span><strong>Format:</strong> @ov.ScoringType.ToString()</span>
                                                            @if (ov.ScoringType != ScoringType.Timed)
                                                            {
                                                                <span><strong>Target:</strong> @ov.PointsToWin pts @(ov.WinByTwo ? "(Win by 2)" : "")</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="row g-3 align-items-center mb-3">
                                                        <div class="col-5 text-center">
                                                            <label class="form-label fw-bold small text-truncate d-block mb-1">
                                                                @m.Team1Player1Name
                                                                @if (!string.IsNullOrEmpty(m.Team1Player2Name))
                                                                {
                                                                    <span class="text-primary d-block small">&amp; @m.Team1Player2Name</span>
                                                                }
                                                            </label>
                                                            <input type="number" name="team1Score" value="@(m.Team1Score ?? 0)" min="0" max="99" class="form-control text-center fs-4 fw-bold" required />
                                                        </div>
                                                        <div class="col-2 text-center text-muted fw-bold">
                                                            VS
                                                        </div>
                                                        <div class="col-5 text-center">
                                                            <label class="form-label fw-bold small text-truncate d-block mb-1">
                                                                @m.Team2Player1Name
                                                                @if (!string.IsNullOrEmpty(m.Team2Player2Name))
                                                                {
                                                                    <span class="text-primary d-block small">&amp; @m.Team2Player2Name</span>
                                                                }
                                                            </label>
                                                            <input type="number" name="team2Score" value="@(m.Team2Score ?? 0)" min="0" max="99" class="form-control text-center fs-4 fw-bold" required />
                                                        </div>
                                                    </div>

                                                    <div class="form-check p-2 bg-light rounded-2 border mb-3">
                                                        <input type="hidden" name="isLiveUpdate" value="false" />
                                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="isLiveUpdate" value="true" id="live_@m.MatchId" @(m.Status == MatchStatus.InProgress ? "checked" : "") />
                                                        <label class="form-check-label small fw-semibold" for="live_@m.MatchId">
                                                            Live In-Progress Update (game is still ongoing)
                                                        </label>
                                                        <div class="text-muted small ps-4" style="font-size:0.75rem;">
                                                            Uncheck when match is completed to calculate winner and conclude game.
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <label class="form-label small fw-semibold">Notes (optional)</label>
                                                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="e.g. Tiebreak details, time-out info" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer py-2 px-3 border-top">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-success fw-semibold px-3">
                                                        <i class="bi bi-check2 me-1"></i>Save Score
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                @if (m.IsFinalized)
                                {
                                    <!-- Score Correction Modal (Admin Override) -->
                                    <div class="modal fade" id="scoreCorrectionModal_@m.MatchId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-3 shadow border-danger-subtle">
                                                <form method="post" asp-page-handler="CorrectScore">
                                                    <input type="hidden" name="matchId" value="@m.MatchId" />
                                                    <div class="modal-header py-2 px-3 border-bottom bg-danger-subtle text-danger-emphasis">
                                                        <div>
                                                            <h6 class="modal-title fw-bold mb-0">
                                                                <i class="bi bi-shield-exclamation me-1"></i>Admin Score Override
                                                            </h6>
                                                            <span class="small">Round @round.RoundNumber &bull; @m.CourtName</span>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-3">
                                                        <div class="alert alert-warning py-2 px-3 small mb-3">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                            <strong>Finalized Match Protection:</strong> This match score was already officially locked. Modifying it requires an explicit justification and will be permanently recorded in the audit log.
                                                        </div>

                                                        <div class="text-center small text-muted mb-2">
                                                            Currently Recorded Score: <strong class="text-dark">@(m.Team1Score ?? 0) - @(m.Team2Score ?? 0)</strong>
                                                        </div>

                                                        <div class="row g-3 align-items-center mb-3">
                                                            <div class="col-5 text-center">
                                                                <label class="form-label fw-bold small text-truncate d-block mb-1">
                                                                    @m.Team1Player1Name
                                                                </label>
                                                                <input type="number" name="team1Score" value="@(m.Team1Score ?? 0)" min="0" max="99" class="form-control text-center fs-4 fw-bold" required />
                                                            </div>
                                                            <div class="col-2 text-center text-muted fw-bold">VS</div>
                                                            <div class="col-5 text-center">
                                                                <label class="form-label fw-bold small text-truncate d-block mb-1">
                                                                    @m.Team2Player1Name
                                                                </label>
                                                                <input type="number" name="team2Score" value="@(m.Team2Score ?? 0)" min="0" max="99" class="form-control text-center fs-4 fw-bold" required />
                                                            </div>
                                                        </div>

                                                        <div>
                                                            <label class="form-label small fw-semibold text-danger">Correction Reason (Mandatory) *</label>
                                                            <textarea name="reason" rows="2" class="form-control form-control-sm" placeholder="e.g. Referee sheet transcription error corrected" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer py-2 px-3 border-top">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-danger fw-semibold px-3">
                                                            <i class="bi bi-shield-check me-1"></i>Apply Override
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (m.Audits != null && m.Audits.Count > 0)
                                {
                                    <!-- Score Audit History Modal -->
                                    <div class="modal fade" id="scoreAuditModal_@m.MatchId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-3 shadow">
                                                <div class="modal-header py-2 px-3 border-bottom bg-light">
                                                    <h6 class="modal-title fw-bold mb-0">
                                                        <i class="bi bi-clock-history me-1 text-primary"></i>Score Audit Trail
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-3">
                                                    <div class="mb-2 small text-muted">
                                                        Match: <strong>Round @round.RoundNumber &bull; @m.CourtName</strong>
                                                    </div>
                                                    <div class="list-group list-group-flush border rounded-2 small">
                                                        @foreach (var audit in m.Audits)
                                                        {
                                                            <div class="list-group-item p-3">
                                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                                    <span class="fw-bold text-dark">
                                                                        <i class="bi bi-person-badge me-1 text-secondary"></i>@audit.ChangedByUserName
                                                                    </span>
                                                                    <span class="text-muted" style="font-size:0.75rem;">
                                                                        @audit.ChangedAt.ToString("MMM dd, yyyy HH:mm") UTC
                                                                    </span>
                                                                </div>
                                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                                    <span class="badge bg-light text-muted border text-decoration-line-through">
                                                                        @(audit.PreviousTeam1Score ?? 0) - @(audit.PreviousTeam2Score ?? 0)
                                                                    </span>
                                                                    <i class="bi bi-arrow-right text-muted small"></i>
                                                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
                                                                        @audit.NewTeam1Score - @audit.NewTeam2Score
                                                                    </span>
                                                                    <span class="text-muted small">(@(audit.NewWinningSide ?? "Draw"))</span>
                                                                </div>
                                                                <div class="p-2 rounded bg-light border text-secondary" style="font-size:0.8rem;">
                                                                    <strong>Reason:</strong> @audit.Reason
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="modal-footer py-2 px-3 border-top">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (round.Byes.Count > 0)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card border-0 shadow-sm h-100 rounded-3 bg-light border-dashed">
                                    <div class="card-header bg-transparent border-bottom py-2 px-3">
                                        <span class="small fw-semibold text-warning-emphasis"><i class="bi bi-pause-circle me-1"></i>Sitting Out (Byes)</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var b in round.Byes)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2">
                                                    @b.PlayerName
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!ov.IsLocked && round.EstimatedStartTime.HasValue && round.EstimatedEndTime.HasValue)
                    {
                        <div class="modal fade" id="editRoundTimeModal_@round.RoundNumber" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                <div class="modal-content rounded-3 shadow">
                                    <form method="post" asp-page-handler="UpdateRoundTime">
                                        <input type="hidden" name="roundNumber" value="@round.RoundNumber" />
                                        <div class="modal-header py-2 px-3 border-bottom">
                                            <h6 class="modal-title fw-bold">Edit Round @round.RoundNumber Time</h6>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-3">
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Start Time</label>
                                                <input type="time" name="startTime" value="@round.EstimatedStartTime.Value.ToString(@"hh\:mm")" class="form-control form-control-sm" required />
                                            </div>
                                            <div>
                                                <label class="form-label small fw-semibold">End Time</label>
                                                <input type="time" name="endTime" value="@round.EstimatedEndTime.Value.ToString(@"hh\:mm")" class="form-control form-control-sm" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer py-2 px-3 border-top">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold">Save Time</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div><!-- /#roundsContainer -->
            </div><!-- /#schedulePane -->

            <!-- Tab Pane 2: Standings & Leaderboard -->
            <div class="tab-pane fade" id="standingsPane" role="tabpanel" aria-labelledby="standings-tab">
                @if (Model.Standings == null)
                {
                    <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
                        <i class="bi bi-trophy text-muted" style="font-size:2.5rem;"></i>
                        <h6 class="fw-bold mt-3">No Standings Available</h6>
                        <p class="text-muted small">Generate a schedule and record matches to compute standings.</p>
                    </div>
                }
                else
                {
                    var st = Model.Standings;

                    <!-- Standings Metrics Overview -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded-3 bg-light-subtle text-center p-3">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Total Matches</div>
                                <div class="fs-4 fw-bold text-dark mt-1">@st.TotalMatches</div>
                                <div class="small text-muted" style="font-size:0.75rem;">Scheduled Games</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded-3 bg-light-subtle text-center p-3">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Finalized Results</div>
                                <div class="fs-4 fw-bold text-success mt-1">@st.FinalizedMatches</div>
                                <div class="small text-muted" style="font-size:0.75rem;">Official Locked Scores</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded-3 bg-light-subtle text-center p-3">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Pending / Live</div>
                                <div class="fs-4 fw-bold text-primary mt-1">@(st.InProgressMatches + st.ScheduledMatches)</div>
                                <div class="small text-muted" style="font-size:0.75rem;">@st.InProgressMatches Live &bull; @st.ScheduledMatches Queued</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm rounded-3 bg-light-subtle text-center p-3">
                                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Event Status</div>
                                <div class="mt-2">
                                    @if (st.IsEventComplete)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-all me-1"></i>Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                                            <i class="bi bi-play-circle-fill me-1"></i>In Progress
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Event Standings Table -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-header bg-white border-bottom p-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                            <div>
                                <h6 class="fw-bold mb-0 d-flex align-items-center">
                                    <i class="bi bi-trophy-fill text-warning me-2"></i>Official Event Standings
                                </h6>
                                <span class="text-muted small">
                                    Ranked by: <strong>Win % &bull; Point Diff (+/-) &bull; Points Scored</strong>
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print();">
                                    <i class="bi bi-printer me-1"></i>Print Standings
                                </button>
                                <a asp-page="/Activities/Leaderboard" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-award me-1"></i>All-Time Leaderboard
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @if (st.Standings.Count == 0)
                            {
                                <div class="text-center py-4 text-muted small">
                                    No players registered for this event.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 small">
                                        <thead class="table-light text-uppercase fw-semibold" style="font-size:0.75rem;">
                                            <tr>
                                                <th class="text-center" style="width: 50px;">Rank</th>
                                                <th>Player</th>
                                                <th class="text-center" title="Matches Played">MP</th>
                                                <th class="text-center" title="Wins">W</th>
                                                <th class="text-center" title="Losses">L</th>
                                                <th class="text-center" title="Draws">D</th>
                                                <th class="text-center" title="Points For">PF</th>
                                                <th class="text-center" title="Points Against">PA</th>
                                                <th class="text-center" title="Point Differential">+/-</th>
                                                <th class="text-center" title="Win Percentage">Win %</th>
                                                <th class="text-center" style="width: 120px;">Form</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in st.Standings)
                                            {
                                                var diffColor = p.PointDifferential > 0 ? "text-success fw-bold" : (p.PointDifferential < 0 ? "text-danger" : "text-muted");
                                                var rowBg = p.Rank == 1 && st.FinalizedMatches > 0 ? "table-warning-subtle" : (p.Rank <= 3 && st.FinalizedMatches > 0 ? "bg-light-subtle" : "");

                                                <tr class="@rowBg">
                                                    <td class="text-center fw-bold">
                                                        @if (st.FinalizedMatches > 0 && p.Rank == 1)
                                                        {
                                                            <span class="badge bg-warning text-dark rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;">1</span>
                                                        }
                                                        else if (st.FinalizedMatches > 0 && p.Rank == 2)
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;">2</span>
                                                        }
                                                        else if (st.FinalizedMatches > 0 && p.Rank == 3)
                                                        {
                                                            <span class="badge bg-bronze text-dark rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;background-color:#f4d1ae;">3</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">@p.Rank</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold text-dark">@p.DisplayName</div>
                                                        @if (p.SkillLevel.HasValue)
                                                        {
                                                            <span class="badge bg-light text-muted border py-0 px-1" style="font-size:0.65rem;">@p.SkillLevel</span>
                                                        }
                                                    </td>
                                                    <td class="text-center fw-semibold">@p.MatchesPlayed</td>
                                                    <td class="text-center text-success fw-bold">@p.Wins</td>
                                                    <td class="text-center text-danger">@p.Losses</td>
                                                    <td class="text-center text-muted">@p.Draws</td>
                                                    <td class="text-center">@p.PointsScored</td>
                                                    <td class="text-center text-muted">@p.PointsConceded</td>
                                                    <td class="text-center @diffColor">
                                                        @(p.PointDifferential > 0 ? "+" : "")@p.PointDifferential
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fw-bold text-dark">@p.WinPercentage.ToString("F1")%</div>
                                                        <div class="progress mt-1" style="height: 4px; min-width: 60px;">
                                                            <div class="progress-bar bg-success" role="progressbar" style="width: @p.WinPercentage%;" aria-valuenow="@p.WinPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-flex justify-content-center gap-1">
                                                            @if (p.RecentForm.Count == 0)
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var res in p.RecentForm)
                                                                {
                                                                    var formBadge = res == "W" ? "bg-success" : (res == "L" ? "bg-danger" : "bg-secondary");
                                                                    <span class="badge @formBadge rounded-1 px-1 py-0" style="font-size:0.65rem;" title="@(res == "W" ? "Win" : (res == "L" ? "Loss" : "Draw"))">@res</span>
                                                                }
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div><!-- /#standingsPane -->
        </div><!-- /#roundRobinTabsContent -->
    }
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const filterBtns = document.querySelectorAll('.round-filter-btn');
    const roundBlocks = document.querySelectorAll('.round-block');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
            filterBtns.forEach(b => {
                b.classList.remove('active', 'btn-success');
                b.classList.add('btn-outline-secondary');
            });
            this.classList.add('active', 'btn-success');
            this.classList.remove('btn-outline-secondary');

            const targetRound = this.getAttribute('data-round');
            roundBlocks.forEach(block => {
                const roundNum = block.getAttribute('data-round-num');
                if (targetRound === 'all' || targetRound === roundNum) {
                    block.style.display = '';
                } else {
                    block.style.display = 'none';
                }
            });
        });
    });
});
</script>
}

@section Styles {
<style>
.format-option-label {
    border: 2px solid #e5e7eb;
    transition: all 0.15s ease;
    cursor: pointer;
}
.btn-check:checked + .format-option-label {
    border-color: #16a34a !important;
    background-color: rgba(22, 163, 74, 0.05);
}
.rr-match-card {
    border: 1px solid rgba(0, 0, 0, 0.06) !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.rr-match-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
}
.border-dashed {
    border: 1px dashed rgba(0, 0, 0, 0.2) !important;
}
.tracking-wider {
    letter-spacing: 0.05em;
}
.bg-success-subtle { background-color: rgba(25,135,84,.12); }
.bg-primary-subtle { background-color: rgba(13,110,253,.12); }
.bg-warning-subtle { background-color: rgba(255,193,7,.18); }
.bg-danger-subtle  { background-color: rgba(220,53,69,.12); }
.bg-info-subtle    { background-color: rgba(13,202,240,.12); }

@@media print {
    nav, .btn, .dropdown, form, .badge.bg-success-subtle, .badge.bg-danger, .round-filter-btn {
        display: none !important;
    }
    .round-block {
        display: block !important;
        page-break-after: always;
        break-after: page;
        margin-bottom: 2rem;
    }
    .rr-match-card {
        border: 1px solid #999 !important;
        break-inside: avoid;
        page-break-inside: avoid;
    }
    .col-md-6, .col-xl-4 {
        width: 50% !important;
        float: left;
    }
}
</style>
}
