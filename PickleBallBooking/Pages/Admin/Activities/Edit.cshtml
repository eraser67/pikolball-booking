@page "/Admin/Activities/Edit/{id:int}"
@model PickleBallBooking.Pages.Admin.Activities.EditModel
@{
    ViewData["Title"] = "Edit Activity";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 fw-bold mb-0"><i class="bi bi-pencil text-success me-2"></i>Edit Activity</h1>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>
<form method="post" id="editActivityForm">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-info-circle me-2 text-success"></i>Activity Details</h2>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.Name" class="form-label fw-medium"></label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.Format" class="form-label fw-medium"></label>
                        <select asp-for="Input.Format" class="form-select"
                                asp-items="Html.GetEnumSelectList<PickleBallBooking.Models.ActivityFormat>()"></select>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.SkillLevel" class="form-label fw-medium"></label>
                        <select asp-for="Input.SkillLevel" class="form-select"
                                asp-items="Html.GetEnumSelectList<PickleBallBooking.Models.ActivitySkillLevel>()"></select>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.Status" class="form-label fw-medium"></label>
                        <select asp-for="Input.Status" class="form-select"
                                asp-items="Html.GetEnumSelectList<PickleBallBooking.Models.ActivityStatus>()"></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label fw-medium"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-clock me-2 text-success"></i>Schedule</h2>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <label asp-for="Input.DateStr" class="form-label fw-medium"></label>
                        <input asp-for="Input.DateStr" type="date" class="form-control" />
                        <span asp-validation-for="Input.DateStr" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.StartTimeStr" class="form-label fw-medium"></label>
                        <input asp-for="Input.StartTimeStr" type="time" class="form-control" />
                        <span asp-validation-for="Input.StartTimeStr" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Input.EndTimeStr" class="form-label fw-medium"></label>
                        <input asp-for="Input.EndTimeStr" type="time" class="form-control" />
                        <span asp-validation-for="Input.EndTimeStr" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.RegistrationOpensAt" class="form-label fw-medium"></label>
                        <input asp-for="Input.RegistrationOpensAt" type="datetime-local" class="form-control" />
                        <div class="form-text">Leave blank to open manually.</div>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.RegistrationClosesAt" class="form-label fw-medium"></label>
                        <input asp-for="Input.RegistrationClosesAt" type="datetime-local" class="form-control" />
                        <div class="form-text">Leave blank to close manually.</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2 text-success"></i>Courts</h2>
            </div>
            <div class="card-body px-4 pb-4">
                @if (Model.CourtOptions != null && Model.CourtOptions.Any())
                {
                    <div class="row g-2">
                        @foreach (var court in Model.CourtOptions)
                        {
                            <div class="col-sm-6 col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="Input.SelectedCourtIds" value="@court.Value"
                                           id="court_@court.Value"
                                           @(Model.Input.SelectedCourtIds != null && Model.Input.SelectedCourtIds.Contains(int.Parse(court.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="court_@court.Value">@court.Text</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else { <p class="text-muted small">No active courts available.</p> }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-people me-2 text-success"></i>Participation</h2>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="mb-3">
                    <label asp-for="Input.MaxCapacity" class="form-label fw-medium"></label>
                    <input asp-for="Input.MaxCapacity" type="number" min="0" class="form-control" />
                    <div class="form-text">0 = unlimited.</div>
                </div>
                <div>
                    <label asp-for="Input.PricePerPlayer" class="form-label fw-medium"></label>
                    <div class="input-group">
                        <span class="input-group-text">&#8369;</span>
                        <input asp-for="Input.PricePerPlayer" type="number" min="0" step="0.01" class="form-control" />
                    </div>
                    <div class="form-text">0 = free.</div>
                </div>
            </div>
        </div>
    </div>
</div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success fw-semibold px-4">
            <i class="bi bi-check-circle me-2"></i>Save Changes
        </button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
