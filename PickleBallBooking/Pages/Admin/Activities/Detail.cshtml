@page "/Admin/Activities/{id:int}"
@model PickleBallBooking.Pages.Admin.Activities.DetailModel
@using PickleBallBooking.Models
@{
    var a = Model.Activity!;
    var roster = Model.Roster;
    ViewData["Title"] = a.Name;
}
@functions {
    static string StatusBadge(ActivityStatus s) => s switch {
        ActivityStatus.Draft              => "bg-secondary text-white",
        ActivityStatus.Published          => "bg-info text-dark",
        ActivityStatus.RegistrationOpen   => "bg-success text-white",
        ActivityStatus.Full               => "bg-warning text-dark",
        ActivityStatus.RegistrationClosed => "bg-secondary text-white",
        ActivityStatus.InProgress         => "bg-primary text-white",
        ActivityStatus.Completed          => "bg-dark text-white",
        ActivityStatus.Cancelled          => "bg-danger text-white",
        _                                 => "bg-light text-dark border"
    };

    static string SkillIcon(PlayerSkillLevel? sk) => sk switch {
        PlayerSkillLevel.Beginner     => "🟢",
        PlayerSkillLevel.Intermediate => "🟡",
        PlayerSkillLevel.Advanced     => "🔴",
        _                             => "⚪"
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-page="Index">Activities</a></li>
                @if (a.SeriesId.HasValue)
                {
                    <li class="breadcrumb-item">
                        <a asp-page="SeriesDetail" asp-route-id="@a.SeriesId">
                            <i class="bi bi-arrow-repeat me-1"></i>Series
                        </a>
                    </li>
                }
                <li class="breadcrumb-item active text-truncate" style="max-width: 250px;">@a.Name</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="h4 fw-bold mb-0">@a.Name</h1>
            <span class="badge @StatusBadge(a.Status) small">@a.Status</span>
            @if (a.SeriesId.HasValue)
            {
                <span class="badge bg-light text-secondary border small">
                    <i class="bi bi-arrow-repeat me-1"></i>Recurring
                </span>
            }
        </div>
        <div class="text-muted small mt-1">@a.Format &bull; @a.SkillLevel</div>
    </div>
    <div class="d-flex gap-2 w-100 w-md-auto flex-wrap">
        <a asp-page="RoundRobin" asp-route-id="@a.Id" class="btn btn-outline-success btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
            <i class="bi bi-diagram-3 me-1"></i>Round Robin
        </a>
        <a asp-page="CourtAssignment" asp-route-id="@a.Id" class="btn btn-outline-secondary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
            <i class="bi bi-grid-3x3-gap me-1"></i>Court Assignments
        </a>
        <a asp-page="Edit" asp-route-id="@a.Id" class="btn btn-outline-primary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Activity Info -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3 p-sm-4">
                <h5 class="h6 fw-bold mb-3 text-muted text-uppercase tracking-wider small">
                    <i class="bi bi-info-circle me-1 text-success"></i>Activity Overview
                </h5>
                <dl class="row mb-0 g-2">
                    <dt class="col-12 col-sm-4 text-muted small">Date &amp; Time</dt>
                    <dd class="col-12 col-sm-8 fw-medium mb-2">
                        <div>@a.Date.ToString("dddd, MMMM d, yyyy")</div>
                        <div class="text-muted small">@PickleBallBooking.Services.AppClock.To12HourRange(a.StartTime, a.EndTime)</div>
                    </dd>

                    <dt class="col-12 col-sm-4 text-muted small">Allocated Courts</dt>
                    <dd class="col-12 col-sm-8 mb-2">
                        @if (a.ActivityCourts.Any())
                        {
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-grid-3x3 text-muted me-1"></i>@string.Join(", ", a.ActivityCourts.Select(ac => ac.Court?.Name ?? "?"))
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">None assigned</span>
                        }
                    </dd>

                    <dt class="col-12 col-sm-4 text-muted small">Capacity &amp; Roster</dt>
                    <dd class="col-12 col-sm-8 mb-2">
                        <span class="fw-semibold">@(a.MaxCapacity == 0 ? "Unlimited capacity" : $"{roster?.ConfirmedCount ?? 0} / {a.MaxCapacity} spots taken")</span>
                        @if ((roster?.WaitlistCount ?? 0) > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis ms-2">@roster!.WaitlistCount on waitlist</span>
                        }
                    </dd>

                    <dt class="col-12 col-sm-4 text-muted small">Price Per Player</dt>
                    <dd class="col-12 col-sm-8 mb-2">
                        @(a.PricePerPlayer == 0 ? "Free" : "₱" + a.PricePerPlayer.ToString("N2"))
                    </dd>

                    <dt class="col-12 col-sm-4 text-muted small">Registration Window</dt>
                    <dd class="col-12 col-sm-8 mb-2">
                        @if (a.RegistrationOpensAt.HasValue || a.RegistrationClosesAt.HasValue)
                        {
                            <span>@(a.RegistrationOpensAt?.ToString("MMM d, h:mm tt") ?? "Now") – @(a.RegistrationClosesAt?.ToString("MMM d, h:mm tt") ?? "Open")</span>
                        }
                        else
                        {
                            <span class="text-muted small">Open (managed manually)</span>
                        }
                    </dd>
                </dl>
                @if (!string.IsNullOrEmpty(a.Description))
                {
                    <hr class="my-3" />
                    <p class="mb-0 text-muted small">@a.Description</p>
                }
            </div>
        </div>

        <!-- Confirmed Players Roster -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h6 fw-bold mb-0 d-flex align-items-center flex-wrap gap-1">
                    <i class="bi bi-people-fill text-success me-1"></i>Confirmed Players
                    <span class="badge bg-success-subtle text-success ms-1">@(roster?.ConfirmedCount ?? 0)</span>
                    @if ((roster?.CheckedInCount ?? 0) > 0)
                    {
                        <span class="badge bg-success ms-1 small">@roster!.CheckedInCount Checked In</span>
                    }
                    @if ((roster?.NoShowCount ?? 0) > 0)
                    {
                        <span class="badge bg-danger ms-1 small">@roster!.NoShowCount No-Show</span>
                    }
                </h2>
                <div class="small text-muted">
                    @(a.MaxCapacity == 0 ? "Unlimited" : $"{a.MaxCapacity - (roster?.ConfirmedCount ?? 0)} spots left")
                </div>
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                @if (roster is null || !roster.ConfirmedPlayers.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-person-x" style="font-size:2rem;"></i>
                        <p class="small mt-2 mb-0">No confirmed players yet.</p>
                    </div>
                }
                else
                {
                    <!-- Desktop Table -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>#</th>
                                    <th>Player</th>
                                    <th>Skill</th>
                                    <th>Contact</th>
                                    <th>Court</th>
                                    <th>Attendance</th>
                                    <th>RSVP Time</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < roster.ConfirmedPlayers.Count; i++)
                                {
                                    var p = roster.ConfirmedPlayers[i];
                                    var assignedCourt = Model.CourtOverview?.Courts.FirstOrDefault(c => c.Players.Any(pl => pl.RsvpId == p.RsvpId));
                                    <tr>
                                        <td class="text-muted small">@(i + 1)</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                                {
                                                    <img src="@p.AvatarUrl" alt="" class="rounded-circle" style="width:28px;height:28px;object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold" style="width:28px;height:28px;">
                                                        @p.PlayerName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <span class="fw-semibold">@p.PlayerName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="small">@SkillIcon(p.SkillLevel) @(p.SkillLevel?.ToString() ?? "—")</span>
                                        </td>
                                        <td class="small">
                                            <div>@p.Email</div>
                                            @if (!string.IsNullOrEmpty(p.Mobile))
                                            {
                                                <div class="text-muted" style="font-size:0.75rem;">@p.Mobile</div>
                                            }
                                        </td>
                                        <td>
                                            @if (assignedCourt is not null)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border" title="Assigned to @assignedCourt.CourtName">
                                                    <i class="bi bi-grid-3x3 me-1"></i>@assignedCourt.CourtName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Unassigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.Status == RsvpStatus.CheckedIn)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Checked In</span>
                                                @if (p.CheckedInAt.HasValue)
                                                {
                                                    <div class="text-muted" style="font-size:0.7rem;">@p.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</div>
                                                }
                                            }
                                            else if (p.Status == RsvpStatus.NoShow)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>No-Show</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pending</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@p.CreatedAt.ToString("MMM d, h:mm tt")</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                @if (p.Status != RsvpStatus.CheckedIn)
                                                {
                                                    <form method="post" asp-page-handler="CheckInRsvp" class="d-inline">
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                        <button type="submit" class="btn btn-success btn-sm py-0 px-2" title="Check In Player">
                                                            <i class="bi bi-check2"></i> Check In
                                                        </button>
                                                    </form>
                                                }
                                                @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                                {
                                                    <form method="post" asp-page-handler="MarkNoShow" class="d-inline ms-1" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                        <button type="submit" class="btn btn-outline-warning btn-sm py-0 px-2" title="Mark No-Show">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                                {
                                                    <form method="post" asp-page-handler="UndoCheckIn" class="d-inline ms-1">
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Reset Check-In">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </form>
                                                }
                                                <form method="post" asp-page-handler="RemoveRsvp" onsubmit="return confirm('Remove @p.PlayerName from confirmed list? If there is a waitlist, the next player will be automatically promoted.');" class="d-inline ms-1">
                                                    <input type="hidden" name="id" value="@a.Id" />
                                                    <input type="hidden" name="userId" value="@p.UserId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Remove player">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Player Cards (d-md-none) -->
                    <div class="d-md-none d-flex flex-column gap-2">
                        @for (int i = 0; i < roster.ConfirmedPlayers.Count; i++)
                        {
                            var p = roster.ConfirmedPlayers[i];
                            var assignedCourt = Model.CourtOverview?.Courts.FirstOrDefault(c => c.Players.Any(pl => pl.RsvpId == p.RsvpId));
                            <div class="border rounded-3 p-3 bg-white shadow-none">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                        {
                                            <img src="@p.AvatarUrl" alt="" class="rounded-circle flex-shrink-0" style="width:36px;height:36px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary fw-bold small flex-shrink-0" style="width:36px;height:36px;">
                                                @p.PlayerName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="fw-bold small text-truncate">@(i + 1). @p.PlayerName</div>
                                            <div class="small text-muted">@SkillIcon(p.SkillLevel) @(p.SkillLevel?.ToString() ?? "Open")</div>
                                        </div>
                                    </div>
                                    <div>
                                        @if (p.Status == RsvpStatus.CheckedIn)
                                        {
                                            <span class="badge bg-success small"><i class="bi bi-check2 me-1"></i>Checked In</span>
                                        }
                                        else if (p.Status == RsvpStatus.NoShow)
                                        {
                                            <span class="badge bg-danger small">No-Show</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">Pending</span>
                                        }
                                    </div>
                                </div>

                                <div class="small text-muted mb-2 d-flex flex-wrap gap-x-3 gap-y-1">
                                    <span><i class="bi bi-envelope me-1"></i>@p.Email</span>
                                    @if (!string.IsNullOrEmpty(p.Mobile))
                                    {
                                        <span><i class="bi bi-phone me-1"></i>@p.Mobile</span>
                                    }
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                    <div>
                                        @if (assignedCourt is not null)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border small">
                                                <i class="bi bi-grid-3x3 me-1"></i>@assignedCourt.CourtName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border small">Unassigned</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-1">
                                        @if (p.Status != RsvpStatus.CheckedIn)
                                        {
                                            <form method="post" asp-page-handler="CheckInRsvp" class="d-inline">
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Check In Player">
                                                    <i class="bi bi-check2"></i> In
                                                </button>
                                            </form>
                                        }
                                        @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                        {
                                            <form method="post" asp-page-handler="MarkNoShow" class="d-inline" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                <button type="submit" class="btn btn-outline-warning btn-sm py-1 px-2" title="Mark No-Show">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                        {
                                            <form method="post" asp-page-handler="UndoCheckIn" class="d-inline">
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset Check-In">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="RemoveRsvp" onsubmit="return confirm('Remove @p.PlayerName from confirmed list?');" class="d-inline">
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <input type="hidden" name="userId" value="@p.UserId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Remove player">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Waitlist Section -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4 d-flex justify-content-between align-items-center">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-hourglass-split text-warning me-2"></i>Waitlist
                    <span class="badge bg-warning-subtle text-warning-emphasis ms-2">@(roster?.WaitlistCount ?? 0)</span>
                </h2>
                <div class="small text-muted">Ordered by position</div>
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                @if (roster is null || !roster.WaitlistedPlayers.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check2-circle text-success" style="font-size:2rem;"></i>
                        <p class="small mt-2 mb-0">Waitlist is empty.</p>
                    </div>
                }
                else
                {
                    <!-- Desktop Table -->
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Pos</th>
                                    <th>Player</th>
                                    <th>Skill</th>
                                    <th>Contact</th>
                                    <th>Waitlisted At</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < roster.WaitlistedPlayers.Count; i++)
                                {
                                    var w = roster.WaitlistedPlayers[i];
                                    <tr>
                                        <td>
                                            <span class="badge bg-dark rounded-pill">#@(w.WaitlistPosition ?? (i + 1))</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(w.AvatarUrl))
                                                {
                                                    <img src="@w.AvatarUrl" alt="" class="rounded-circle" style="width:28px;height:28px;object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold" style="width:28px;height:28px;">
                                                        @w.PlayerName.Substring(0, 1).ToUpper()
                                                    </div>
                                                }
                                                <span class="fw-semibold">@w.PlayerName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="small">@SkillIcon(w.SkillLevel) @(w.SkillLevel?.ToString() ?? "—")</span>
                                        </td>
                                        <td class="small">
                                            <div>@w.Email</div>
                                            @if (!string.IsNullOrEmpty(w.Mobile))
                                            {
                                                <div class="text-muted" style="font-size:0.75rem;">@w.Mobile</div>
                                            }
                                        </td>
                                        <td class="small text-muted">@w.CreatedAt.ToString("MMM d, h:mm tt")</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <form method="post" asp-page-handler="Promote" class="d-inline" onsubmit="return confirm('Promote @w.PlayerName to Confirmed spot?');">
                                                    <input type="hidden" name="id" value="@a.Id" />
                                                    <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                                    <button type="submit" class="btn btn-success btn-sm py-0 px-2" title="Manually promote to confirmed">
                                                        <i class="bi bi-arrow-up-circle me-1"></i>Promote
                                                    </button>
                                                </form>

                                                @if (i > 0)
                                                {
                                                    <form method="post" asp-page-handler="MoveWaitlist" class="d-inline ms-1">
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                                        <input type="hidden" name="moveUp" value="true" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Move Up">
                                                            <i class="bi bi-arrow-up"></i>
                                                        </button>
                                                    </form>
                                                }

                                                @if (i < roster.WaitlistedPlayers.Count - 1)
                                                {
                                                    <form method="post" asp-page-handler="MoveWaitlist" class="d-inline ms-1">
                                                        <input type="hidden" name="id" value="@a.Id" />
                                                        <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                                        <input type="hidden" name="moveUp" value="false" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Move Down">
                                                            <i class="bi bi-arrow-down"></i>
                                                        </button>
                                                    </form>
                                                }

                                                <form method="post" asp-page-handler="RemoveRsvp" class="d-inline ms-1" onsubmit="return confirm('Remove @w.PlayerName from the waitlist?');">
                                                    <input type="hidden" name="id" value="@a.Id" />
                                                    <input type="hidden" name="userId" value="@w.UserId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Remove from waitlist">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Waitlist Cards (d-md-none) -->
                    <div class="d-md-none d-flex flex-column gap-2">
                        @for (int i = 0; i < roster.WaitlistedPlayers.Count; i++)
                        {
                            var w = roster.WaitlistedPlayers[i];
                            <div class="border rounded-3 p-3 bg-white shadow-none">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark rounded-pill">#@(w.WaitlistPosition ?? (i + 1))</span>
                                        <span class="fw-bold small">@w.PlayerName</span>
                                    </div>
                                    <span class="small text-muted">@SkillIcon(w.SkillLevel) @(w.SkillLevel?.ToString() ?? "—")</span>
                                </div>
                                <div class="small text-muted mb-2">@w.Email</div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top gap-1">
                                    <form method="post" asp-page-handler="Promote" class="flex-fill" onsubmit="return confirm('Promote @w.PlayerName to Confirmed spot?');">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                        <button type="submit" class="btn btn-success btn-sm w-100 py-1" title="Promote to confirmed">
                                            <i class="bi bi-arrow-up-circle me-1"></i>Promote
                                        </button>
                                    </form>
                                    @if (i > 0)
                                    {
                                        <form method="post" asp-page-handler="MoveWaitlist">
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                            <input type="hidden" name="moveUp" value="true" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Move Up">
                                                <i class="bi bi-arrow-up"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (i < roster.WaitlistedPlayers.Count - 1)
                                    {
                                        <form method="post" asp-page-handler="MoveWaitlist">
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <input type="hidden" name="rsvpId" value="@w.RsvpId" />
                                            <input type="hidden" name="moveUp" value="false" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Move Down">
                                                <i class="bi bi-arrow-down"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="RemoveRsvp" onsubmit="return confirm('Remove @w.PlayerName from the waitlist?');">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="userId" value="@w.UserId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Remove">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Court Assignments widget (Phase 39) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4 d-flex justify-content-between align-items-center">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-grid-3x3-gap me-2 text-success"></i>Court Assignments
                </h2>
                @if (Model.CourtOverview?.AreCourtAssignmentsLocked == true)
                {
                    <span class="badge bg-danger small"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success small"><i class="bi bi-unlock-fill me-1"></i>Editable</span>
                }
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Assigned / Confirmed:</span>
                    <span class="fw-bold small">@(Model.CourtOverview?.TotalAssignedCount ?? 0) / @(Model.CourtOverview?.TotalConfirmedCount ?? 0)</span>
                </div>
                @if (Model.CourtOverview?.Courts.Any() == true)
                {
                    <ul class="list-group list-group-flush mb-3 small">
                        @foreach (var c in Model.CourtOverview.Courts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <span><i class="bi bi-grid-3x3 text-muted me-1"></i>@c.CourtName</span>
                                <span class="badge bg-light text-dark border">@c.Players.Count players</span>
                            </li>
                        }
                    </ul>
                }
                <div class="d-grid">
                    <a asp-page="CourtAssignment" asp-route-id="@a.Id" class="btn btn-outline-success btn-sm fw-semibold py-2">
                        <i class="bi bi-gear-fill me-1"></i>Manage Court Assignments
                    </a>
                </div>
            </div>
        </div>

        <!-- Phase 40: Round Robin Engine widget -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4 d-flex justify-content-between align-items-center">
                <h2 class="h6 fw-bold mb-0">
                    <i class="bi bi-diagram-3-fill me-2 text-success"></i>Round Robin
                </h2>
                @if (Model.RoundRobinOverview?.EventId > 0)
                {
                    @if (Model.RoundRobinOverview.IsLocked)
                    {
                        <span class="badge bg-danger small"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success small">Scheduled</span>
                    }
                }
                else
                {
                    <span class="badge bg-light text-muted border small">Not Generated</span>
                }
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                @if (Model.RoundRobinOverview?.EventId > 0)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <span class="text-muted">Format:</span>
                        <span class="fw-semibold">@Model.RoundRobinOverview.Format</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <span class="text-muted">Rounds / Matches:</span>
                        <span class="fw-semibold">@Model.RoundRobinOverview.NumberOfRounds Rounds &bull; @Model.RoundRobinOverview.TotalMatchesCount Matches</span>
                    </div>
                    <div class="d-grid mt-3">
                        <a asp-page="RoundRobin" asp-route-id="@a.Id" class="btn btn-success btn-sm fw-semibold py-2 shadow-sm">
                            <i class="bi bi-diagram-3 me-1"></i>View Match Schedule
                        </a>
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-3">Generate automated round robin match pairings, court assignments, and schedules.</p>
                    <div class="d-grid">
                        <a asp-page="RoundRobin" asp-route-id="@a.Id" class="btn btn-outline-success btn-sm fw-semibold py-2">
                            <i class="bi bi-plus-circle me-1"></i>Create Round Robin
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Status management -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4">
                <h2 class="h6 fw-bold mb-0"><i class="bi bi-toggle-on me-2 text-success"></i>Change Status</h2>
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                <div class="d-flex flex-column gap-2">
                    @foreach (var s in Enum.GetValues<ActivityStatus>())
                    {
                        if (s == a.Status) continue;
                        <form method="post" asp-page-handler="SetStatus">
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="status" value="@((int)s)" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 py-1 text-start d-flex justify-content-between align-items-center">
                                <span>Set to: @s</span>
                                <i class="bi bi-chevron-right text-muted small"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Danger zone -->
        <div class="card border-0 border-danger shadow-sm rounded-3">
            <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4">
                <h2 class="h6 fw-bold mb-0 text-danger"><i class="bi bi-trash me-2"></i>Danger Zone</h2>
            </div>
            <div class="card-body px-3 px-md-4 pb-3 pb-md-4">
                <form method="post" asp-page-handler="Delete"
                      onsubmit="return confirm('Delete this activity and all its RSVP registrations? This cannot be undone.')">
                    <input type="hidden" name="id" value="@a.Id" />
                    <button type="submit" class="btn btn-danger btn-sm w-100 py-2">
                        <i class="bi bi-trash me-1"></i>Delete Activity
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
.bg-success-subtle { background-color: rgba(25,135,84,.12); }
.bg-primary-subtle { background-color: rgba(13,110,253,.12); }
.bg-warning-subtle { background-color: rgba(255,193,7,.18); }
.bg-danger-subtle  { background-color: rgba(220,53,69,.12); }
.tracking-wider { letter-spacing: 0.05em; }
</style>
}
