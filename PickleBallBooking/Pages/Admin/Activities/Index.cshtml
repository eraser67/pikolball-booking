@page "/Admin/Activities"
@model PickleBallBooking.Pages.Admin.Activities.IndexModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Activities";
}
@functions {
    static string StatusBadge(PickleBallBooking.Models.ActivityStatus s) => s switch {
        PickleBallBooking.Models.ActivityStatus.Draft              => "bg-secondary",
        PickleBallBooking.Models.ActivityStatus.Published          => "bg-info text-dark",
        PickleBallBooking.Models.ActivityStatus.RegistrationOpen   => "bg-success",
        PickleBallBooking.Models.ActivityStatus.Full               => "bg-warning text-dark",
        PickleBallBooking.Models.ActivityStatus.RegistrationClosed => "bg-secondary",
        PickleBallBooking.Models.ActivityStatus.InProgress         => "bg-primary",
        PickleBallBooking.Models.ActivityStatus.Completed          => "bg-dark",
        PickleBallBooking.Models.ActivityStatus.Cancelled          => "bg-danger",
        _                                                          => "bg-light text-dark"
    };
    static string SkillBadge(PickleBallBooking.Models.ActivitySkillLevel sk) => sk switch {
        PickleBallBooking.Models.ActivitySkillLevel.Open         => "bg-primary",
        PickleBallBooking.Models.ActivitySkillLevel.Beginner     => "bg-success",
        PickleBallBooking.Models.ActivitySkillLevel.Intermediate => "bg-warning text-dark",
        PickleBallBooking.Models.ActivitySkillLevel.Advanced     => "bg-danger",
        _                                                        => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 fw-bold mb-0"><i class="bi bi-calendar-event text-success me-2"></i>Activities</h1>
    <div class="d-flex gap-2">
        <a asp-page="SeriesIndex" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-repeat me-1"></i>Recurring Series
        </a>
        <a asp-page="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>New Activity
        </a>
    </div>
</div>

@if (!Model.Activities.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size:2.5rem;"></i>
            <p class="text-muted mt-3 mb-2">No activities yet. Create your first one!</p>
            <a asp-page="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-circle me-1"></i>New Activity
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Activity</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Courts</th>
                        <th>Skill</th>
                        <th>Capacity</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Activities)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">
                                <a asp-page="Detail" asp-route-id="@a.Id" class="text-decoration-none">@a.Name</a>
                                @if (a.SeriesId.HasValue)
                                {
                                    <a asp-page="SeriesDetail" asp-route-id="@a.SeriesId" class="badge bg-light text-secondary border ms-1 text-decoration-none" style="font-size:.65rem;">
                                        <i class="bi bi-arrow-repeat me-1"></i>Series
                                    </a>
                                }
                                <div class="small text-muted">@a.Format</div>
                            </td>
                            <td class="small">@a.Date.ToString("MMM d, yyyy")</td>
                            <td class="small text-muted">
                                @PickleBallBooking.Services.AppClock.To12HourRange(a.StartTime, a.EndTime)
                            </td>
                            <td class="small">
                                @if (a.ActivityCourts.Any())
                                {
                                    @string.Join(", ", a.ActivityCourts.Select(ac => ac.Court?.Name ?? "?"))
                                }
                                else { <span class="text-muted">None</span> }
                            </td>
                            <td><span class="badge @SkillBadge(a.SkillLevel) rounded-pill small">@a.SkillLevel</span></td>
                            <td class="small">@(a.MaxCapacity == 0 ? "∞" : a.MaxCapacity.ToString())</td>
                            <td class="small">@(a.PricePerPlayer == 0 ? "Free" : "₱" + a.PricePerPlayer.ToString("N0"))</td>
                            <td><span class="badge @StatusBadge(a.Status) rounded-pill small">@a.Status</span></td>
                            <td class="pe-3 text-end">
                                <a asp-page="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <a asp-page="Detail" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
