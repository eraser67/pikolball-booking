@page "/Admin/Players"
@model PickleBallBooking.Pages.Admin.Players.IndexModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Venue Players & Roster";
}

@functions {
    static string SkillBadge(PlayerSkillLevel sk) => sk switch {
        PlayerSkillLevel.Beginner => "🟢 Beginner",
        PlayerSkillLevel.Intermediate => "🟡 Intermediate",
        PlayerSkillLevel.Advanced => "🔴 Advanced",
        _ => sk.ToString()
    };
}

<div class="container-fluid px-3 px-md-4 py-3 py-md-4 max-w-7xl">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-2 mb-md-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Admin/Index" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Players</li>
        </ol>
    </nav>

    <!-- Header & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4">
        <div>
            <h1 class="h4 h3-md fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i> Venue Players & Roster
            </h1>
            <p class="text-muted small mb-0">Manage registered members and walk-in guest players participating at your venue.</p>
        </div>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2 fw-semibold"
                data-bs-toggle="modal" data-bs-target="#registerGuestModal">
            <i class="bi bi-person-plus-fill"></i> Register Walk-in Player
        </button>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm py-2 px-3 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm py-2 px-3 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Metric Stat Cards -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 p-2 p-sm-3 bg-white h-100 player-kpi-card">
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <div class="p-2 p-sm-3 rounded-circle bg-primary-subtle text-primary fs-5 fs-sm-4 flex-shrink-0">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-muted small text-uppercase fw-semibold text-truncate" style="font-size:0.7rem;">Total Players</div>
                        <div class="fs-4 fs-sm-3 fw-bold text-dark">@Model.TotalCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 p-2 p-sm-3 bg-white h-100 player-kpi-card">
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <div class="p-2 p-sm-3 rounded-circle bg-warning-subtle text-warning-emphasis fs-5 fs-sm-4 flex-shrink-0">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-muted small text-uppercase fw-semibold text-truncate" style="font-size:0.7rem;">Walk-ins</div>
                        <div class="fs-4 fs-sm-3 fw-bold text-dark">@Model.GuestCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 p-2 p-sm-3 bg-white h-100 player-kpi-card">
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <div class="p-2 p-sm-3 rounded-circle bg-success-subtle text-success fs-5 fs-sm-4 flex-shrink-0">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-muted small text-uppercase fw-semibold text-truncate" style="font-size:0.7rem;">Members</div>
                        <div class="fs-4 fs-sm-3 fw-bold text-dark">@Model.RegisteredCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card border-0 shadow-sm rounded-3 mb-3 mb-md-4 bg-white">
        <div class="card-body p-2 p-sm-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="Search" value="@Model.Search" class="form-control border-start-0"
                               placeholder="Search by name, phone, notes..." />
                        @if (!string.IsNullOrEmpty(Model.Search))
                        {
                            <a asp-page="./Index" asp-route-Filter="@Model.Filter" class="btn btn-outline-secondary border-start-0" title="Clear Search">
                                <i class="bi bi-x"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-5">
                    <!-- Horizontal Scrollable Filter Chips -->
                    <div class="player-filter-chips d-flex gap-1 overflow-x-auto pb-1 pb-md-0" style="scrollbar-width:none;">
                        <a asp-page="./Index" asp-route-Search="@Model.Search" asp-route-Filter="all"
                           class="filter-chip @(Model.Filter == "all" ? "active" : "")">
                            All <span class="badge rounded-pill ms-1">@Model.TotalCount</span>
                        </a>
                        <a asp-page="./Index" asp-route-Search="@Model.Search" asp-route-Filter="guests"
                           class="filter-chip @(Model.Filter == "guests" ? "active" : "")">
                            Walk-Ins <span class="badge rounded-pill ms-1">@Model.GuestCount</span>
                        </a>
                        <a asp-page="./Index" asp-route-Search="@Model.Search" asp-route-Filter="registered"
                           class="filter-chip @(Model.Filter == "registered" ? "active" : "")">
                            Members <span class="badge rounded-pill ms-1">@Model.RegisteredCount</span>
                        </a>
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm py-2 w-100 fw-semibold">Apply</button>
                    @if (!string.IsNullOrEmpty(Model.Search) || Model.Filter != "all")
                    {
                        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm py-2 px-3" title="Reset all filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Players Roster Container -->
    @if (Model.Players.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white">
            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
            <h5 class="fw-bold mb-1">No players found</h5>
            <p class="text-muted small mb-3">Try adjusting your search criteria or register a new walk-in player.</p>
            <div>
                <button type="button" class="btn btn-primary btn-sm px-3 py-2 fw-semibold"
                        data-bs-toggle="modal" data-bs-target="#registerGuestModal">
                    <i class="bi bi-person-plus-fill me-1"></i>Register Walk-in Player
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- 📱 Mobile & Tablet View: Player Cards (< 992px) -->
        <div class="d-lg-none d-flex flex-column gap-3 mb-4">
            @foreach (var player in Model.Players)
            {
                var initial = !string.IsNullOrEmpty(player.DisplayName) ? player.DisplayName.Substring(0, 1).ToUpper() : "P";
                var cleanPhone = !string.IsNullOrEmpty(player.Mobile) ? new string(player.Mobile.Where(char.IsDigit).ToArray()) : "";

                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white player-card-item">
                    <!-- Top Info Row -->
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <div class="avatar-circle rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0 @(player.IsGuest ? "bg-warning-subtle text-warning-emphasis" : "bg-primary-subtle text-primary")"
                                 style="width: 44px; height: 44px; font-size: 1.15rem;">
                                @initial
                            </div>
                            <div class="min-w-0">
                                <div class="fw-bold text-dark text-truncate d-flex align-items-center gap-1">
                                    <span class="text-truncate">@player.DisplayName</span>
                                </div>
                                @if (!string.Equals(player.DisplayName, player.FullName, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(player.FullName))
                                {
                                    <div class="text-muted small text-truncate" style="font-size:0.8rem;">@player.FullName</div>
                                }
                                <div class="d-flex align-items-center gap-1 flex-wrap mt-1">
                                    @if (player.IsGuest)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill" style="font-size: 0.68rem; font-weight: 600;">
                                            <i class="bi bi-person-walking me-1"></i>Walk-in
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem; font-weight: 600;">
                                            <i class="bi bi-shield-check me-1"></i>Member
                                        </span>
                                    }
                                    <span class="badge bg-light text-dark border rounded-pill" style="font-size: 0.68rem;">
                                        @SkillBadge(player.SkillLevel)
                                    </span>
                                    <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.68rem;">
                                        @player.PlayingHand hand
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Action button for profile -->
                        <a asp-page="/Player/Profile" asp-route-userId="@player.UserId"
                           class="btn btn-outline-secondary btn-sm p-2 rounded-circle flex-shrink-0" title="View Profile & Stats">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>

                    <!-- Attendance & Matches Chips -->
                    <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-2 bg-light text-muted small">
                        <div class="flex-fill text-center">
                            <span class="fw-bold text-dark fs-6">@player.ActivitiesAttended</span>
                            <span class="d-block text-muted" style="font-size: 0.7rem;">Activities</span>
                        </div>
                        <div class="border-start" style="height: 24px;"></div>
                        <div class="flex-fill text-center">
                            <span class="fw-bold text-dark fs-6">@player.MatchesPlayed</span>
                            <span class="d-block text-muted" style="font-size: 0.7rem;">Matches</span>
                        </div>
                        <div class="border-start" style="height: 24px;"></div>
                        <div class="flex-fill text-center">
                            @if (player.LastActiveDate.HasValue)
                            {
                                <span class="fw-semibold text-dark" style="font-size: 0.8rem;">@player.LastActiveDate.Value.ToString("MMM d")</span>
                                <span class="d-block text-muted" style="font-size: 0.7rem;">@player.LastActiveDate.Value.ToString("h:mm tt")</span>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 0.8rem;">No events</span>
                                <span class="d-block text-muted" style="font-size: 0.7rem;">Yet</span>
                            }
                        </div>
                    </div>

                    <!-- Contact & Notes details -->
                    <div class="small text-muted mb-3 d-flex flex-column gap-1">
                        @if (!string.IsNullOrEmpty(player.Mobile))
                        {
                            <div class="d-flex align-items-center gap-1 text-dark">
                                <i class="bi bi-telephone text-success me-1"></i>
                                <span class="font-monospace">@player.Mobile</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(player.Email))
                        {
                            <div class="d-flex align-items-center gap-1 text-truncate">
                                <i class="bi bi-envelope text-primary me-1"></i>
                                <span class="text-truncate">@player.Email</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(player.AdminNotes))
                        {
                            <div class="p-2 rounded bg-warning bg-opacity-10 text-dark small mt-1 border border-warning border-opacity-25">
                                <i class="bi bi-sticky-fill text-warning me-1"></i>
                                <span class="fst-italic">@player.AdminNotes</span>
                            </div>
                        }
                    </div>

                    <!-- 1-Tap Touch Contact & Action Bar -->
                    <div class="d-flex align-items-center gap-1 pt-2 border-top flex-wrap">
                        @if (!string.IsNullOrEmpty(cleanPhone))
                        {
                            <a href="tel:@cleanPhone" class="btn btn-outline-success btn-sm flex-fill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1" title="Call player">
                                <i class="bi bi-telephone-fill"></i>
                                <span>Call</span>
                            </a>
                            <a href="sms:@cleanPhone" class="btn btn-outline-info btn-sm flex-fill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1" title="SMS text player">
                                <i class="bi bi-chat-dots-fill"></i>
                                <span>SMS</span>
                            </a>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-2 copy-btn" data-copy="@player.Mobile" title="Copy phone number">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        }
                        <a asp-page="/Player/Profile" asp-route-userId="@player.UserId" class="btn btn-outline-primary btn-sm flex-fill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Stats</span>
                        </a>
                        @if (player.IsGuest)
                        {
                            <button type="button" class="btn btn-outline-dark btn-sm flex-fill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1 edit-guest-btn"
                                    data-bs-toggle="modal" data-bs-target="#editGuestModal"
                                    data-userid="@player.UserId"
                                    data-firstname="@player.FullName.Split(' ').FirstOrDefault()"
                                    data-lastname="@(player.FullName.Contains(' ') ? player.FullName.Substring(player.FullName.IndexOf(' ') + 1) : "")"
                                    data-displayname="@player.DisplayName"
                                    data-skill="@((int)player.SkillLevel)"
                                    data-hand="@((int)player.PlayingHand)"
                                    data-mobile="@player.Mobile"
                                    data-email="@player.Email"
                                    data-notes="@player.AdminNotes"
                                    title="Edit Walk-in Player">
                                <i class="bi bi-pencil-square"></i>
                                <span>Edit</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 💻 Desktop View: Full Table (≥ 992px) -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white d-none d-lg-block mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-3 py-3" style="min-width: 220px;">Player</th>
                            <th style="min-width: 130px;">Skill Rating</th>
                            <th style="min-width: 140px;">Contact</th>
                            <th class="text-center" style="min-width: 100px;">Activities</th>
                            <th class="text-center" style="min-width: 100px;">Matches</th>
                            <th style="min-width: 130px;">Last Active</th>
                            <th class="text-end pe-3" style="min-width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players)
                        {
                            var initial = !string.IsNullOrEmpty(player.DisplayName) ? player.DisplayName.Substring(0, 1).ToUpper() : "P";
                            var cleanPhone = !string.IsNullOrEmpty(player.Mobile) ? new string(player.Mobile.Where(char.IsDigit).ToArray()) : "";

                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle rounded-circle d-flex align-items-center justify-content-center fw-bold @(player.IsGuest ? "bg-warning-subtle text-warning-emphasis" : "bg-primary-subtle text-primary")"
                                             style="width: 40px; height: 40px; font-size: 1.1rem; flex-shrink: 0;">
                                            @initial
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                <span>@player.DisplayName</span>
                                                @if (player.IsGuest)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small"
                                                          style="font-size: 0.7rem; font-weight: 600;">
                                                        <i class="bi bi-person-walking me-1"></i>Walk-in
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small"
                                                          style="font-size: 0.7rem; font-weight: 600;">
                                                        <i class="bi bi-shield-check me-1"></i>Member
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.Equals(player.DisplayName, player.FullName, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="small text-muted">@player.FullName</div>
                                            }
                                            @if (!string.IsNullOrEmpty(player.AdminNotes))
                                            {
                                                <div class="small text-muted fst-italic text-truncate" style="max-width: 250px;" title="@player.AdminNotes">
                                                    <i class="bi bi-sticky me-1"></i>@player.AdminNotes
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-2">
                                        @SkillBadge(player.SkillLevel)
                                    </span>
                                    <div class="small text-muted mt-1">@player.PlayingHand hand</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(player.Mobile))
                                    {
                                        <div class="small d-flex align-items-center gap-1">
                                            <i class="bi bi-telephone text-muted"></i>
                                            <span>@player.Mobile</span>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-muted copy-btn ms-1" data-copy="@player.Mobile" title="Copy Phone">
                                                <i class="bi bi-clipboard" style="font-size:0.75rem;"></i>
                                            </button>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(player.Email))
                                    {
                                        <div class="small text-truncate" style="max-width: 180px;" title="@player.Email">
                                            <i class="bi bi-envelope text-muted me-1"></i>@player.Email
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(player.Mobile) && string.IsNullOrEmpty(player.Email))
                                    {
                                        <span class="text-muted small">None recorded</span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">
                                    @player.ActivitiesAttended
                                </td>
                                <td class="text-center fw-semibold">
                                    @player.MatchesPlayed
                                </td>
                                <td>
                                    @if (player.LastActiveDate.HasValue)
                                    {
                                        <div class="small fw-semibold text-dark">@player.LastActiveDate.Value.ToString("MMM d, yyyy")</div>
                                        <div class="small text-muted">@player.LastActiveDate.Value.ToString("h:mm tt")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No events yet</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        @if (!string.IsNullOrEmpty(cleanPhone))
                                        {
                                            <a href="tel:@cleanPhone" class="btn btn-outline-success btn-sm py-1 px-2" title="Call @player.DisplayName">
                                                <i class="bi bi-telephone-fill"></i>
                                            </a>
                                        }
                                        <a asp-page="/Player/Profile" asp-route-userId="@player.UserId"
                                           class="btn btn-outline-secondary btn-sm py-1 px-2" title="View Statistics & Match History">
                                            <i class="bi bi-bar-chart-line text-primary me-1"></i>Stats
                                        </a>
                                        @if (player.IsGuest)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2 edit-guest-btn"
                                                    data-bs-toggle="modal" data-bs-target="#editGuestModal"
                                                    data-userid="@player.UserId"
                                                    data-firstname="@player.FullName.Split(' ').FirstOrDefault()"
                                                    data-lastname="@(player.FullName.Contains(' ') ? player.FullName.Substring(player.FullName.IndexOf(' ') + 1) : "")"
                                                    data-displayname="@player.DisplayName"
                                                    data-skill="@((int)player.SkillLevel)"
                                                    data-hand="@((int)player.PlayingHand)"
                                                    data-mobile="@player.Mobile"
                                                    data-email="@player.Email"
                                                    data-notes="@player.AdminNotes"
                                                    title="Edit Walk-in Player">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- 📱 Mobile Floating Action Button (FAB) to register Walk-In -->
<div class="position-fixed bottom-0 end-0 p-3 d-lg-none" style="z-index: 1040;">
    <button type="button" class="btn btn-primary rounded-pill shadow-lg py-2 px-3 fw-semibold d-flex align-items-center gap-2"
            data-bs-toggle="modal" data-bs-target="#registerGuestModal">
        <i class="bi bi-person-plus-fill fs-5"></i>
        <span>+ Walk-in</span>
    </button>
</div>

<!-- Modal: Register Walk-In Player -->
<div class="modal fade" id="registerGuestModal" tabindex="-1" aria-labelledby="registerGuestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="RegisterGuest">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="registerGuestModalLabel">
                        <i class="bi bi-person-plus-fill text-primary me-2"></i>Register Walk-in Player
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Register a walk-in or offline player without creating a login account. They can be scheduled into Open Play, assigned courts, paired in Round Robin, and scored.
                    </p>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" required placeholder="e.g. John" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" required placeholder="e.g. Doe" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Display / Nickname <span class="text-muted fw-normal">(Optional)</span></label>
