@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Edit modal wireup for both desktop table and mobile cards
        const editButtons = document.querySelectorAll('.edit-guest-btn');
        editButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editGuestUserId').value = this.dataset.userid || '';
                document.getElementById('editGuestFirstName').value = this.dataset.firstname || '';
                document.getElementById('editGuestLastName').value = this.dataset.lastname || '';
                document.getElementById('editGuestDisplayName').value = this.dataset.displayname || '';
                
                const skillVal = parseInt(this.dataset.skill, 10);
                const skillSelect = document.getElementById('editGuestSkill');
                if (!isNaN(skillVal) && skillSelect.options[skillVal]) {
                    skillSelect.selectedIndex = skillVal;
                }

                const handVal = parseInt(this.dataset.hand, 10);
                const handSelect = document.getElementById('editGuestHand');
                if (!isNaN(handVal) && handSelect.options[handVal]) {
                    handSelect.selectedIndex = handVal;
                }

                document.getElementById('editGuestMobile').value = this.dataset.mobile || '';
                document.getElementById('editGuestEmail').value = this.dataset.email || '';
                document.getElementById('editGuestNotes').value = this.dataset.notes || '';
            });
        });

        // 1-Tap Copy phone button feedback
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.preventDefault();
                e.stopPropagation();
                const text = this.getAttribute('data-copy');
                if (!text) return;

                try {
                    await navigator.clipboard.writeText(text);
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check-lg text-success"></i>';
                    setTimeout(() => { this.innerHTML = originalHtml; }, 1500);
                } catch (err) {
                    // Fallback
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-check-lg text-success"></i>';
                    setTimeout(() => { this.innerHTML = originalHtml; }, 1500);
                }
            });
        });
    });
</script>
}

