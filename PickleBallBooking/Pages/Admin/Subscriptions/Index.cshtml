@page "/Admin/Subscriptions"
@model PickleBallBooking.Pages.Admin.Subscriptions.IndexModel
@{
    ViewData["Title"] = "Organization Subscriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Organization Subscriptions</h1>
        <p class="text-muted small mb-0">Manage subscription assignments for all organizations.</p>
    </div>
    <a asp-page="Plans/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-stack me-1"></i>Manage Plans
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Organization</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Trial End</th>
                        <th>Last Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.Subscriptions)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@sub.OrganizationName</div>
                                <div class="text-muted small">@sub.OrganizationSlug</div>
                            </td>
                            <td>@sub.PlanName</td>
                            <td>
                                @{
                                    var (badgeClass, icon) = sub.Status switch {
                                        PickleBallBooking.Models.SubscriptionStatus.Trial     => ("bg-info-subtle text-info border border-info-subtle", "bi-hourglass-split"),
                                        PickleBallBooking.Models.SubscriptionStatus.Active    => ("bg-success-subtle text-success border border-success-subtle", "bi-check-circle"),
                                        PickleBallBooking.Models.SubscriptionStatus.Expired   => ("bg-warning-subtle text-warning border border-warning-subtle", "bi-exclamation-circle"),
                                        PickleBallBooking.Models.SubscriptionStatus.Suspended => ("bg-danger-subtle text-danger border border-danger-subtle", "bi-pause-circle"),
                                        _                                                      => ("bg-secondary-subtle text-secondary border border-secondary-subtle", "bi-x-circle")
                                    };
                                }
                                <span class="badge @badgeClass">
                                    <i class="bi @icon me-1"></i>@sub.Status
                                </span>
                            </td>
                            <td class="text-muted small">@(sub.StartDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-muted small">@(sub.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-muted small">@(sub.TrialEndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-muted small">@PickleBallBooking.Services.AppClock.ToPhilippineTime(sub.UpdatedAt).ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a asp-page="Assign" asp-route-organizationId="@sub.OrganizationId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i>Manage
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Subscriptions.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No subscriptions found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.UnsubscribedOrgs.Any())
{
    <div class="mt-4">
        <h5 class="mb-3 text-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Organizations Without a Subscription
        </h5>
        <div class="list-group">
            @foreach (var org in Model.UnsubscribedOrgs)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@org.Name</div>
                        <div class="text-muted small">@org.Slug</div>
                    </div>
                    <a asp-page="Assign" asp-route-organizationId="@org.Id" class="btn btn-sm btn-warning">
                        <i class="bi bi-plus-circle me-1"></i>Assign Plan
                    </a>
                </div>
            }
        </div>
    </div>
}
