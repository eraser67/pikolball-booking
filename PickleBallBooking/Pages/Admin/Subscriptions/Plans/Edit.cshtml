@page "/Admin/Subscriptions/Plans/Edit/{id:int}"
@model PickleBallBooking.Pages.Admin.Subscriptions.Plans.EditModel
@{
    ViewData["Title"] = $"Edit Plan — {Model.Input.Name}";
}

<div class="mb-4">
    <h1 class="h3">Edit Plan — @Model.Input.Name</h1>
</div>

<form method="post" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label fw-semibold"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Input.Price" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text">₱</span>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <span asp-validation-for="Input.Price" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Input.BillingPeriod" class="form-label fw-semibold"></label>
            <select asp-for="Input.BillingPeriod" class="form-select"
                    asp-items="Html.GetEnumSelectList<PickleBallBooking.Models.BillingPeriod>()"></select>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Input.MaxCourts" class="form-label fw-semibold"></label>
            <input asp-for="Input.MaxCourts" class="form-control" type="number" min="1"
                   placeholder="Leave blank for unlimited" />
            <span asp-validation-for="Input.MaxCourts" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Input.MaxBookingsPerMonth" class="form-label fw-semibold"></label>
            <input asp-for="Input.MaxBookingsPerMonth" class="form-control" type="number" min="1"
                   placeholder="Leave blank for unlimited" />
            <span asp-validation-for="Input.MaxBookingsPerMonth" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Features" class="form-label fw-semibold"></label>
        <textarea asp-for="Input.Features" class="form-control" rows="4"></textarea>
        <div class="form-text">One feature per line.</div>
        <span asp-validation-for="Input.Features" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Input.IsActive" class="form-check-label fw-semibold">Active</label>
        </div>
    </div>

    <div class="mb-4">
        <div class="form-check form-switch">
            <input asp-for="Input.IsFree" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="Input.IsFree" class="form-check-label fw-semibold">Free plan (never blocked)</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy me-1"></i>Save Changes
        </button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
