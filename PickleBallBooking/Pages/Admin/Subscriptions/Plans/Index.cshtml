@page "/Admin/Subscriptions/Plans"
@model PickleBallBooking.Pages.Admin.Subscriptions.Plans.IndexModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Subscription Plans</h1>
        <p class="text-muted small mb-0">Manage the plans available to organizations.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Plan
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @foreach (var plan in Model.Plans)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 shadow-sm border-0 @(plan.IsActive ? "" : "opacity-50")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="card-title mb-0">@plan.Name</h5>
                            @if (plan.IsFree)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle mt-1">Free</span>
                            }
                        </div>
                        <div class="text-end">
                            @if (plan.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(plan.Description))
                    {
                        <p class="card-text text-muted small mb-2">@plan.Description</p>
                    }

                    <div class="mb-3">
                        <span class="fs-4 fw-bold">₱@plan.Price.ToString("N2")</span>
                        <span class="text-muted small">/ @plan.BillingPeriod.ToString().ToLower()</span>
                    </div>

                    <ul class="list-unstyled small mb-3">
                        <li>
                            <i class="bi bi-building me-2 text-primary"></i>
                            @(plan.MaxCourts.HasValue ? $"Up to {plan.MaxCourts} courts" : "Unlimited courts")
                        </li>
                        <li>
                            <i class="bi bi-calendar-check me-2 text-primary"></i>
                            @(plan.MaxBookingsPerMonth.HasValue ? $"Up to {plan.MaxBookingsPerMonth} bookings/month" : "Unlimited bookings")
                        </li>
                        @if (!string.IsNullOrEmpty(plan.Features))
                        {
                            @foreach (var feature in plan.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <li><i class="bi bi-check-circle me-2 text-success"></i>@feature</li>
                            }
                        }
                    </ul>

                    <div class="d-flex gap-2">
                        <a asp-page="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        @if (plan.IsActive)
                        {
                            <form method="post" asp-page-handler="Deactivate" asp-route-id="@plan.Id"
                                  onsubmit="return confirm('Deactivate this plan?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pause-circle me-1"></i>Deactivate
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Activate" asp-route-id="@plan.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-play-circle me-1"></i>Activate
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Plans.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-stack display-4 d-block mb-3"></i>
                <p>No subscription plans yet. <a asp-page="Create">Create your first plan.</a></p>
            </div>
        </div>
    }
</div>
