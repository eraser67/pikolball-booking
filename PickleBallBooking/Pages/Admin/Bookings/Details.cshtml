@page "/Admin/Bookings/{id:int}"
@model PickleBallBooking.Pages.Admin.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<dl class="row">
    <dt class="col-sm-3">Booking Reference</dt>
    <dd class="col-sm-9">@Model.Booking!.BookingReference</dd>

    <dt class="col-sm-3">Customer Name</dt>
    <dd class="col-sm-9">@Model.Booking.CustomerName</dd>

    <dt class="col-sm-3">Customer Phone</dt>
    <dd class="col-sm-9">@Model.Booking.CustomerPhone</dd>

    <dt class="col-sm-3">Customer Email</dt>
    <dd class="col-sm-9">@Model.Booking.CustomerEmail</dd>

    <dt class="col-sm-3">Court</dt>
    <dd class="col-sm-9">@Model.Booking.Court?.Name</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Booking.BookingDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Time</dt>
    <dd class="col-sm-9">@PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime, Model.Booking.EndTime)</dd>

    @if (Model.BookingSlots.Count > 0)
    {
        <dt class="col-sm-3">Booked Slots</dt>
        <dd class="col-sm-9">
            <ul>
                @foreach (var (slot, timeSlot) in Model.BookingSlots)
                {
                    <li>@PickleBallBooking.Services.AppClock.To12HourRange(timeSlot.StartTime, timeSlot.EndTime) (#@slot.SlotOrder)</li>
                }
            </ul>
        </dd>
    }

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Booking.Price.ToString("C")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @switch (Model.Booking.BookingStatus)
        {
            case PickleBallBooking.Models.BookingStatus.Pending:
                <span class="badge bg-warning text-dark">Pending</span>
                break;
            case PickleBallBooking.Models.BookingStatus.Confirmed:
                <span class="badge bg-success">Confirmed</span>
                break;
            case PickleBallBooking.Models.BookingStatus.Cancelled:
                <span class="badge bg-danger">Cancelled</span>
                break;
            case PickleBallBooking.Models.BookingStatus.Completed:
                <span class="badge bg-secondary">Completed</span>
                break;
        }
    </dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.Booking.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Updated At</dt>
    <dd class="col-sm-9">@Model.Booking.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<div class="btn-group" role="group">
    <a asp-page="Index" class="btn btn-secondary">Back to Bookings</a>
    @if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Pending)
    {
        <form method="post" asp-page-handler="Confirm" style="display:inline;">
            <input type="hidden" name="id" value="@Model.Booking.Id" />
            <button type="submit" class="btn btn-success">Confirm Booking</button>
        </form>
    }
    @if (Model.Booking.BookingStatus is PickleBallBooking.Models.BookingStatus.Pending or PickleBallBooking.Models.BookingStatus.Confirmed)
    {
        <form method="post" asp-page-handler="Cancel" style="display:inline;"
              data-pb-confirm="Cancel booking @Model.Booking.BookingReference for @Model.Booking.CustomerName? This will release the booked time slot(s) and cannot be undone."
              data-pb-confirm-title="Cancel booking"
              data-pb-confirm-ok="Cancel booking">
            <input type="hidden" name="id" value="@Model.Booking.Id" />
            <button type="submit" class="btn btn-danger">
                Cancel Booking
            </button>
        </form>
    }
    @if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
    {
        <form method="post" asp-page-handler="Complete" style="display:inline;">
            <input type="hidden" name="id" value="@Model.Booking.Id" />
            <button type="submit" class="btn btn-secondary">Complete Booking</button>
        </form>
    }
</div>

