@page "/Admin/Bookings"
@model PickleBallBooking.Pages.Admin.Bookings.IndexModel
@{
    ViewData["Title"] = "Manage Bookings";
    var hasCustomFilters = Model.CourtId.HasValue || (Model.BookingDate.HasValue && string.IsNullOrEmpty(Model.QuickFilter)) || (Model.Status.HasValue && string.IsNullOrEmpty(Model.QuickFilter)) || !string.IsNullOrWhiteSpace(Model.CustomerSearch);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0 fw-bold">Manage Bookings</h1>
        <p class="text-muted small mb-0">Review player reservations, check-ins, and court schedules</p>
    </div>
    <div class="d-none d-sm-block">
        <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ── KPI Quick Glance Bar (Mobile & Tablet friendly) ────────────────────────── -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <a asp-page="Index" asp-route-QuickFilter="pending" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 @(Model.PendingCount > 0 ? "bg-warning-subtle border border-warning" : "bg-light")">
                <div class="card-body p-3 text-center">
                    <span class="text-uppercase small fw-bold d-block text-muted" style="font-size:0.75rem;">
                        <i class="bi bi-hourglass-split text-warning me-1"></i>Pending Review
                    </span>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.PendingCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-page="Index" asp-route-QuickFilter="today" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body p-3 text-center">
                    <span class="text-uppercase small fw-bold d-block text-muted" style="font-size:0.75rem;">
                        <i class="bi bi-calendar-event text-primary me-1"></i>Today's Bookings
                    </span>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.TodayCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-page="Index" asp-route-QuickFilter="confirmed" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body p-3 text-center">
                    <span class="text-uppercase small fw-bold d-block text-muted" style="font-size:0.75rem;">
                        <i class="bi bi-check-circle text-success me-1"></i>Confirmed Today
                    </span>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.ConfirmedTodayCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 bg-light">
            <div class="card-body p-3 text-center">
                <span class="text-uppercase small fw-bold d-block text-muted" style="font-size:0.75rem;">
                    <i class="bi bi-list-check text-secondary me-1"></i>Showing Total
                </span>
                <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalMatchingCount</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Quick Horizontal Filter Chips (Swipeable / Scrollable on Mobile) ─────── -->
<div class="d-flex gap-2 overflow-x-auto pb-2 mb-3 align-items-center" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
    <a asp-page="Index" class="btn btn-sm rounded-pill px-3 fw-semibold @(string.IsNullOrEmpty(Model.QuickFilter) && !hasCustomFilters ? "btn-dark text-white" : "btn-outline-secondary")">
        All Bookings
    </a>
    <a asp-page="Index" asp-route-QuickFilter="pending" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.QuickFilter == "pending" ? "btn-warning text-dark" : "btn-outline-warning text-dark")">
        ⚡ Pending @if (Model.PendingCount > 0) { <span class="badge bg-danger rounded-pill ms-1">@Model.PendingCount</span> }
    </a>
    <a asp-page="Index" asp-route-QuickFilter="today" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.QuickFilter == "today" ? "btn-primary" : "btn-outline-primary")">
        📅 Today
    </a>
    <a asp-page="Index" asp-route-QuickFilter="tomorrow" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.QuickFilter == "tomorrow" ? "btn-primary" : "btn-outline-primary")">
        Tomorrow
    </a>
    <a asp-page="Index" asp-route-QuickFilter="confirmed" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.QuickFilter == "confirmed" ? "btn-success" : "btn-outline-success")">
        ✓ Confirmed
    </a>
    <button type="button" class="btn btn-sm rounded-pill px-3 fw-semibold ms-auto @(hasCustomFilters ? "btn-info text-dark" : "btn-outline-secondary")"
            data-bs-toggle="collapse" data-bs-target="#advancedFiltersCollapse" aria-expanded="@(hasCustomFilters ? "true" : "false")">
        <i class="bi bi-funnel me-1"></i>Filter @(hasCustomFilters ? "• Active" : "")
    </button>
</div>

<!-- ── Instant Search Bar & Collapsible Advanced Filters ───────────────────────── -->
<div class="card border rounded-3 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" id="bookingSearchForm">
            <!-- Search bar with 1-tap clear -->
            <div class="input-group mb-2">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input asp-for="CustomerSearch" type="search" class="form-control border-start-0 border-end-0"
                       placeholder="Search name, phone, email, or reference..." />
                @if (!string.IsNullOrWhiteSpace(Model.CustomerSearch))
                {
                    <a asp-page="Index" class="btn btn-outline-secondary border-start-0" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary px-3 fw-semibold">Search</button>
            </div>

            <!-- Advanced Filter Accordion/Collapse -->
            <div class="collapse @(hasCustomFilters ? "show" : "")" id="advancedFiltersCollapse">
                <div class="pt-3 border-top mt-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-sm-6 col-md-3">
                            <label asp-for="BookingDate" class="form-label small fw-semibold text-muted">Booking Date</label>
                            <input asp-for="BookingDate" type="date" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <label asp-for="CourtId" class="form-label small fw-semibold text-muted">Court</label>
                            <select asp-for="CourtId" class="form-select form-select-sm">
                                <option value="">All Courts</option>
                                @foreach (var court in Model.Courts)
                                {
                                    <option value="@court.Id">@court.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <label asp-for="Status" class="form-label small fw-semibold text-muted">Status</label>
                            <select asp-for="Status" class="form-select form-select-sm">
                                <option value="">All Statuses</option>
                                @foreach (var status in Enum.GetValues<PickleBallBooking.Models.BookingStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-dark btn-sm flex-grow-1 fw-semibold">Apply Filters</button>
                            <a asp-page="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Bookings.Count == 0)
{
    <div class="text-center py-5 bg-light rounded-3 border">
        <i class="bi bi-calendar-x text-muted display-4 d-block mb-3"></i>
        <h5 class="fw-bold text-dark">No bookings found</h5>
        <p class="text-muted small mb-3">Try adjusting your filters or search term to see more bookings.</p>
        <a asp-page="Index" class="btn btn-outline-primary btn-sm px-3">Clear Filters</a>
    </div>
}
else
{
    <!-- ── MOBILE & TABLET CARDS VIEW (< 992px) ─────────────────────────────────── -->
    <div class="d-block d-lg-none">
        @foreach (var booking in Model.Bookings)
        {
            var statusBadgeClass = booking.BookingStatus switch
            {
                PickleBallBooking.Models.BookingStatus.Pending => "bg-warning text-dark",
                PickleBallBooking.Models.BookingStatus.Confirmed => "bg-success text-white",
                PickleBallBooking.Models.BookingStatus.Cancelled => "bg-danger text-white",
                PickleBallBooking.Models.BookingStatus.Completed => "bg-secondary text-white",
                _ => "bg-light text-dark"
            };

            <div class="card border rounded-3 shadow-sm mb-3">
                <!-- Header: Ref + Status + Price -->
                <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @statusBadgeClass fw-semibold px-2 py-1">@booking.BookingStatus</span>
                        <button type="button" class="btn btn-link p-0 text-decoration-none font-monospace fw-bold copy-ref-btn text-dark"
                                data-ref="@booking.BookingReference" title="Tap to copy reference">
                            <span>@booking.BookingReference</span>
                            <i class="bi bi-clipboard small ms-1 text-muted"></i>
                        </button>
                    </div>
                    <div class="fw-bold text-success fs-6">
                        @booking.Price.ToString("C")
                    </div>
                </div>

                <!-- Body: Schedule Pill + Customer Info -->
                <div class="card-body pt-1 pb-2">
                    <!-- Court & Schedule Pill -->
                    <div class="p-2 mb-2 rounded-2 bg-light border d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>@(booking.Court?.Name ?? "Court")
                            </span>
                            <span class="text-muted mx-1">•</span>
                            <span class="small text-muted fw-semibold">
                                @booking.BookingDate.ToString("ddd, MMM d")
                            </span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size:0.8rem;">
                            <i class="bi bi-clock me-1"></i>@PickleBallBooking.Services.AppClock.To12HourRange(booking.StartTime, booking.EndTime)
                        </span>
                    </div>

                    <!-- Customer Row -->
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-person me-1 text-secondary"></i>@booking.CustomerName
                            </div>
                            @if (!string.IsNullOrWhiteSpace(booking.FacebookName))
                            {
                                <div class="text-muted" style="font-size:0.8rem;">
                                    <i class="bi bi-facebook text-primary me-1"></i>@booking.FacebookName
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                        {
                            <a href="tel:@booking.CustomerPhone" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold">
                                <i class="bi bi-telephone-fill me-1"></i>Call
                            </a>
                        }
                    </div>

                    <!-- Payment Method & Booked Time -->
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top text-muted" style="font-size:0.78rem;">
                        <div>
                            <i class="bi bi-credit-card me-1"></i>
                            <span>@(booking.SelectedPaymentMethod?.ToString() ?? "Payment")</span>
                        </div>
                        <div>
                            <i class="bi bi-calendar-check me-1"></i>Booked @booking.CreatedAt.ToString("MMM d, h:mm tt")
                        </div>
                    </div>
                </div>

                <!-- Footer: Thumb-friendly Large Action Buttons -->
                <div class="card-footer bg-white border-top d-flex gap-2 p-2">
                    <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary flex-grow-1 py-2 fw-semibold">
                        <i class="bi bi-eye me-1"></i>Details
                    </a>

                    @if (booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Pending)
                    {
                        <form method="post" asp-page-handler="Confirm" asp-route-id="@booking.Id" class="flex-grow-1 m-0">
                            <button type="submit" class="btn btn-sm btn-success w-100 py-2 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Confirm
                            </button>
                        </form>
                    }

                    @if (booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                    {
                        <form method="post" asp-page-handler="Complete" asp-route-id="@booking.Id" class="flex-grow-1 m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 py-2 fw-semibold">
                                <i class="bi bi-check2-all me-1"></i>Complete
                            </button>
                        </form>
                    }

                    @if (booking.BookingStatus is PickleBallBooking.Models.BookingStatus.Pending or PickleBallBooking.Models.BookingStatus.Confirmed)
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@booking.Id" class="m-0"
                              data-pb-confirm="Cancel booking @booking.BookingReference for @booking.CustomerName? This will release the booked time slot(s) and cannot be undone."
                              data-pb-confirm-title="Cancel booking"
                              data-pb-confirm-ok="Cancel booking">
                            <button type="submit" class="btn btn-sm btn-outline-danger py-2 px-3" title="Cancel booking">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ── DESKTOP TABLE VIEW (≥ 992px) ─────────────────────────────────────────── -->
    <div class="d-none d-lg-block">
        <table class="pb-table">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Court</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th><span class="pb-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td data-label="Reference">
                            <button type="button" class="btn btn-link p-0 text-decoration-none font-monospace fw-bold copy-ref-btn text-dark"
                                    data-ref="@booking.BookingReference" title="Tap to copy reference">
                                <span>@booking.BookingReference</span>
                                <i class="bi bi-clipboard small ms-1 text-muted"></i>
                            </button>
                        </td>
                        <td data-label="Customer">
                            <div class="fw-semibold">@booking.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                            {
                                <div class="small text-muted">@booking.CustomerPhone</div>
                            }
                        </td>
                        <td data-label="Court">@booking.Court?.Name</td>
                        <td data-label="Date">@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                        <td data-label="Time">@PickleBallBooking.Services.AppClock.To12HourRange(booking.StartTime, booking.EndTime)</td>
                        <td data-label="Price" class="fw-bold text-success">@booking.Price.ToString("C")</td>
                        <td data-label="Status">
                            @switch (booking.BookingStatus)
                            {
                                case PickleBallBooking.Models.BookingStatus.Pending:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                                case PickleBallBooking.Models.BookingStatus.Confirmed:
                                    <span class="badge bg-success">Confirmed</span>
                                    break;
                                case PickleBallBooking.Models.BookingStatus.Cancelled:
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                                case PickleBallBooking.Models.BookingStatus.Completed:
                                    <span class="badge bg-secondary">Completed</span>
                                    break;
                            }
                        </td>
                        <td data-label="Created">@booking.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="pb-actions-cell">
                            <div class="pb-actions">
                                <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">View</a>
                                @if (booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Pending)
                                {
                                    <form method="post" asp-page-handler="Confirm" asp-route-id="@booking.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Confirm</button>
                                    </form>
                                }
                                @if (booking.BookingStatus is PickleBallBooking.Models.BookingStatus.Pending or PickleBallBooking.Models.BookingStatus.Confirmed)
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-id="@booking.Id"
                                          data-pb-confirm="Cancel booking @booking.BookingReference for @booking.CustomerName? This will release the booked time slot(s) and cannot be undone."
                                          data-pb-confirm-title="Cancel booking"
                                          data-pb-confirm-ok="Cancel booking">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                                @if (booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                                {
                                    <form method="post" asp-page-handler="Complete" asp-route-id="@booking.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Complete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            'use strict';
            // 1-Tap Copy Booking Reference to Clipboard
            document.querySelectorAll('.copy-ref-btn').forEach(btn => {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    const ref = this.dataset.ref;
                    if (!ref) return;

                    const originalHtml = this.innerHTML;
                    try {
                        await navigator.clipboard.writeText(ref);
                        this.innerHTML = '<span class="text-success"><i class="bi bi-check-lg me-1"></i>Copied!</span>';
                        setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                    } catch (err) {
                        const ta = document.createElement('textarea');
                        ta.value = ref;
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                        this.innerHTML = '<span class="text-success"><i class="bi bi-check-lg me-1"></i>Copied!</span>';
                        setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                    }
                });
            });
        })();
    </script>
}

