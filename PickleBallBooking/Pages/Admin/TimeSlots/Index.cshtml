@page "/Admin/TimeSlots"
@model PickleBallBooking.Pages.Admin.TimeSlots.IndexModel
@{
    ViewData["Title"] = "Manage Time Slots";
}

<h1>Manage Time Slots</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">Add Time Slot</a>
</p>

<table class="pb-table">
    <thead>
        <tr>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Status</th>
            <th><span class="pb-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var slot in Model.TimeSlots)
        {
            <tr>
                <td data-label="Start Time">@PickleBallBooking.Services.AppClock.To12Hour(slot.StartTime)</td>
                <td data-label="End Time">@PickleBallBooking.Services.AppClock.To12Hour(slot.EndTime)</td>
                <td data-label="Status">
                    @if (slot.Status == PickleBallBooking.Models.TimeSlotStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="pb-actions-cell">
                    <div class="pb-actions">
                        <a asp-page="Edit" asp-route-id="@slot.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@slot.Id">
                            @if (slot.Status == PickleBallBooking.Models.TimeSlotStatus.Active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            }
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@slot.Id"
                              data-pb-confirm="Delete time slot @PickleBallBooking.Services.AppClock.To12HourRange(slot.StartTime, slot.EndTime)? This cannot be undone."
                              data-pb-confirm-title="Delete time slot"
                              data-pb-confirm-ok="Delete">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

