@page "/Admin/Payments"
@model PickleBallBooking.Pages.Admin.Payments.IndexModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Payments</h1>
</div>

<!-- Search Bar -->
<div class="mb-3">
    <div class="input-group">
        <span class="input-group-text bg-white">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text"
               id="paymentSearch"
               class="form-control"
               placeholder="Search by Booking Reference or Customer Name…"
               value="@Model.SearchQuery"
               autocomplete="off" />
        <button class="btn btn-outline-secondary" type="button" id="clearSearch" title="Clear search">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div id="searchCount" class="form-text text-muted mt-1" style="display:none;"></div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-tabs mb-4">
    @{
        string[] filterLabels = { "All", "Pending", "Submitted", "Verified", "Rejected" };
        PaymentStatus?[] filterValues = { null, PaymentStatus.Pending, PaymentStatus.Submitted, PaymentStatus.Verified, PaymentStatus.Rejected };
    }
    @for (int i = 0; i < filterLabels.Length; i++)
    {
        var label  = filterLabels[i];
        var value  = filterValues[i];
        var active = Model.StatusFilter == value ? "active" : "";
        <li class="nav-item">
            <a class="nav-link @active"
               asp-page="Index"
               asp-route-status="@value">@label</a>
        </li>
    }
</ul>

@if (!Model.Payments.Any())
{
    <div class="alert alert-secondary text-center py-4">
        <i class="bi bi-inbox display-5 d-block mb-2"></i>
        No payments found@(Model.StatusFilter.HasValue ? $" with status &#8220;{Model.StatusFilter}&#8221;" : "").
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="paymentsTable">
            <thead class="table-light">
                <tr>
                    <th>Booking Ref</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr class="payment-row">
                        <td class="font-monospace small ref-cell">@p.BookingReference</td>
                        <td class="customer-cell">@p.CustomerName</td>
                        <td>@p.Amount.ToString("C2")</td>
                        <td><span class="badge bg-primary">@p.Method</span></td>
                        <td>
                            @{
                                var (cls, lbl) = p.Status switch
                                {
                                    PaymentStatus.Pending   => ("bg-secondary", "Pending"),
                                    PaymentStatus.Submitted => ("bg-warning text-dark", "Submitted"),
                                    PaymentStatus.Verified  => ("bg-success", "Verified"),
                                    PaymentStatus.Rejected  => ("bg-danger", "Rejected"),
                                    PaymentStatus.Cancelled => ("bg-light text-dark border", "Cancelled"),
                                    _ => ("bg-secondary", p.Status.ToString())
                                };
                            }
                            <span class="badge @cls">@lbl</span>
                        </td>
                        <td class="small text-muted">
                            @(p.SubmittedAt.HasValue ? p.SubmittedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt") : "—")
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div id="noResults" class="alert alert-secondary text-center py-4" style="display:none;">
        <i class="bi bi-search display-5 d-block mb-2"></i>
        No payments match your search.
    </div>
}

@section Scripts {
    <script>
    (function () {
        const searchInput = document.getElementById('paymentSearch');
        const clearBtn    = document.getElementById('clearSearch');
        const countEl     = document.getElementById('searchCount');
        const noResults   = document.getElementById('noResults');
        const rows        = document.querySelectorAll('.payment-row');

        if (!searchInput || rows.length === 0) return;

        function filterRows() {
            const q = searchInput.value.trim().toLowerCase();
            let visible = 0;

            rows.forEach(row => {
                const ref      = row.querySelector('.ref-cell')?.textContent.toLowerCase() ?? '';
                const customer = row.querySelector('.customer-cell')?.textContent.toLowerCase() ?? '';
                const match    = !q || ref.includes(q) || customer.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });

            // Show count hint when searching
            if (q) {
                countEl.textContent = `${visible} result${visible !== 1 ? 's' : ''} found`;
                countEl.style.display = 'block';
            } else {
                countEl.style.display = 'none';
            }

            // Show "no results" message
            if (noResults) {
                noResults.style.display = (q && visible === 0) ? 'block' : 'none';
            }

            clearBtn.style.display = q ? 'flex' : 'none';
        }

        searchInput.addEventListener('input', filterRows);
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            filterRows();
            searchInput.focus();
        });

        // Run on load if there's a pre-filled search value
        filterRows();
    })();
    </script>
}
