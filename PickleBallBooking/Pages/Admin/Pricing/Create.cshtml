@page "/Admin/Pricing/Create"
@model PickleBallBooking.Pages.Admin.Pricing.CreateModel
@{
    ViewData["Title"] = "Add Pricing";
}

<h1>Add Pricing</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Pricing.DayType" class="form-label"></label>
        <select asp-for="Pricing.DayType" asp-items="Html.GetEnumSelectList<PickleBallBooking.Models.DayType>()" class="form-select"></select>
        <span asp-validation-for="Pricing.DayType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Pricing.StartTime" class="form-label"></label>
        <input asp-for="Pricing.StartTime" type="time" class="form-control" />
        <span asp-validation-for="Pricing.StartTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Pricing.EndTime" class="form-label"></label>
        <input asp-for="Pricing.EndTime" type="time" class="form-control" />
        <span asp-validation-for="Pricing.EndTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Pricing.Price" class="form-label"></label>
        <input asp-for="Pricing.Price" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Pricing.Price" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
