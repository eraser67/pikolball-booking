@page "/Admin/Pricing"
@model PickleBallBooking.Pages.Admin.Pricing.IndexModel
@{
    ViewData["Title"] = "Manage Pricing";
}

<h1>Manage Pricing</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">Add Pricing</a>
</p>

<table class="pb-table">
    <thead>
        <tr>
            <th>Day Type</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Price</th>
            <th>Status</th>
            <th><span class="pb-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pricing in Model.Pricings)
        {
            <tr>
                <td data-label="Day Type">@pricing.DayType</td>
                <td data-label="Start Time">@PickleBallBooking.Services.AppClock.To12Hour(pricing.StartTime)</td>
                <td data-label="End Time">@PickleBallBooking.Services.AppClock.To12Hour(pricing.EndTime)</td>
                <td data-label="Price">@pricing.Price.ToString("C2")</td>
                <td data-label="Status">
                    @if (pricing.Status == PickleBallBooking.Models.PricingStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="pb-actions-cell">
                    <div class="pb-actions">
                        <a asp-page="Edit" asp-route-id="@pricing.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@pricing.Id">
                            @if (pricing.Status == PickleBallBooking.Models.PricingStatus.Active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            }
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@pricing.Id"
                              data-pb-confirm="Delete this pricing rule (@pricing.DayType @PickleBallBooking.Services.AppClock.To12HourRange(pricing.StartTime, pricing.EndTime))? This cannot be undone."
                              data-pb-confirm-title="Delete pricing rule"
                              data-pb-confirm-ok="Delete">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
