@page "/Admin/PaymentOptions/{id:int}/Edit"
@model PickleBallBooking.Pages.Admin.PaymentOptions.EditModel
@{
    ViewData["Title"] = $"Edit — {Model.Input.Label}";
}

<div class="mb-4">
    <a asp-page="Index" class="btn btn-link ps-0 text-muted">
        <i class="bi bi-arrow-left me-1"></i>Back to Payment Methods
    </a>
    <h1 class="h3 mb-0 mt-2"><i class="bi bi-pencil me-2 text-primary"></i>Edit Payment Method</h1>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Input.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Label" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Label" class="form-control" />
                        <span asp-validation-for="Input.Label" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AccountName" class="form-label fw-semibold"></label>
                        <input asp-for="Input.AccountName" class="form-control" />
                        <span asp-validation-for="Input.AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AccountNumber" class="form-label fw-semibold"></label>
                        <input asp-for="Input.AccountNumber" class="form-control"
                               placeholder="e.g. 09xxxxxxxxx or account number" />
                        <span asp-validation-for="Input.AccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Instructions" class="form-label fw-semibold"></label>
                        <textarea asp-for="Input.Instructions" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Input.Instructions" class="text-danger small"></span>
                    </div>

                    <!-- QR Code -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">QR Code</label>
                        @if (!string.IsNullOrEmpty(Model.CurrentQRCodeUrl))
                        {
                            <div class="mb-2 d-flex align-items-start gap-3">
                                <img src="@Model.CurrentQRCodeUrl"
                                     alt="Current QR"
                                     class="rounded border"
                                     style="max-width:120px;max-height:120px;object-fit:contain;" />
                                <div>
                                    <p class="text-muted small mb-2">Current QR code</p>
                                    <div class="form-check">
                                        <input asp-for="Input.RemoveQRCode" class="form-check-input" type="checkbox" id="removeQR" />
                                        <label class="form-check-label text-danger small" for="removeQR">
                                            Remove QR code
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                        <label asp-for="Input.QRCodeImage" class="form-label small text-muted">
                            @(string.IsNullOrEmpty(Model.CurrentQRCodeUrl) ? "Upload QR Code" : "Replace with new QR code")
                        </label>
                        <input asp-for="Input.QRCodeImage" class="form-control" type="file"
                               accept="image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="Input.QRCodeImage" class="text-danger small"></span>
                        <div class="form-text">Max 1 MB. JPEG, PNG, or WEBP.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DisplayOrder" class="form-label fw-semibold"></label>
                        <input asp-for="Input.DisplayOrder" class="form-control" type="number" min="0" max="999"
                               style="max-width:120px" />
                        <div class="form-text">Lower = shown first.</div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.IsActive" class="form-check-label fw-semibold">
                                Active (visible to customers during booking)
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
