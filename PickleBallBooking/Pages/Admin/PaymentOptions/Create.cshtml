@page "/Admin/PaymentOptions/Create"
@model PickleBallBooking.Pages.Admin.PaymentOptions.CreateModel
@{
    ViewData["Title"] = "Add Payment Method";
}

<div class="mb-4">
    <a asp-page="Index" class="btn btn-link ps-0 text-muted">
        <i class="bi bi-arrow-left me-1"></i>Back to Payment Methods
    </a>
    <h1 class="h3 mb-0 mt-2"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Payment Method</h1>
    <p class="text-muted small mb-0">Add a new payment option that customers can choose during booking.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Label" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Label" class="form-control"
                               placeholder="e.g. GCash, Maya, BDO Bank QR, Palawan Pay" />
                        <span asp-validation-for="Input.Label" class="text-danger small"></span>
                        <div class="form-text">This is what the customer will see on the booking form.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AccountName" class="form-label fw-semibold"></label>
                        <input asp-for="Input.AccountName" class="form-control"
                               placeholder="e.g. Juan Dela Cruz" />
                        <span asp-validation-for="Input.AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.AccountNumber" class="form-label fw-semibold"></label>
                        <input asp-for="Input.AccountNumber" class="form-control"
                               placeholder="e.g. 09xxxxxxxxx or account number" />
                        <span asp-validation-for="Input.AccountNumber" class="text-danger small"></span>
                        <div class="form-text">Optional — shown to customer if no QR code is uploaded.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Instructions" class="form-label fw-semibold"></label>
                        <textarea asp-for="Input.Instructions" class="form-control" rows="3"
                                  placeholder="e.g. Send payment then screenshot and upload proof below."></textarea>
                        <span asp-validation-for="Input.Instructions" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.QRCodeImage" class="form-label fw-semibold"></label>
                        <input asp-for="Input.QRCodeImage" class="form-control" type="file"
                               accept="image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="Input.QRCodeImage" class="text-danger small"></span>
                        <div class="form-text">Optional but recommended. Max 1 MB. JPEG, PNG, or WEBP.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.DisplayOrder" class="form-label fw-semibold"></label>
                        <input asp-for="Input.DisplayOrder" class="form-control" type="number" min="0" max="999"
                               style="max-width:120px" />
                        <div class="form-text">Lower number = shown first to customers. (0 = first)</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add Payment Method
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
