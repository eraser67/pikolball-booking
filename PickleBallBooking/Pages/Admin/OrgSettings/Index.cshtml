@page "/Admin/OrgSettings"
@model PickleBallBooking.Pages.Admin.OrgSettings.IndexModel
@{
    ViewData["Title"] = "Organization Settings";
}

<h1>Organization Settings</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" enctype="multipart/form-data" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" id="settingsErrorSummary"></div>

    <!-- ── GENERAL ─────────────────────────────────────────────── -->
    <h5 class="mb-3">General</h5>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label fw-semibold"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Subdomain</label>
        <input class="form-control" value="@Model.Slug" readonly disabled />
        <div class="form-text">Cannot be changed here.</div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Status</label>
        <div>
            @if (Model.Status == PickleBallBooking.Models.OrganizationStatus.Active)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
            <span class="form-text d-inline ms-2">Controlled by the platform administrator.</span>
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold">Created</label>
        <div>@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
    </div>

    <!-- ── BRAND LOGO ───────────────────────────────────────────── -->
    <h5 class="mb-1">Brand Logo</h5>
    <p class="text-muted small mb-3">Upload your custom venue logo to appear on the navbar, footer, and booking page.</p>

    <div class="card mb-4 p-3 bg-light border">
        <div class="d-flex align-items-center gap-3">
            <div class="border rounded p-2 bg-white d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
                {
                    <img src="@Model.CurrentLogoUrl" alt="Brand Logo" class="img-fluid" style="max-height: 64px; max-width: 64px; object-fit: contain;" />
                }
                else
                {
                    <img src="~/images/pickleball.png" alt="Default Logo" class="img-fluid" style="max-height: 64px; max-width: 64px; object-fit: contain;" />
                }
            </div>
            <div>
                <div class="fw-semibold">
                    @(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "Default Logo Active" : "Custom Logo Active")
                </div>
                <div class="text-muted small">
                    @(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "Using default Pikolball logo." : "Using your uploaded organization logo.")
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
                {
                    <div class="form-check mt-2">
                        <input asp-for="Input.RemoveLogo" class="form-check-input" type="checkbox" id="removeLogoCheck" />
                        <label class="form-check-label text-danger small fw-semibold" for="removeLogoCheck">
                            <i class="bi bi-trash me-1"></i>Revert to default logo
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Input.LogoImage" class="form-label fw-semibold">Upload New Logo</label>
            <input asp-for="Input.LogoImage" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
            <span asp-validation-for="Input.LogoImage" class="text-danger"></span>
            <div class="form-text">Supported formats: PNG, JPEG, WebP. Max 2 MB.</div>
        </div>
    </div>

    <hr class="my-4" />

    <!-- ── LOCATION ────────────────────────────────────────────── -->
    <h5 class="mb-1">Location &amp; Map</h5>
    <p class="text-muted small mb-3">Shown in the <strong>Find Us</strong> section on your public homepage.</p>

    <div class="mb-3">
        <label asp-for="Input.Address" class="form-label fw-semibold"></label>
        <input asp-for="Input.Address" class="form-control"
               placeholder="e.g. 123 Main St, Cebu City, Philippines" />
        <span asp-validation-for="Input.Address" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Input.Latitude" class="form-label fw-semibold"></label>
            <input asp-for="Input.Latitude" class="form-control" type="number"
                   step="0.000001" placeholder="e.g. 10.671029" />
            <span asp-validation-for="Input.Latitude" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Input.Longitude" class="form-label fw-semibold"></label>
            <input asp-for="Input.Longitude" class="form-control" type="number"
                   step="0.000001" placeholder="e.g. 124.020279" />
            <span asp-validation-for="Input.Longitude" class="text-danger"></span>
        </div>
    </div>
    <div class="form-text mb-4">
        <i class="bi bi-lightbulb me-1"></i>
        Get coordinates from <a href="https://www.google.com/maps" target="_blank" rel="noopener">Google Maps</a>:
        right-click your venue → click the coordinates at the top to copy them.
    </div>

    <hr class="my-4" />

    <!-- ── PAYMENT SETTINGS ────────────────────────────────────── -->
    <h5 class="mb-1">GCash Payment Settings</h5>
    <p class="text-muted small mb-3">
        Customers will see these details on the payment page after booking.
        Leave blank to disable the payment prompt.
    </p>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Input.GCashEnabled" class="form-check-input" type="checkbox" role="switch" id="gcashEnabled" />
            <label class="form-check-label fw-semibold" for="gcashEnabled">
                @Html.DisplayNameFor(m => m.Input.GCashEnabled)
            </label>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.AccountName" class="form-label fw-semibold"></label>
        <input asp-for="Input.AccountName" class="form-control"
               placeholder="e.g. Juan Dela Cruz" />
        <span asp-validation-for="Input.AccountName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.AccountNumber" class="form-label fw-semibold"></label>
        <input asp-for="Input.AccountNumber" class="form-control"
               placeholder="e.g. 09171234567" />
        <span asp-validation-for="Input.AccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Instructions" class="form-label fw-semibold"></label>
        <textarea asp-for="Input.Instructions" class="form-control" rows="3"
                  placeholder="e.g. Please include your booking reference in the GCash note."></textarea>
        <span asp-validation-for="Input.Instructions" class="text-danger"></span>
    </div>

    <!-- QR Code Upload -->
    <div class="mb-4">
        <label asp-for="Input.QRCodeImage" class="form-label fw-semibold"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentQRCodeUrl))
        {
            <div class="mb-2">
                <img src="@Model.CurrentQRCodeUrl" alt="Current GCash QR Code"
                     style="max-width:160px;border-radius:8px;border:1px solid #dee2e6;" />
                <div class="text-muted small mt-1">Current QR code</div>
            </div>
        }
        <input asp-for="Input.QRCodeImage" type="file" class="form-control"
               accept="image/jpeg,image/png,image/webp" id="qrImageInput" />
        <div class="form-text">Max 3 MB (JPEG, PNG, WEBP). Leave blank to keep existing QR code.</div>
        <div id="qrSizeError" class="text-danger small mt-1" style="display:none;">
            File too large. Maximum allowed size is 3 MB.
        </div>
        <span asp-validation-for="Input.QRCodeImage" class="text-danger"></span>
    </div>

    <hr class="my-4" />

    <!-- ── NOTIFICATIONS ────────────────────────────────────── -->
    <h5 class="mb-1">Notifications</h5>
    <p class="text-muted small mb-3">
        Admin email for new bookings, payment submissions, and cancellations.
        Leave blank to disable organization notifications.
    </p>

    <div class="mb-4">
        <label asp-for="Input.NotificationEmail" class="form-label fw-semibold"></label>
        <input asp-for="Input.NotificationEmail" class="form-control" type="email"
               placeholder="e.g. admin@yourclub.com" />
        <div class="form-text">
            <i class="bi bi-bell me-1"></i>
            This address will receive alerts for new bookings, payment submissions, and cancellations.
        </div>
        <span asp-validation-for="Input.NotificationEmail" class="text-danger"></span>
    </div>

    <div class="d-flex align-items-center gap-3 mt-3">
        <button type="submit" class="btn btn-primary" id="saveSettingsBtn">
            <i class="bi bi-floppy me-1"></i>Save Settings
        </button>
        <a asp-page="/Admin/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<!-- ── SUBSCRIPTION (read-only) ──────────────────────────────────── -->
<div class="col-lg-7 mt-4">
    <hr />
    <h5 class="mb-3">Subscription</h5>

    @if (Model.CurrentSubscription is not null)
    {
        var sub  = Model.CurrentSubscription;
        var plan = sub.Plan;

        var (badgeClass, icon) = sub.Status switch {
            PickleBallBooking.Models.SubscriptionStatus.Trial     => ("bg-info-subtle text-info border border-info-subtle", "bi-hourglass-split"),
            PickleBallBooking.Models.SubscriptionStatus.Active    => ("bg-success-subtle text-success border border-success-subtle", "bi-check-circle"),
            PickleBallBooking.Models.SubscriptionStatus.Expired   => ("bg-warning-subtle text-warning border border-warning-subtle", "bi-exclamation-circle"),
            PickleBallBooking.Models.SubscriptionStatus.Suspended => ("bg-danger-subtle text-danger border border-danger-subtle", "bi-pause-circle"),
            _                                                      => ("bg-secondary-subtle text-secondary border border-secondary-subtle", "bi-x-circle")
        };

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="fw-semibold fs-5">@(plan?.Name ?? "—")</div>
                        @if (plan is not null)
                        {
                            <div class="text-muted small">₱@plan.Price.ToString("N2") / @plan.BillingPeriod.ToString().ToLower()</div>
                        }
                    </div>
                    <span class="badge @badgeClass">
                        <i class="bi @icon me-1"></i>@sub.Status
                    </span>
                </div>

                <dl class="row small mb-0">
                    @if (sub.StartDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Start Date</dt>
                        <dd class="col-sm-8">@sub.StartDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                    @if (sub.EndDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">End Date</dt>
                        <dd class="col-sm-8">@sub.EndDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                    @if (sub.TrialEndDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Trial Ends</dt>
                        <dd class="col-sm-8">@sub.TrialEndDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                </dl>

                @if (!string.IsNullOrEmpty(plan?.Features))
                {
                    <ul class="list-unstyled small mt-3 mb-0">
                        @foreach (var feat in plan.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <li><i class="bi bi-check-circle text-success me-2"></i>@feat</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-transparent small text-muted">
                <i class="bi bi-info-circle me-1"></i>
                To upgrade or change your plan, please contact support.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                No subscription has been assigned to your organization yet.
                Please <strong>contact support</strong> to activate your plan.
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const MAX = 3 * 1024 * 1024;
            const input = document.getElementById('qrImageInput');
            const err   = document.getElementById('qrSizeError');
            if (!input) return;
            input.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > MAX) {
                    err.style.display = 'block';
                    this.value = '';
                } else {
                    err.style.display = 'none';
                }
            });
        })();
    </script>
}
