@page "/Admin/OrgSettings"
@model PickleBallBooking.Pages.Admin.OrgSettings.IndexModel
@{
    ViewData["Title"] = "Organization Settings";
}

<h1>Organization Settings</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" enctype="multipart/form-data" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" id="settingsErrorSummary"></div>

    <!-- ── GENERAL ─────────────────────────────────────────────── -->
    <h5 class="mb-3">General</h5>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label fw-semibold"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Subdomain</label>
        <input class="form-control" value="@Model.Slug" readonly disabled />
        <div class="form-text">Cannot be changed here.</div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Status</label>
        <div>
            @if (Model.Status == PickleBallBooking.Models.OrganizationStatus.Active)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
            <span class="form-text d-inline ms-2">Controlled by the platform administrator.</span>
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold">Created</label>
        <div>@PickleBallBooking.Services.AppClock.ToPhilippineTime(Model.CreatedAt).ToString("yyyy-MM-dd")</div>
    </div>

    <!-- ── BRAND LOGO ───────────────────────────────────────────── -->
    <h5 class="mb-1">Brand Logo</h5>
    <p class="text-muted small mb-3">Upload your custom venue logo to appear on the navbar, footer, and booking page.</p>

    <div class="card mb-4 p-3 bg-light border">
        <div class="d-flex align-items-center gap-3">
            <div class="border rounded p-2 bg-white d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
                {
                    <img src="@Model.CurrentLogoUrl" alt="Brand Logo" class="img-fluid" style="max-height: 64px; max-width: 64px; object-fit: contain;" />
                }
                else
                {
                    <img src="~/images/pickleball.png" alt="Default Logo" class="img-fluid" style="max-height: 64px; max-width: 64px; object-fit: contain;" />
                }
            </div>
            <div>
                <div class="fw-semibold">
                    @(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "Default Logo Active" : "Custom Logo Active")
                </div>
                <div class="text-muted small">
                    @(string.IsNullOrEmpty(Model.CurrentLogoUrl) ? "Using default Pikolball logo." : "Using your uploaded organization logo.")
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
                {
                    <div class="form-check mt-2">
                        <input asp-for="Input.RemoveLogo" class="form-check-input" type="checkbox" id="removeLogoCheck" />
                        <label class="form-check-label text-danger small fw-semibold" for="removeLogoCheck">
                            <i class="bi bi-trash me-1"></i>Revert to default logo
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Input.LogoImage" class="form-label fw-semibold">Upload New Logo</label>
            <input asp-for="Input.LogoImage" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
            <span asp-validation-for="Input.LogoImage" class="text-danger"></span>
            <div class="form-text">Supported formats: PNG, JPEG, WebP. Max 3 MB.</div>
        </div>
    </div>

    <!-- ── HERO IMAGE ───────────────────────────────────────────── -->
    <h5 class="mb-1">Hero Image (Landing Page)</h5>
    <p class="text-muted small mb-3">Upload a custom action or venue image to appear in the hero section of your public homepage.</p>

    <div class="card mb-4 p-3 bg-light border">
        <div class="d-flex align-items-center gap-3">
            <div class="border rounded p-2 bg-white d-flex align-items-center justify-content-center" style="width: 120px; height: 80px;">
                @if (!string.IsNullOrEmpty(Model.CurrentHeroImageUrl))
                {
                    <img src="@Model.CurrentHeroImageUrl" alt="Hero Image" class="img-fluid rounded" style="max-height: 64px; max-width: 100px; object-fit: cover;" />
                }
                else
                {
                    <img src="~/images/hero-player.png" alt="Default Hero Image" class="img-fluid rounded" style="max-height: 64px; max-width: 100px; object-fit: contain;" />
                }
            </div>
            <div>
                <div class="fw-semibold">
                    @(string.IsNullOrEmpty(Model.CurrentHeroImageUrl) ? "Default Hero Image Active" : "Custom Hero Image Active")
                </div>
                <div class="text-muted small">
                    @(string.IsNullOrEmpty(Model.CurrentHeroImageUrl) ? "Using default Pikolball player illustration." : "Using your uploaded custom hero artwork.")
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentHeroImageUrl))
                {
                    <div class="form-check mt-2">
                        <input asp-for="Input.RemoveHeroImage" class="form-check-input" type="checkbox" id="removeHeroImageCheck" />
                        <label class="form-check-label text-danger small fw-semibold" for="removeHeroImageCheck">
                            <i class="bi bi-trash me-1"></i>Revert to default hero image
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Input.HeroImage" class="form-label fw-semibold">Upload New Hero Image</label>
            <input asp-for="Input.HeroImage" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
            <span asp-validation-for="Input.HeroImage" class="text-danger"></span>
            <div class="form-text">Supported formats: PNG, JPEG, WebP. Max 3 MB.</div>
        </div>
    </div>

    <hr class="my-4" />

    <!-- ── BRANDING & HOMEPAGE ──────────────────────────────── -->
    <h5 class="mb-1"><i class="bi bi-palette me-2 text-success"></i>Branding &amp; Custom Homepage</h5>
    <p class="text-muted small mb-3">Personalise how your venue's homepage looks to players.</p>

    <div class="mb-3">
        <label asp-for="Input.Tagline" class="form-label fw-semibold"></label>
        <input asp-for="Input.Tagline" class="form-control"
               placeholder='e.g. "Manila''s Premier Pickleball Venue"' maxlength="200" />
        <div class="form-text">Short line shown in the hero banner below your venue name.</div>
        <span asp-validation-for="Input.Tagline" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.AboutText" class="form-label fw-semibold"></label>
        <textarea asp-for="Input.AboutText" class="form-control" rows="3" maxlength="1000"
                  placeholder="A short welcome paragraph about your venue…"></textarea>
        <div class="form-text">Shown as an About section on your homepage.</div>
        <span asp-validation-for="Input.AboutText" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.PrimaryColorHex" class="form-label fw-semibold"></label>
        <div class="input-group" style="max-width:240px;">
            <input asp-for="Input.PrimaryColorHex" class="form-control" type="text"
                   id="primaryColorHex" placeholder="#16a34a" maxlength="7" />
            <span class="input-group-text p-1">
                <input type="color" id="primaryColorPicker" value="#16a34a"
                       style="width:36px;height:32px;border:none;padding:2px;cursor:pointer;"
                       title="Pick a colour" />
            </span>
        </div>
        <div class="form-text">Overrides the default green theme for your venue. Enter a 6-digit hex, e.g. <code>#16a34a</code>. Leave blank to use the default.</div>
        <span asp-validation-for="Input.PrimaryColorHex" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Social Media Links</label>
        <div class="input-group mb-2">
            <span class="input-group-text"><i class="bi bi-facebook"></i></span>
            <input asp-for="Input.FacebookUrl" class="form-control" placeholder="https://facebook.com/yourpage" />
        </div>
        <span asp-validation-for="Input.FacebookUrl" class="text-danger small d-block mb-1"></span>
        <div class="input-group mb-2">
            <span class="input-group-text"><i class="bi bi-instagram"></i></span>
            <input asp-for="Input.InstagramUrl" class="form-control" placeholder="https://instagram.com/yourprofile" />
        </div>
        <span asp-validation-for="Input.InstagramUrl" class="text-danger small d-block mb-1"></span>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-twitter-x"></i></span>
            <input asp-for="Input.TwitterUrl" class="form-control" placeholder="https://x.com/yourprofile" />
        </div>
        <span asp-validation-for="Input.TwitterUrl" class="text-danger small d-block"></span>
    </div>

    <div class="mb-3 form-check form-switch">
        <input asp-for="Input.ShowActivitiesOnHome" class="form-check-input" role="switch" id="showActivitiesSwitch" />
        <label class="form-check-label fw-semibold" for="showActivitiesSwitch">
            Show upcoming Activities on homepage
        </label>
        <div class="form-text">When enabled, players will see upcoming open activities directly on your landing page.</div>
    </div>

    <hr class="my-4" />

    <!-- ── SECTION VISIBILITY ────────────────────────────────── -->
    <h5 class="mb-1"><i class="bi bi-layout-text-sidebar-reverse me-2 text-success"></i>Section Visibility</h5>
    <p class="text-muted small mb-3">Toggle which sections appear on your public homepage.</p>

    <div class="row g-2 mb-3">
        <div class="col-sm-6">
            <div class="form-check form-switch">
                <input asp-for="Input.ShowHowItWorksSection" class="form-check-input" role="switch" id="showHowItWorks" />
                <label class="form-check-label" for="showHowItWorks">How It Works</label>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-check form-switch">
                <input asp-for="Input.ShowWhyUsSection" class="form-check-input" role="switch" id="showWhyUs" />
                <label class="form-check-label" for="showWhyUs">Why Choose Us</label>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-check form-switch">
                <input asp-for="Input.ShowFaqSection" class="form-check-input" role="switch" id="showFaq" />
                <label class="form-check-label" for="showFaq">FAQ</label>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-check form-switch">
                <input asp-for="Input.ShowLocationSection" class="form-check-input" role="switch" id="showLocation" />
                <label class="form-check-label" for="showLocation">Location &amp; Map</label>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <!-- ── AMENITIES ─────────────────────────────────────────── -->
    <h5 class="mb-1"><i class="bi bi-stars me-2 text-success"></i>Venue Amenities</h5>
    <p class="text-muted small mb-2">Tick what your venue offers. These appear as an icon grid on your homepage.</p>

    <div class="mb-2 form-check form-switch">
        <input asp-for="Input.ShowAmenitiesSection" class="form-check-input" role="switch" id="showAmenitiesSwitch" />
        <label class="form-check-label fw-semibold" for="showAmenitiesSwitch">Show Amenities section on homepage</label>
    </div>

    @foreach (var group in PickleBallBooking.Models.VenueAmenities.Grouped)
    {
        <p class="text-muted small mb-1 mt-2 fw-semibold">@group.Key</p>
        <div class="row g-1 mb-1">
            @foreach (var amenity in group)
            {
                var isChecked = Model.Input.SelectedAmenities.Contains(amenity.Key);
                <div class="col-6 col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="Input.SelectedAmenities" value="@amenity.Key"
                               id="am-@amenity.Key" @(isChecked ? "checked" : "") />
                        <label class="form-check-label small" for="am-@amenity.Key">
                            <i class="bi @amenity.Icon me-1"></i>@amenity.Label
                        </label>
                    </div>
                </div>
            }
        </div>
    }

    <hr class="my-4" />

    <!-- ── OPENING HOURS ─────────────────────────────────────── -->
    <h5 class="mb-1"><i class="bi bi-clock me-2 text-success"></i>Opening Hours</h5>
    <p class="text-muted small mb-3">Shown in the Find Us section and footer.</p>

    <div class="mb-3">
        <label asp-for="Input.OpeningHours" class="form-label fw-semibold"></label>
        <input asp-for="Input.OpeningHours" class="form-control"
               placeholder="e.g. Mon–Sun: 6:00 AM – 10:00 PM" maxlength="200" />
        <div class="form-text">Leave blank to hide operating hours.</div>
        <span asp-validation-for="Input.OpeningHours" class="text-danger small"></span>
    </div>

    <hr class="my-4" />

    <!-- ── ANNOUNCEMENT BANNER ───────────────────────────────── -->
    <h5 class="mb-1"><i class="bi bi-megaphone me-2 text-success"></i>Announcement Banner</h5>
    <p class="text-muted small mb-3">Shows a dismissible banner at the top of every page — great for promotions, maintenance notices, or special events.</p>

    <div class="mb-3">
        <label asp-for="Input.AnnouncementText" class="form-label fw-semibold"></label>
        <input asp-for="Input.AnnouncementText" class="form-control"
               placeholder="e.g. 🎉 Court 3 now open! Book now to celebrate." maxlength="300" />
        <span asp-validation-for="Input.AnnouncementText" class="text-danger small"></span>
    </div>

    <div class="mb-3 form-check form-switch">
        <input asp-for="Input.ShowAnnouncementBanner" class="form-check-input" role="switch" id="showBannerSwitch" />
        <label class="form-check-label fw-semibold" for="showBannerSwitch">Show banner to all visitors</label>
    </div>

    <hr class="my-4" />

    <!-- ── LOCATION ────────────────────────────────────────────── -->
    <h5 class="mb-1">Location &amp; Map</h5>
    <p class="text-muted small mb-3">Shown in the <strong>Find Us</strong> section on your public homepage.</p>

    <div class="mb-3">
        <label asp-for="Input.Address" class="form-label fw-semibold"></label>
        <input asp-for="Input.Address" class="form-control"
               placeholder="e.g. 123 Main St, Cebu City, Philippines" />
        <span asp-validation-for="Input.Address" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Input.Latitude" class="form-label fw-semibold"></label>
            <input asp-for="Input.Latitude" class="form-control" type="number"
                   step="0.000001" placeholder="e.g. 10.671029" />
            <span asp-validation-for="Input.Latitude" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Input.Longitude" class="form-label fw-semibold"></label>
            <input asp-for="Input.Longitude" class="form-control" type="number"
                   step="0.000001" placeholder="e.g. 124.020279" />
            <span asp-validation-for="Input.Longitude" class="text-danger"></span>
        </div>
    </div>
    <div class="form-text mb-4">
        <i class="bi bi-lightbulb me-1"></i>
        Get coordinates from <a href="https://www.google.com/maps" target="_blank" rel="noopener">Google Maps</a>:
        right-click your venue → click the coordinates at the top to copy them.
    </div>

    <hr class="my-4" />

    <!-- ── PAYMENT SETTINGS ────────────────────────────────────── -->
    <h5 class="mb-1">GCash Payment Settings</h5>
    <p class="text-muted small mb-3">
        Customers will see these details on the payment page after booking.
        Leave blank to disable the payment prompt.
    </p>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input asp-for="Input.GCashEnabled" class="form-check-input" type="checkbox" role="switch" id="gcashEnabled" />
            <label class="form-check-label fw-semibold" for="gcashEnabled">
                @Html.DisplayNameFor(m => m.Input.GCashEnabled)
            </label>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.AccountName" class="form-label fw-semibold"></label>
        <input asp-for="Input.AccountName" class="form-control"
               placeholder="e.g. Juan Dela Cruz" />
        <span asp-validation-for="Input.AccountName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.AccountNumber" class="form-label fw-semibold"></label>
        <input asp-for="Input.AccountNumber" class="form-control"
               placeholder="e.g. 09171234567" />
        <span asp-validation-for="Input.AccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Instructions" class="form-label fw-semibold"></label>
        <textarea asp-for="Input.Instructions" class="form-control" rows="3"
                  placeholder="e.g. Please include your booking reference in the GCash note."></textarea>
        <span asp-validation-for="Input.Instructions" class="text-danger"></span>
    </div>

    <!-- QR Code Upload -->
    <div class="mb-4">
        <label asp-for="Input.QRCodeImage" class="form-label fw-semibold"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentQRCodeUrl))
        {
            <div class="mb-2">
                <img src="@Model.CurrentQRCodeUrl" alt="Current GCash QR Code"
                     style="max-width:160px;border-radius:8px;border:1px solid #dee2e6;" />
                <div class="text-muted small mt-1">Current QR code</div>
            </div>
        }
        <input asp-for="Input.QRCodeImage" type="file" class="form-control"
               accept="image/jpeg,image/png,image/webp" id="qrImageInput" />
        <div class="form-text">Max 3 MB (JPEG, PNG, WEBP). Leave blank to keep existing QR code.</div>
        <div id="qrSizeError" class="text-danger small mt-1" style="display:none;">
            File too large. Maximum allowed size is 3 MB.
        </div>
        <span asp-validation-for="Input.QRCodeImage" class="text-danger"></span>
    </div>

    <hr class="my-4" />

    <!-- ── NOTIFICATIONS ────────────────────────────────────── -->
    <h5 class="mb-1">Notifications</h5>
    <p class="text-muted small mb-3">
        Admin email for new bookings, payment submissions, and cancellations.
        Leave blank to disable organization notifications.
    </p>

    <div class="mb-4">
        <label asp-for="Input.NotificationEmail" class="form-label fw-semibold"></label>
        <input asp-for="Input.NotificationEmail" class="form-control" type="email"
               placeholder="e.g. admin@yourclub.com" />
        <div class="form-text">
            <i class="bi bi-bell me-1"></i>
            This address will receive email alerts for new bookings, payment submissions, and cancellations.
        </div>
        <span asp-validation-for="Input.NotificationEmail" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.TelegramChatId" class="form-label fw-semibold">
            <i class="bi bi-telegram text-primary me-1"></i>Telegram Chat / Group ID (Instant Staff Alerts)
        </label>
        <input asp-for="Input.TelegramChatId" class="form-control" type="text"
               placeholder="e.g. -1001234567890 (group) or 123456789 (user)" />
        <div class="form-text">
            <i class="bi bi-info-circle me-1"></i>
            Get instant push notifications in your staff Telegram group or private chat for new bookings and GCash submissions.
            Leave blank to disable Telegram alerts. <em>(Add your bot to your group and invite <code>&#64;RawDataBot</code> or message <code>&#64;userinfobot</code> to find your Chat ID)</em>.
        </div>
        <span asp-validation-for="Input.TelegramChatId" class="text-danger"></span>
    </div>

    <div class="d-flex align-items-center gap-3 mt-3">
        <button type="submit" class="btn btn-primary" id="saveSettingsBtn">
            <i class="bi bi-floppy me-1"></i>Save Settings
        </button>
        <a asp-page="/Admin/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<!-- ── SUBSCRIPTION (read-only) ──────────────────────────────────── -->
<div class="col-lg-7 mt-4">
    <hr />
    <h5 class="mb-3">Subscription</h5>

    @if (Model.CurrentSubscription is not null)
    {
        var sub  = Model.CurrentSubscription;
        var plan = sub.Plan;

        var (badgeClass, icon) = sub.Status switch {
            PickleBallBooking.Models.SubscriptionStatus.Trial     => ("bg-info-subtle text-info border border-info-subtle", "bi-hourglass-split"),
            PickleBallBooking.Models.SubscriptionStatus.Active    => ("bg-success-subtle text-success border border-success-subtle", "bi-check-circle"),
            PickleBallBooking.Models.SubscriptionStatus.Expired   => ("bg-warning-subtle text-warning border border-warning-subtle", "bi-exclamation-circle"),
            PickleBallBooking.Models.SubscriptionStatus.Suspended => ("bg-danger-subtle text-danger border border-danger-subtle", "bi-pause-circle"),
            _                                                      => ("bg-secondary-subtle text-secondary border border-secondary-subtle", "bi-x-circle")
        };

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="fw-semibold fs-5">@(plan?.Name ?? "—")</div>
                        @if (plan is not null)
                        {
                            <div class="text-muted small">₱@plan.Price.ToString("N2") / @plan.BillingPeriod.ToString().ToLower()</div>
                        }
                    </div>
                    <span class="badge @badgeClass">
                        <i class="bi @icon me-1"></i>@sub.Status
                    </span>
                </div>

                <dl class="row small mb-0">
                    @if (sub.StartDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Start Date</dt>
                        <dd class="col-sm-8">@sub.StartDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                    @if (sub.EndDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">End Date</dt>
                        <dd class="col-sm-8">@sub.EndDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                    @if (sub.TrialEndDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Trial Ends</dt>
                        <dd class="col-sm-8">@sub.TrialEndDate.Value.ToString("MMMM d, yyyy")</dd>
                    }
                </dl>

                @if (!string.IsNullOrEmpty(plan?.Features))
                {
                    <ul class="list-unstyled small mt-3 mb-0">
                        @foreach (var feat in plan.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <li><i class="bi bi-check-circle text-success me-2"></i>@feat</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-transparent small text-muted">
                <i class="bi bi-info-circle me-1"></i>
                To upgrade or change your plan, please contact support.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                No subscription has been assigned to your organization yet.
                Please <strong>contact support</strong> to activate your plan.
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const MAX = 3 * 1024 * 1024;
            const input = document.getElementById('qrImageInput');
            const err   = document.getElementById('qrSizeError');
            if (!input) return;
            input.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > MAX) {
                    err.style.display = 'block';
                    this.value = '';
                } else {
                    err.style.display = 'none';
                }
            });
        })();

        // Sync color picker ↔ hex input
        (function () {
            const hexInput    = document.getElementById('primaryColorHex');
            const colorPicker = document.getElementById('primaryColorPicker');
            if (!hexInput || !colorPicker) return;

            // Initialise picker from existing value
            if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
                colorPicker.value = hexInput.value;
            }

            colorPicker.addEventListener('input', function () {
                hexInput.value = this.value;
            });
            hexInput.addEventListener('input', function () {
                if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
                    colorPicker.value = this.value;
                }
            });
        })();
    </script>
}
