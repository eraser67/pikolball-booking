@page
@model PickleBallBooking.Pages.Admin.Reports.AttendanceModel
@{
    ViewData["Title"] = $"Attendance & No-Show Report - {Model.Report.MonthName}";
    var currentYear = DateTime.UtcNow.Year;
    var currentMonth = DateTime.UtcNow.Month;
    var prevMonthDate = new DateTime(Model.Year, Model.Month, 1).AddMonths(-1);
    var nextMonthDate = new DateTime(Model.Year, Model.Month, 1).AddMonths(1);
}

<div class="container-fluid py-3 py-md-4 px-2 px-sm-3 px-md-4">

    <!-- ─── HEADER BAR ─── -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill small fw-semibold">
                    <i class="bi bi-buildings me-1"></i>@Model.Report.OrganizationName
                </span>
                <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                    Tenant ID: #@Model.Report.OrganizationId
                </span>
            </div>
            <h1 class="h3 fw-bold text-dark mt-1 mb-0 report-page-title">
                <i class="bi bi-person-check-fill text-primary me-2"></i>Attendance, Check-In &amp; No-Show Report
            </h1>
            <p class="text-muted small mb-0">Arrival tracking, QR scan compliance, customer reliability &amp; no-show audit for <strong>@Model.Report.MonthName</strong>.</p>
        </div>

        <!-- Export & Print Actions -->
        <div class="d-flex flex-wrap align-items-center gap-2 header-actions">
            <a asp-page-handler="ExportCsv" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
               class="btn btn-outline-success btn-sm fw-semibold shadow-xs d-inline-flex align-items-center gap-1 rounded-3">
                <i class="bi bi-file-earmark-spreadsheet fs-6"></i>
                <span>Export CSV</span>
            </a>
            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold shadow-xs d-inline-flex align-items-center gap-1 rounded-3" onclick="window.print()">
                <i class="bi bi-printer fs-6"></i>
                <span class="d-none d-sm-inline">Print Report</span>
            </button>
        </div>
    </div>

    <!-- ─── REPORT SELECTION TABS (4-CARD SEGMENTED SELECTOR) ─── -->
    <div class="report-tabs-wrapper mb-3 mb-md-4">
        <div class="row g-2 g-md-3">
            <!-- Tab 1: Monthly Revenue & Ledger -->
            <div class="col-6 col-xl-3">
                <a asp-page="./Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                   class="report-tab-card revenue-tab d-flex align-items-center p-2 p-sm-3 rounded-4 border text-decoration-none h-100">
                    <div class="tab-icon-box rounded-3 me-2 me-md-3 d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="bi bi-wallet2 fs-5 text-muted"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <span class="tab-title fw-bold text-dark d-block">Revenue &amp; Ledger</span>
                        <span class="tab-desc text-muted small d-none d-md-block text-truncate">Financial audit</span>
                    </div>
                </a>
            </div>

            <!-- Tab 2: Court Utilization & Peak Hours -->
            <div class="col-6 col-xl-3">
                <a asp-page="./Utilization" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                   class="report-tab-card utilization-tab d-flex align-items-center p-2 p-sm-3 rounded-4 border text-decoration-none h-100">
                    <div class="tab-icon-box rounded-3 me-2 me-md-3 d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="bi bi-fire fs-5 text-muted"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <span class="tab-title fw-bold text-dark d-block">Utilization &amp; Peak</span>
                        <span class="tab-desc text-muted small d-none d-md-block text-truncate">Hourly heatmaps</span>
                    </div>
                </a>
            </div>

            <!-- Tab 3: Attendance & No-Shows (Active) -->
            <div class="col-6 col-xl-3">
                <a asp-page="./Attendance" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                   class="report-tab-card active attendance-tab d-flex align-items-center p-2 p-sm-3 rounded-4 border text-decoration-none shadow-xs h-100">
                    <div class="tab-icon-box rounded-3 me-2 me-md-3 d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="bi bi-person-check-fill fs-5 text-primary"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center justify-content-between gap-1 mb-0 mb-md-1">
                            <span class="tab-title fw-bold text-dark d-block">Attendance &amp; No-Shows</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small px-2 d-none d-sm-inline">Active</span>
                        </div>
                        <span class="tab-desc text-muted small d-none d-md-block text-truncate">Arrivals &amp; QR</span>
                    </div>
                </a>
            </div>

            <!-- Tab 4: Customer & Player Insights -->
            <div class="col-6 col-xl-3">
                <a asp-page="./Customers" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                   class="report-tab-card customers-tab d-flex align-items-center p-2 p-sm-3 rounded-4 border text-decoration-none h-100">
                    <div class="tab-icon-box rounded-3 me-2 me-md-3 d-flex align-items-center justify-content-center flex-shrink-0">
                        <i class="bi bi-people-fill fs-5 text-muted"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <span class="tab-title fw-bold text-dark d-block">Customer Insights</span>
                        <span class="tab-desc text-muted small d-none d-md-block text-truncate">VIPs &amp; Retention</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- ─── MONTH SELECTOR ─── -->
    <div class="card border-0 shadow-sm rounded-4 mb-3 mb-md-4 bg-white">
        <div class="card-body p-2 p-sm-3">
            <form method="get" class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-2">
                <!-- Steppers & Selectors -->
                <div class="d-flex align-items-center gap-2 flex-grow-1 flex-sm-grow-0">
                    <div class="btn-group flex-shrink-0" role="group">
                        <a asp-page="./Attendance" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month"
                           class="btn btn-outline-secondary btn-sm" title="Previous Month">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <a asp-page="./Attendance" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month"
                           class="btn btn-outline-secondary btn-sm @(nextMonthDate > DateTime.UtcNow.AddMonths(1) ? "disabled" : "")" title="Next Month">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>

                    <select name="month" class="form-select form-select-sm fw-semibold rounded-3 flex-grow-1" style="min-width: 120px;" onchange="this.form.submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var dt = new DateTime(2026, m, 1);
                            <option value="@m" selected="@(m == Model.Month)">@dt.ToString("MMMM")</option>
                        }
                    </select>

                    <select name="year" class="form-select form-select-sm fw-semibold rounded-3 flex-shrink-0" style="width: 84px;" onchange="this.form.submit()">
                        @for (int y = currentYear - 3; y <= currentYear + 1; y++)
                        {
                            <option value="@y" selected="@(y == Model.Year)">@y</option>
                        }
                    </select>
                </div>

                <!-- Quick Presets -->
                <div class="d-flex gap-2">
                    <a asp-page="./Attendance" asp-route-year="@currentYear" asp-route-month="@currentMonth"
                       class="btn btn-sm flex-fill flex-sm-grow-0 @(Model.Year == currentYear && Model.Month == currentMonth ? "btn-primary" : "btn-light border") rounded-3">
                        This Month
                    </a>
                    @{
                        var lm = DateTime.UtcNow.AddMonths(-1);
                    }
                    <a asp-page="./Attendance" asp-route-year="@lm.Year" asp-route-month="@lm.Month"
                       class="btn btn-sm flex-fill flex-sm-grow-0 @(Model.Year == lm.Year && Model.Month == lm.Month ? "btn-primary" : "btn-light border") rounded-3">
                        Last Month
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- ─── STRATEGIC INSIGHTS ─── -->
    @if (Model.Report.StrategicInsights.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary-subtle border-start border-4 border-primary">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightbulb-fill text-primary fs-5"></i>
                    <h6 class="fw-bold text-dark mb-0">Attendance &amp; Reliability Insights</h6>
                </div>
                <ul class="mb-0 ps-3 small text-secondary">
                    @foreach (var ins in Model.Report.StrategicInsights)
                    {
                        <li class="mb-1">@ins</li>
                    }
                </ul>
            </div>
        </div>
    }

    <!-- ─── EXECUTIVE KPI CARDS ─── -->
    <div class="row g-3 mb-4">
        <!-- 1. Check-In Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Check-In Turnout</span>
                        <div class="p-2 bg-success-subtle text-success rounded-circle">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-success mb-1">@Model.Report.CheckInRate.ToString("F1")%</h2>
                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @Math.Min(100m, Model.Report.CheckInRate)%"></div>
                    </div>
                    <div class="small text-muted d-flex justify-content-between">
                        <span><strong>@Model.Report.CheckedInCount</strong> checked-in</span>
                        <span>@Model.Report.TotalEligibleBookings total</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. No-Show Frequency & Loss -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">No-Show Frequency</span>
                        <div class="p-2 bg-danger-subtle text-danger rounded-circle">
                            <i class="bi bi-person-x-fill fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-danger mb-1">@Model.Report.NoShowRate.ToString("F1")%</h2>
                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar bg-danger" style="width: @Math.Min(100m, Model.Report.NoShowRate)%"></div>
                    </div>
                    <div class="small text-muted d-flex justify-content-between">
                        <span><strong>@Model.Report.NoShowCount</strong> no-shows</span>
                        <span class="text-danger fw-semibold">₱@Model.Report.NoShowRevenueLoss.ToString("N0") loss</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Arrival Punctuality -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Arrival Punctuality</span>
                        <div class="p-2 bg-info-subtle text-info rounded-circle">
                            <i class="bi bi-stopwatch-fill fs-5"></i>
                        </div>
                    </div>
                    @if (Model.Report.AveragePunctualityMinutes.HasValue)
                    {
                        var pVal = Model.Report.AveragePunctualityMinutes.Value;
                        if (pVal < 0)
                        {
                            <h2 class="fw-bold text-primary mb-1">@Math.Abs(pVal).ToString("F1") <span class="fs-6 text-muted fw-normal">mins early</span></h2>
                            <div class="small text-success fw-semibold"><i class="bi bi-arrow-down-left me-1"></i>Arriving ahead of schedule</div>
                        }
                        else if (pVal > 0)
                        {
                            <h2 class="fw-bold text-warning-emphasis mb-1">@pVal.ToString("F1") <span class="fs-6 text-muted fw-normal">mins late</span></h2>
                            <div class="small text-warning-emphasis fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i>Arriving after start time</div>
                        }
                        else
                        {
                            <h2 class="fw-bold text-dark mb-1">On Time</h2>
                            <div class="small text-muted">Right on the minute</div>
                        }
                    }
                    else
                    {
                        <h2 class="fw-bold text-muted mb-1">N/A</h2>
                        <div class="small text-muted">No check-in timestamps recorded</div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Realized Checked-In Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Attended Revenue</span>
                        <div class="p-2 bg-primary-subtle text-primary rounded-circle">
                            <i class="bi bi-cash-coin fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-dark mb-1">₱@Model.Report.RealizedCheckedInRevenue.ToString("N2")</h2>
                    <div class="small text-muted d-flex justify-content-between">
                        <span>Turnout realization</span>
                        <span class="badge bg-light text-dark border">@Model.Report.UnmarkedCount Unmarked</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── TWO COLUMN: CHECK-IN METHODS & DAY OF WEEK ATTENDANCE ─── -->
    <div class="row g-4 mb-4">
        <!-- Check-In Methods -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-qr-code-scan text-primary me-2"></i>Check-In Method Breakdown
                    </h6>
                    <span class="badge bg-light text-muted border">@Model.Report.CheckedInCount Check-ins</span>
                </div>
                <div class="card-body p-3 p-md-4">
                    @if (!Model.Report.MethodStats.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-upc-scan fs-3 d-block mb-2"></i>No check-in transactions recorded for this month.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var m in Model.Report.MethodStats)
                            {
                                var icon = m.MethodName.Contains("QR") ? "bi-qr-code" :
                                           m.MethodName.Contains("Manual") ? "bi-person-badge" : "bi-door-open";
                                var iconBg = m.MethodName.Contains("QR") ? "bg-primary-subtle text-primary" :
                                             m.MethodName.Contains("Manual") ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning-emphasis";

                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 @iconBg rounded-3">
                                                <i class="bi @icon fs-5"></i>
                                            </div>
                                            <div>
                                                <span class="fw-semibold text-dark d-block">@m.MethodName</span>
                                                <span class="text-muted small">@m.Count attendees</span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold font-monospace fs-5">@m.SharePercentage.ToString("F1")%</span>
                                        </div>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px;">
                                        <div class="progress-bar bg-primary" style="width: @m.SharePercentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Day of the Week Attendance -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-calendar-event text-primary me-2"></i>Turnout &amp; No-Shows by Day of Week
                    </h6>
                    <span class="small text-muted">Weekly attendance distribution</span>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th>Day</th>
                                    <th class="text-center">Bookings</th>
                                    <th class="text-center">Checked-In</th>
                                    <th class="text-center">No-Shows</th>
                                    <th class="text-end">Check-In Rate</th>
                                    <th class="text-end">No-Show Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Report.DayOfWeekStats)
                                {
                                    var isWeekend = d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday;
                                    <tr>
                                        <td class="fw-semibold text-dark">
                                            @if (isWeekend)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis me-1">Weekend</span>
                                            }
                                            @d.DayName
                                        </td>
                                        <td class="text-center font-monospace">@d.TotalBookings</td>
                                        <td class="text-center font-monospace text-success fw-semibold">@d.CheckedInCount</td>
                                        <td class="text-center font-monospace text-danger fw-semibold">@d.NoShowCount</td>
                                        <td class="text-end font-monospace fw-bold text-success">@d.CheckInRate.ToString("F1")%</td>
                                        <td class="text-end font-monospace fw-bold @(d.NoShowRate >= 15 ? "text-danger" : "text-muted")">
                                            @d.NoShowRate.ToString("F1")%
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── CUSTOMER RELIABILITY & REPEAT NO-SHOW AUDIT ─── -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 pb-0 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-shield-exclamation text-primary me-2"></i>Customer Reliability &amp; Repeat No-Show Audit
                </h6>
                <p class="text-muted small mb-0">Identifies frequent players and customers with repeat no-shows for proactive policy management.</p>
            </div>
            <span class="badge bg-light text-muted border">Top Players &amp; Risk Profiles</span>
        </div>
        <div class="card-body p-3 p-md-4">
            @if (!Model.Report.CustomerReliabilityStats.Any())
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-people fs-3 d-block mb-2"></i>No customer attendance data recorded for this month.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Customer Name</th>
                                <th>Contact</th>
                                <th class="text-center">Total Bookings</th>
                                <th class="text-center">Checked-In</th>
                                <th class="text-center">No-Shows</th>
                                <th class="text-end">Reliability %</th>
                                <th class="text-center">Risk Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Report.CustomerReliabilityStats)
                            {
                                var riskBadge = c.RiskLevel == "High" ? "bg-danger text-white" :
                                                c.RiskLevel == "Medium" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" :
                                                "bg-success-subtle text-success border border-success-subtle";

                                <tr>
                                    <td class="fw-semibold text-dark">
                                        <i class="bi bi-person me-1 text-muted"></i>@c.CustomerName
                                    </td>
                                    <td class="small">
                                        <div>@c.CustomerPhone</div>
                                        @if (!string.IsNullOrWhiteSpace(c.CustomerEmail))
                                        {
                                            <div class="text-muted" style="font-size: 0.75rem;">@c.CustomerEmail</div>
                                        }
                                    </td>
                                    <td class="text-center font-monospace">@c.TotalBookings</td>
                                    <td class="text-center font-monospace text-success fw-semibold">@c.CheckedInCount</td>
                                    <td class="text-center font-monospace @(c.NoShowCount > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @c.NoShowCount
                                    </td>
                                    <td class="text-end font-monospace fw-bold">
                                        @c.ReliabilityRate.ToString("F1")%
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @riskBadge px-2 py-1 rounded-pill small">
                                            @c.RiskLevel
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ─── FULL ATTENDANCE AUDIT LEDGER ─── -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-header bg-white border-0 pt-3 px-3 px-md-4 pb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-text text-primary me-2"></i>Attendance &amp; Check-In Ledger
                    </h6>
                    <span class="small text-muted">@Model.Report.Records.Count record(s) matching current filter</span>
                </div>

                <!-- Ledger Search and Filter Form -->
                <form method="get" class="d-flex flex-column flex-sm-row flex-wrap gap-2 w-100 w-md-auto">
                    <input type="hidden" name="year" value="@Model.Year" />
                    <input type="hidden" name="month" value="@Model.Month" />

                    <select name="Filter" class="form-select form-select-sm w-100 w-sm-auto" style="min-width: 140px;" onchange="this.form.submit()">
                        <option value="all" selected="@(string.IsNullOrEmpty(Model.Filter) || Model.Filter == "all")">All Statuses</option>
                        <option value="checkedin" selected="@(Model.Filter == "checkedin")">Checked-In Only</option>
                        <option value="noshow" selected="@(Model.Filter == "noshow")">No-Shows Only</option>
                        <option value="unmarked" selected="@(Model.Filter == "unmarked")">Pending Arrival</option>
                    </select>

                    <div class="input-group input-group-sm flex-grow-1">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Search ref, customer..." />
                        <button type="submit" class="btn btn-outline-primary">Filter</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.Filter))
                    {
                        <a asp-page="./Attendance" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-light btn-sm border text-center">Reset</a>
                    }
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th>Reference</th>
                        <th>Date &amp; Time</th>
                        <th>Court</th>
                        <th>Customer</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Attendance</th>
                        <th>Check-In Time</th>
                        <th>Method</th>
                        <th class="text-center">Punctuality</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Report.Records.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted small">
                                No attendance records found matching your filters.
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Report.Records)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Admin/Bookings/Details" asp-route-id="@r.BookingId" class="font-monospace fw-bold text-decoration-none text-primary">
                                    @r.BookingReference
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@r.BookingDate.ToString("MMM d, yyyy")</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@r.TimeRange</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@r.CourtName</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@r.CustomerName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@r.CustomerPhone</div>
                            </td>
                            <td class="text-end font-monospace text-dark fw-semibold">
                                ₱@r.Price.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (r.IsNoShow)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small">
                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                    </span>
                                }
                                else if (r.CheckedIn)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                        <i class="bi bi-check-circle me-1"></i>Checked-In
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill small">
                                        <i class="bi bi-clock me-1"></i>Pending Arrival
                                    </span>
                                }
                            </td>
                            <td class="small">
                                @if (r.CheckedInAtLocal.HasValue)
                                {
                                    <div>@r.CheckedInAtLocal.Value.ToString("h:mm tt")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@r.CheckedInAtLocal.Value.ToString("MMM d")</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="small">
                                @if (r.CheckInMethod.HasValue)
                                {
                                    var methodBadge = r.CheckInMethod == PickleBallBooking.Models.CheckInMethod.QrScan ? "bg-primary-subtle text-primary border-primary-subtle" :
                                                      r.CheckInMethod == PickleBallBooking.Models.CheckInMethod.AdminManual ? "bg-info-subtle text-info border-info-subtle" :
                                                      "bg-light text-muted border";
                                    <span class="badge @methodBadge border px-2 py-1 rounded-pill small">
                                        @r.CheckInMethod
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (r.PunctualityMinutes.HasValue)
                                {
                                    if (r.PunctualityMinutes.Value < 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace small">
                                            @Math.Abs(r.PunctualityMinutes.Value)m Early
                                        </span>
                                    }
                                    else if (r.PunctualityMinutes.Value > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace small">
                                            @r.PunctualityMinutes.Value m Late
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border font-monospace small">On Time</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ─── TAB & PRINT STYLES ─── -->
