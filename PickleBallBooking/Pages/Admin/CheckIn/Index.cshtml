@section Scripts {
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    let html5QrCode = null;
    let isCameraActive = false;
    let isTorchActive = false;
    let activeStatusFilter = 'all';

    const btnToggle = document.getElementById('btnToggleCamera');
    const cameraText = document.getElementById('cameraBtnText');
    const container = document.getElementById('cameraContainer');
    const btnToggleTorch = document.getElementById('btnToggleTorch');
    const torchText = document.getElementById('torchBtnText');
    const payloadInput = document.getElementById('qrPayloadInput');
    const btnClearPayload = document.getElementById('btnClearPayload');
    const ajaxAlert = document.getElementById('ajax-alert');
    const searchInput = document.getElementById('attendanceSearchInput');
    const btnClearSearch = document.getElementById('btnClearSearch');

    function playSuccessChime() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
            osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12); // A5
            gain.gain.setValueAtTime(0.2, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.2);
        } catch(e) {}
    }

    function triggerHaptic() {
        if (navigator.vibrate) {
            navigator.vibrate([100, 50, 100]);
        }
    }

    function showAlert(msg, isSuccess) {
        ajaxAlert.className = `alert ${isSuccess ? 'alert-success' : 'alert-danger'} d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3`;
        ajaxAlert.innerHTML = `<i class="bi ${isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2 fs-5 flex-shrink-0"></i><div class="small fw-medium">${msg}</div>`;
        ajaxAlert.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Filter engine combining Text search + Status chip filter
    function applyCombinedFilter() {
        const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
        const status = activeStatusFilter;

        document.querySelectorAll('.searchable-item').forEach(item => {
            const itemText = (item.getAttribute('data-search') || '').toLowerCase();
            const itemStatus = item.getAttribute('data-status') || '';

            const matchesQuery = query === '' || itemText.includes(query);
            const matchesStatus = status === 'all' || itemStatus === status;

            item.style.display = (matchesQuery && matchesStatus) ? '' : 'none';
        });

        // Hide empty activity card blocks if all their children are hidden
        document.querySelectorAll('.activity-parent-card').forEach(actCard => {
            const visibleItems = actCard.querySelectorAll('.searchable-item:not([style*="display: none"])');
            if ((query !== '' || status !== 'all') && visibleItems.length === 0) {
                actCard.style.display = 'none';
            } else {
                actCard.style.display = '';
            }
        });
    }

    // Status chip buttons click handlers
    document.querySelectorAll('.status-chip').forEach(chip => {
        chip.addEventListener('click', function () {
            document.querySelectorAll('.status-chip').forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            activeStatusFilter = this.getAttribute('data-status-filter') || 'all';
            applyCombinedFilter();
        });
    });

    // KPI card click to filter shortcuts
    document.querySelectorAll('.kpi-card-filter').forEach(kpiCard => {
        kpiCard.addEventListener('click', function () {
            const filterVal = this.getAttribute('data-kpi-filter') || 'all';
            const targetChip = document.querySelector(`.status-chip[data-status-filter="${filterVal}"]`);
            if (targetChip) {
                targetChip.click();
            }
        });
    });

    // Live search filter across active tab
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            if (btnClearSearch) {
                btnClearSearch.classList.toggle('d-none', query.length === 0);
            }
            applyCombinedFilter();
        });

        if (btnClearSearch) {
            btnClearSearch.addEventListener('click', function() {
                searchInput.value = '';
                searchInput.dispatchEvent(new Event('input'));
                searchInput.focus();
            });
        }
    }

    // QR payload input clear button
    if (payloadInput && btnClearPayload) {
        payloadInput.addEventListener('input', function() {
            btnClearPayload.classList.toggle('d-none', this.value.length === 0);
        });
        btnClearPayload.addEventListener('click', function() {
            payloadInput.value = '';
            btnClearPayload.classList.add('d-none');
            payloadInput.focus();
        });
    }

    async function handleQrPayload(decodedText) {
        if (!decodedText) return;
        payloadInput.value = decodedText;
        if (btnClearPayload) btnClearPayload.classList.remove('d-none');

        const formData = new FormData();
        formData.append('qrPayload', decodedText);
        formData.append('date', '@Model.SelectedDate.ToString("yyyy-MM-dd")');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch('?handler=ProcessQr', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const data = await resp.json();
            showAlert(data.message, data.success);

            if (data.success) {
                playSuccessChime();
                triggerHaptic();
                setTimeout(() => window.location.reload(), 1200);
            }
        } catch(err) {
            document.getElementById('checkInForm').submit();
        }
    }

    // Check camera video track for torch/flashlight capability
    function checkTorchCapability() {
        try {
            const videoElem = document.querySelector('#qrReader video');
            if (videoElem && videoElem.srcObject) {
                const track = videoElem.srcObject.getVideoTracks()[0];
                if (track) {
                    const capabilities = track.getCapabilities ? track.getCapabilities() : {};
                    if (capabilities.torch) {
                        btnToggleTorch.classList.remove('d-none');
                        return;
                    }
                }
            }
        } catch(e) {}
    }

    if (btnToggleTorch) {
        btnToggleTorch.addEventListener('click', async () => {
            try {
                const videoElem = document.querySelector('#qrReader video');
                if (videoElem && videoElem.srcObject) {
                    const track = videoElem.srcObject.getVideoTracks()[0];
                    if (track) {
                        isTorchActive = !isTorchActive;
                        await track.applyConstraints({
                            advanced: [{ torch: isTorchActive }]
                        });
                        torchText.textContent = isTorchActive ? 'Torch ON' : 'Torch';
                        btnToggleTorch.classList.toggle('btn-warning', isTorchActive);
                        btnToggleTorch.classList.toggle('btn-outline-warning', !isTorchActive);
                    }
                }
            } catch(err) {
                console.warn('Torch constraint error:', err);
            }
        });
    }

    const btnSnapPhoto = document.getElementById('btnSnapPhoto');
    const qrFileInput = document.getElementById('qrFileInput');

    if (btnSnapPhoto && qrFileInput) {
        btnSnapPhoto.addEventListener('click', () => {
            qrFileInput.click();
        });

        qrFileInput.addEventListener('change', async (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;

            showAlert("Scanning QR from photo...", true);
            try {
                if (!html5QrCode) {
                    html5QrCode = new Html5Qrcode("qrReader");
                }
                const decodedText = await html5QrCode.scanFile(file, false);
                handleQrPayload(decodedText);
            } catch(err) {
                console.error("Photo scan error:", err);
                showAlert("Could not detect a clear QR code in that photo. Please try snapping closer with good lighting.", false);
            } finally {
                qrFileInput.value = '';
            }
        });
    }

    btnToggle.addEventListener('click', async () => {
        if (!isCameraActive) {
            // Check for insecure context restriction on mobile browsers
            const isSecure = window.isSecureContext || location.hostname === 'localhost' || location.hostname === '127.0.0.1';
            if (!isSecure && (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia)) {
                showAlert("⚠️ Mobile browsers require HTTPS to stream live video over the local network. Tap 'Snap QR Photo' instead to scan instantly with your camera!", false);
                btnSnapPhoto?.classList.add('btn-primary');
                btnSnapPhoto?.classList.remove('btn-outline-primary');
                return;
            }

            container.classList.remove('d-none');
            cameraText.textContent = 'Close Camera Scanner';
            btnToggle.classList.replace('btn-outline-success', 'btn-outline-secondary');
            isCameraActive = true;

            try {
                if (typeof Html5Qrcode !== 'undefined') {
                    if (!html5QrCode) {
                        html5QrCode = new Html5Qrcode("qrReader");
                    }
                    await html5QrCode.start(
                        { facingMode: "environment" },
                        { fps: 10, qrbox: { width: 220, height: 220 } },
                        (decodedText) => {
                            handleQrPayload(decodedText);
                        },
                        (errorMessage) => {}
                    );
                    setTimeout(checkTorchCapability, 800);
                }
            } catch(e) {
                console.error("Camera access error:", e);
                const isSecure = window.isSecureContext || location.hostname === 'localhost' || location.hostname === '127.0.0.1';
                if (!isSecure) {
                    showAlert("⚠️ Mobile browsers block live camera on plain HTTP (http://" + location.host + "). Please tap 'Snap QR Photo' to scan using your phone camera directly!", false);
                    btnSnapPhoto?.classList.add('btn-primary');
                    btnSnapPhoto?.classList.remove('btn-outline-primary');
                } else {
                    showAlert("Could not access camera. Please check camera permissions in your browser or type the code manually.", false);
                }
                container.classList.add('d-none');
                cameraText.textContent = 'Live Camera Scanner';
                btnToggle.classList.replace('btn-outline-secondary', 'btn-outline-success');
                isCameraActive = false;
            }
        } else {
            if (html5QrCode) {
                await html5QrCode.stop().catch(() => {});
                html5QrCode = null;
            }
            container.classList.add('d-none');
            btnToggleTorch.classList.add('d-none');
            isTorchActive = false;
            cameraText.textContent = 'Live Camera Scanner';
            btnToggle.classList.replace('btn-outline-secondary', 'btn-outline-success');
            isCameraActive = false;
        }
    });

    // ⚡ Fast In-Place AJAX Check-In / No-Show / Undo Handler
    document.addEventListener('submit', async function (e) {
        const form = e.target.closest('.ajax-checkin-form');
        if (!form) return;

        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        }

        try {
            const formData = new FormData(form);
            const actionUrl = form.action || window.location.href;

            const resp = await fetch(actionUrl, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            if (!resp.ok) {
                form.submit();
                return;
            }

            const data = await resp.json();
            showAlert(data.message, data.success);

            if (data.success) {
                playSuccessChime();
                triggerHaptic();
                // Smoothly reload page state after 800ms to keep all complex event aggregations 100% in sync
                setTimeout(() => window.location.reload(), 800);
            } else {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origBtnHtml;
                }
            }
        } catch(err) {
            // Fallback to standard HTTP POST submit
            form.submit();
        }
    });
</script>
}

