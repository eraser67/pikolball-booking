@page
@model PickleBallBooking.Pages.Admin.CheckIn.IndexModel
@using PickleBallBooking.Models
@using PickleBallBooking.Services
@{
    ViewData["Title"] = "Player Check-In";
    var feed = Model.Feed;
    var isToday = Model.SelectedDate == DateOnly.FromDateTime(DateTime.Today);
    var checkInPercent = feed.TotalExpected > 0 ? (int)Math.Round((double)feed.TotalCheckedIn / feed.TotalExpected * 100) : 0;
}

<div class="container-fluid py-3 py-md-4 px-2 px-sm-3 px-md-4">
    <!-- Header & Date Filter -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h4 h3-md fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-qr-code-scan text-success me-2"></i>Player Check-In
                </h1>
                @if (isToday)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Today</span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">Scan player QR passes or record attendance for activities and court bookings.</p>
        </div>

        <!-- Date Navigator -->
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-between justify-content-md-end flex-wrap">
            <div class="btn-group btn-group-sm flex-shrink-0 shadow-sm">
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary py-2 px-3" title="Previous Day">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <a asp-page="./Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn @(isToday ? "btn-success" : "btn-outline-secondary") py-2 px-3 fw-semibold">
                    Today
                </a>
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary py-2 px-3" title="Next Day">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <form method="get" class="d-flex align-items-center flex-grow-1 flex-md-grow-0">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" class="form-control form-control-sm py-2 shadow-sm" style="min-width:135px;" />
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    <div id="ajax-alert" class="alert d-none align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert"></div>

    <!-- Summary Statistics Cards (Interactive Filter Shortcuts) -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 checkin-stat-card cursor-pointer kpi-card-filter" data-kpi-filter="all" title="Click to show all expected players">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-muted small fw-semibold text-uppercase tracking-wider">Total Expected</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-dark" id="stat-total-count">@feed.TotalExpected</div>
                    <div class="text-muted small text-truncate" style="font-size:0.75rem;">@feed.Activities.Sum(a => a.TotalRsvps) acts &bull; @feed.Bookings.Count bookings</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-success border-4 checkin-stat-card cursor-pointer kpi-card-filter" data-kpi-filter="checkedin" title="Click to filter Checked In players">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-success small fw-semibold text-uppercase tracking-wider">Checked In</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-success" id="stat-checkedin-count">@feed.TotalCheckedIn</div>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar bg-success" id="stat-progressbar" role="progressbar" style="width: @(checkInPercent)%" aria-valuenow="@(checkInPercent)" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-warning border-4 checkin-stat-card cursor-pointer kpi-card-filter" data-kpi-filter="pending" title="Click to filter Awaiting players">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-warning-emphasis small fw-semibold text-uppercase tracking-wider">Awaiting</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-warning-emphasis" id="stat-pending-count">@feed.TotalPending</div>
                    <div class="text-muted small" style="font-size:0.75rem;">Pending arrival</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-danger border-4 checkin-stat-card cursor-pointer kpi-card-filter" data-kpi-filter="noshow" title="Click to filter No-Show players">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-danger small fw-semibold text-uppercase tracking-wider">No-Shows</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-danger" id="stat-noshow-count">@feed.TotalNoShow</div>
                    <div class="text-muted small" style="font-size:0.75rem;">Recorded absent</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scanner & Quick Input Banner -->
    <div class="card border-0 shadow-sm mb-3 mb-md-4 rounded-3 scanner-hero">
        <div class="card-body p-3 p-sm-4">
            <div class="row g-3 g-md-4 align-items-center">
                <div class="col-12 col-lg-7">
                    <h5 class="fw-bold mb-1 d-flex align-items-center">
                        <i class="bi bi-upc-scan me-2 text-success"></i>Scan Pass or Enter Reference
                    </h5>
                    <p class="text-muted small mb-3">Scan with device camera, 2D barcode scanner, or type player RSVP ID / Booking Ref.</p>

                    <form id="checkInForm" method="post" asp-page-handler="ProcessQr" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <div class="col-12 col-sm-8 col-md-8">
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-qr-code"></i></span>
                                <input type="text" id="qrPayloadInput" name="qrPayload" class="form-control border-start-0 py-2"
                                       placeholder="e.g. RSVP:42 or BOOKING:PB-1234..." autofocus autocomplete="off" />
                                <button type="button" class="btn btn-outline-secondary border-start-0 d-none" id="btnClearPayload" title="Clear input">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4">
                            <button type="submit" id="btnSubmitCheckIn" class="btn btn-success w-100 py-2 fw-semibold d-flex align-items-center justify-content-center shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Check In
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-12 col-lg-5 text-lg-end">
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-lg-end">
                        <button type="button" id="btnToggleCamera" class="btn btn-outline-success btn-sm py-2 px-3 fw-semibold shadow-sm">
                            <i class="bi bi-camera-video me-1"></i><span id="cameraBtnText">Live Camera Scanner</span>
                        </button>
                        <button type="button" id="btnSnapPhoto" class="btn btn-outline-primary btn-sm py-2 px-3 fw-semibold shadow-sm">
                            <i class="bi bi-camera me-1"></i><span>Snap QR Photo</span>
                        </button>
                        <input type="file" id="qrFileInput" accept="image/*" capture="environment" class="d-none" />
                    </div>
                    <div id="cameraContainer" class="d-none mt-3 p-2 bg-white rounded-3 border shadow-sm mx-auto mx-lg-0 ms-lg-auto" style="max-width:340px; width:100%;">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <span class="small fw-semibold text-muted"><i class="bi bi-camera me-1"></i>Camera Live</span>
                            <button type="button" id="btnToggleTorch" class="btn btn-sm btn-outline-warning py-0 px-2 d-none" title="Toggle Flashlight / Torch">
                                <i class="bi bi-flashlight me-1"></i><span id="torchBtnText">Torch</span>
                            </button>
                        </div>
                        <div id="qrReader" style="width:100%;min-height:240px;border-radius:8px;overflow:hidden;"></div>
                        <div class="small text-muted text-center mt-2"><i class="bi bi-bullseye me-1"></i>Point camera at player QR code</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Tabs Container -->
    <div class="card border-0 shadow-sm rounded-3">
        <!-- Tab Navigation & Quick Filter Toolbar -->
        <div class="card-header bg-white border-bottom p-3 p-md-4 pb-2 pb-md-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 mb-2">
                <!-- Custom Navigation Pills -->
                <ul class="nav nav-pills checkin-nav-pills gap-2" id="checkInTabs" role="tablist">
                    <li class="nav-item flex-fill flex-sm-grow-0" role="presentation">
                        <button class="nav-link active fw-semibold w-100 d-flex align-items-center justify-content-center py-2 px-3 rounded-pill" id="activities-tab" data-bs-toggle="pill" data-bs-target="#activities-pane" type="button" role="tab">
                            <i class="bi bi-calendar-event me-2"></i>Activities
                            <span class="badge ms-2 rounded-pill tab-count-badge">@feed.Activities.Sum(a => a.TotalRsvps)</span>
                        </button>
                    </li>
                    <li class="nav-item flex-fill flex-sm-grow-0" role="presentation">
                        <button class="nav-link fw-semibold w-100 d-flex align-items-center justify-content-center py-2 px-3 rounded-pill" id="bookings-tab" data-bs-toggle="pill" data-bs-target="#bookings-pane" type="button" role="tab">
                            <i class="bi bi-journal-text me-2"></i>Court Bookings
                            <span class="badge ms-2 rounded-pill tab-count-badge">@feed.Bookings.Count</span>
                        </button>
                    </li>
                </ul>

                <!-- Live Search Box -->
                <div class="d-flex align-items-center gap-2 flex-grow-1 flex-md-grow-0">
                    <div class="input-group input-group-sm search-input-group shadow-sm w-100" style="max-width:320px;">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="attendanceSearchInput" class="form-control border-start-0 py-2" placeholder="Filter roster or bookings..." autocomplete="off" />
                        <button class="btn btn-outline-secondary border-start-0 d-none" type="button" id="btnClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Horizontal Swipeable Status Filter Chips -->
            <div class="checkin-status-chips d-flex gap-1 overflow-x-auto pt-2" style="scrollbar-width:none;">
                <button type="button" class="status-chip active" data-status-filter="all">
                    All <span class="badge rounded-pill ms-1">@feed.TotalExpected</span>
                </button>
                <button type="button" class="status-chip" data-status-filter="pending">
                    <i class="bi bi-hourglass-split me-1 text-warning"></i>Awaiting <span class="badge rounded-pill ms-1" id="chip-pending-count">@feed.TotalPending</span>
                </button>
                <button type="button" class="status-chip" data-status-filter="checkedin">
                    <i class="bi bi-check2-circle me-1 text-success"></i>Checked In <span class="badge rounded-pill ms-1" id="chip-checkedin-count">@feed.TotalCheckedIn</span>
                </button>
                <button type="button" class="status-chip" data-status-filter="noshow">
                    <i class="bi bi-x-circle me-1 text-danger"></i>No-Show <span class="badge rounded-pill ms-1" id="chip-noshow-count">@feed.TotalNoShow</span>
                </button>
            </div>
        </div>

        <div class="card-body p-2 p-sm-3 p-md-4">
            <div class="tab-content" id="checkInTabsContent">

                <!-- 🏓 Activities Pane -->
                <div class="tab-pane fade show active" id="activities-pane" role="tabpanel">
                    @if (!feed.Activities.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-5 d-block mb-2 text-secondary"></i>
                            <h6 class="fw-bold mb-1">No activities scheduled</h6>
                            <p class="small mb-0">No activities scheduled for @Model.SelectedDate.ToString("MMMM d, yyyy").</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 gap-md-4" id="activitiesListContainer">
                            @foreach (var act in feed.Activities)
                            {
                                var actCheckInPercent = act.TotalRsvps > 0 ? (int)Math.Round((double)act.CheckedInCount / act.TotalRsvps * 100) : 0;
                                <div class="border rounded-3 p-3 bg-white activity-block shadow-none activity-parent-card">
                                    <!-- Activity Header Card -->
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3 pb-2 border-bottom">
                                        <div class="min-w-0">
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <h5 class="fw-bold mb-0 text-truncate">
                                                    <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="text-decoration-none text-dark hover-underline">
                                                        @act.Name
                                                    </a>
                                                </h5>
                                                <span class="badge bg-light text-dark border small"><i class="bi bi-grid-3x3 me-1 text-muted"></i>@act.Courts</span>
                                            </div>
                                            <div class="small text-muted d-flex align-items-center flex-wrap gap-2">
                                                <span><i class="bi bi-clock me-1 text-success"></i>@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap w-100 w-sm-auto justify-content-between justify-content-sm-end">
                                            <div class="d-flex flex-column align-items-end">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                                        @act.CheckedInCount / @act.TotalRsvps In
                                                    </span>
                                                    @if (act.NoShowCount > 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                                            @act.NoShowCount No-Show
                                                        </span>
                                                    }
                                                </div>
                                                <div class="progress mt-1 d-none d-sm-block" style="height: 4px; width: 100px;">
                                                    <div class="progress-bar bg-success" style="width: @(actCheckInPercent)%"></div>
                                                </div>
                                            </div>
                                            <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Manage Roster">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Detail
                                            </a>
                                        </div>
                                    </div>

                                    @if (!act.Players.Any())
                                    {
                                        <div class="text-muted small py-3 text-center">No registered players for this activity.</div>
                                    }
                                    else
                                    {
                                        <!-- Desktop Table View -->
                                        <div class="table-responsive d-none d-md-block">
                                            <table class="table table-hover align-middle mb-0 checkin-table">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Player</th>
                                                        <th>Contact</th>
                                                        <th>Skill</th>
                                                        <th>Status</th>
                                                        <th>Check-In Time</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in act.Players)
                                                    {
                                                        var pStatus = p.Status == RsvpStatus.CheckedIn ? "checkedin" : p.Status == RsvpStatus.NoShow ? "noshow" : "pending";
                                                        var cleanPhone = !string.IsNullOrEmpty(p.Mobile) ? new string(p.Mobile.Where(char.IsDigit).ToArray()) : "";

                                                        <tr class="searchable-item" data-search="@p.PlayerName @p.Email @p.Mobile @p.RsvpId @act.Name @act.Courts" data-status="@pStatus" id="row-rsvp-@p.RsvpId">
                                                            <td>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                                                    {
                                                                        <img src="@p.AvatarUrl" alt="" class="rounded-circle shadow-sm" style="width:34px;height:34px;object-fit:cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold shadow-sm" style="width:34px;height:34px;">
                                                                            @p.PlayerName.Substring(0, 1).ToUpper()
                                                                        </div>
                                                                    }
                                                                    <div>
                                                                        <div class="fw-semibold d-flex align-items-center gap-1">
                                                                            <span>@p.PlayerName</span>
                                                                            @if (p.IsGuest)
                                                                            {
                                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill" style="font-size:0.65rem;">Walk-in</span>
                                                                            }
                                                                        </div>
                                                                        <div class="text-muted small" style="font-size:0.75rem;">RSVP #@p.RsvpId</div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="small">
                                                                @if (!string.IsNullOrEmpty(p.Email))
                                                                {
                                                                    <div>@p.Email</div>
                                                                }
                                                                @if (!string.IsNullOrEmpty(p.Mobile))
                                                                {
                                                                    <div class="text-muted d-flex align-items-center gap-1" style="font-size:0.75rem;">
                                                                        <i class="bi bi-telephone text-muted"></i>
                                                                        <span>@p.Mobile</span>
                                                                        @if (!string.IsNullOrEmpty(cleanPhone))
                                                                        {
                                                                            <a href="tel:@cleanPhone" class="text-success ms-1" title="Call"><i class="bi bi-telephone-fill"></i></a>
                                                                        }
                                                                    </div>
                                                                }
                                                                @if (string.IsNullOrEmpty(p.Email) && string.IsNullOrEmpty(p.Mobile))
                                                                {
                                                                    <span class="text-muted small">No contact</span>
                                                                }
                                                            </td>
                                                            <td class="small">
                                                                <span class="badge bg-light text-dark border">@(p.SkillLevel?.ToString() ?? "Open")</span>
                                                            </td>
                                                            <td class="status-cell">
                                                                @if (p.Status == RsvpStatus.CheckedIn)
                                                                {
                                                                    <span class="badge bg-success px-2 py-1">
                                                                        <i class="bi bi-check2-circle me-1"></i>Checked In
                                                                    </span>
                                                                }
                                                                else if (p.Status == RsvpStatus.NoShow)
                                                                {
                                                                    <span class="badge bg-danger px-2 py-1">
                                                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td class="small text-muted time-cell">
                                                                @if (p.CheckedInAt.HasValue)
                                                                {
                                                                    <span class="text-success fw-medium">@p.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                                    @if (p.CheckInMethod == CheckInMethod.QrScan)
                                                                    {
                                                                        <span class="badge bg-light text-dark border ms-1" title="Checked in via QR Scanner"><i class="bi bi-qr-code"></i></span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span>—</span>
                                                                }
                                                            </td>
                                                            <td class="text-end actions-cell">
                                                                <div class="btn-group btn-group-sm">
                                                                    @if (p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="CheckInRsvp" class="d-inline ajax-checkin-form" data-type="rsvp" data-id="@p.RsvpId">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-success btn-sm py-1 px-2 shadow-sm" title="Check In">
                                                                                <i class="bi bi-check2 me-1"></i>Check In
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="MarkRsvpNoShowAsync" class="d-inline ms-1 ajax-checkin-form" data-type="rsvp" data-id="@p.RsvpId" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Mark No-Show">
                                                                                <i class="bi bi-x-circle"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                                                    {
                                                                        <form method="post" asp-page-handler="UndoRsvp" class="d-inline ms-1 ajax-checkin-form" data-type="rsvp" data-id="@p.RsvpId">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset to Pending">
                                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
