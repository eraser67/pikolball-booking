@page
@model PickleBallBooking.Pages.Admin.CheckIn.IndexModel
@using PickleBallBooking.Models
@using PickleBallBooking.Services
@{
    ViewData["Title"] = "Player Check-In";
    var feed = Model.Feed;
    var isToday = Model.SelectedDate == DateOnly.FromDateTime(DateTime.Today);
    var checkInPercent = feed.TotalExpected > 0 ? (int)Math.Round((double)feed.TotalCheckedIn / feed.TotalExpected * 100) : 0;
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header & Date Filter -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-0">
                    <i class="bi bi-qr-code-scan text-primary me-2"></i>Player Check-In
                </h1>
                @if (isToday)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Today</span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">Scan player QR codes or manually record attendance for activities and court bookings.</p>
        </div>

        <!-- Date Navigator -->
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm">
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" title="Previous Day">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <a asp-page="./Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn @(isToday ? "btn-primary" : "btn-outline-secondary")">
                    Today
                </a>
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" title="Next Day">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <form method="get" class="d-flex align-items-center">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" class="form-control form-control-sm" style="width:145px;" />
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div id="ajax-alert" class="alert d-none align-items-center py-2 px-3 mb-4" role="alert"></div>

    <!-- Summary Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Total Expected</div>
                    <div class="h3 fw-bold mb-1 mt-1 text-dark">@feed.TotalExpected</div>
                    <div class="text-muted small">@feed.Activities.Sum(a => a.TotalRsvps) activities &bull; @feed.Bookings.Count bookings</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="text-success small fw-semibold text-uppercase">Checked In</div>
                    <div class="h3 fw-bold mb-1 mt-1 text-success">@feed.TotalCheckedIn</div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(checkInPercent)%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
                <div class="card-body p-3">
                    <div class="text-warning-emphasis small fw-semibold text-uppercase">Awaiting Arrival</div>
                    <div class="h3 fw-bold mb-1 mt-1 text-warning-emphasis">@feed.TotalPending</div>
                    <div class="text-muted small">Pending check-in</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-danger border-4">
                <div class="card-body p-3">
                    <div class="text-danger small fw-semibold text-uppercase">No-Shows</div>
                    <div class="h3 fw-bold mb-1 mt-1 text-danger">@feed.TotalNoShow</div>
                    <div class="text-muted small">Unexcused absence</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scanner & Quick Input Banner -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-upc-scan me-2 text-primary"></i>Scan QR Pass or Enter Reference
                    </h5>
                    <p class="text-muted small mb-3">Scan with a camera, USB barcode scanner, or type player RSVP ID / Booking Ref.</p>

                    <form id="checkInForm" method="post" asp-page-handler="ProcessQr" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <div class="col-sm-8 col-md-9">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-qr-code"></i></span>
                                <input type="text" id="qrPayloadInput" name="qrPayload" class="form-control border-start-0"
                                       placeholder="e.g. RSVP:42 or BOOKING:PB-1234..." autofocus autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-sm-4 col-md-3">
                            <button type="submit" id="btnSubmitCheckIn" class="btn btn-primary w-100">
                                <i class="bi bi-check2-circle me-1"></i>Check In
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <button type="button" id="btnToggleCamera" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-camera-video me-1"></i><span id="cameraBtnText">Open Camera Scanner</span>
                    </button>
                    <div id="cameraContainer" class="d-none mt-3 p-2 bg-white rounded border shadow-sm mx-auto mx-lg-0 ms-lg-auto" style="max-width:320px;">
                        <div id="qrReader" style="width:100%;min-height:220px;"></div>
                        <div class="small text-muted text-center mt-2">Point camera at player QR code</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Tabs -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom pt-3 pb-0 px-4">
            <ul class="nav nav-tabs card-header-tabs" id="checkInTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities-pane" type="button" role="tab">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>Activities
                        <span class="badge bg-secondary ms-1">@feed.Activities.Sum(a => a.TotalRsvps)</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button" role="tab">
                        <i class="bi bi-journal-text me-2 text-success"></i>Court Bookings
                        <span class="badge bg-secondary ms-1">@feed.Bookings.Count</span>
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="checkInTabsContent">

                <!-- 🏓 Activities Pane -->
                <div class="tab-pane fade show active" id="activities-pane" role="tabpanel">
                    @if (!feed.Activities.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-5 d-block mb-2"></i>
                            <p class="mb-0">No activities scheduled for @Model.SelectedDate.ToString("MMMM d, yyyy").</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-4">
                            @foreach (var act in feed.Activities)
                            {
                                <div class="border rounded-3 p-3 bg-white">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                                        <div>
                                            <h5 class="fw-bold mb-1">
                                                <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="text-decoration-none text-dark">
                                                    @act.Name
                                                </a>
                                            </h5>
                                            <div class="small text-muted">
                                                <i class="bi bi-clock me-1"></i>@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)
                                                <span class="mx-2">&bull;</span>
                                                <i class="bi bi-grid-3x3 me-1"></i>@act.Courts
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                @act.CheckedInCount / @act.TotalRsvps Checked In
                                            </span>
                                            @if (act.NoShowCount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    @act.NoShowCount No-Show
                                                </span>
                                            }
                                            <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Manage Roster">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>

                                    @if (!act.Players.Any())
                                    {
                                        <div class="text-muted small py-2">No registered players for this activity.</div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Player</th>
                                                        <th>Contact</th>
                                                        <th>Skill</th>
                                                        <th>Status</th>
                                                        <th>Check-In Time</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in act.Players)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                                                    {
                                                                        <img src="@p.AvatarUrl" alt="" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold" style="width:32px;height:32px;">
                                                                            @p.PlayerName.Substring(0, 1).ToUpper()
                                                                        </div>
                                                                    }
                                                                    <div>
                                                                        <div class="fw-semibold">@p.PlayerName</div>
                                                                        <div class="text-muted small" style="font-size:0.75rem;">RSVP #@p.RsvpId</div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="small">
                                                                <div>@p.Email</div>
                                                                @if (!string.IsNullOrEmpty(p.Mobile))
                                                                {
                                                                    <div class="text-muted" style="font-size:0.75rem;">@p.Mobile</div>
                                                                }
                                                            </td>
                                                            <td class="small">
                                                                @(p.SkillLevel?.ToString() ?? "—")
                                                            </td>
                                                            <td>
                                                                @if (p.Status == RsvpStatus.CheckedIn)
                                                                {
                                                                    <span class="badge bg-success px-2 py-1">
                                                                        <i class="bi bi-check2-circle me-1"></i>Checked In
                                                                    </span>
                                                                }
                                                                else if (p.Status == RsvpStatus.NoShow)
                                                                {
                                                                    <span class="badge bg-danger px-2 py-1">
                                                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td class="small text-muted">
                                                                @if (p.CheckedInAt.HasValue)
                                                                {
                                                                    <span>@p.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                                    @if (p.CheckInMethod == CheckInMethod.QrScan)
                                                                    {
                                                                        <span class="badge bg-light text-dark border ms-1" title="Checked in via QR Scanner"><i class="bi bi-qr-code"></i></span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span>—</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="btn-group btn-group-sm">
                                                                    @if (p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="CheckInRsvp" class="d-inline">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Check In">
                                                                                <i class="bi bi-check2 me-1"></i>Check In
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="MarkRsvpNoShowAsync" class="d-inline ms-1" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Mark No-Show">
                                                                                <i class="bi bi-x-circle"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                                                    {
                                                                        <form method="post" asp-page-handler="UndoRsvp" class="d-inline ms-1">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset to Pending">
                                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 📅 Bookings Pane -->
                <div class="tab-pane fade" id="bookings-pane" role="tabpanel">
                    @if (!feed.Bookings.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-5 d-block mb-2"></i>
                            <p class="mb-0">No court bookings scheduled for @Model.SelectedDate.ToString("MMMM d, yyyy").</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Booking Reference</th>
                                        <th>Customer</th>
                                        <th>Court</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Check-In Time</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in feed.Bookings)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                                    @b.BookingReference
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@b.CustomerName</div>
                                                <div class="text-muted small" style="font-size:0.75rem;">@b.CustomerEmail &bull; @b.CustomerPhone</div>
                                            </td>
                                            <td class="small fw-medium">@b.CourtName</td>
                                            <td class="small">
                                                @PickleBallBooking.Services.AppClock.To12HourRange(b.StartTime, b.EndTime)
                                            </td>
                                            <td>
                                                @if (b.IsCheckedIn)
                                                {
                                                    <span class="badge bg-success px-2 py-1">
                                                        <i class="bi bi-check2-circle me-1"></i>Checked In
                                                    </span>
                                                }
                                                else if (b.IsNoShow)
                                                {
                                                    <span class="badge bg-danger px-2 py-1">
                                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                                    </span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @if (b.CheckedInAt.HasValue)
                                                {
                                                    <span>@b.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                    @if (b.CheckInMethod == CheckInMethod.QrScan)
                                                    {
                                                        <span class="badge bg-light text-dark border ms-1" title="Checked in via QR Scanner"><i class="bi bi-qr-code"></i></span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    @if (!b.IsCheckedIn)
                                                    {
                                                        <form method="post" asp-page-handler="CheckInBooking" class="d-inline">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Check In Booking">
                                                                <i class="bi bi-check2 me-1"></i>Check In
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (!b.IsNoShow && !b.IsCheckedIn)
                                                    {
                                                        <form method="post" asp-page-handler="MarkBookingNoShow" class="d-inline ms-1" onsubmit="return confirm('Mark booking @b.BookingReference as No-Show?');">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Mark No-Show">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (b.IsCheckedIn || b.IsNoShow)
                                                    {
                                                        <form method="post" asp-page-handler="UndoBooking" class="d-inline ms-1">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset to Pending">
                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    let html5QrCode = null;
    let isCameraActive = false;

    const btnToggle = document.getElementById('btnToggleCamera');
    const cameraText = document.getElementById('cameraBtnText');
    const container = document.getElementById('cameraContainer');
    const payloadInput = document.getElementById('qrPayloadInput');
    const ajaxAlert = document.getElementById('ajax-alert');

    function showAlert(msg, isSuccess) {
        ajaxAlert.className = `alert ${isSuccess ? 'alert-success' : 'alert-danger'} d-flex align-items-center py-2 px-3 mb-4`;
        ajaxAlert.innerHTML = `<i class="bi ${isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2 fs-5"></i><div>${msg}</div>`;
        ajaxAlert.classList.remove('d-none');
    }

    async function handleQrPayload(decodedText) {
        if (!decodedText) return;
        payloadInput.value = decodedText;

        const formData = new FormData();
        formData.append('qrPayload', decodedText);
        formData.append('date', '@Model.SelectedDate.ToString("yyyy-MM-dd")');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch('?handler=ProcessQr', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const data = await resp.json();
            showAlert(data.message, data.success);

            if (data.success) {
                // Play notification audio tone if available
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                    osc.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.15);
                } catch(e) {}

                // Reload after short delay to refresh attendance feed
                setTimeout(() => window.location.reload(), 1200);
            }
        } catch(err) {
            // Fallback to normal form submit
            document.getElementById('checkInForm').submit();
        }
    }

    btnToggle.addEventListener('click', async () => {
        if (!isCameraActive) {
            container.classList.remove('d-none');
            cameraText.textContent = 'Close Camera Scanner';
            btnToggle.classList.replace('btn-outline-primary', 'btn-outline-secondary');
            isCameraActive = true;

            try {
                if (typeof Html5Qrcode !== 'undefined') {
                    html5QrCode = new Html5Qrcode("qrReader");
                    await html5QrCode.start(
                        { facingMode: "environment" },
                        { fps: 10, qrbox: { width: 220, height: 220 } },
                        (decodedText) => {
                            handleQrPayload(decodedText);
                        },
                        (errorMessage) => {}
                    );
                }
            } catch(e) {
                console.error("Camera access error:", e);
                showAlert("Could not access camera. Please check permissions or type the code manually.", false);
            }
        } else {
            if (html5QrCode) {
                await html5QrCode.stop().catch(() => {});
                html5QrCode = null;
            }
            container.classList.add('d-none');
            cameraText.textContent = 'Open Camera Scanner';
            btnToggle.classList.replace('btn-outline-secondary', 'btn-outline-primary');
            isCameraActive = false;
        }
    });
</script>
}
