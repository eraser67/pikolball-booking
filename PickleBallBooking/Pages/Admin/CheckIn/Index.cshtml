@page
@model PickleBallBooking.Pages.Admin.CheckIn.IndexModel
@using PickleBallBooking.Models
@using PickleBallBooking.Services
@{
    ViewData["Title"] = "Player Check-In";
    var feed = Model.Feed;
    var isToday = Model.SelectedDate == DateOnly.FromDateTime(DateTime.Today);
    var checkInPercent = feed.TotalExpected > 0 ? (int)Math.Round((double)feed.TotalCheckedIn / feed.TotalExpected * 100) : 0;
}

<div class="container-fluid py-3 py-md-4 px-2 px-sm-3 px-md-4">
    <!-- Header & Date Filter -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 mb-md-4">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h4 h3-md fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-qr-code-scan text-success me-2"></i>Player Check-In
                </h1>
                @if (isToday)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">Today</span>
                }
            </div>
            <p class="text-muted small mb-0 mt-1">Scan player QR passes or record attendance for activities and court bookings.</p>
        </div>

        <!-- Date Navigator -->
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-between justify-content-md-end flex-wrap">
            <div class="btn-group btn-group-sm flex-shrink-0">
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" title="Previous Day">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <a asp-page="./Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn @(isToday ? "btn-success" : "btn-outline-secondary") fw-semibold">
                    Today
                </a>
                <a asp-page="./Index" asp-route-date="@Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" title="Next Day">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <form method="get" class="d-flex align-items-center flex-grow-1 flex-md-grow-0">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" class="form-control form-control-sm w-100" style="min-width:135px;" />
            </form>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.StatusMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 flex-shrink-0"></i>
            <div class="small fw-medium">@Model.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    <div id="ajax-alert" class="alert d-none align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3" role="alert"></div>

    <!-- Summary Statistics Cards -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 checkin-stat-card">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-muted small fw-semibold text-uppercase tracking-wider">Total Expected</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-dark">@feed.TotalExpected</div>
                    <div class="text-muted small text-truncate" style="font-size:0.75rem;">@feed.Activities.Sum(a => a.TotalRsvps) acts &bull; @feed.Bookings.Count bookings</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-success border-4 checkin-stat-card">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-success small fw-semibold text-uppercase tracking-wider">Checked In</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-success">@feed.TotalCheckedIn</div>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(checkInPercent)%" aria-valuenow="@(checkInPercent)" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-warning border-4 checkin-stat-card">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-warning-emphasis small fw-semibold text-uppercase tracking-wider">Awaiting</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-warning-emphasis">@feed.TotalPending</div>
                    <div class="text-muted small" style="font-size:0.75rem;">Pending arrival</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 border-start border-danger border-4 checkin-stat-card">
                <div class="card-body p-2 p-sm-3">
                    <div class="text-danger small fw-semibold text-uppercase tracking-wider">No-Shows</div>
                    <div class="fs-4 fs-md-3 fw-bold mb-1 mt-1 text-danger">@feed.TotalNoShow</div>
                    <div class="text-muted small" style="font-size:0.75rem;">Recorded absent</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scanner & Quick Input Banner -->
    <div class="card border-0 shadow-sm mb-3 mb-md-4 rounded-3 scanner-hero">
        <div class="card-body p-3 p-sm-4">
            <div class="row g-3 g-md-4 align-items-center">
                <div class="col-12 col-lg-7">
                    <h5 class="fw-bold mb-1 d-flex align-items-center">
                        <i class="bi bi-upc-scan me-2 text-success"></i>Scan Pass or Enter Reference
                    </h5>
                    <p class="text-muted small mb-3">Scan with device camera, 2D barcode scanner, or type player RSVP ID / Booking Ref.</p>

                    <form id="checkInForm" method="post" asp-page-handler="ProcessQr" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                        <div class="col-12 col-sm-8 col-md-8">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-qr-code"></i></span>
                                <input type="text" id="qrPayloadInput" name="qrPayload" class="form-control border-start-0"
                                       placeholder="e.g. RSVP:42 or BOOKING:PB-1234..." autofocus autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4">
                            <button type="submit" id="btnSubmitCheckIn" class="btn btn-success w-100 fw-semibold d-flex align-items-center justify-content-center">
                                <i class="bi bi-check2-circle me-1"></i>Check In
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-12 col-lg-5 text-lg-end">
                    <button type="button" id="btnToggleCamera" class="btn btn-outline-success btn-sm w-100 w-lg-auto py-2 px-3 fw-semibold">
                        <i class="bi bi-camera-video me-1"></i><span id="cameraBtnText">Open Camera Scanner</span>
                    </button>
                    <div id="cameraContainer" class="d-none mt-3 p-2 bg-white rounded-3 border shadow-sm mx-auto mx-lg-0 ms-lg-auto" style="max-width:320px; width:100%;">
                        <div id="qrReader" style="width:100%;min-height:220px;"></div>
                        <div class="small text-muted text-center mt-2"><i class="bi bi-bullseye me-1"></i>Point camera at player QR code</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Tabs -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom pt-3 pb-0 px-3 px-md-4">
            <ul class="nav nav-tabs card-header-tabs" id="checkInTabs" role="tablist">
                <li class="nav-item flex-fill flex-sm-grow-0" role="presentation">
                    <button class="nav-link active fw-semibold w-100 d-flex align-items-center justify-content-center" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities-pane" type="button" role="tab">
                        <i class="bi bi-calendar-event me-2 text-success"></i>Activities
                        <span class="badge bg-secondary ms-2 rounded-pill">@feed.Activities.Sum(a => a.TotalRsvps)</span>
                    </button>
                </li>
                <li class="nav-item flex-fill flex-sm-grow-0" role="presentation">
                    <button class="nav-link fw-semibold w-100 d-flex align-items-center justify-content-center" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button" role="tab">
                        <i class="bi bi-journal-text me-2 text-primary"></i>Court Bookings
                        <span class="badge bg-secondary ms-2 rounded-pill">@feed.Bookings.Count</span>
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-2 p-sm-3 p-md-4">
            <div class="tab-content" id="checkInTabsContent">

                <!-- 🏓 Activities Pane -->
                <div class="tab-pane fade show active" id="activities-pane" role="tabpanel">
                    @if (!feed.Activities.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-5 d-block mb-2 text-secondary"></i>
                            <h6 class="fw-bold mb-1">No activities scheduled</h6>
                            <p class="small mb-0">No activities scheduled for @Model.SelectedDate.ToString("MMMM d, yyyy").</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 gap-md-4">
                            @foreach (var act in feed.Activities)
                            {
                                <div class="border rounded-3 p-3 bg-white activity-block shadow-none">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3 pb-2 border-bottom">
                                        <div class="min-w-0">
                                            <h5 class="fw-bold mb-1 text-truncate">
                                                <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="text-decoration-none text-dark hover-underline">
                                                    @act.Name
                                                </a>
                                            </h5>
                                            <div class="small text-muted d-flex align-items-center flex-wrap gap-2">
                                                <span><i class="bi bi-clock me-1 text-success"></i>@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)</span>
                                                <span class="text-muted">&bull;</span>
                                                <span><i class="bi bi-grid-3x3 me-1"></i>@act.Courts</span>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap w-100 w-sm-auto justify-content-between justify-content-sm-end">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                                @act.CheckedInCount / @act.TotalRsvps Checked In
                                            </span>
                                            @if (act.NoShowCount > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                                    @act.NoShowCount No-Show
                                                </span>
                                            }
                                            <a asp-page="/Admin/Activities/Detail" asp-route-id="@act.ActivityId" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Manage Roster">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>

                                    @if (!act.Players.Any())
                                    {
                                        <div class="text-muted small py-3 text-center">No registered players for this activity.</div>
                                    }
                                    else
                                    {
                                        <!-- Desktop Table View -->
                                        <div class="table-responsive d-none d-md-block">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small">
                                                    <tr>
                                                        <th>Player</th>
                                                        <th>Contact</th>
                                                        <th>Skill</th>
                                                        <th>Status</th>
                                                        <th>Check-In Time</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in act.Players)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-items-center gap-2">
                                                                    @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                                                    {
                                                                        <img src="@p.AvatarUrl" alt="" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold" style="width:32px;height:32px;">
                                                                            @p.PlayerName.Substring(0, 1).ToUpper()
                                                                        </div>
                                                                    }
                                                                    <div>
                                                                        <div class="fw-semibold">@p.PlayerName</div>
                                                                        <div class="text-muted small" style="font-size:0.75rem;">RSVP #@p.RsvpId</div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="small">
                                                                <div>@p.Email</div>
                                                                @if (!string.IsNullOrEmpty(p.Mobile))
                                                                {
                                                                    <div class="text-muted" style="font-size:0.75rem;">@p.Mobile</div>
                                                                }
                                                            </td>
                                                            <td class="small">
                                                                @(p.SkillLevel?.ToString() ?? "—")
                                                            </td>
                                                            <td>
                                                                @if (p.Status == RsvpStatus.CheckedIn)
                                                                {
                                                                    <span class="badge bg-success px-2 py-1">
                                                                        <i class="bi bi-check2-circle me-1"></i>Checked In
                                                                    </span>
                                                                }
                                                                else if (p.Status == RsvpStatus.NoShow)
                                                                {
                                                                    <span class="badge bg-danger px-2 py-1">
                                                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td class="small text-muted">
                                                                @if (p.CheckedInAt.HasValue)
                                                                {
                                                                    <span>@p.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                                    @if (p.CheckInMethod == CheckInMethod.QrScan)
                                                                    {
                                                                        <span class="badge bg-light text-dark border ms-1" title="Checked in via QR Scanner"><i class="bi bi-qr-code"></i></span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span>—</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="btn-group btn-group-sm">
                                                                    @if (p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="CheckInRsvp" class="d-inline">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Check In">
                                                                                <i class="bi bi-check2 me-1"></i>Check In
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                                                    {
                                                                        <form method="post" asp-page-handler="MarkRsvpNoShowAsync" class="d-inline ms-1" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Mark No-Show">
                                                                                <i class="bi bi-x-circle"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                    @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                                                    {
                                                                        <form method="post" asp-page-handler="UndoRsvp" class="d-inline ms-1">
                                                                            <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset to Pending">
                                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                                            </button>
                                                                        </form>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Mobile Card List View -->
                                        <div class="d-md-none d-flex flex-column gap-2">
                                            @foreach (var p in act.Players)
                                            {
                                                <div class="border rounded-2 p-2 p-sm-3 bg-light-subtle">
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                        <div class="d-flex align-items-center gap-2 min-w-0">
                                                            @if (!string.IsNullOrEmpty(p.AvatarUrl))
                                                            {
                                                                <img src="@p.AvatarUrl" alt="" class="rounded-circle flex-shrink-0" style="width:34px;height:34px;object-fit:cover;" />
                                                            }
                                                            else
                                                            {
                                                                <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center text-secondary small fw-bold flex-shrink-0" style="width:34px;height:34px;">
                                                                    @p.PlayerName.Substring(0, 1).ToUpper()
                                                                </div>
                                                            }
                                                            <div class="min-w-0">
                                                                <div class="fw-semibold small text-truncate">@p.PlayerName</div>
                                                                <div class="text-muted small" style="font-size:0.75rem;">RSVP #@p.RsvpId &bull; @(p.SkillLevel?.ToString() ?? "Open")</div>
                                                            </div>
                                                        </div>
                                                        <div class="flex-shrink-0">
                                                            @if (p.Status == RsvpStatus.CheckedIn)
                                                            {
                                                                <span class="badge bg-success small"><i class="bi bi-check2 me-1"></i>In</span>
                                                            }
                                                            else if (p.Status == RsvpStatus.NoShow)
                                                            {
                                                                <span class="badge bg-danger small">No-Show</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">Pending</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="small text-muted mb-2 d-flex flex-wrap gap-x-3 gap-y-1">
                                                        <span><i class="bi bi-envelope me-1"></i>@p.Email</span>
                                                        @if (!string.IsNullOrEmpty(p.Mobile))
                                                        {
                                                            <span><i class="bi bi-phone me-1"></i>@p.Mobile</span>
                                                        }
                                                        @if (p.CheckedInAt.HasValue)
                                                        {
                                                            <span class="text-success"><i class="bi bi-clock-check me-1"></i>@p.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                        }
                                                    </div>

                                                    <div class="d-flex align-items-center justify-content-end gap-1 pt-2 border-top">
                                                        @if (p.Status != RsvpStatus.CheckedIn)
                                                        {
                                                            <form method="post" asp-page-handler="CheckInRsvp" class="flex-fill">
                                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                <button type="submit" class="btn btn-success btn-sm w-100 py-1" title="Check In">
                                                                    <i class="bi bi-check2 me-1"></i>Check In
                                                                </button>
                                                            </form>
                                                        }
                                                        @if (p.Status != RsvpStatus.NoShow && p.Status != RsvpStatus.CheckedIn)
                                                        {
                                                            <form method="post" asp-page-handler="MarkRsvpNoShowAsync" class="flex-shrink-0" onsubmit="return confirm('Mark @p.PlayerName as No-Show?');">
                                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-3" title="Mark No-Show">
                                                                    <i class="bi bi-x-circle me-1"></i>No-Show
                                                                </button>
                                                            </form>
                                                        }
                                                        @if (p.Status == RsvpStatus.CheckedIn || p.Status == RsvpStatus.NoShow)
                                                        {
                                                            <form method="post" asp-page-handler="UndoRsvp" class="w-100">
                                                                <input type="hidden" name="rsvpId" value="@p.RsvpId" />
                                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100 py-1" title="Reset to Pending">
                                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Pending
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 📅 Bookings Pane -->
                <div class="tab-pane fade" id="bookings-pane" role="tabpanel">
                    @if (!feed.Bookings.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-5 d-block mb-2 text-secondary"></i>
                            <h6 class="fw-bold mb-1">No court bookings</h6>
                            <p class="small mb-0">No court bookings scheduled for @Model.SelectedDate.ToString("MMMM d, yyyy").</p>
                        </div>
                    }
                    else
                    {
                        <!-- Desktop Table View -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Booking Reference</th>
                                        <th>Customer</th>
                                        <th>Court</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Check-In Time</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in feed.Bookings)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                                    @b.BookingReference
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@b.CustomerName</div>
                                                <div class="text-muted small" style="font-size:0.75rem;">@b.CustomerEmail &bull; @b.CustomerPhone</div>
                                            </td>
                                            <td class="small fw-medium">@b.CourtName</td>
                                            <td class="small">
                                                @PickleBallBooking.Services.AppClock.To12HourRange(b.StartTime, b.EndTime)
                                            </td>
                                            <td>
                                                @if (b.IsCheckedIn)
                                                {
                                                    <span class="badge bg-success px-2 py-1">
                                                        <i class="bi bi-check2-circle me-1"></i>Checked In
                                                    </span>
                                                }
                                                else if (b.IsNoShow)
                                                {
                                                    <span class="badge bg-danger px-2 py-1">
                                                        <i class="bi bi-x-circle me-1"></i>No-Show
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                                    </span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @if (b.CheckedInAt.HasValue)
                                                {
                                                    <span>@b.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                                    @if (b.CheckInMethod == CheckInMethod.QrScan)
                                                    {
                                                        <span class="badge bg-light text-dark border ms-1" title="Checked in via QR Scanner"><i class="bi bi-qr-code"></i></span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    @if (!b.IsCheckedIn)
                                                    {
                                                        <form method="post" asp-page-handler="CheckInBooking" class="d-inline">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-success btn-sm py-1 px-2" title="Check In Booking">
                                                                <i class="bi bi-check2 me-1"></i>Check In
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (!b.IsNoShow && !b.IsCheckedIn)
                                                    {
                                                        <form method="post" asp-page-handler="MarkBookingNoShow" class="d-inline ms-1" onsubmit="return confirm('Mark booking @b.BookingReference as No-Show?');">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Mark No-Show">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (b.IsCheckedIn || b.IsNoShow)
                                                    {
                                                        <form method="post" asp-page-handler="UndoBooking" class="d-inline ms-1">
                                                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="btn btn-outline-secondary btn-sm py-1 px-2" title="Reset to Pending">
                                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card List View -->
                        <div class="d-md-none d-flex flex-column gap-2">
                            @foreach (var b in feed.Bookings)
                            {
                                <div class="border rounded-2 p-2 p-sm-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <div>
                                            <div class="fw-semibold small">@b.CourtName</div>
                                            <span class="badge bg-light text-dark border font-monospace small">@b.BookingReference</span>
                                        </div>
                                        <div>
                                            @if (b.IsCheckedIn)
                                            {
                                                <span class="badge bg-success small"><i class="bi bi-check2 me-1"></i>In</span>
                                            }
                                            else if (b.IsNoShow)
                                            {
                                                <span class="badge bg-danger small">No-Show</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">Pending</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="small text-muted mb-2 d-flex flex-column gap-1">
                                        <div><i class="bi bi-person me-1"></i><strong>@b.CustomerName</strong></div>
                                        <div class="d-flex flex-wrap gap-x-2">
                                            <span><i class="bi bi-envelope me-1"></i>@b.CustomerEmail</span>
                                            @if (!string.IsNullOrEmpty(b.CustomerPhone))
                                            {
                                                <span><i class="bi bi-phone me-1"></i>@b.CustomerPhone</span>
                                            }
                                        </div>
                                        <div>
                                            <i class="bi bi-clock me-1 text-success"></i>@PickleBallBooking.Services.AppClock.To12HourRange(b.StartTime, b.EndTime)
                                            @if (b.CheckedInAt.HasValue)
                                            {
                                                <span class="ms-2 text-success"><i class="bi bi-patch-check me-1"></i>@b.CheckedInAt.Value.ToLocalTime().ToString("h:mm tt")</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-end gap-1 pt-2 border-top">
                                        @if (!b.IsCheckedIn)
                                        {
                                            <form method="post" asp-page-handler="CheckInBooking" class="flex-fill">
                                                <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-success btn-sm w-100 py-1" title="Check In Booking">
                                                    <i class="bi bi-check2 me-1"></i>Check In
                                                </button>
                                            </form>
                                        }
                                        @if (!b.IsNoShow && !b.IsCheckedIn)
                                        {
                                            <form method="post" asp-page-handler="MarkBookingNoShow" class="flex-shrink-0" onsubmit="return confirm('Mark booking @b.BookingReference as No-Show?');">
                                                <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-3" title="Mark No-Show">
                                                    <i class="bi bi-x-circle me-1"></i>No-Show
                                                </button>
                                            </form>
                                        }
                                        @if (b.IsCheckedIn || b.IsNoShow)
                                        {
                                            <form method="post" asp-page-handler="UndoBooking" class="w-100">
                                                <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100 py-1" title="Reset to Pending">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Pending
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
    let html5QrCode = null;
    let isCameraActive = false;

    const btnToggle = document.getElementById('btnToggleCamera');
    const cameraText = document.getElementById('cameraBtnText');
    const container = document.getElementById('cameraContainer');
    const payloadInput = document.getElementById('qrPayloadInput');
    const ajaxAlert = document.getElementById('ajax-alert');

    function showAlert(msg, isSuccess) {
        ajaxAlert.className = `alert ${isSuccess ? 'alert-success' : 'alert-danger'} d-flex align-items-center py-2 px-3 mb-3 mb-md-4 shadow-sm border-0 rounded-3`;
        ajaxAlert.innerHTML = `<i class="bi ${isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2 fs-5 flex-shrink-0"></i><div class="small fw-medium">${msg}</div>`;
        ajaxAlert.classList.remove('d-none');
    }

    async function handleQrPayload(decodedText) {
        if (!decodedText) return;
        payloadInput.value = decodedText;

        const formData = new FormData();
        formData.append('qrPayload', decodedText);
        formData.append('date', '@Model.SelectedDate.ToString("yyyy-MM-dd")');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch('?handler=ProcessQr', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const data = await resp.json();
            showAlert(data.message, data.success);

            if (data.success) {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.15);
                } catch(e) {}

                setTimeout(() => window.location.reload(), 1200);
            }
        } catch(err) {
            document.getElementById('checkInForm').submit();
        }
    }

    btnToggle.addEventListener('click', async () => {
        if (!isCameraActive) {
            container.classList.remove('d-none');
            cameraText.textContent = 'Close Camera Scanner';
            btnToggle.classList.replace('btn-outline-success', 'btn-outline-secondary');
            isCameraActive = true;

            try {
                if (typeof Html5Qrcode !== 'undefined') {
                    html5QrCode = new Html5Qrcode("qrReader");
                    await html5QrCode.start(
                        { facingMode: "environment" },
                        { fps: 10, qrbox: { width: 220, height: 220 } },
                        (decodedText) => {
                            handleQrPayload(decodedText);
                        },
                        (errorMessage) => {}
                    );
                }
            } catch(e) {
                console.error("Camera access error:", e);
                showAlert("Could not access camera. Please check permissions or type the code manually.", false);
            }
        } else {
            if (html5QrCode) {
                await html5QrCode.stop().catch(() => {});
                html5QrCode = null;
            }
            container.classList.add('d-none');
            cameraText.textContent = 'Open Camera Scanner';
            btnToggle.classList.replace('btn-outline-secondary', 'btn-outline-success');
            isCameraActive = false;
        }
    });
</script>
}

