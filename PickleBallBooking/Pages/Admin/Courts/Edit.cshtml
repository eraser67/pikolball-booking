@page "/Admin/Courts/Edit/{id:int}"
@model PickleBallBooking.Pages.Admin.Courts.EditModel
@{
    ViewData["Title"] = "Edit Court";
}

<h1>Edit Court</h1>

@if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">

        @* ── Current image preview + remove (standalone form, OUTSIDE main form) ── *@
        @if (Model.CurrentImageUrl is not null)
        {
            <div class="mb-4 p-3 border rounded" style="background:#f8f9fa;">
                <p class="fw-semibold mb-2">Current Image</p>
                <div class="d-flex align-items-start gap-3">
                    <img src="@Model.CurrentImageUrl"
                         alt="Current court image"
                         style="width:120px;height:120px;object-fit:cover;border-radius:8px;border:1px solid #dee2e6;" />
                    <div>
                        <p class="text-muted small mb-2">Upload a new file below to replace it,<br />or remove it entirely.</p>
                        <form method="post"
                              asp-page-handler="RemoveImage"
                              asp-route-id="@Model.Id">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Remove Image
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* ── Main edit form ── *@
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Court.Name" class="form-label fw-semibold"></label>
                <input asp-for="Court.Name" class="form-control" />
                <span asp-validation-for="Court.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Court.Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Court.Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Court.Description" class="text-danger"></span>
            </div>

            <hr class="my-3" />
            <h5 class="mb-3">
                @(Model.CurrentImageUrl is not null ? "Replace Image" : "Upload Image")
            </h5>

            <div class="mb-3">
                <label asp-for="Court.Image" class="form-label fw-semibold"></label>
                <input asp-for="Court.Image" type="file" class="form-control"
                       accept="image/jpeg,image/png,image/webp"
                       id="courtImageInput" />
                <div class="form-text">
                    Maximum file size: <strong>3 MB</strong>.
                    Supported formats: JPG, PNG, WEBP.
                    Leave blank to keep the current image.
                </div>
                <div id="courtImageSizeError" class="text-danger small mt-1" style="display:none;">
                    File too large. Maximum allowed size is 3 MB.
                </div>
                <span asp-validation-for="Court.Image" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const MAX_BYTES = 3 * 1024 * 1024; // 3 MB
            const input = document.getElementById('courtImageInput');
            const error = document.getElementById('courtImageSizeError');
            const form  = input ? input.closest('form') : null;

            if (!input) return;

            input.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > MAX_BYTES) {
                    error.style.display = 'block';
                    this.value = '';   // clear the selection
                } else {
                    error.style.display = 'none';
                }
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (input.files.length > 0 && input.files[0].size > MAX_BYTES) {
                        error.style.display = 'block';
                        e.preventDefault();
                    }
                });
            }
        })();
    </script>
}
