@page "/Admin/Courts/Create"
@model PickleBallBooking.Pages.Admin.Courts.CreateModel
@{
    ViewData["Title"] = "Add Court";
}

<h1>Add Court</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Court.Name" class="form-label fw-semibold"></label>
                <input asp-for="Court.Name" class="form-control" placeholder="e.g. Court 1" />
                <span asp-validation-for="Court.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Court.Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Court.Description" class="form-control" rows="2"
                          placeholder="Optional description"></textarea>
                <span asp-validation-for="Court.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Court.Image" class="form-label fw-semibold"></label>
                <input asp-for="Court.Image" type="file" class="form-control"
                       accept="image/jpeg,image/png,image/webp"
                       id="courtImageInput" />
                <div class="form-text">
                    Optional. Maximum file size: <strong>3 MB</strong>.
                    Supported formats: JPG, PNG, WEBP.
                </div>
                <div id="courtImageSizeError" class="text-danger small mt-1" style="display:none;">
                    File too large. Maximum allowed size is 3 MB.
                </div>
                <span asp-validation-for="Court.Image" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create Court</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const MAX_BYTES = 3 * 1024 * 1024; // 3 MB
            const input = document.getElementById('courtImageInput');
            const error = document.getElementById('courtImageSizeError');
            const form  = input ? input.closest('form') : null;

            if (!input) return;

            input.addEventListener('change', function () {
                if (this.files.length > 0 && this.files[0].size > MAX_BYTES) {
                    error.style.display = 'block';
                    this.value = '';   // clear the selection
                } else {
                    error.style.display = 'none';
                }
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (input.files.length > 0 && input.files[0].size > MAX_BYTES) {
                        error.style.display = 'block';
                        e.preventDefault();
                    }
                });
            }
        })();
    </script>
}
