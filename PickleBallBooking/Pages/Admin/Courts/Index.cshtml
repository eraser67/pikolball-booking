@page "/Admin/Courts"
@model PickleBallBooking.Pages.Admin.Courts.IndexModel
@{
    ViewData["Title"] = "Manage Courts";
}

<h1>Manage Courts</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">Add Court</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var court in Model.Courts)
        {
            <tr>
                <td>@court.Name</td>
                <td>@court.Description</td>
                <td>
                    @if (court.Status == PickleBallBooking.Models.CourtStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-page="Edit" asp-route-id="@court.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@court.Id" class="d-inline">
                        @if (court.Status == PickleBallBooking.Models.CourtStatus.Active)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@court.Id" class="d-inline"
                          onsubmit="return confirm('Delete court &quot;@court.Name&quot;? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
