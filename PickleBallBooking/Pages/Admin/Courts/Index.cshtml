@page "/Admin/Courts"
@model PickleBallBooking.Pages.Admin.Courts.IndexModel
@{
    ViewData["Title"] = "Manage Courts";
}

<h1>Manage Courts</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-page="Create" class="btn btn-primary">+ Add Court</a>
</p>

@if (!Model.Courts.Any())
{
    <div class="alert alert-secondary">No courts have been added yet.</div>
}
else
{
    <table class="pb-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th><span class="pb-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var court in Model.Courts)
            {
                var imgUrl = Model.CourtImageUrls.GetValueOrDefault(court.Id);
                <tr>
                    <td data-label="Image" style="width:80px">
                        @if (imgUrl is not null)
                        {
                            <img src="@imgUrl"
                                 alt="@court.Name"
                                 style="width:64px;height:64px;object-fit:cover;border-radius:6px;"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div style="width:64px;height:64px;background:#e9ecef;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#adb5bd;font-size:1.5rem;"
                                 title="No image">
                                &#x1F3D8;
                            </div>
                        }
                    </td>
                    <td data-label="Description">
                        <div>@court.Description</div>
                        @if (!string.IsNullOrWhiteSpace(court.Features))
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var spec in court.Features.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-light text-dark border font-monospace" style="font-size:0.7rem;">@spec</span>
                                }
                            </div>
                        }
                    </td>
                    <td data-label="Status">
                        @if (court.Status == PickleBallBooking.Models.CourtStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                            @if (!string.IsNullOrWhiteSpace(court.MaintenanceNote))
                            {
                                <div class="small text-muted mt-1" style="max-width: 200px;">
                                    <i class="bi bi-tools me-1 text-warning"></i>@court.MaintenanceNote
                                </div>
                            }
                        }
                    </td>
                    <td class="pb-actions-cell">
                        <div class="pb-actions">
                            <a asp-page="Edit" asp-route-id="@court.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@court.Id">
                                @if (court.Status == PickleBallBooking.Models.CourtStatus.Active)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                }
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@court.Id"
                                  data-pb-confirm="Delete court &quot;@court.Name&quot;? This cannot be undone."
                                  data-pb-confirm-title="Delete court"
                                  data-pb-confirm-ok="Delete">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
