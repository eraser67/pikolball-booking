@page "/Activities/Leaderboard"
@model PickleBallBooking.Pages.Activities.LeaderboardModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Competitive Leaderboards";
    var lb = Model.Leaderboard;
    var topPlayer = lb.Rankings.FirstOrDefault();
    var topPointDiff = lb.Rankings.OrderByDescending(r => r.PointDifferential).FirstOrDefault();
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Activities/Index">Activities</a></li>
            <li class="breadcrumb-item active" aria-current="page">Leaderboard</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1 d-flex align-items-center">
                <i class="bi bi-trophy-fill text-warning me-2"></i>Competitive Leaderboard
            </h1>
            <p class="text-muted small mb-0">Official competitive standings and rankings calculated exclusively from finalized match results.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Activities/Index" class="btn btn-outline-success btn-sm d-flex align-items-center">
                <i class="bi bi-calendar-event me-1"></i>Join Activities
            </a>
            <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center" onclick="window.print();">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Summary Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light-subtle">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Finalized Matches</div>
                    <div class="fs-3 fw-bold text-dark mt-1">@lb.TotalFinalizedMatches</div>
                    <div class="small text-muted" style="font-size:0.75rem;">Official Games</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light-subtle">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Ranked Players</div>
                    <div class="fs-3 fw-bold text-primary mt-1">@lb.TotalActivePlayers</div>
                    <div class="small text-muted" style="font-size:0.75rem;">Active Competitors</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light-subtle">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Top Win Rate</div>
                    <div class="fs-3 fw-bold text-success mt-1">@(topPlayer != null ? $"{topPlayer.WinPercentage:F1}%" : "—")</div>
                    <div class="small text-truncate text-muted" style="font-size:0.75rem;" title="@(topPlayer?.DisplayName ?? "")">
                        @(topPlayer?.DisplayName ?? "No matches yet")
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light-subtle">
                <div class="card-body p-3 text-center">
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Top Differential</div>
                    <div class="fs-3 fw-bold text-info mt-1">@(topPointDiff != null ? $"{(topPointDiff.PointDifferential >= 0 ? "+" : "")}{topPointDiff.PointDifferential}" : "—")</div>
                    <div class="small text-truncate text-muted" style="font-size:0.75rem;" title="@(topPointDiff?.DisplayName ?? "")">
                        @(topPointDiff?.DisplayName ?? "No matches yet")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top 3 Podium (Shown when players exist) -->
    @if (lb.TopPodium.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-gradient p-3 p-md-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #edf2f7 100%);">
            <div class="text-center mb-3">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill small fw-bold">
                    <i class="bi bi-award-fill me-1"></i>Competitive Podium
                </span>
            </div>
            <div class="row g-3 justify-content-center align-items-end text-center">
                <!-- 2nd Place -->
                @if (lb.TopPodium.Count > 1)
                {
                    var p2 = lb.TopPodium[1];
                    <div class="col-12 col-sm-4 order-2 order-sm-1">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-top border-4 border-secondary">
                            <div class="fs-2 mb-1">🥈</div>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-0 small mb-2">2nd Place</span>
                            <h6 class="fw-bold text-dark text-truncate mb-1">@p2.DisplayName</h6>
                            @if (p2.SkillLevel.HasValue)
                            {
                                <span class="badge bg-light text-muted border mb-2 small" style="font-size:0.7rem;">@p2.SkillLevel</span>
                            }
                            <div class="fs-5 fw-bold text-dark mt-1">@p2.WinPercentage.ToString("F1")% Win</div>
                            <div class="small text-muted">@p2.Wins W - @p2.Losses L &bull; @(p2.PointDifferential >= 0 ? "+" : "")@p2.PointDifferential diff</div>
                        </div>
                    </div>
                }

                <!-- 1st Place (Champion) -->
                @if (lb.TopPodium.Count > 0)
                {
                    var p1 = lb.TopPodium[0];
                    <div class="col-12 col-sm-4 order-1 order-sm-2 mb-2 mb-sm-0">
                        <div class="card border-0 shadow rounded-3 p-3 bg-white h-100 border-top border-4 border-warning transform-scale" style="transform: scale(1.03);">
                            <div class="fs-1 mb-1">👑</div>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1 small fw-bold mb-2">1st Place &bull; Leader</span>
                            <h5 class="fw-bold text-dark text-truncate mb-1">@p1.DisplayName</h5>
                            @if (p1.SkillLevel.HasValue)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle mb-2 small">@p1.SkillLevel</span>
                            }
                            <div class="fs-4 fw-bold text-success mt-1">@p1.WinPercentage.ToString("F1")% Win</div>
                            <div class="small text-muted fw-semibold">@p1.Wins W - @p1.Losses L &bull; @(p1.PointDifferential >= 0 ? "+" : "")@p1.PointDifferential diff</div>
                        </div>
                    </div>
                }

                <!-- 3rd Place -->
                @if (lb.TopPodium.Count > 2)
                {
                    var p3 = lb.TopPodium[2];
                    <div class="col-12 col-sm-4 order-3 order-sm-3">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-top border-4 border-bronze">
                            <div class="fs-2 mb-1">🥉</div>
                            <span class="badge bg-light text-muted border rounded-pill px-2 py-0 small mb-2">3rd Place</span>
                            <h6 class="fw-bold text-dark text-truncate mb-1">@p3.DisplayName</h6>
                            @if (p3.SkillLevel.HasValue)
                            {
                                <span class="badge bg-light text-muted border mb-2 small" style="font-size:0.7rem;">@p3.SkillLevel</span>
                            }
                            <div class="fs-5 fw-bold text-dark mt-1">@p3.WinPercentage.ToString("F1")% Win</div>
                            <div class="small text-muted">@p3.Wins W - @p3.Losses L &bull; @(p3.PointDifferential >= 0 ? "+" : "")@p3.PointDifferential diff</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Play Format</label>
                    <select name="Format" class="form-select form-select-sm" onchange="this.form.submit();">
                        <option value="">All Formats</option>
                        <option value="@((int)RoundRobinFormat.RotatingPartners)" selected="@(Model.Format == RoundRobinFormat.RotatingPartners)">Rotating Partners (Social)</option>
                        <option value="@((int)RoundRobinFormat.FixedPartners)" selected="@(Model.Format == RoundRobinFormat.FixedPartners)">Fixed Partners (Doubles)</option>
                        <option value="@((int)RoundRobinFormat.Singles)" selected="@(Model.Format == RoundRobinFormat.Singles)">Singles (1 vs 1)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Timeframe</label>
                    <select name="Timeframe" class="form-select form-select-sm" onchange="this.form.submit();">
                        <option value="all" selected="@(Model.Timeframe == "all")">All Time</option>
                        <option value="month" selected="@(Model.Timeframe == "month")">This Month</option>
                        <option value="year" selected="@(Model.Timeframe == "year")">This Year</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Player Search</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="Search" value="@Model.Search" placeholder="Search player name..." class="form-control" />
                    </div>
                </div>

                <div class="col-md-2 d-flex align-items-end gap-1 pt-3 pt-md-0">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill fw-semibold">Filter</button>
                    @if (Model.Format.HasValue || Model.Timeframe != "all" || !string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-page="/Activities/Leaderboard" class="btn btn-outline-secondary btn-sm" title="Clear filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Complete Leaderboard Rankings Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ol text-success me-2"></i>Rankings Table
            </h5>
            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                @lb.Rankings.Count Competitors
            </span>
        </div>
        <div class="card-body p-0">
            @if (lb.Rankings.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-trophy text-muted" style="font-size:2.5rem;"></i>
                    <h6 class="fw-bold text-dark mt-3 mb-1">No Finalized Match Records Found</h6>
                    <p class="text-muted small mb-3">
                        @if (!string.IsNullOrEmpty(Model.Search) || Model.Format.HasValue)
                        {
                            <span>No players matched your filter criteria. Try resetting your search or format filter.</span>
                        }
                        else
                        {
                            <span>Standings and leaderboards are calculated exclusively from finalized matches in Round Robin activities.</span>
                        }
                    </p>
                    <a asp-page="/Activities/Index" class="btn btn-outline-success btn-sm px-3">
                        <i class="bi bi-calendar-event me-1"></i>View Upcoming Activities
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-uppercase fw-semibold" style="font-size:0.75rem;">
                            <tr>
                                <th class="text-center" style="width: 50px;">Rank</th>
                                <th>Player</th>
                                <th class="text-center" title="Matches Played">MP</th>
                                <th class="text-center" title="Wins">W</th>
                                <th class="text-center" title="Losses">L</th>
                                <th class="text-center" title="Draws">D</th>
                                <th class="text-center" title="Points For">PF</th>
                                <th class="text-center" title="Points Against">PA</th>
                                <th class="text-center" title="Point Differential">+/-</th>
                                <th class="text-center" title="Win Percentage">Win %</th>
                                <th class="text-center" style="width: 120px;">Form</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in lb.Rankings)
                            {
                                var diffColor = p.PointDifferential > 0 ? "text-success fw-bold" : (p.PointDifferential < 0 ? "text-danger" : "text-muted");
                                var rowBg = p.Rank == 1 ? "table-warning-subtle" : (p.Rank <= 3 ? "bg-light-subtle" : "");

                                <tr class="@rowBg">
                                    <td class="text-center fw-bold">
                                        @if (p.Rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;">1</span>
                                        }
                                        else if (p.Rank == 2)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;">2</span>
                                        }
                                        else if (p.Rank == 3)
                                        {
                                            <span class="badge bg-bronze text-dark rounded-circle p-2" style="width:26px;height:26px;display:inline-flex;align-items:center;justify-content:center;background-color:#f4d1ae;">3</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@p.Rank</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@p.DisplayName</div>
                                        @if (p.SkillLevel.HasValue)
                                        {
                                            <span class="badge bg-light text-muted border py-0 px-1" style="font-size:0.65rem;">@p.SkillLevel</span>
                                        }
                                    </td>
                                    <td class="text-center fw-semibold">@p.MatchesPlayed</td>
                                    <td class="text-center text-success fw-bold">@p.Wins</td>
                                    <td class="text-center text-danger">@p.Losses</td>
                                    <td class="text-center text-muted">@p.Draws</td>
                                    <td class="text-center">@p.PointsScored</td>
                                    <td class="text-center text-muted">@p.PointsConceded</td>
                                    <td class="text-center @diffColor">
                                        @(p.PointDifferential > 0 ? "+" : "")@p.PointDifferential
                                    </td>
                                    <td class="text-center">
                                        <div class="fw-bold text-dark">@p.WinPercentage.ToString("F1")%</div>
                                        <div class="progress mt-1" style="height: 4px; min-width: 60px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @p.WinPercentage%;" aria-valuenow="@p.WinPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (p.RecentForm.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                @foreach (var res in p.RecentForm)
                                                {
                                                    var formBadge = res == "W" ? "bg-success" : (res == "L" ? "bg-danger" : "bg-secondary");
                                                    <span class="badge @formBadge rounded-1 px-1 py-0" style="font-size:0.65rem;" title="@(res == "W" ? "Win" : (res == "L" ? "Loss" : "Draw"))">@res</span>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
<style>
.border-bronze {
    border-color: #cd7f32 !important;
}
.bg-bronze {
    background-color: #f4d1ae !important;
}
.table-warning-subtle {
    background-color: rgba(255, 193, 7, 0.08) !important;
}
.bg-light-subtle {
    background-color: rgba(0, 0, 0, 0.02) !important;
}
@@media print {
    nav, .btn, form {
        display: none !important;
    }
}
</style>
}
