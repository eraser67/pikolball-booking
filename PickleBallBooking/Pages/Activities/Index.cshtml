@page "/Activities"
@model PickleBallBooking.Pages.Activities.IndexModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Activities";
}
@functions {
    static string StatusBadge(ActivityStatus s) => s switch {
        ActivityStatus.RegistrationOpen   => "bg-success",
        ActivityStatus.Published          => "bg-info text-dark",
        ActivityStatus.Full               => "bg-warning text-dark",
        ActivityStatus.RegistrationClosed => "bg-secondary",
        _                                 => "bg-light text-dark"
    };
    static string SkillIcon(ActivitySkillLevel sk) => sk switch {
        ActivitySkillLevel.Beginner     => "🟢",
        ActivitySkillLevel.Intermediate => "🟡",
        ActivitySkillLevel.Advanced     => "🔴",
        _                               => "🔵"
    };
}

<div class="container py-4">

    <!-- Flash Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-0">
                <i class="bi bi-calendar-event text-success me-2"></i>Upcoming Activities
            </h1>
            <p class="text-muted small mt-1 mb-0">Browse, join organised pickleball activities, and view waitlist status.</p>
        </div>
        <div>
            <a asp-page="/Activities/Leaderboard" class="btn btn-outline-dark btn-sm fw-semibold shadow-sm">
                <i class="bi bi-trophy-fill text-warning me-1"></i>Leaderboard
            </a>
        </div>
    </div>

    @if (!Model.Activities.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x text-muted" style="font-size:2.5rem;"></i>
                <p class="text-muted mt-3 mb-0">No upcoming activities right now. Check back soon!</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var a in Model.Activities)
            {
                var hasUserRsvp = Model.UserRsvps.TryGetValue(a.Id, out var userRsvp);
                Model.RsvpCounts.TryGetValue(a.Id, out var counts);
                var isFull = a.MaxCapacity > 0 && counts.Confirmed >= a.MaxCapacity;
                var effectiveStatus = a.GetEffectiveStatus();
                var isRegOpen = a.IsRegistrationOpen();
                var isPending = a.IsRegistrationPending();
                var isClosed = a.IsRegistrationClosed();
                var isOrgAdmin = Model.AdminActivityIds.Contains(a.Id);

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm activity-card">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge @StatusBadge(effectiveStatus) rounded-pill small mb-2">@effectiveStatus.ToString().Replace("Registration", "Reg. ")</span>
                                    <h2 class="h6 fw-bold mb-0">@a.Name</h2>
                                    <div class="small text-muted mt-1">@a.Format</div>
                                </div>
                                <div class="text-end flex-shrink-0 ms-2">
                                    @if (a.PricePerPlayer == 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fw-semibold">Free</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-success">₱@a.PricePerPlayer.ToString("N0")</span>
                                        <div class="text-muted" style="font-size:0.7rem;">per player</div>
                                    }
                                </div>
                            </div>

                            <!-- Details -->
                            <ul class="list-unstyled small mb-3">
                                <li class="mb-1">
                                    <i class="bi bi-calendar3 text-muted me-2"></i>
                                    <strong>@a.Date.ToString("dddd, MMM d")</strong>
                                </li>
                                <li class="mb-1">
                                    <i class="bi bi-clock text-muted me-2"></i>
                                    @PickleBallBooking.Services.AppClock.To12HourRange(a.StartTime, a.EndTime)
                                </li>
                                @if (a.ActivityCourts.Any())
                                {
                                    <li class="mb-1">
                                        <i class="bi bi-grid text-muted me-2"></i>
                                        @string.Join(", ", a.ActivityCourts.Select(ac => ac.Court?.Name ?? "?"))
                                    </li>
                                }
                                <li class="mb-1">
                                    <i class="bi bi-bar-chart text-muted me-2"></i>
                                    @SkillIcon(a.SkillLevel) @a.SkillLevel
                                </li>
                                <li>
                                    <i class="bi bi-people text-muted me-2"></i>
                                    @if (a.MaxCapacity == 0)
                                    {
                                        <span>Unlimited spots (@counts.Confirmed joined)</span>
                                    }
                                    else
                                    {
                                        <span class="@(isFull ? "text-danger fw-semibold" : "")">
                                            @counts.Confirmed / @a.MaxCapacity spots filled
                                        </span>
                                        @if (counts.Waitlist > 0)
                                        {
                                            <span class="text-muted ms-1">(@counts.Waitlist on waitlist)</span>
                                        }
                                    }
                                </li>
                            </ul>

                            @if (!string.IsNullOrEmpty(a.Description))
                            {
                                <p class="small text-muted mb-3 flex-grow-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                    @a.Description
                                </p>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }

                            <!-- RSVP Actions -->
                            <div class="mt-auto pt-2">
                                @if (hasUserRsvp && userRsvp != null)
                                {
                                    @if (userRsvp.Status == RsvpStatus.CheckedIn)
                                    {
                                        <div class="alert alert-primary py-2 px-3 mb-2 small d-flex align-items-center justify-content-between">
                                            <span><i class="bi bi-patch-check-fill me-1"></i>You're Checked In!</span>
                                            <span class="badge bg-primary">Checked In</span>
                                        </div>
                                        <button type="button" class="btn btn-outline-primary btn-sm w-100 fw-medium btn-show-qr mb-2"
                                                data-title="@a.Name"
                                                data-subtitle="@a.Date.ToString("ddd, MMM d, yyyy") &bull; @PickleBallBooking.Services.AppClock.To12HourRange(a.StartTime, a.EndTime)"
                                                data-type="Activity Pass"
                                                data-code="RSVP:@userRsvp.Id"
                                                title="Show QR Check-In Pass">
                                            <i class="bi bi-qr-code me-1"></i>Show Check-In Pass
                                        </button>
                                    }
                                    else if (userRsvp.Status == RsvpStatus.Confirmed)
                                    {
                                        <div class="alert alert-success py-2 px-3 mb-2 small d-flex align-items-center justify-content-between">
                                            <span><i class="bi bi-check-circle-fill me-1"></i>You're Confirmed!</span>
                                            @if (userRsvp.CourtAssignment?.Court != null)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-grid-3x3 me-1"></i>@userRsvp.CourtAssignment.Court.Name</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Spot Secured</span>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 mb-2">
                                            <button type="button" class="btn btn-outline-success btn-sm flex-grow-1 fw-medium btn-show-qr"
                                                    data-title="@a.Name"
                                                    data-subtitle="@a.Date.ToString("ddd, MMM d, yyyy") &bull; @PickleBallBooking.Services.AppClock.To12HourRange(a.StartTime, a.EndTime) @(userRsvp.CourtAssignment?.Court != null ? $"&bull; <strong>Assigned: {userRsvp.CourtAssignment.Court.Name}</strong>" : "")"
                                                    data-type="Activity Pass"
                                                    data-code="RSVP:@userRsvp.Id"
                                                    title="Show QR Check-In Pass">
                                                <i class="bi bi-qr-code me-1"></i>Pass
                                            </button>
                                            <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Are you sure you want to cancel your spot? If you cancel, your spot will be given to the next player on the waitlist.');" class="m-0">
                                                <input type="hidden" name="activityId" value="@a.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-medium">
                                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (userRsvp.Status == RsvpStatus.Waitlisted)
                                    {
                                        <div class="alert alert-warning py-2 px-3 mb-2 small d-flex align-items-center justify-content-between">
                                            <span><i class="bi bi-hourglass-split me-1"></i>On Waitlist</span>
                                            <span class="badge bg-warning-subtle text-warning-emphasis">Position #@userRsvp.WaitlistPosition</span>
                                        </div>
                                        <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Are you sure you want to leave the waitlist?');">
                                            <input type="hidden" name="activityId" value="@a.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100 fw-medium">
                                                <i class="bi bi-dash-circle me-1"></i>Leave Waitlist
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    @if (User.Identity?.IsAuthenticated != true)
                                    {
                                        <div class="d-grid">
                                            <a asp-page="/Account/Login" asp-route-returnUrl="/Activities" class="btn btn-success fw-semibold">
                                                <i class="bi bi-person-check me-2"></i>Sign In to Join
                                            </a>
                                        </div>
                                    }
                                    else if (isOrgAdmin)
                                    {
                                        <div class="d-grid">
                                            <button class="btn btn-outline-secondary fw-semibold" disabled title="The admin for the current organization cannot join their own activities.">
                                                <i class="bi bi-shield-lock me-1"></i>Admin (Cannot Join)
                                            </button>
                                        </div>
                                    }
                                    else if (isRegOpen && !isFull)
                                    {
                                        <form method="post" asp-page-handler="Join">
                                            <input type="hidden" name="activityId" value="@a.Id" />
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-success fw-semibold">
                                                    <i class="bi bi-check-circle me-1"></i>Join Activity
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else if (isRegOpen && isFull)
                                    {
                                        <form method="post" asp-page-handler="Join">
                                            <input type="hidden" name="activityId" value="@a.Id" />
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-warning text-dark fw-semibold">
                                                    <i class="bi bi-hourglass-split me-1"></i>Join Waitlist
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else if (isPending)
                                    {
                                        <div class="d-grid">
                                            <button class="btn btn-outline-info fw-semibold" disabled>
                                                <i class="bi bi-clock me-1"></i>Registration Opens Soon
                                            </button>
                                        </div>
                                    }
                                    else if (isClosed)
                                    {
                                        <div class="d-grid">
                                            <button class="btn btn-outline-secondary fw-semibold" disabled>
                                                Registration Closed
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-grid">
                                            <button class="btn btn-outline-secondary fw-semibold" disabled>
                                                @effectiveStatus
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- Check-In QR Pass Modal -->
<div class="modal fade" id="activityQrPassModal" tabindex="-1" aria-labelledby="activityQrPassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="activityQrPassModalLabel">
                    <i class="bi bi-qr-code-scan text-success me-2"></i>Check-In Pass
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <span id="actPassTypeBadge" class="badge bg-success-subtle text-success border mb-2">Activity Pass</span>
                <h5 id="actPassTitle" class="fw-bold mb-1">Activity Name</h5>
                <p id="actPassSubtitle" class="text-muted small mb-3">Venue &amp; Date info</p>

                <div class="p-3 bg-light rounded-3 d-inline-block border mb-3">
                    <a id="actPassQrLink" href="#" target="_blank" rel="noopener noreferrer" title="Click to view full-size QR code" style="cursor: pointer;">
                        <img id="actPassQrImg" src="" alt="Check-In QR Code" style="width:200px;height:200px;object-fit:contain;" class="d-block mx-auto rounded-1" />
                        <span class="badge bg-dark bg-opacity-75 small mt-2 d-inline-block">
                            <i class="bi bi-arrows-fullscreen me-1"></i>Click to Enlarge
                        </span>
                    </a>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-1 d-block">Pass Code (or staff manual entry):</label>
                    <div class="input-group input-group-sm w-75 mx-auto">
                        <input type="text" id="actPassCodeText" class="form-control text-center font-monospace fw-bold" readonly />
                        <button class="btn btn-outline-secondary" type="button" id="btnActCopyPassCode" title="Copy Code">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small mb-0 text-start">
                    <i class="bi bi-info-circle me-1"></i> Present this QR code to the venue desk or event host upon arrival to complete your check-in.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const modalEl = document.getElementById('activityQrPassModal');
    if (!modalEl) return;
    const modal = new bootstrap.Modal(modalEl);

    document.querySelectorAll('.btn-show-qr').forEach(btn => {
        btn.addEventListener('click', function () {
            const title = this.getAttribute('data-title') || 'Pass';
            const subtitle = this.getAttribute('data-subtitle') || '';
            const code = this.getAttribute('data-code') || '';
            const type = this.getAttribute('data-type') || 'Pass';

            document.getElementById('actPassTitle').textContent = title;
            document.getElementById('actPassSubtitle').innerHTML = subtitle;
            document.getElementById('actPassTypeBadge').textContent = type;
            document.getElementById('actPassCodeText').value = code;

            const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=10&data=' + encodeURIComponent(code);
            document.getElementById('actPassQrImg').src = qrUrl;
            const link = document.getElementById('actPassQrLink');
            if (link) {
                link.href = qrUrl;
            }

            modal.show();
        });
    });

    const copyBtn = document.getElementById('btnActCopyPassCode');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            const input = document.getElementById('actPassCodeText');
            input.select();
            navigator.clipboard.writeText(input.value);
            copyBtn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
            setTimeout(() => { copyBtn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
        });
    }
});
</script>
}

@section Styles {
<style>
.activity-card { transition: transform .15s, box-shadow .15s; }
.activity-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.12) !important; }
.bg-success-subtle { background-color: rgba(25,135,84,.12); }
.bg-warning-subtle { background-color: rgba(255,193,7,.18); }
</style>
}
