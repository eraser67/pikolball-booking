@page "/Booking/Confirmation/{reference}"
@model PickleBallBooking.Pages.Booking.ConfirmationModel
@{
    ViewData["Title"] = "Booking Confirmation";
    var methodLabel = Model.SelectedPaymentOption?.Label ?? "GCash";
    var accountName = Model.SelectedPaymentOption?.AccountName ?? Model.PaymentSettings?.AccountName;
    var accountNumber = Model.SelectedPaymentOption?.AccountNumber ?? Model.PaymentSettings?.AccountNumber;
    var instructions = Model.SelectedPaymentOption?.Instructions ?? Model.PaymentSettings?.Instructions;
    var hasActivePayment = (Model.SelectedPaymentOption != null || (Model.PaymentSettings != null &&
Model.PaymentSettings.IsActive)) && Model.Payment is not null && Model.Booking is not null;
}

<div class="booking-confirmation-mobile-container py-2 py-md-4">
    @if (Model.Booking is null)
    {
        <div class="alert alert-danger shadow-sm rounded-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Booking record not found.
        </div>
    }
    else
    {
        <!-- Mobile Hero Header -->
        <div class="confirmation-hero text-center mb-3 mb-md-4">
            <div class="confirmation-celebrate-icon mb-2">
                <span class="celebrate-badge shadow-sm">
                    <i class="bi bi-check-circle-fill text-success"></i>
                </span>
            </div>
            <h1 class="h4 fw-bold mb-1">Booking Reserved!</h1>
            <p class="text-muted small mb-2">
                Thank you, <strong>@Model.Booking.CustomerName</strong>. We're holding your court!
            </p>
            <div
                class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small fw-semibold">
                <span class="spinner-grow spinner-grow-sm text-warning" role="status" aria-hidden="true"></span>
                Awaiting Payment to Confirm
            </div>
        </div>

        <div class="row g-3 g-md-4 justify-content-center">
        
            <!-- ─── DIGITAL COURT PASS (Ticket Card) ─── -->
            <div class="col-12 col-md-6 col-lg-5">
                <div class="court-ticket-card shadow-sm h-100">
                    <div class="ticket-header p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                        <div>
                            <span class="ticket-eyebrow text-uppercase text-white-50 small fw-semibold">Court Pass</span>
                            <h2 class="h5 mb-0 fw-bold">@Model.Booking.Court?.Name</h2>
                        </div>
                        <span class="badge bg-white text-primary fw-bold px-2 py-1">
                            <i class="bi bi-trophy-fill me-1"></i>Pickle Ball
                        </span>
                    </div>

                    <!-- Reference Bar with 1-Tap Copy -->
                    <div
                        class="ticket-ref-bar px-3 py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small d-block">Booking Reference</span>
                            <span class="font-monospace fw-bold text-dark fs-6"
                                  id="textBookingRef">@Model.Booking.BookingReference</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary copy-btn py-1 px-2"
                                data-copy="@Model.Booking.BookingReference" title="Copy booking reference">
                            <i class="bi bi-clipboard me-1"></i><span>Copy</span>
                        </button>
                    </div>

                    <!-- Ticket Details Body -->
                    <div class="ticket-body p-3">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                    <span class="text-muted small d-block"><i
                                        class="bi bi-calendar3 me-1 text-primary"></i>Date</span>
                                        <span class="fw-semibold small">@Model.Booking.BookingDate.ToString("ddd, MMM d, yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                        <span class="text-muted small d-block"><i
                                            class="bi bi-clock me-1 text-primary"></i>Time</span>
                                            <span
                                                class="fw-semibold small">@PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime,
                                                Model.Booking.EndTime)</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Amount Due Highlight -->
                                    <div class="ticket-price-box p-3 rounded-3 bg-success-subtle border border-success-subtle mb-2">
                                        <span class="text-success-emphasis small d-block fw-semibold">Total Amount Due</span>
                                        <span class="fs-4 fw-bolder text-success">@Model.Booking.Price.ToString("C2")</span>
                                    </div>

                                    <p class="text-muted text-center small mb-0 mt-2">
                                        <i class="bi bi-info-circle me-1"></i>Please complete payment promptly to secure your time slot.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- ─── MOBILE PAYMENT ACTION CARD ─── -->
                        @if (hasActivePayment)
                        {
                            <div class="col-12 col-md-6 col-lg-5">
                                <div class="card payment-action-card border-0 shadow-sm h-100">
                                    <div class="card-header bg-white border-bottom p-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <span
                                                    class="payment-method-icon-badge bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center"
                                                    style="width:36px;height:36px;">
                                                    <i class="bi bi-phone-fill"></i>
                                                </span>
                                                <div>
                                                    <h3 class="h6 mb-0 fw-bold">Pay via @methodLabel</h3>
                                                    <span class="text-muted small">Send exact amount to confirm</span>
                                                </div>
                                            </div>
                                            @if (Model.EnableAiPaymentVerification)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                                    ✨ Instant AI Verify
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="card-body p-3 d-flex flex-column">

                                        <!-- QR Code Showcase with Mobile Save -->
                                        @if (!string.IsNullOrWhiteSpace(Model.QRCodeUrl))
                                        {
                                            <div class="mobile-qr-wrapper text-center p-2 mb-3 rounded-3 bg-light border">
                                                <p class="text-muted small mb-2 fw-semibold">
                                                    <i class="bi bi-qr-code-scan me-1 text-primary"></i>Scan or Save QR Code
                                                </p>
                                
                                                <div class="qr-preview-container d-inline-block position-relative">
                                                    <button type="button" class="btn p-0 border-0 bg-transparent" data-bs-toggle="modal"
                                                            data-bs-target="#qrZoomModal" title="Tap to zoom QR code">
                                                        <img src="@Model.QRCodeUrl" alt="@methodLabel QR Code"
                                                             class="img-fluid rounded-3 shadow-sm bg-white p-2"
                                                             style="max-width: 210px; width: 100%; border: 2px solid #0d6efd; cursor: zoom-in;" />
                                                    </button>
                                                </div>

                                                <div class="d-flex justify-content-center gap-2 mt-2">
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm px-3 fw-semibold btn-save-qr"
                                                            data-qr-url="@Model.QRCodeUrl"
                                                            data-filename="@(methodLabel.ToLowerInvariant())-qr.jpg">
                                                        <i class="bi bi-download me-1"></i><span>Save QR to Phone</span>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal"
                                                            data-bs-target="#qrZoomModal">
                                                        <i class="bi bi-arrows-fullscreen"></i>
                                                    </button>
                                                </div>
                                                <span class="d-block text-muted text-center mt-1" style="font-size:0.75rem;">
                                                    Tip: In @methodLabel, tap <em>Scan QR</em> → <em>Upload from Gallery</em>
                                                </span>
                                            </div>
                                        }

                                        <!-- Quick Copy Account Details Box -->
                                        <div class="account-details-box rounded-3 p-3 bg-light border mb-3">
                                            <span class="text-uppercase text-muted small fw-bold d-block mb-2">Recipient Account
                                                Details</span>
                            
                                                @if (!string.IsNullOrWhiteSpace(accountName))
                                                {
                                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                                                        <span class="text-muted small">Account Name</span>
                                                        <span class="fw-bold small text-dark">@accountName</span>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(accountNumber))
                                                {
                                                    <div class="d-flex justify-content-between align-items-center pt-2">
                                                        <div>
                                                            <span class="text-muted small d-block">Account Number</span>
                                                            <span class="font-monospace fw-bold text-dark fs-6"
                                                                  id="textAccountNumber">@accountNumber</span>
                                                        </div>
                                                        <button type="button" class="btn btn-sm btn-outline-primary copy-btn py-1 px-2"
                                                                data-copy="@accountNumber" title="Copy account number">
                                                            <i class="bi bi-clipboard me-1"></i><span>Copy</span>
                                                        </button>
                                                    </div>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(instructions))
                                            {
                                                <div class="alert alert-light border small py-2 px-3 mb-3 text-muted">
                                                    <i class="bi bi-chat-left-dots me-1 text-primary"></i>@instructions
                                                </div>
                                            }

                                            <!-- Visual 3-Step Guide -->
                                            <div class="payment-steps-mini p-2 rounded bg-light border-0 mb-3" style="font-size: 0.8rem;">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="badge bg-primary rounded-circle">1</span>
                                                    <span>Send <strong>@Model.Booking.Price.ToString("C2")</strong> via @methodLabel</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="badge bg-primary rounded-circle">2</span>
                                                    <span>Save your transaction screenshot</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-success rounded-circle">3</span>
                                                    @if (Model.EnableAiPaymentVerification)
                                                    {
                                                        <span>Submit proof for <strong>Instant AI Auto-Verification</strong></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Submit proof to complete booking</span>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Primary CTA Button -->
                                            <div class="mt-auto pt-2">
                                                <a asp-page="/Booking/Payment" asp-route-reference="@Model.Booking.BookingReference"
                                                   class="btn btn-success btn-lg w-100 shadow-sm py-3 fw-bold d-flex flex-column align-items-center justify-content-center">
                                                    <span class="d-flex align-items-center gap-2 fs-6">
                                                        @if (Model.EnableAiPaymentVerification)
                                                        {
                                                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-shield-check"></i>
                                                        }
                                                        Submit Payment Proof
                                                        <i class="bi bi-arrow-right"></i>
                                                    </span>
                                                    @if (Model.EnableAiPaymentVerification)
                                                    {
                                                        <span class="small opacity-75 fw-normal mt-1" style="font-size:0.78rem;">
                                                            AI Auto-Verification confirms within ~15s
                                                        </span>
                                                    }
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
        else
                            {
                                <div class="col-12 col-md-6 col-lg-5">
                                    <div class="card h-100 border-secondary shadow-sm">
                                        <div class="card-body text-center text-muted d-flex flex-column justify-content-center p-4">
                                            <i class="bi bi-info-circle display-4 mb-3 text-primary"></i>
                                            <h3 class="h6 fw-bold">Manual Venue Instructions</h3>
                                            <p class="small mb-0">Payment instructions will be provided directly by the venue staff. Please keep
                                                your booking reference safe.</p>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>

                            <!-- Bottom Secondary Actions -->
                            <div class="text-center mt-4">
                                <a asp-page="Index" class="btn btn-link text-decoration-none text-muted small">
                                    <i class="bi bi-plus-circle me-1"></i>Book Another Court
                                </a>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.QRCodeUrl))
                    {
                        var modalMethodLabel = Model.SelectedPaymentOption?.Label ?? "GCash";
                        <!-- QR Zoom Modal -->
                        <div class="modal fade" id="qrZoomModal" tabindex="-1" aria-labelledby="qrZoomModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" style="max-width:min(92vw,440px)">
                                <div class="modal-content rounded-4 border-0 shadow-lg">
                                    <div class="modal-header border-0 pb-1">
                                        <h5 class="modal-title h6 fw-bold" id="qrZoomModalLabel">
                                            <i class="bi bi-qr-code text-primary me-2"></i>@modalMethodLabel QR Code
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center pt-1 pb-3">
                                        <img src="@Model.QRCodeUrl" alt="@modalMethodLabel QR Code"
                                             class="img-fluid rounded-3 bg-white p-2 shadow-sm"
                                             style="width:100%;max-width:340px;border:2px solid #0d6efd;" />
                                        <p class="text-muted small mt-2 mb-0">
                                            Open @modalMethodLabel and select <strong>Scan QR</strong> to complete your payment.
                                        </p>
                                    </div>
                                    <div class="modal-footer border-0 justify-content-center pt-0 pb-3">
                                        <button type="button"
                                                class="btn btn-primary btn-sm px-3 fw-semibold btn-save-qr"
                                                data-qr-url="@Model.QRCodeUrl"
                                                data-filename="@(modalMethodLabel.ToLowerInvariant())-qr.jpg">
                                            <i class="bi bi-download me-1"></i><span>Save QR to Phone</span>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @section Scripts {
                        <script>
                            (function () {
                                'use strict';
                                // 1-Tap Copy to Clipboard with temporary visual feedback
                                document.querySelectorAll('.copy-btn').forEach(btn => {
                                    btn.addEventListener('click', async function () {
                                        const textToCopy = this.dataset.copy;
                                        if (!textToCopy) return;

                                        const originalHtml = this.innerHTML;
                                        try {
                                            await navigator.clipboard.writeText(textToCopy);
                                            this.classList.remove('btn-outline-secondary', 'btn-outline-primary', 'btn-success');
                                            this.classList.add('btn-success');
                                            this.innerHTML = '<i class="bi bi-check-lg me-1"></i><span>Copied!</span>';
                                            setTimeout(() => {
                                                this.innerHTML = originalHtml;
                                                this.classList.remove('btn-success');
                                                this.classList.add('btn-outline-secondary');
                                            }, 2000);
                                        } catch (err) {
                                            // Fallback
                                            const ta = document.createElement('textarea');
                                            ta.value = textToCopy;
                                            document.body.appendChild(ta);
                                            ta.select();
                                            document.execCommand('copy');
                                            document.body.removeChild(ta);
                                            this.innerHTML = '<i class="bi bi-check-lg me-1"></i><span>Copied!</span>';
                                            setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                                        }
                                    });
                                });

                                // Direct Blob / Web Share API for QR Code on Mobile & Desktop
                                document.querySelectorAll('.btn-save-qr').forEach(btn => {
                                    btn.addEventListener('click', async function () {
                                        const url = this.dataset.qrUrl;
                                        const filename = this.dataset.filename || 'qr-code.jpg';
                                        if (!url) return;

                                        const span = this.querySelector('span');
                                        const icon = this.querySelector('i');
                                        const origText = span ? span.textContent : 'Save QR to Phone';
                                        const origIcon = icon ? icon.className : 'bi bi-download me-1';

                                        try {
                                            this.disabled = true;
                                            if (span) span.textContent = 'Saving...';
                                            if (icon) icon.className = 'spinner-border spinner-border-sm me-1';

                                            const res = await fetch(url, { mode: 'cors' });
                                            if (!res.ok) throw new Error('Fetch failed: ' + res.status);
                                            const blob = await res.blob();

                                            // Attempt Web Share API with File (Native iOS "Save Image" to Photos / Android Gallery)
                                            let shared = false;
                                            const mimeType = blob.type || (filename.endsWith('.png') ? 'image/png' : 'image/jpeg');
                                            if (typeof File !== 'undefined' && navigator.canShare) {
                                                const file = new File([blob], filename, { type: mimeType });
                                                if (navigator.canShare({ files: [file] })) {
                                                    try {
                                                        await navigator.share({
                                                            files: [file],
                                                            title: filename
                                                        });
                                                        shared = true;
                                                    } catch (shareErr) {
                                                        if (shareErr.name === 'AbortError') {
                                                            // User dismissed native share sheet
                                                            if (span) span.textContent = origText;
                                                            if (icon) icon.className = origIcon;
                                                            this.disabled = false;
                                                            return;
                                                        }
                                                        console.warn('Web Share failed, falling back to blob download', shareErr);
                                                    }
                                                }
                                            }

                                            // Fallback to direct blob download if not shared via Web Share API
                                            if (!shared) {
                                                const blobUrl = URL.createObjectURL(blob);
                                                const link = document.createElement('a');
                                                link.href = blobUrl;
                                                link.download = filename;
                                                document.body.appendChild(link);
                                                link.click();
                                                document.body.removeChild(link);
                                                setTimeout(() => URL.revokeObjectURL(blobUrl), 3000);
                                            }

                                            if (span) span.textContent = 'Saved!';
                                            if (icon) icon.className = 'bi bi-check-lg me-1 text-success';
                                            setTimeout(() => {
                                                if (span) span.textContent = origText;
                                                if (icon) icon.className = origIcon;
                                                this.disabled = false;
                                            }, 2000);
                                        } catch (err) {
                                            console.warn('Save failed, falling back to download link', err);
                                            const link = document.createElement('a');
                                            link.href = url;
                                            link.target = '_blank';
                                            link.download = filename;
                                            document.body.appendChild(link);
                                            link.click();
                                            document.body.removeChild(link);

                                            if (span) span.textContent = origText;
                                            if (icon) icon.className = origIcon;
                                            this.disabled = false;
                                        }
                                    });
                                });
                            })();
                        </script>
                    }
