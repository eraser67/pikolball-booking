@page "/Booking/Confirmation/{reference}"
@model PickleBallBooking.Pages.Booking.ConfirmationModel
@{
    ViewData["Title"] = "Booking Confirmation";
    var methodLabel = Model.SelectedPaymentOption?.Label ?? "GCash";
    
    var isConfirmed = Model.Booking != null && (
        Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed ||
        Model.Payment?.PaymentStatus == PickleBallBooking.Models.PaymentStatus.Verified
    );
    var isSubmitted = !isConfirmed && Model.Payment?.PaymentStatus == PickleBallBooking.Models.PaymentStatus.Submitted;
    var isPending = !isConfirmed && !isSubmitted;
}

<div class="booking-confirmation-mobile-container py-3 py-md-5">
    @if (Model.Booking is null)
    {
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">
                <div class="alert alert-danger shadow-sm rounded-4 p-4">
                    <i class="bi bi-exclamation-triangle-fill display-4 text-danger mb-3 d-block"></i>
                    <h2 class="h5 fw-bold mb-2">Booking Record Not Found</h2>
                    <p class="text-muted small mb-3">We couldn't locate a booking with this reference number.</p>
                    <a asp-page="/Booking/Index" class="btn btn-primary px-4">
                        <i class="bi bi-calendar-plus me-1"></i>Book a Court
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <!-- ─── STATUS HEADER BANNER ─── -->
                <div class="text-center mb-4">
                    @if (isConfirmed)
                    {
                        <div class="mb-2">
                            <span class="d-inline-flex p-3 bg-success-subtle text-success rounded-circle shadow-sm">
                                <i class="bi bi-check-circle-fill display-5"></i>
                            </span>
                        </div>
                        <h1 class="h3 fw-bold mb-1">Booking Confirmed!</h1>
                        <p class="text-muted small mb-2">
                            See you on the court, <strong>@Model.Booking.CustomerName</strong>! Your reservation is secured.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-success-subtle text-success border border-success-subtle rounded-pill small fw-semibold">
                            <i class="bi bi-shield-check"></i>
                            Court Reserved &amp; Confirmed
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Booking.CustomerEmail))
                        {
                            <p class="text-muted small mt-2 mb-0">
                                <i class="bi bi-envelope-check me-1 text-primary"></i>A confirmation email with your digital pass was sent to <strong>@Model.Booking.CustomerEmail</strong>.
                            </p>
                        }
                    }
                    else if (isSubmitted)
                    {
                        <div class="mb-2">
                            <span class="d-inline-flex p-3 bg-info-subtle text-primary rounded-circle shadow-sm">
                                <i class="bi bi-clock-history display-5"></i>
                            </span>
                        </div>
                        <h1 class="h3 fw-bold mb-1">Payment Received!</h1>
                        <p class="text-muted small mb-2">
                            Thank you, <strong>@Model.Booking.CustomerName</strong>. We received your @methodLabel payment submission.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small fw-semibold">
                            <span class="spinner-grow spinner-grow-sm text-warning" role="status" aria-hidden="true"></span>
                            Verification in Progress
                        </div>
                        <p class="text-muted small mt-2 mb-0">
                            <i class="bi bi-info-circle me-1 text-primary"></i>Your court slot is held while our team verifies your receipt. You will receive an email once confirmed.
                        </p>
                    }
                    else
                    {
                        <div class="mb-2">
                            <span class="d-inline-flex p-3 bg-warning-subtle text-warning-emphasis rounded-circle shadow-sm">
                                <i class="bi bi-exclamation-circle-fill display-5"></i>
                            </span>
                        </div>
                        <h1 class="h3 fw-bold mb-1">Payment Required</h1>
                        <p class="text-muted small mb-2">
                            Your slot is temporarily held, but your booking is not confirmed until payment is completed.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small fw-semibold">
                            <i class="bi bi-hourglass-split"></i>
                            15-Minute Slot Hold Active
                        </div>
                        <div class="mt-3">
                            <a asp-page="/Booking/Payment" asp-route-reference="@Model.Booking.BookingReference"
                               class="btn btn-success btn-lg px-4 py-3 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                <i class="bi bi-wallet2"></i>
                                Pay Now to Confirm Slot (@Model.Booking.Price.ToString("C2"))
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    }
                </div>

                <!-- ─── DIGITAL COURT PASS (Ticket Card) ─── -->
                <div class="court-ticket-card shadow-sm rounded-4 overflow-hidden mb-4 border">
                    <div class="ticket-header p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                        <div>
                            <span class="ticket-eyebrow text-uppercase text-white-50 small fw-semibold d-block">Digital Court Pass</span>
                            <h2 class="h5 mb-0 fw-bold">@Model.Booking.Court?.Name</h2>
                        </div>
                        <span class="badge bg-white text-primary fw-bold px-2 py-1">
                            <i class="bi bi-trophy-fill me-1"></i>Pickleball
                        </span>
                    </div>

                    <!-- Reference Bar with 1-Tap Copy -->
                    <div class="ticket-ref-bar px-3 py-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small d-block">Booking Reference</span>
                            <span class="font-monospace fw-bold text-dark fs-6" id="textBookingRef">@Model.Booking.BookingReference</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary copy-btn py-1 px-2"
                                data-copy="@Model.Booking.BookingReference" title="Copy booking reference">
                            <i class="bi bi-clipboard me-1"></i><span>Copy</span>
                        </button>
                    </div>

                    <!-- Ticket Details Body -->
                    <div class="ticket-body p-3 p-md-4">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                    <span class="text-muted small d-block"><i class="bi bi-calendar3 me-1 text-primary"></i>Date</span>
                                    <span class="fw-semibold small">@Model.Booking.BookingDate.ToString("ddd, MMM d, yyyy")</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                    <span class="text-muted small d-block"><i class="bi bi-clock me-1 text-primary"></i>Time</span>
                                    <span class="fw-semibold small">@PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime, Model.Booking.EndTime)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Amount & Status Row -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                    <span class="text-muted small d-block">Amount</span>
                                    <span class="fw-bold fs-6 text-success">@Model.Booking.Price.ToString("C2")</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="ticket-stat-box p-2 rounded bg-light border border-light">
                                    <span class="text-muted small d-block">Pass Status</span>
                                    @if (isConfirmed)
                                    {
                                        <span class="badge bg-success fw-semibold"><i class="bi bi-check2 me-1"></i>Confirmed</span>
                                    }
                                    else if (isSubmitted)
                                    {
                                        <span class="badge bg-info text-dark fw-semibold"><i class="bi bi-hourglass me-1"></i>Verifying</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark fw-semibold"><i class="bi bi-clock me-1"></i>Pending</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (Model.Payment?.ReferenceNumber != null)
                        {
                            <div class="p-2 mb-3 rounded bg-light border d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Payment Reference</span>
                                    <span class="font-monospace fw-bold small text-dark">@Model.Payment.ReferenceNumber</span>
                                </div>
                                <span class="badge bg-light text-muted border small">@methodLabel</span>
                            </div>
                        }

                        <!-- Front Desk Check-in QR Code -->
                        <div class="text-center p-3 rounded-3 bg-light border mt-2">
                            <p class="text-muted small fw-semibold mb-2">
                                <i class="bi bi-qr-code me-1 text-primary"></i>Venue Check-in QR Pass
                            </p>
                            <div class="d-inline-block bg-white p-2 rounded-3 shadow-sm border mb-2">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&amp;margin=6&amp;data=@Uri.EscapeDataString($"BOOKING:{Model.Booking.BookingReference}")"
                                     alt="Booking Check-In QR"
                                     class="img-fluid"
                                     style="width: 160px; height: 160px;" />
                            </div>
                            <span class="d-block text-muted" style="font-size:0.75rem;">
                                Present this QR code at the front desk when arriving at the court.
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ─── ACTION BUTTONS ─── -->
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                    @if (isPending)
                    {
                        <a asp-page="/Booking/Payment" asp-route-reference="@Model.Booking.BookingReference"
                           class="btn btn-success fw-bold py-2 px-3">
                            <i class="bi bi-wallet2 me-1"></i>Complete Payment Now
                        </a>
                    }
                    <button type="button" class="btn btn-outline-primary py-2 px-3" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i>Print / Save Pass
                    </button>
                    <a asp-page="/Booking/Index" class="btn btn-outline-secondary py-2 px-3">
                        <i class="bi bi-calendar-plus me-1"></i>Book Another Court
                    </a>
                </div>

                <!-- Help note -->
                <p class="text-muted text-center small mb-0">
                    <i class="bi bi-info-circle me-1"></i>Have questions about your booking? Contact venue staff or visit <a asp-page="/Booking/Lookup" class="text-decoration-none">Booking Lookup</a>.
                </p>

            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            // 1-Tap Copy to Clipboard with temporary visual feedback
            document.querySelectorAll('.copy-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const textToCopy = this.dataset.copy;
                    if (!textToCopy) return;

                    const originalHtml = this.innerHTML;
                    try {
                        await navigator.clipboard.writeText(textToCopy);
                        this.classList.remove('btn-outline-secondary', 'btn-outline-primary');
                        this.classList.add('btn-success');
                        this.innerHTML = '<i class="bi bi-check-lg me-1"></i><span>Copied!</span>';
                        setTimeout(() => {
                            this.innerHTML = originalHtml;
                            this.classList.remove('btn-success');
                            this.classList.add('btn-outline-secondary');
                        }, 2000);
                    } catch (err) {
                        const ta = document.createElement('textarea');
                        ta.value = textToCopy;
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand('copy');
                        document.body.removeChild(ta);
                        this.innerHTML = '<i class="bi bi-check-lg me-1"></i><span>Copied!</span>';
                        setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                    }
                });
            });
        })();
    </script>
}
