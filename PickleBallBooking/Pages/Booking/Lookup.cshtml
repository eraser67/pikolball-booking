@page "/Booking/Lookup"
@model PickleBallBooking.Pages.Booking.LookupModel
@{
    ViewData["Title"] = "Look Up Booking";
}

<h1>Look Up Booking</h1>

<p>Enter your booking reference along with the mobile number or email you used when booking.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.BookingReference" class="form-label"></label>
        <input asp-for="Input.BookingReference" class="form-control" />
        <span asp-validation-for="Input.BookingReference" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ContactInfo" class="form-label"></label>
        <input asp-for="Input.ContactInfo" class="form-control" />
        <span asp-validation-for="Input.ContactInfo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Look Up Booking</button>
</form>

@if (Model.Searched)
{
    if (Model.Booking is null)
    {
        <div class="alert alert-danger mt-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>No booking was found matching that reference and contact information.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Booking Details</h5>
                    <div>
                        @if (Model.Booking.CheckedInAt.HasValue && !Model.Booking.IsNoShow)
                        {
                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                <i class="bi bi-patch-check-fill me-1"></i>Checked In
                            </span>
                        }
                        else if (Model.Booking.IsNoShow)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                <i class="bi bi-x-circle-fill me-1"></i>No-Show
                            </span>
                        }
                        else if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Confirmed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2">@Model.Booking.BookingStatus</span>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-7">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Booking Ref</dt>
                            <dd class="col-sm-8 font-monospace fw-bold">@Model.Booking.BookingReference</dd>

                            <dt class="col-sm-4 text-muted">Customer</dt>
                            <dd class="col-sm-8">@Model.Booking.CustomerName</dd>

                            <dt class="col-sm-4 text-muted">Court</dt>
                            <dd class="col-sm-8 fw-semibold text-success">@Model.Booking.Court?.Name</dd>

                            <dt class="col-sm-4 text-muted">Date</dt>
                            <dd class="col-sm-8">@Model.Booking.BookingDate.ToString("dddd, MMMM d, yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Time Slot</dt>
                            <dd class="col-sm-8">@PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime, Model.Booking.EndTime)</dd>

                            <dt class="col-sm-4 text-muted">Amount</dt>
                            <dd class="col-sm-8 fw-bold">₱@Model.Booking.Price.ToString("N2")</dd>

                            @if (Model.Booking.CheckedInAt.HasValue)
                            {
                                <dt class="col-sm-4 text-muted">Checked In At</dt>
                                <dd class="col-sm-8 text-primary">
                                    <i class="bi bi-clock-history me-1"></i>@Model.Booking.CheckedInAt.Value.ToLocalTime().ToString("g")
                                    @if (Model.Booking.CheckInMethod.HasValue)
                                    {
                                        <span class="text-muted small">(@Model.Booking.CheckInMethod)</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </div>

                    @if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                    {
                        <div class="col-lg-5 text-center">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="badge bg-success-subtle text-success border mb-2">Check-In QR Pass</span>
                                <div class="bg-white p-2 rounded-2 d-inline-block shadow-sm mb-2">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=8&data=@Uri.EscapeDataString($"BOOKING:{Model.Booking.BookingReference}")"
                                         alt="Check-In QR Code"
                                         style="width:170px;height:170px;object-fit:contain;"
                                         class="d-block mx-auto" />
                                </div>
                                <div class="input-group input-group-sm w-75 mx-auto mb-2">
                                    <input type="text" id="passCodeRef" class="form-control text-center font-monospace fw-bold"
                                           value="BOOKING:@Model.Booking.BookingReference" readonly />
                                    <button class="btn btn-outline-secondary" type="button" id="btnCopyRef" title="Copy Pass Code">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                <p class="small text-muted mb-0">
                                    <i class="bi bi-qr-code-scan me-1"></i>Present this QR code to the front desk upon arrival.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('btnCopyRef');
            if (btn) {
                btn.addEventListener('click', function () {
                    const input = document.getElementById('passCodeRef');
                    input.select();
                    navigator.clipboard.writeText(input.value);
                    btn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
                    setTimeout(() => { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
                });
            }
        });
    </script>
}
