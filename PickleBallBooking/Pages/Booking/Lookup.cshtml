@page "/Booking/Lookup"
@model PickleBallBooking.Pages.Booking.LookupModel
@{
    ViewData["Title"] = "Look Up Booking";
}

<h1>Look Up Booking</h1>

<p>Enter your booking reference along with the mobile number or email you used when booking.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.BookingReference" class="form-label"></label>
        <input asp-for="Input.BookingReference" class="form-control" />
        <span asp-validation-for="Input.BookingReference" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ContactInfo" class="form-label"></label>
        <input asp-for="Input.ContactInfo" class="form-control" />
        <span asp-validation-for="Input.ContactInfo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Look Up Booking</button>
</form>

@if (Model.Searched)
{
    if (Model.Booking is null)
    {
        <div class="alert alert-danger mt-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>No booking was found matching that reference and contact information.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Booking Details</h5>
                    <div>
                        @if (Model.Booking.CheckedInAt.HasValue && !Model.Booking.IsNoShow)
                        {
                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                <i class="bi bi-patch-check-fill me-1"></i>Checked In
                            </span>
                        }
                        else if (Model.Booking.IsNoShow)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                <i class="bi bi-x-circle-fill me-1"></i>No-Show
                            </span>
                        }
                        else if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Confirmed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2">@Model.Booking.BookingStatus</span>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-7">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Booking Ref</dt>
                            <dd class="col-sm-8 font-monospace fw-bold">@Model.Booking.BookingReference</dd>

                            <dt class="col-sm-4 text-muted">Customer</dt>
                            <dd class="col-sm-8">@Model.Booking.CustomerName</dd>

                            <dt class="col-sm-4 text-muted">Court</dt>
                            <dd class="col-sm-8 fw-semibold text-success">@Model.Booking.Court?.Name</dd>

                            <dt class="col-sm-4 text-muted">Date</dt>
                            <dd class="col-sm-8">@Model.Booking.BookingDate.ToString("dddd, MMMM d, yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Time Slot</dt>
                            <dd class="col-sm-8">@PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime, Model.Booking.EndTime)</dd>

                            <dt class="col-sm-4 text-muted">Amount</dt>
                            <dd class="col-sm-8 fw-bold">₱@Model.Booking.Price.ToString("N2")</dd>

                            @if (Model.Booking.CheckedInAt.HasValue)
                            {
                                <dt class="col-sm-4 text-muted">Checked In At</dt>
                                <dd class="col-sm-8 text-primary">
                                    <i class="bi bi-clock-history me-1"></i>@Model.Booking.CheckedInAt.Value.ToLocalTime().ToString("g")
                                    @if (Model.Booking.CheckInMethod.HasValue)
                                    {
                                        <span class="text-muted small">(@Model.Booking.CheckInMethod)</span>
                                    }
                                </dd>
                            }
                        </dl>
                    </div>

                    @if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
                    {
                        <div class="col-lg-5 text-center">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="badge bg-success-subtle text-success border mb-2">
                                    <i class="bi bi-patch-check-fill me-1"></i>Check-In QR Pass
                                </span>
                                <div class="my-2">
                                    <button type="button" class="btn p-0 border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#qrZoomModal" title="Click to enlarge QR pass">
                                        <div class="bg-white p-2 rounded-3 d-inline-block shadow-sm position-relative qr-pass-card" style="cursor: pointer;">
                                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=8&data=@Uri.EscapeDataString($"BOOKING:{Model.Booking.BookingReference}")"
                                                 alt="Check-In QR Code"
                                                 style="width:170px;height:170px;object-fit:contain;"
                                                 class="d-block mx-auto rounded-1" />
                                            <div class="mt-1">
                                                <span class="badge bg-dark bg-opacity-75 small">
                                                    <i class="bi bi-arrows-fullscreen me-1"></i>Click to Enlarge
                                                </span>
                                            </div>
                                        </div>
                                    </button>
                                </div>
                                <div class="input-group input-group-sm w-75 mx-auto mb-2">
                                    <input type="text" id="passCodeRef" class="form-control text-center font-monospace fw-bold"
                                           value="BOOKING:@Model.Booking.BookingReference" readonly />
                                    <button class="btn btn-outline-secondary" type="button" id="btnCopyRef" title="Copy Pass Code">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                <p class="small text-muted mb-0">
                                    <i class="bi bi-qr-code-scan me-1"></i>Tap QR to enlarge, or present to staff at front desk.
                                </p>
                            </div>
                        </div>
                    }
                    else if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Pending)
                    {
                        <div class="col-lg-5 text-center">
                            <div class="p-4 bg-light rounded-3 border">
                                <div class="text-warning mb-2">
                                    <i class="bi bi-hourglass-split display-6"></i>
                                </div>
                                <h6 class="fw-bold mb-1">Awaiting Confirmation</h6>
                                <p class="small text-muted mb-3">
                                    This booking is currently <strong>Pending</strong>. Your Check-In QR Pass will become available once confirmed by staff.
                                </p>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form method="post" asp-page-handler="StaffCheckIn" class="d-inline">
                                        <input type="hidden" name="bookingReference" value="@Model.Booking.BookingReference" />
                                        <input type="hidden" name="contactInfo" value="@Model.Input.ContactInfo" />
                                        <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm">
                                            <i class="bi bi-check2-circle me-1"></i>Confirm &amp; Check In Now
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.Booking.BookingStatus == PickleBallBooking.Models.BookingStatus.Confirmed)
        {
            <!-- QR Pass Enlarged Modal -->
            <div class="modal fade" id="qrZoomModal" tabindex="-1" aria-labelledby="qrZoomModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow border-0">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold" id="qrZoomModalLabel">
                                <i class="bi bi-qr-code-scan text-success me-2"></i>Court Check-In Pass
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center p-4">
                            <span class="badge bg-success-subtle text-success border mb-2">Confirmed Booking</span>
                            <h5 class="fw-bold mb-1">@Model.Booking.Court?.Name</h5>
                            <p class="text-muted small mb-3">
                                @Model.Booking.BookingDate.ToString("dddd, MMMM d, yyyy") &bull; @PickleBallBooking.Services.AppClock.To12HourRange(Model.Booking.StartTime, Model.Booking.EndTime)
                            </p>

                            <div class="p-3 bg-light rounded-3 d-inline-block border shadow-sm mb-3">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&data=@Uri.EscapeDataString($"BOOKING:{Model.Booking.BookingReference}")"
                                     alt="Enlarged Check-In QR Code"
                                     style="width:240px;height:240px;object-fit:contain;"
                                     class="d-block mx-auto" />
                            </div>

                            <div class="mb-3">
                                <label class="small text-muted mb-1 d-block">Pass Code (or staff manual check-in):</label>
                                <div class="input-group input-group-sm w-75 mx-auto">
                                    <input type="text" id="modalPassCodeText" class="form-control text-center font-monospace fw-bold"
                                           value="BOOKING:@Model.Booking.BookingReference" readonly />
                                    <button class="btn btn-outline-secondary" type="button" id="btnCopyModalPass" title="Copy Pass Code">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 small mb-0 text-start">
                                <i class="bi bi-info-circle me-1"></i> Present this QR code to venue staff upon arrival. Staff will scan it to verify and record your attendance.
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}

<style>
    .qr-pass-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .qr-pass-card:hover {
        transform: scale(1.03);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function setupCopy(btnId, inputId) {
                const btn = document.getElementById(btnId);
                const input = document.getElementById(inputId);
                if (btn && input) {
                    btn.addEventListener('click', function () {
                        input.select();
                        navigator.clipboard.writeText(input.value);
                        btn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
                        setTimeout(() => { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
                    });
                }
            }
            setupCopy('btnCopyRef', 'passCodeRef');
            setupCopy('btnCopyModalPass', 'modalPassCodeText');
        });
    </script>
}
