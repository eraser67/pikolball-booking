@page "/Booking/Payment"
@model PickleBallBooking.Pages.Booking.PaymentModel
@{
    var methodLabel = Model.SelectedPaymentOption?.Label ?? "GCash";
    ViewData["Title"] = $"Pay via {methodLabel}";
    var displayName   = Model.SelectedPaymentOption?.AccountName   ?? Model.Settings?.AccountName;
    var displayNumber = Model.SelectedPaymentOption?.AccountNumber ?? Model.Settings?.AccountNumber;
    var displayInstr  = Model.SelectedPaymentOption?.Instructions  ?? Model.Settings?.Instructions;
}

@if (Model.PaymentInfo is null)
{
    <div class="alert alert-danger shadow-sm rounded-3 my-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Payment record not found.
    </div>
    return;
}

<div class="payment-mobile-container py-2 py-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <!-- ─── TOP CONTEXT BAR (Mobile-Friendly Booking Reminder) ─── -->
            <div class="card booking-summary-strip border-0 shadow-sm rounded-4 mb-3 mb-md-4 bg-white overflow-hidden">
                <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 text-uppercase small fw-semibold d-block">Booking Checkout</span>
                        <h1 class="h6 mb-0 fw-bold">@Model.PaymentInfo.CourtName</h1>
                    </div>
                    <span class="badge bg-white text-primary fw-bold px-2 py-1">
                        @PickleBallBooking.Services.AppClock.To12HourRange(Model.PaymentInfo.StartTime, Model.PaymentInfo.EndTime)
                    </span>
                </div>
                <div class="p-3 bg-light d-flex justify-content-between align-items-center border-top">
                    <div>
                        <span class="text-muted small d-block">Booking Reference</span>
                        <span class="font-monospace fw-bold text-dark fs-6">@Model.PaymentInfo.BookingReference</span>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Total to Pay</span>
                        <span class="fs-5 fw-bold text-success">@Model.PaymentInfo.Amount.ToString("C2")</span>
                    </div>
                </div>
            </div>

            <!-- ─── STEP 1: SEND PAYMENT DETAILS (Quick Copy & QR) ─── -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 mb-md-4 bg-white">
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="h6 mb-0 fw-bold d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle">1</span>
                            Send via @methodLabel
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(Model.QRCodeUrl))
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2 fw-semibold"
                                    data-bs-toggle="modal" data-bs-target="#qrZoomModal">
                                <i class="bi bi-qr-code me-1"></i>View QR
                            </button>
                        }
                    </div>
                </div>

                <div class="card-body p-3">
                    <div class="account-copy-box p-3 rounded-3 bg-light border mb-2">
                        @if (!string.IsNullOrWhiteSpace(displayName))
                        {
                            <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-light">
                                <span class="text-muted small">Account Name</span>
                                <span class="fw-bold small text-dark">@displayName</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(displayNumber))
                        {
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <div>
                                    <span class="text-muted small d-block">Account Number</span>
                                    <span class="font-monospace fw-bold text-dark fs-6" id="textAccountNumber">@displayNumber</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary copy-btn py-1 px-2"
                                        data-copy="@displayNumber"
                                        title="Copy account number">
                                    <i class="bi bi-clipboard me-1"></i><span>Copy Number</span>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Quick Amount Copy -->
                    <div class="d-flex justify-content-between align-items-center p-2 rounded bg-success-subtle border border-success-subtle mb-2">
                        <span class="text-success-emphasis small fw-semibold">
                            Exact Amount: <strong>@Model.PaymentInfo.Amount.ToString("C2")</strong>
                        </span>
                        <button type="button" class="btn btn-sm btn-success copy-btn py-1 px-2"
                                data-copy="@Model.PaymentInfo.Amount.ToString("F2")"
                                title="Copy exact amount">
                            <i class="bi bi-clipboard me-1"></i><span>Copy Amount</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(displayInstr))
                    {
                        <div class="alert alert-light border small py-2 px-3 mb-0 text-muted">
                            <i class="bi bi-info-circle me-1 text-primary"></i>@displayInstr
                        </div>
                    }
                </div>
            </div>

            <!-- ─── STEP 2: SUBMIT PAYMENT PROOF ─── -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="h6 mb-0 fw-bold d-flex align-items-center gap-2">
                            <span class="badge bg-success rounded-circle">2</span>
                            Submit Payment Details
                        </h2>
                        @if (Model.EnableAiPaymentVerification)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                ✨ AI Auto-Verify
                            </span>
                        }
                    </div>
                </div>

                <div class="card-body p-3">
                    <form method="post" enctype="multipart/form-data" id="paymentSubmitForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <input type="hidden" asp-for="Input.Reference" />

                        <!-- Reference Number Input with Paste Button -->
                        <div class="mb-3">
                            <label asp-for="Input.GCashReference" class="form-label fw-bold small text-dark d-flex justify-content-between align-items-center">
                                <span>@methodLabel Reference Number</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" id="btnPasteReference" style="font-size:0.8rem;">
                                    <i class="bi bi-clipboard me-1"></i>Paste from Clipboard
                                </button>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input asp-for="Input.GCashReference"
                                       class="form-control form-control-lg border-start-0 font-monospace fs-6"
                                       placeholder="e.g. 8045858980078 (13 digits)"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       id="inputGCashRef" />
                            </div>
                            <div class="form-text small">
                                Found on your @methodLabel receipt or Transaction History screen.
                            </div>
                            <span asp-validation-for="Input.GCashReference" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- ─── RECEIPT SCREENSHOT DROPZONE (MOBILE TOUCH) ─── -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark mb-1">
                                Receipt Screenshot
                                @if (Model.EnableAiPaymentVerification)
                                {
                                    <span class="badge bg-primary-subtle text-primary ms-1 small">Recommended for Instant Verify</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border ms-1 small">Optional</span>
                                }
                            </label>

                            <!-- Hidden file input triggered by custom dropzone -->
                            <input asp-for="Input.ProofImage" type="file"
                                   accept="image/jpeg,image/png,image/webp"
                                   id="proofImageInput"
                                   class="d-none" />

                            <!-- Custom Interactive Dropzone -->
                            <div class="receipt-dropzone p-3 rounded-3 text-center border border-2 border-dashed bg-light"
                                 id="receiptDropzone">
                                
                                <!-- Empty state -->
                                <div id="dropzoneEmptyState">
                                    <div class="dropzone-icon mb-2">
                                        <i class="bi bi-camera-fill fs-2 text-primary"></i>
                                    </div>
                                    <p class="fw-semibold small mb-1 text-dark">
                                        Tap to upload GCash receipt screenshot
                                    </p>
                                    <span class="text-muted d-block" style="font-size: 0.75rem;">
                                        Supports JPG, PNG, WEBP (Max 1 MB)
                                    </span>
                                </div>

                                <!-- Selected Preview state -->
                                <div id="dropzonePreviewState" class="d-none">
                                    <div class="position-relative d-inline-block mb-2">
                                        <img id="proofPreviewImg" src="#" alt="Receipt preview"
                                             class="img-fluid rounded-3 shadow-sm border"
                                             style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                                    </div>
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <span class="badge bg-success py-1 px-2" id="proofFileName">
                                            <i class="bi bi-check2 me-1"></i>Receipt attached
                                        </span>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" id="btnRemoveProof" style="font-size: 0.78rem;">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    </div>
                                </div>

                            </div>

                            <div id="proofSizeError" class="text-danger small mt-1" style="display:none;">
                                <i class="bi bi-exclamation-circle me-1"></i>File too large. Maximum allowed size is 1 MB.
                            </div>
                            <span asp-validation-for="Input.ProofImage" class="text-danger small d-block mt-1"></span>

                            @if (Model.EnableAiPaymentVerification)
                            {
                                <!-- AI Speed Callout -->
                                <div class="d-flex align-items-start gap-2 p-2 mt-2 rounded bg-light border-0" style="font-size: 0.78rem;">
                                    <i class="bi bi-lightning-charge-fill text-warning fs-6 mt-n1"></i>
                                    <span class="text-muted">
                                        <strong>Instant Confirmation:</strong> Our AI Vision scans your receipt screenshot to confirm your reservation in ~15 seconds without waiting for admin review!
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Submit CTA Button -->
                        <div class="pt-2">
                            <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" id="btnSubmitPayment">
                                <span class="spinner-border spinner-border-sm d-none" id="btnSpinner" role="status" aria-hidden="true"></span>
                                <i class="bi bi-shield-check fs-5" id="btnIcon"></i>
                                <span id="btnText">Verify Payment &amp; Confirm Booking</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Assurance Note -->
            <p class="text-muted text-center small mb-0 px-2" style="font-size: 0.75rem;">
                <i class="bi bi-lock-fill me-1 text-success"></i>
                Payments are securely processed and verified directly against the venue's account.
            </p>

        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.QRCodeUrl))
{
    <!-- QR Zoom Modal -->
    <div class="modal fade" id="qrZoomModal" tabindex="-1" aria-labelledby="qrZoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:min(92vw,440px)">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-1">
                    <h5 class="modal-title h6 fw-bold" id="qrZoomModalLabel">
                        <i class="bi bi-qr-code text-primary me-2"></i>@methodLabel QR Code
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-1 pb-3">
                    <img src="@Model.QRCodeUrl"
                         alt="@methodLabel QR Code"
                         class="img-fluid rounded-3 bg-white p-2 shadow-sm"
                         style="width:100%;max-width:340px;border:2px solid #0d6efd;" />
                    <p class="text-muted small mt-2 mb-0">
                        Scan with @methodLabel or upload this image to complete your payment.
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center pt-0 pb-3">
                    <a href="@Model.QRCodeUrl"
                       download="@(methodLabel.ToLowerInvariant())-qr.png"
                       class="btn btn-primary btn-sm px-3 fw-semibold">
                        <i class="bi bi-download me-1"></i>Save QR to Photos
                    </a>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        'use strict';

        const MAX = 1 * 1024 * 1024; // 1 MB
        const fileInput = document.getElementById('proofImageInput');
        const dropzone = document.getElementById('receiptDropzone');
        const emptyState = document.getElementById('dropzoneEmptyState');
        const previewState = document.getElementById('dropzonePreviewState');
        const previewImg = document.getElementById('proofPreviewImg');
        const fileNameBadge = document.getElementById('proofFileName');
        const btnRemoveProof = document.getElementById('btnRemoveProof');
        const sizeError = document.getElementById('proofSizeError');
        const btnPasteRef = document.getElementById('btnPasteReference');
        const inputGCashRef = document.getElementById('inputGCashRef');
        const form = document.getElementById('paymentSubmitForm');
        const btnSubmit = document.getElementById('btnSubmitPayment');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnIcon = document.getElementById('btnIcon');
        const btnText = document.getElementById('btnText');

        // Dropzone click triggers file input
        if (dropzone && fileInput) {
            dropzone.addEventListener('click', function (e) {
                if (e.target.closest('#btnRemoveProof')) return;
                fileInput.click();
            });
        }

        // Live image preview
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    const file = this.files[0];
                    if (file.size > MAX) {
                        sizeError.style.display = 'block';
                        clearFileInput();
                        return;
                    }

                    sizeError.style.display = 'none';
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        if (previewImg) previewImg.src = e.target.result;
                        if (emptyState) emptyState.classList.add('d-none');
                        if (previewState) previewState.classList.remove('d-none');
                        if (fileNameBadge) fileNameBadge.innerHTML = '<i class="bi bi-check2 me-1"></i>' + file.name;
                    };
                    reader.readAsDataURL(file);
                } else {
                    clearFileInput();
                }
            });
        }

        function clearFileInput() {
            if (fileInput) fileInput.value = '';
            if (previewImg) previewImg.src = '#';
            if (emptyState) emptyState.classList.remove('d-none');
            if (previewState) previewState.classList.add('d-none');
        }

        if (btnRemoveProof) {
            btnRemoveProof.addEventListener('click', function (e) {
                e.stopPropagation();
                clearFileInput();
            });
        }

        // 1-Tap Paste Reference Number
        if (btnPasteRef && inputGCashRef) {
            btnPasteRef.addEventListener('click', async function () {
                try {
                    const text = await navigator.clipboard.readText();
                    if (text) {
                        inputGCashRef.value = text.trim();
                        inputGCashRef.focus();
                    }
                } catch (err) {
                    inputGCashRef.focus();
                }
            });
        }

        // 1-Tap Copy Buttons
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const textToCopy = this.dataset.copy;
                if (!textToCopy) return;

                const originalHtml = this.innerHTML;
                try {
                    await navigator.clipboard.writeText(textToCopy);
                    this.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied!';
                    setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                } catch (err) {
                    const ta = document.createElement('textarea');
                    ta.value = textToCopy;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    this.innerHTML = '<i class="bi bi-check-lg me-1"></i>Copied!';
                    setTimeout(() => { this.innerHTML = originalHtml; }, 2000);
                }
            });
        });

        // Submit loading state to prevent double-click
        if (form && btnSubmit) {
            form.addEventListener('submit', function () {
                if (form.checkValidity()) {
                    btnSubmit.disabled = true;
                    if (btnSpinner) btnSpinner.classList.remove('d-none');
                    if (btnIcon) btnIcon.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Verifying & Submitting...';
                }
            });
        }

    })();
    </script>
}
