@page "/Booking"
@model PickleBallBooking.Pages.Booking.IndexModel
@using PickleBallBooking.Models
@using PickleBallBooking.Services
@{
    ViewData["Title"] = "Book a Court";
    var hasSlots = Model.TimeSlotAvailabilities.Count > 0;
    var todayStr = AppClock.TodayLocal.ToString("yyyy-MM-dd");
}

<div class="container my-4 my-lg-5">

    <header class="mb-4">
        <h1 class="mb-1">
            <i class="bi bi-calendar-plus me-2 text-primary"></i>Book a Court
        </h1>
        <p class="text-muted mb-0">
            Select a court, date, and time slots — then fill in your details to complete your booking.
        </p>
    </header>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 mt-1" aria-hidden="true"></i>
            <div>
                <strong>We couldn't complete that.</strong>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" id="bookingForm" data-pb-loading-text="Checking availability&hellip;">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"
             id="validationSummary"
             style="@(ViewData.ModelState.IsValid ? "display: none;" : "")">
            <strong>Please correct the following errors:</strong>
        </div>

        <!-- Hidden container to hold selected slot IDs from other dates across midnight -->
        <div id="hiddenSelectedSlotsContainer">
            @if (Model.SelectedDay2Slots != null && Model.SelectedDay2Slots.Count > 0)
            {
                foreach (var s in Model.SelectedDay2Slots)
                {
                    <input type="hidden"
                           name="SelectedSlotIds"
                           value="@s.SlotId"
                           data-date="@s.Date"
                           data-start-minutes="@s.StartMinutes"
                           data-end-minutes="@s.EndMinutes"
                           data-display-time="@s.DisplayTime" />
                }
            }
        </div>

        <div class="row g-4">

            <!-- ================= LEFT: SELECTION ================= -->
            <div class="col-lg-7">

                <!-- ─── STEP 1: COURT ─── -->
                <section class="booking-form-section card mb-4 shadow-sm" aria-labelledby="step1Heading">
                    <div class="card-body">
                        <h2 class="h5 card-title d-flex align-items-center gap-2" id="step1Heading">
                            <span class="pb-step-index" aria-hidden="true">1</span>
                            Select a Court
                        </h2>

                        <!-- Visual court cards -->
                        <div class="court-card-grid mb-2" id="courtCardGrid" role="group" aria-label="Available courts">
                            @foreach (var court in Model.Courts)
                            {
                                var isDisabled = court.Disabled;
                                var courtId = court.Value;
                                var isSelected = courtId == Model.Input.CourtId.ToString();
                                <button type="button"
                                        class="court-card-btn @(isSelected ? "selected" : "") @(isDisabled ? "disabled-court" : "")"
                                        data-court-id="@courtId"
                                        @(isDisabled ? "disabled" : "")
                                        aria-pressed="@(isSelected ? "true" : "false")">
                                    <i class="bi bi-geo-alt-fill court-card-icon"></i>
                                    <span class="court-card-name">@court.Text</span>
                                    @if (isSelected)
                                    {
                                        <i class="bi bi-check-circle-fill court-card-check text-success"></i>
                                    }
                                </button>
                            }
                        </div>
                        <!-- Hidden select kept for model binding -->
                        <select asp-for="Input.CourtId"
                                asp-items="Model.Courts"
                                id="courtSelect"
                                class="d-none">
                            <option value="">-- Select a court --</option>
                        </select>
                        <span asp-validation-for="Input.CourtId" class="text-danger"></span>

                        @if (Model.SelectedCourt != null && Model.SelectedCourt.Status == CourtStatus.Inactive)
                        {
                            <div class="alert alert-warning py-2 px-3 small mt-3 mb-0 d-flex align-items-start gap-2" role="status">
                                <i class="bi bi-tools text-warning-emphasis fs-6 flex-shrink-0 mt-1"></i>
                                <div>
                                    <strong>@Model.SelectedCourt.Name is Temporarily Unavailable</strong>
                                    <p class="mb-0 text-muted">
                                        @(string.IsNullOrWhiteSpace(Model.SelectedCourt.MaintenanceNote)
                                            ? "This court is undergoing maintenance and cannot be reserved at this time."
                                            : Model.SelectedCourt.MaintenanceNote)
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <!-- ─── STEP 2: DATE ─── -->
                <section class="booking-form-section card mb-4 shadow-sm" aria-labelledby="step2Heading">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h2 class="h5 card-title d-flex align-items-center gap-2 mb-0" id="step2Heading">
                                <span class="pb-step-index" aria-hidden="true">2</span>
                                Select a Date
                            </h2>
                            <span class="badge bg-light text-muted border fw-normal d-none d-sm-inline-flex align-items-center gap-1">
                                <i class="bi bi-calendar3 text-primary"></i> 7-Day Quick View
                            </span>
                        </div>

                        <!-- 7-Day Horizontal Strip (All 7 days visible horizontally in one view, NO swipe) -->
                        <div class="date-quick-strip-grid mb-3" id="dateQuickStrip" role="radiogroup" aria-label="7-day horizontal date selection">
                            @foreach (var opt in Model.DateOptions)
                            {
                                var isToday = opt.Date == AppClock.TodayLocal;
                                var isTomorrow = opt.Date == AppClock.TodayLocal.AddDays(1);
                                var dayName = isToday ? "Today" : isTomorrow ? "Tmrw" : opt.DayLabel;
                                var dateIso = opt.Date.ToString("yyyy-MM-dd");
                                var isSelected = opt.Date == Model.Input.BookingDate;

                                <button type="button"
                                        class="date-quick-pill @(isSelected ? "active" : "") @(isToday ? "is-today" : "")"
                                        data-date="@dateIso"
                                        role="radio"
                                        aria-checked="@(isSelected ? "true" : "false")"
                                        title="@opt.Date.ToString("dddd, MMMM d, yyyy")">
                                    <span class="pill-day-label">@dayName</span>
                                    <span class="pill-day-num">@opt.Date.Day</span>
                                    <span class="pill-month-label">@opt.Date.ToString("MMM")</span>
                                </button>
                            }
                        </div>

                        <!-- Directly Visible Custom Date Picker (in one view with 7 days) -->
                        <div class="custom-date-row pt-2 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar-event text-primary fs-5" aria-hidden="true"></i>
                                <label for="bookingDate" class="form-label mb-0 fw-semibold small text-muted">
                                    Or Pick Any Date:
                                </label>
                            </div>
                            <div class="custom-date-input-wrap flex-grow-1" style="max-width: 240px; min-width: 170px;">
                                <input asp-for="Input.BookingDate"
                                       type="date"
                                       id="bookingDate"
                                       class="form-control form-control-sm fw-semibold"
                                       min="@todayStr"
                                       required />
                            </div>
                        </div>
                        <span asp-validation-for="Input.BookingDate" class="text-danger small mt-1 d-block"></span>
                    </div>
                </section>

                <!-- ─── STEP 3: TIME SLOTS ─── -->
                <section class="booking-form-section card mb-4 shadow-sm" aria-labelledby="step3Heading">
                    <div class="card-body">
                        <h2 class="h5 card-title d-flex align-items-center gap-2" id="step3Heading">
                            <span class="pb-step-index" aria-hidden="true">3</span>
                            Select Time Slots
                        </h2>

                        <div class="calendar-empty-state" id="timeslotEmptyState" style="@(!hasSlots ? "" : "display: none;")">
                            <div class="calendar-empty-state-icon">
                                <i class="bi bi-calendar2-x" aria-hidden="true"></i>
                            </div>
                            <p class="mb-0">
                                Please select a court and date to view available time slots.
                            </p>
                        </div>

                        <div id="timeslotContent" style="@(hasSlots ? "" : "display: none;")">
                            <p class="text-muted small mb-2">
                                Tap the <span class="text-success fw-semibold">green</span> slots to select them.
                                Selected slots must be <strong>continuous</strong> with no gaps.
                            </p>

                            <div class="pb-legend mb-3" aria-hidden="true">
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-available"></span>Available</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-selected"></span>Selected</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-booked"></span>Booked</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-maintenance"></span>Maintenance</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-past"></span>Passed</span>
                            </div>

                            <!-- Time of Day Filter Chips -->
                            <div class="time-filter-strip d-flex flex-wrap gap-1 mb-3" id="timeFilterStrip" role="group" aria-label="Filter time slots by time of day">
                                <button type="button" class="btn btn-sm btn-outline-primary slot-filter-btn active" data-filter="all">
                                    <i class="bi bi-grid-fill me-1"></i>All Times
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="morning">
                                    🌅 Morning <span class="badge bg-light text-dark ms-1 filter-count" id="countMorning"></span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="afternoon">
                                    ☀️ Afternoon <span class="badge bg-light text-dark ms-1 filter-count" id="countAfternoon"></span>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary slot-filter-btn" data-filter="evening">
                                    🌙 Evening <span class="badge bg-light text-dark ms-1 filter-count" id="countEvening"></span>
                                </button>
                            </div>

                            <!-- Overnight Continuation alert -->
                            <div id="overnightContinueAlert"
                                 class="alert alert-info alert-dismissible fade show d-none align-items-center mb-3"
                                 role="alert">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-moon-stars-fill fs-5 text-primary me-2 mt-1" aria-hidden="true"></i>
                                    <div>
                                        <strong id="overnightContinueTitle">Continuing booking from previous day</strong>
                                        <div class="small mt-1" id="overnightContinueDetail"></div>
                                    </div>
                                </div>
                                <button type="button" class="btn-close" id="overnightContinueAlertClose" aria-label="Close"></button>
                            </div>

                            <!-- Gap Alert -->
                            <div id="timeslotGapAlert"
                                 class="alert alert-danger alert-dismissible fade show d-none align-items-center mb-3"
                                 role="alert">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-exclamation-octagon-fill fs-5 text-danger me-2 mt-1" aria-hidden="true"></i>
                                    <div>
                                        <strong id="timeslotGapAlertTitle">Please select continuous time slots.</strong>
                                        <div class="small mt-1" id="timeslotGapAlertDetail"></div>
                                    </div>
                                </div>
                                <button type="button" class="btn-close" id="timeslotGapAlertClose" aria-label="Close"></button>
                            </div>

                            <div class="timeslot-grid"
                                 id="timeslotGrid"
                                 role="group"
                                 aria-label="Available time slots">

                                @foreach (var slot in Model.TimeSlotAvailabilities)
                                {
                                    var slotStatusClass = slot.Status switch
                                    {
                                        "available" => "available",
                                        "booked" => "booked",
                                        "maintenance" => "maintenance",
                                        "past" => "past",
                                        _ => "unavailable"
                                    };

                                    var isDisabled = slot.Status != "available";
                                    var displayStatus = slot.IsPast ? "passed" : slot.Status;
                                    var ariaLabel = $"{slot.DisplayTime} - {displayStatus}";
                                    var startMinutes = (int)slot.StartTime.TotalMinutes;
                                    var endMinutes = (int)(slot.EndTime == TimeSpan.Zero ? 1440 : slot.EndTime.TotalMinutes);

                                    var statusIcon = slot.IsSelected ? "bi-check-circle-fill"
                                        : slot.IsPast ? "bi-clock-history"
                                        : slot.Status switch
                                        {
                                            "available" => "bi-circle",
                                            "booked" => "bi-lock-fill",
                                            "maintenance" => "bi-tools",
                                            _ => "bi-slash-circle"
                                        };

                                    <label class="timeslot-btn @slotStatusClass @(slot.IsSelected ? "selected" : "")"
                                           title="@ariaLabel"
                                           data-slot-id="@slot.TimeSlotId"
                                           data-start-minutes="@startMinutes"
                                           data-end-minutes="@endMinutes">

                                        <input type="checkbox"
                                               name="SelectedSlotIds"
                                               value="@slot.TimeSlotId"
                                               class="timeslot-checkbox"
                                               aria-label="@ariaLabel"
                                               data-slot-id="@slot.TimeSlotId"
                                               data-start-minutes="@startMinutes"
                                               data-end-minutes="@endMinutes"
                                               @(isDisabled ? "disabled" : "")
                                               @(slot.IsSelected ? "checked" : "") />

                                        <span class="timeslot-time">
                                            @slot.DisplayTime
                                        </span>

                                        <span class="timeslot-status">
                                            <i class="bi @statusIcon" aria-hidden="true"></i>
                                            <span class="status-text">@(slot.IsSelected ? "selected" : displayStatus)</span>
                                        </span>

                                        @if (slot.Status == "maintenance" && !string.IsNullOrWhiteSpace(slot.MaintenanceNote))
                                        {
                                            <span class="small text-danger d-block text-truncate mt-1 px-1" style="font-size:0.68rem; max-width: 100%;" title="@slot.MaintenanceNote">
                                                @slot.MaintenanceNote
                                            </span>
                                        }

                                    </label>
                                }

                            </div>

                            <!-- AJAX error -->
                            <div id="priceCalcError" class="alert alert-danger mt-2 d-none" role="alert"></div>

                        </div>

                    </div>
                </section>

                <!-- ─── STEP 4: YOUR INFORMATION (revealed after price calc) ─── -->
                <section class="booking-form-section card mb-4 shadow-sm step4-panel"
                         id="step4Card"
                         aria-labelledby="step4Heading"
                         style="@(Model.CalculatedPrice.HasValue || !ViewData.ModelState.IsValid ? "" : "display:none;")">
                    <div class="card-body">
                        <h2 class="h5 card-title d-flex align-items-center gap-2" id="step4Heading">
                            <span class="pb-step-index" aria-hidden="true">4</span>
                            Your Details
                        </h2>

                        <!-- Estimated price banner -->
                        <div class="price-alert mb-4" id="step4PriceAlert">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">Total</span>
                                <span class="price-alert-value" id="step4PriceValue">
                                    @(Model.CalculatedPrice.HasValue ? $"₱{Model.CalculatedPrice.Value:N2}" : "")
                                </span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Input.CustomerName" class="form-label fw-semibold"></label>
                                <input asp-for="Input.CustomerName"
                                       class="form-control"
                                       id="Input_CustomerName"
                                       placeholder="Enter your full name"
                                       autocomplete="name" />
                                <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.CustomerPhone" class="form-label fw-semibold"></label>
                                <input asp-for="Input.CustomerPhone"
                                       class="form-control"
                                       id="Input_CustomerPhone"
                                       inputmode="tel"
                                       placeholder="e.g., +63 9XX XXXX XXX"
                                       autocomplete="tel" />
                                <span asp-validation-for="Input.CustomerPhone" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.CustomerEmail" class="form-label fw-semibold"></label>
                                <input asp-for="Input.CustomerEmail"
                                       class="form-control"
                                       id="Input_CustomerEmail"
                                       inputmode="email"
                                       placeholder="email@example.com"
                                       autocomplete="email" />
                                <span asp-validation-for="Input.CustomerEmail" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Input.FacebookName" class="form-label fw-semibold">
                                    <i class="bi bi-facebook text-primary me-1"></i>Facebook Name
                                    <span class="badge bg-secondary fw-normal ms-1" style="font-size:0.7rem;">Optional</span>
                                </label>
                                <input asp-for="Input.FacebookName"
                                       class="form-control"
                                       id="Input_FacebookName"
                                       placeholder="Your Facebook name for easy contact"
                                       autocomplete="off" />
                                <div class="form-text">Helps the venue contact you if needed.</div>
                                <span asp-validation-for="Input.FacebookName" class="text-danger"></span>
                            </div>

                            <div class="col-12 mt-1">
                                <div class="form-check p-2 rounded bg-light border">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" id="rememberDetailsCheck" checked />
                                    <label class="form-check-label small text-muted" for="rememberDetailsCheck">
                                        <i class="bi bi-shield-check text-success me-1"></i>
                                        <strong>Remember my details on this device</strong> for faster bookings next time
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method Selection -->
                        <div class="mt-4">
                            <p class="fw-semibold mb-2">
                                <i class="bi bi-credit-card me-1 text-primary"></i>
                                How would you like to pay?
                            </p>

                            @if (!Model.PaymentOptions.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    No payment methods have been configured yet. Contact the venue to complete your booking.
                                </div>
                            }
                            else
                            {
                                <input type="hidden"
                                       asp-for="Input.SelectedPaymentOptionId"
                                       id="Input_SelectedPaymentOptionId" />

                                <div class="payment-method-grid" id="paymentMethodGrid"
                                     role="group" aria-label="Payment method">
                                    @{ var isFirst = true; }
                                    @foreach (var opt in Model.PaymentOptions)
                                    {
                                        var isSelected = Model.Input.SelectedPaymentOptionId == opt.Id
                                            || (!Model.Input.SelectedPaymentOptionId.HasValue && isFirst);
                                        <button type="button"
                                                class="payment-method-card @(isSelected ? "selected" : "")"
                                                data-method="@opt.Id"
                                                aria-pressed="@(isSelected ? "true" : "false")"
                                                id="pmCard_@opt.Id">
                                            <i class="bi bi-qr-code payment-method-icon"></i>
                                            <div class="payment-method-label">@opt.Label</div>
                                            <div class="payment-method-sub">@opt.AccountName</div>
                                            @if (isSelected)
                                            {
                                                <i class="bi bi-check-circle-fill payment-method-check text-success"></i>
                                            }
                                        </button>
                                        isFirst = false;
                                    }
                                </div>

                                <div class="form-text mt-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    After booking, you'll be shown the QR code to scan and pay. Upload your receipt to confirm.
                                </div>
                            }
                        </div>

                    </div>
                </section>

            </div><!-- /col-lg-7 -->

            <!-- ================= RIGHT: SUMMARY ================= -->
            <div class="col-lg-5">
                <div class="pb-sticky-summary">

                    <!-- Booking Summary Card (always rendered, shown by JS) -->
                    <div id="bookingSummaryContainer"
                         style="@(Model.CalculatedPrice.HasValue || (Model.SelectedSlotIds != null && Model.SelectedSlotIds.Length > 0) ? "" : "display: none;")">
                        <div class="booking-form-section card mb-4 bg-light shadow-sm" aria-live="polite">
                            <div class="card-body">
                                <h2 class="h5 card-title">
                                    <i class="bi bi-receipt me-1"></i>Booking Summary
                                </h2>

                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Court</span>
                                    <span class="booking-summary-value" id="summaryCourtName">-</span>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Date</span>
                                    <span class="booking-summary-value" id="summaryDate">-</span>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Time</span>
                                    <span class="booking-summary-value" id="summaryTime">-</span>
                                </div>
                                <div class="booking-summary-item" id="summaryOvernightTransitionItem" style="display: none;">
                                    <span class="booking-summary-label">Schedule</span>
                                    <div class="booking-summary-value overnight-date-block w-100 mt-1" id="summaryOvernightDetails"></div>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Duration</span>
                                    <span class="booking-summary-value" id="summaryDuration">-</span>
                                </div>

                                <div id="priceContainer"
                                     style="@(Model.CalculatedPrice.HasValue ? "" : "display: none;")"
                                     class="booking-summary-item">
                                    <span class="booking-summary-label">Price</span>
                                    <span class="booking-summary-value text-success fw-bold" id="summaryPrice">
                                        @(Model.CalculatedPrice.HasValue ? $"₱{Model.CalculatedPrice.Value:N2}" : "-")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm Actions (shown after price is calculated) -->
                    <div id="confirmActionsContainer" class="booking-actions d-grid gap-2 mb-4"
                         style="@(Model.CalculatedPrice.HasValue || !ViewData.ModelState.IsValid ? "" : "display:none !important;")">
                        <button type="submit"
                                asp-page-handler="Confirm"
                                class="btn btn-success btn-lg"
                                id="btnConfirmBooking">
                            <span class="pb-btn-spinner spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                            <i class="bi bi-check-circle pb-btn-label me-1"></i>
                            <span class="pb-btn-label">Confirm Booking</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg" id="btnEditBooking">
                            <i class="bi bi-pencil me-1"></i>Edit Slots
                        </button>
                    </div>

                </div>
            </div><!-- /col-lg-5 -->

        </div><!-- /row -->

    </form>

    <!-- Mobile Bottom Sheet Backdrop -->
    <div class="bottom-sheet-backdrop d-lg-none" id="bottomSheetBackdrop"></div>

    <!-- Mobile Sticky Summary Bar & Expandable Bottom Sheet (fixed bottom) -->
    <div class="mobile-sticky-summary d-lg-none" id="mobileStickySummary" aria-expanded="false">
        
        <!-- Bottom Sheet Header / Drag Trigger -->
        <div class="bottom-sheet-header-trigger" id="bottomSheetHeaderTrigger" role="button" tabindex="0" aria-label="Toggle booking summary details">
            <div class="bottom-sheet-handle-bar">
                <span class="bottom-sheet-handle"></span>
            </div>

            <div class="container-fluid px-2 px-sm-3 py-1">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div class="mobile-summary-info d-flex align-items-center gap-2">
                        <div class="mobile-summary-text text-truncate">
                            <div class="fw-bold small text-truncate" id="mobileSummaryCourtDate">-</div>
                            <div class="text-primary fw-bold small text-truncate" id="mobileSummaryTimeDuration">-</div>
                        </div>
                        <i class="bi bi-chevron-up sheet-chevron text-muted flex-shrink-0" id="sheetChevronIcon"></i>
                    </div>
                    <div class="mobile-summary-actions d-flex align-items-center gap-2 flex-shrink-0">
                        <span class="fw-bold text-success fs-6 text-nowrap" id="mobileSummaryPrice" style="display: none;"></span>
                        <button type="button" class="btn btn-primary btn-sm px-2 px-sm-3 fw-semibold text-nowrap" id="btnMobileProceed">
                            <span class="sheet-btn-word-prefix">Enter </span>Details <i class="bi bi-arrow-down ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Expanded Bottom Sheet Content -->
        <div class="bottom-sheet-body" id="bottomSheetBody">
            <div class="container-fluid px-3 pt-2 pb-3">
                <div class="d-flex justify-content-between align-items-center pb-2 mb-2 border-bottom">
                    <h5 class="h6 mb-0 fw-bold d-flex align-items-center text-dark">
                        <i class="bi bi-receipt text-primary me-2 fs-5"></i>Booking Summary
                    </h5>
                    <button type="button" class="btn-close btn-sm" id="btnCloseBottomSheet" aria-label="Close summary"></button>
                </div>

                <div class="bottom-sheet-details">
                    <div class="sheet-summary-item d-flex justify-content-between py-1 border-bottom border-light">
                        <span class="text-muted small">Court</span>
                        <span class="fw-semibold small text-end" id="sheetCourtName">-</span>
                    </div>
                    <div class="sheet-summary-item d-flex justify-content-between py-1 border-bottom border-light">
                        <span class="text-muted small">Date</span>
                        <span class="fw-semibold small text-end" id="sheetDate">-</span>
                    </div>
                    <div class="sheet-summary-item d-flex justify-content-between py-1 border-bottom border-light">
                        <span class="text-muted small">Time</span>
                        <span class="fw-semibold small text-end" id="sheetTime">-</span>
                    </div>

                    <div class="sheet-summary-item py-1 border-bottom border-light" id="sheetOvernightItem" style="display: none;">
                        <span class="text-muted small d-block mb-1">Overnight Schedule</span>
                        <div class="overnight-date-block w-100 p-2 rounded bg-light" id="sheetOvernightDetails"></div>
                    </div>

                    <div class="sheet-summary-item d-flex justify-content-between py-1 border-bottom border-light">
                        <span class="text-muted small">Duration</span>
                        <span class="fw-semibold small text-end" id="sheetDuration">-</span>
                    </div>

                    <div class="sheet-summary-item d-flex justify-content-between align-items-center py-2 mt-2 rounded bg-success-subtle px-2 border border-success-subtle" id="sheetPriceRow">
                        <span class="fw-bold text-success-emphasis small">Total Amount</span>
                        <span class="fw-bold text-success fs-5" id="sheetPriceValue">-</span>
                    </div>
                </div>

                <!-- Customer Details Recap inside Bottom Sheet -->
                <div class="sheet-customer-recap mt-3 p-2 rounded bg-light border" id="sheetCustomerRecap" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold"><i class="bi bi-person me-1"></i>Player Details</span>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" id="btnSheetEditDetails">Edit</button>
                    </div>
                    <div class="fw-bold small text-dark" id="sheetCustomerName">-</div>
                    <div class="text-muted small" id="sheetCustomerContact">-</div>
                    <div class="text-muted small mt-1" id="sheetCustomerPayment"></div>
                </div>

                <div class="d-grid gap-2 mt-3" id="sheetActionButtons">
                    <!-- Shown when details are complete -->
                    <button type="button" class="btn btn-success btn-lg fw-semibold shadow-sm" id="btnSheetConfirmBooking" style="display: none;">
                        <span class="pb-btn-spinner spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                        <i class="bi bi-check-circle pb-btn-label me-1"></i>
                        <span class="pb-btn-label">Confirm Booking</span>
                    </button>
                    <!-- Fallback: Continue to Your Details (shown if user opens summary before filling details) -->
                    <button type="button" class="btn btn-primary btn-lg fw-semibold shadow-sm" id="btnSheetContinue">
                        <i class="bi bi-person-fill me-1"></i> Continue to Your Details
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnSheetCloseSecondary">
                        Close Summary
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
    <script>
    (function () {
        'use strict';

        const courtSelect = document.getElementById('courtSelect');
        const bookingDateInput = document.getElementById('bookingDate');

        // ─── Court card selection ───────────────────────────────────────────
        const courtCards = document.querySelectorAll('.court-card-btn:not([disabled])');
        courtCards.forEach(card => {
            card.addEventListener('click', function () {
                courtCards.forEach(c => {
                    c.classList.remove('selected');
                    c.setAttribute('aria-pressed', 'false');
                    c.querySelector('.court-card-check')?.remove();
                });
                this.classList.add('selected');
                this.setAttribute('aria-pressed', 'true');
                // Add check icon if not present
                if (!this.querySelector('.court-card-check')) {
                    const icon = document.createElement('i');
                    icon.className = 'bi bi-check-circle-fill court-card-check text-success';
                    this.appendChild(icon);
                }
                if (courtSelect) {
                    courtSelect.value = this.dataset.courtId;
                    courtSelect.dispatchEvent(new Event('change'));
                }
            });
        });

        // ─── Payment method card selection ──────────────────────────────────
        const pmCards = document.querySelectorAll('.payment-method-card');
        const pmInput = document.getElementById('Input_SelectedPaymentOptionId');
        pmCards.forEach(card => {
            card.addEventListener('click', function () {
                pmCards.forEach(c => {
                    c.classList.remove('selected');
                    c.setAttribute('aria-pressed', 'false');
                    c.querySelector('.payment-method-check')?.remove();
                });
                this.classList.add('selected');
                this.setAttribute('aria-pressed', 'true');
                if (!this.querySelector('.payment-method-check')) {
                    const icon = document.createElement('i');
                    icon.className = 'bi bi-check-circle-fill payment-method-check text-success';
                    this.appendChild(icon);
                }
                if (pmInput) pmInput.value = this.dataset.method;
                if (window.updateMobileProceedState) window.updateMobileProceedState();
            });
        });

        // ─── Calculate Price handled canonically by booking.js ─────────────

        // ─── Edit Slots (collapse step 4 back) ─────────────────────────────
        const btnEdit = document.getElementById('btnEditBooking');
        if (btnEdit) {
            btnEdit.addEventListener('click', function () {
                if (step4Card) step4Card.style.display = 'none';
                if (confirmActionsContainer) confirmActionsContainer.style.setProperty('display', 'none', 'important');
                document.getElementById('timeslotGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        }

    }());
    </script>
}