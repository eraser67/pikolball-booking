@page "/Booking"
@model PickleBallBooking.Pages.Booking.IndexModel
@{
    ViewData["Title"] = "Book a Court";
    var hasSlots = Model.TimeSlotAvailabilities.Count > 0;
}

<div class="container my-5">

    <header class="mb-4">
        <h1 class="mb-2">Book a Court</h1>
        <p class="text-muted mb-0">
            Select a court, date, and one or more continuous time slots to complete your booking.
        </p>
    </header>

    <!-- Progress indicator (decorative guidance) -->
    <nav aria-label="Booking progress">
        <ol class="pb-steps">
            <li class="pb-step is-active">
                <span class="pb-step-index">1</span> Court &amp; Date
            </li>
            <li class="pb-step">
                <span class="pb-step-index">2</span> Time Slots
            </li>
            <li class="pb-step">
                <span class="pb-step-index">3</span> Details
            </li>
            <li class="pb-step">
                <span class="pb-step-index">4</span> Confirm
            </li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 mt-1" aria-hidden="true"></i>
            <div>
                <strong>We couldn't complete that.</strong>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@Model.StatusMessage
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <form method="post" id="bookingForm" data-pb-loading-text="Checking availability&hellip;">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"
             id="validationSummary"
             style="display: none;">

            <strong>Please correct the following errors:</strong>

        </div>

        <div class="row g-4">

            <!-- ================= LEFT: SELECTION ================= -->
            <div class="col-lg-7">

                <!-- STEP 1: COURT -->
                <section class="booking-form-section card mb-4" aria-labelledby="step1Heading">
                    <div class="card-body">
                        <h2 class="h5 card-title" id="step1Heading">
                            <span class="pb-step-index me-1" aria-hidden="true">1</span>
                            Select a Court
                        </h2>

                        <div class="mb-1">
                            <label for="courtSelect" class="form-label">Court</label>
                            <select asp-for="Input.CourtId"
                                    asp-items="Model.Courts"
                                    class="form-select form-select-lg"
                                    id="courtSelect">
                                <option value="">-- Select a court --</option>
                            </select>
                            <span asp-validation-for="Input.CourtId" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <!-- STEP 2: DATE -->
                <section class="booking-form-section card mb-4" aria-labelledby="step2Heading">
                    <div class="card-body">
                        <h2 class="h5 card-title" id="step2Heading">
                            <span class="pb-step-index me-1" aria-hidden="true">2</span>
                            Select a Booking Date
                        </h2>

                        <div class="mb-1">
                            <label for="bookingDate" class="form-label">Booking Date</label>
                            <input asp-for="Input.BookingDate"
                                   type="date"
                                   id="bookingDate"
                                   class="form-control form-control-lg"
                                   required />
                            <span asp-validation-for="Input.BookingDate" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <!-- STEP 3: TIMESLOTS -->
                <section class="booking-form-section card mb-4" aria-labelledby="step3Heading">
                    <div class="card-body">
                        <h2 class="h5 card-title" id="step3Heading">
                            <span class="pb-step-index me-1" aria-hidden="true">3</span>
                            Select Time Slots
                        </h2>

                        @if (!hasSlots)
                        {
                            <div class="calendar-empty-state">
                                <div class="calendar-empty-state-icon">
                                    <i class="bi bi-calendar2-x" aria-hidden="true"></i>
                                </div>
                                <p class="mb-0">
                                    Please select a court and date to view available time slots.
                                </p>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">
                                Tap the available (green) slots to select them.
                                Multiple slots must be continuous with no gaps.
                            </p>

                            <div class="pb-legend" aria-hidden="true">
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-available"></span>Available</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-selected"></span>Selected</span>
                                                                <span class="pb-legend-item"><span class="pb-legend-swatch is-booked"></span>Booked</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-maintenance"></span>Maintenance</span>
                                <span class="pb-legend-item"><span class="pb-legend-swatch is-past"></span>Passed</span>
                            </div>

                            <!-- Dedicated Gap Alert directly above timeslot grid -->
                            <div id="timeslotGapAlert"
                                 class="alert alert-danger alert-dismissible fade show d-none align-items-center mb-3"
                                 role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-octagon-fill fs-5 text-danger me-2" aria-hidden="true"></i>
                                    <div>
                                        <strong id="timeslotGapAlertTitle">Cannot select time slot with gap.</strong>
                                        <div class="small text-muted" id="timeslotGapAlertDetail">Please select continuous time slots.</div>
                                    </div>
                                </div>
                                <button type="button" class="btn-close" id="timeslotGapAlertClose" aria-label="Close"></button>
                            </div>

                            <div class="timeslot-grid"
                                 id="timeslotGrid"
                                 role="group"
                                 aria-label="Available time slots">

                                @foreach (var slot in Model.TimeSlotAvailabilities)
                                {
                                    var slotStatusClass = slot.Status switch
                                    {
                                        "available" => "available",
                                        "booked" => "booked",
                                        "maintenance" => "maintenance",
                                        "past" => "past",
                                        _ => "unavailable"
                                    };

                                    var isDisabled = slot.Status != "available";

                                    var displayStatus = slot.IsPast ? "passed" : slot.Status;

                                    var ariaLabel = $"{slot.DisplayTime} - {displayStatus}";

                                    var startMinutes = (int)slot.StartTime.TotalMinutes;
                                    var endMinutes = (int)(slot.EndTime == TimeSpan.Zero ? 1440 : slot.EndTime.TotalMinutes);

                                    <label class="timeslot-btn @slotStatusClass"
                                           title="@ariaLabel"
                                           data-slot-id="@slot.TimeSlotId"
                                           data-start-minutes="@startMinutes"
                                           data-end-minutes="@endMinutes">

                                        <input type="checkbox"
                                               name="SelectedSlotIds"
                                               value="@slot.TimeSlotId"
                                               class="timeslot-checkbox"
                                               aria-label="@ariaLabel"
                                               data-slot-id="@slot.TimeSlotId"
                                               data-start-minutes="@startMinutes"
                                               data-end-minutes="@endMinutes"
                                               @(isDisabled ? "disabled" : "")
                                               @(slot.IsSelected ? "checked" : "") />

                                        <span class="timeslot-time">
                                            @slot.DisplayTime
                                        </span>

                                        <span class="timeslot-status">
                                            @(slot.IsPast ? "passed" : slot.Status)
                                        </span>

                                    </label>
                                }

                            </div>
                        }

                    </div>
                </section>

            </div>

            <!-- ================= RIGHT: SUMMARY ================= -->
            <div class="col-lg-5">
                <div class="pb-sticky-summary">

                    <div id="bookingSummaryContainer" style="display: none;">
                        <div class="booking-form-section card mb-4 bg-light" aria-live="polite">
                            <div class="card-body">
                                <h2 class="h5 card-title">Booking Summary</h2>

                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Court</span>
                                    <span class="booking-summary-value" id="summaryCourtName">-</span>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Date</span>
                                    <span class="booking-summary-value" id="summaryDate">-</span>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Time</span>
                                    <span class="booking-summary-value" id="summaryTime">-</span>
                                </div>
                                <div class="booking-summary-item">
                                    <span class="booking-summary-label">Duration</span>
                                    <span class="booking-summary-value" id="summaryDuration">-</span>
                                </div>

                                <div id="priceContainer" style="display: none;" class="booking-summary-item">
                                    <span class="booking-summary-label">Price</span>
                                    <span class="booking-summary-value text-success" id="summaryPrice">-</span>
                                </div>

                                <div id="calculateButtonContainer" class="mt-3 d-grid">
                                    <button type="submit"
                                            asp-page-handler="Calculate"
                                            class="btn btn-info btn-lg"
                                            id="btnCalculatePrice">
                                        <span class="pb-btn-spinner spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                        <i class="bi bi-calculator pb-btn-label"></i>
                                        <span class="pb-btn-label">Calculate Price</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.CalculatedPrice.HasValue)
                    {
                        <div class="booking-form-section card mb-4"
                             aria-labelledby="step4Heading"
                             id="step4Card">
                            <div class="card-body">
                                <h2 class="h5 card-title" id="step4Heading">
                                    <span class="pb-step-index me-1" aria-hidden="true">4</span>
                                    Your Information
                                </h2>

                                <div class="price-alert mb-3" id="step4PriceAlert">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold">Estimated total</span>
                                        <span class="price-alert-value" id="step4PriceValue">@Model.CalculatedPrice.Value.ToString("C")</span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.CustomerName" class="form-label">Full Name</label>
                                    <input asp-for="Input.CustomerName"
                                           class="form-control"
                                           id="Input_CustomerName"
                                           placeholder="Enter your full name"
                                           autocomplete="name" />
                                    <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.CustomerPhone" class="form-label">Mobile Number</label>
                                    <input asp-for="Input.CustomerPhone"
                                           class="form-control"
                                           id="Input_CustomerPhone"
                                           inputmode="tel"
                                           placeholder="e.g., +63 9XX XXXX XXX"
                                           autocomplete="tel" />
                                    <span asp-validation-for="Input.CustomerPhone" class="text-danger"></span>
                                </div>

                                <div class="mb-1">
                                    <label asp-for="Input.CustomerEmail" class="form-label">Email Address</label>
                                    <input asp-for="Input.CustomerEmail"
                                           class="form-control"
                                           id="Input_CustomerEmail"
                                           inputmode="email"
                                           placeholder="email@example.com"
                                           autocomplete="email" />
                                    <span asp-validation-for="Input.CustomerEmail" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="booking-actions d-grid gap-2 mb-4" id="confirmActionsContainer">
                            <button type="submit"
                                    asp-page-handler="Confirm"
                                    class="btn btn-success btn-lg"
                                    id="btnConfirmBooking">
                                <span class="pb-btn-spinner spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                <i class="bi bi-check-circle pb-btn-label"></i>
                                <span class="pb-btn-label">Confirm Booking</span>
                            </button>

                            <a href="@Url.Page("/Index")" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    }

                </div>
            </div>

        </div>

    </form>

</div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}