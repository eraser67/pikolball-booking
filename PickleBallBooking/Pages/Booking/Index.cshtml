@page "/Booking"
@model PickleBallBooking.Pages.Booking.IndexModel
@{
    ViewData["Title"] = "Book a Court";
}

<div class="container my-5">

    <h1 class="mb-3">Book a Court</h1>

    <p class="text-muted mb-4">
        Select a court, date, and one or more continuous time slots to complete your booking.
    </p>


    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <strong>Error:</strong> @Model.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <form method="post" id="bookingForm">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"
             id="validationSummary"
             style="display: none;">

            <strong>Please correct the following errors:</strong>

        </div>


        <!-- ========================================================= -->
        <!-- STEP 1: COURT -->
        <!-- ========================================================= -->

        <div class="booking-form-section card mb-4">

            <div class="card-body">

                <h5 class="card-title">
                    Step 1: Select a Court
                </h5>

                <div class="mb-3">

                    <select asp-for="Input.CourtId"
                            asp-items="Model.Courts"
                            class="form-select form-select-lg"
                            id="courtSelect">

                        <option value="">
                            -- Select a court --
                        </option>

                    </select>

                    <span asp-validation-for="Input.CourtId"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- STEP 2: DATE -->
        <!-- ========================================================= -->

        <div class="booking-form-section card mb-4">

            <div class="card-body">

                <h5 class="card-title">
                    Step 2: Select a Booking Date
                </h5>

                <div class="mb-3">

                    <label for="bookingDate"
                           class="form-label">
                        Booking Date
                    </label>

                    <input asp-for="Input.BookingDate"
                           type="date"
                           id="bookingDate"
                           class="form-control form-control-lg"
                           required />

                    <span asp-validation-for="Input.BookingDate"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- STEP 3: TIMESLOTS -->
        <!-- ========================================================= -->

        <div class="booking-form-section card mb-4">

            <div class="card-body">

                <h5 class="card-title">
                    Step 3: Select Time Slots
                </h5>


                @if (Model.TimeSlotAvailabilities.Count == 0)
                {
                    <div class="alert alert-info">

                        <i class="bi bi-info-circle"></i>

                        Please select a court and date to view available time slots.

                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">

                        Click on available (green) slots to select them.
                        Multiple slots must be continuous with no gaps.

                    </p>


                    <div class="timeslot-grid"
                         id="timeslotGrid"
                         role="group"
                         aria-label="Available time slots">


                        @foreach (var slot in Model.TimeSlotAvailabilities)
                        {
                            var slotStatusClass = slot.Status switch
                            {
                                "available" => "available",
                                "booked" => "booked",
                                "maintenance" => "maintenance",
                                _ => "unavailable"
                            };

                            var isDisabled = slot.Status != "available";

                            var ariaLabel =
                                $"{slot.DisplayTime} - {slot.Status}";


                            <label class="timeslot-btn @slotStatusClass"
                                   title="@ariaLabel"
                                   data-slot-id="@slot.TimeSlotId">


                                <input type="checkbox"
                                       name="SelectedSlotIds"
                                       value="@slot.TimeSlotId"
                                       class="timeslot-checkbox"
                                       aria-label="@ariaLabel"
                                       @(isDisabled ? "disabled" : "")
                                       @(slot.IsSelected ? "checked" : "") />


                                <span class="timeslot-time">
                                    @slot.DisplayTime
                                </span>


                                <span class="timeslot-status">
                                    @slot.Status
                                </span>


                            </label>
                        }


                    </div>
                }

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- BOOKING SUMMARY -->
        <!-- ========================================================= -->

        <div id="bookingSummaryContainer"
             style="display: none;">

            <div class="booking-form-section card mb-4 bg-light">

                <div class="card-body">

                    <h5 class="card-title">
                        Booking Summary
                    </h5>


                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <strong>Court:</strong>

                            <span id="summaryCourtName">
                                -
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>Date:</strong>

                            <span id="summaryDate">
                                -
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>Time:</strong>

                            <span id="summaryTime">
                                -
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>Duration:</strong>

                            <span id="summaryDuration">
                                -
                            </span>

                        </div>


                        <div class="col-md-6">

                            <div id="priceContainer"
                                 style="display: none;">

                                <strong class="h5">
                                    Price:
                                </strong>

                                <span id="summaryPrice"
                                      class="h5 text-success">
                                    -
                                </span>

                            </div>

                        </div>


                    </div>

                </div>

            </div>


            <!-- CALCULATE PRICE -->

            <div id="calculateButtonContainer"
                 class="mb-4">

                <button type="submit"
                        asp-page-handler="Calculate"
                        class="btn btn-info btn-lg">

                    <i class="bi bi-calculator"></i>

                    Calculate Price

                </button>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- CUSTOMER INFORMATION -->
        <!-- ========================================================= -->

        @if (Model.CalculatedPrice.HasValue)
        {
            <div class="booking-form-section card mb-4">

                <div class="card-body">

                    <h5 class="card-title">
                        Step 4: Your Information
                    </h5>


                    <div class="mb-3">

                        <label asp-for="Input.CustomerName"
                               class="form-label">

                            Full Name

                        </label>

                        <input asp-for="Input.CustomerName"
                               class="form-control"
                               placeholder="Enter your full name" />

                        <span asp-validation-for="Input.CustomerName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Input.CustomerPhone"
                               class="form-label">

                            Mobile Number

                        </label>

                        <input asp-for="Input.CustomerPhone"
                               class="form-control"
                               placeholder="e.g., +63 9XX XXXX XXX" />

                        <span asp-validation-for="Input.CustomerPhone"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Input.CustomerEmail"
                               class="form-label">

                            Email Address

                        </label>

                        <input asp-for="Input.CustomerEmail"
                               class="form-control"
                               placeholder="email@example.com" />

                        <span asp-validation-for="Input.CustomerEmail"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- CONFIRM BOOKING -->

            <div class="booking-actions mb-5">

                <button type="submit"
                        asp-page-handler="Confirm"
                        class="btn btn-success btn-lg">

                    <i class="bi bi-check-circle"></i>

                    Confirm Booking

                </button>


                <a href="@Url.Page("/Index")"
                   class="btn btn-secondary btn-lg">

                    Cancel

                </a>

            </div>
        }

    </form>

</div>


<!-- ============================================================= -->
<!-- CSS -->
<!-- ============================================================= -->

<style>

    /* ========================================================= */
    /* TIMESLOT GRID */
    /* ========================================================= */

    .timeslot-grid {

        display: grid;

        grid-template-columns:
            repeat(auto-fit, minmax(100px, 1fr));

        gap: 8px;

        margin-bottom: 20px;

    }


    /* ========================================================= */
    /* TIMESLOT CARD */
    /* ========================================================= */

    .timeslot-btn {

        position: relative;

        padding: 12px 8px;

        border: 2px solid #ddd;

        border-radius: 6px;

        text-align: center;

        cursor: pointer;

        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;

        background: white;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        gap: 4px;

        user-select: none;

    }


    /* ========================================================= */
    /* HIDE CHECKBOX */
    /* ========================================================= */

    .timeslot-checkbox {

        position: absolute;

        opacity: 0;

        width: 1px;

        height: 1px;

        pointer-events: none;

    }


    /* ========================================================= */
    /* TIME */
    /* ========================================================= */

    .timeslot-time {

        font-weight: bold;

        font-size: 0.9rem;

    }


    /* ========================================================= */
    /* STATUS */
    /* ========================================================= */

    .timeslot-status {

        font-size: 0.75rem;

        text-transform: uppercase;

        opacity: 0.7;

    }


    /* ========================================================= */
    /* AVAILABLE */
    /* ========================================================= */

    .timeslot-btn.available {

        background-color: #d4edda;

        border-color: #28a745;

        color: #155724;

        cursor: pointer;

    }


    .timeslot-btn.available:hover {

        background-color: #c3e6cb;

        transform: translateY(-2px);

        box-shadow:
            0 4px 8px rgba(0, 0, 0, 0.1);

    }


    /* ========================================================= */
    /* SELECTED */
    /* ========================================================= */

    .timeslot-btn.selected {

        background-color: #0d6efd !important;

        border-color: #0d6efd !important;

        color: #ffffff !important;

        font-weight: bold;

        transform: translateY(-1px);

        box-shadow:
            0 4px 10px rgba(13, 110, 253, 0.35);

    }


    .timeslot-btn.selected .timeslot-status {

        color: #ffffff;

        opacity: 1;

    }


    /* ========================================================= */
    /* BOOKED */
    /* ========================================================= */

    .timeslot-btn.booked {

        background-color: #f8d7da;

        border-color: #f5c6cb;

        color: #721c24;

        cursor: not-allowed;

        opacity: 0.6;

    }


    .timeslot-btn.booked:hover {

        background-color: #f8d7da;

        transform: none;

        box-shadow: none;

    }


    /* ========================================================= */
    /* MAINTENANCE */
    /* ========================================================= */

    .timeslot-btn.maintenance {

        background-color: #f0f0f0;

        border-color: #cccccc;

        color: #666666;

        cursor: not-allowed;

        opacity: 0.6;

    }


    .timeslot-btn.maintenance:hover {

        background-color: #e2e3e5;

        transform: none;

        box-shadow: none;

    }


    /* ========================================================= */
    /* UNAVAILABLE */
    /* ========================================================= */

    .timeslot-btn.unavailable {

        background-color: #e2e3e5;

        border-color: #6c757d;

        color: #383d41;

        cursor: not-allowed;

        opacity: 0.6;

    }


    .timeslot-btn.unavailable:hover {

        background-color: #e2e3e5;

        transform: none;

        box-shadow: none;

    }


    /* ========================================================= */
    /* BOOKING SECTION */
    /* ========================================================= */

    .booking-form-section {

        border-left: 4px solid #007bff;

    }


    /* ========================================================= */
    /* ERROR */
    /* ========================================================= */

    .error-message {

        color: #dc3545;

        font-weight: 500;

        margin-top: 10px;

    }

</style>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    document.addEventListener('DOMContentLoaded', function () {

        /*
         * =========================================================
         * ELEMENTS
         * =========================================================
         */

        const form =
            document.getElementById('bookingForm');

        const checkboxes =
            Array.from(
                document.querySelectorAll('.timeslot-checkbox')
            );

        const validationSummary =
            document.getElementById('validationSummary');

        const courtSelect =
            document.getElementById('courtSelect');

        const bookingDateInput =
            document.getElementById('bookingDate');

        const bookingSummaryContainer =
            document.getElementById(
                'bookingSummaryContainer'
            );


        /*
         * =========================================================
         * TIMESLOT INFORMATION
         * =========================================================
         */

        const slotDisplayTimes = {};

        checkboxes.forEach(function (checkbox) {

            const card =
                checkbox.closest('.timeslot-btn');

            if (!card) {
                return;
            }

            const timeElement =
                card.querySelector('.timeslot-time');

            if (timeElement) {

                slotDisplayTimes[checkbox.value] =
                    timeElement.textContent.trim();

            }

        });


        /*
         * =========================================================
         * GET SELECTED SLOTS
         * =========================================================
         */

        function getSelectedCheckboxes() {

            return checkboxes.filter(function (checkbox) {

                return checkbox.checked;

            });

        }


        function getSelectedSlotIds() {

            return getSelectedCheckboxes().map(
                function (checkbox) {

                    return parseInt(
                        checkbox.value,
                        10
                    );

                }
            );

        }


        /*
         * =========================================================
         * UPDATE CARD APPEARANCE
         * =========================================================
         */

        function updateCardAppearance() {

            checkboxes.forEach(function (checkbox) {

                const card =
                    checkbox.closest('.timeslot-btn');

                if (!card) {
                    return;
                }


                if (checkbox.checked) {

                    card.classList.add('selected');

                }
                else {

                    card.classList.remove('selected');

                }

            });

        }


        /*
         * =========================================================
         * CHECK CONTINUITY
         * =========================================================
         *
         * The IDs are ordered sequentially for the seeded
         * hourly Timeslots.
         *
         * The server performs the authoritative validation
         * using the actual StartTime / EndTime values.
         */

        function areSlotsContiguous() {

            const selected =
                getSelectedCheckboxes()
                    .sort(function (a, b) {

                        return parseInt(a.value, 10) -
                               parseInt(b.value, 10);

                    });


            if (selected.length <= 1) {

                return true;

            }


            for (
                let i = 1;
                i < selected.length;
                i++
            ) {

                const previousId =
                    parseInt(
                        selected[i - 1].value,
                        10
                    );

                const currentId =
                    parseInt(
                        selected[i].value,
                        10
                    );


                if (
                    currentId !==
                    previousId + 1
                ) {

                    return false;

                }

            }


            return true;

        }


        /*
         * =========================================================
         * SUMMARY
         * =========================================================
         */

        function updateSummary() {

            const selected =
                getSelectedCheckboxes();


            if (selected.length === 0) {

                bookingSummaryContainer.style.display =
                    'none';

                return;

            }


            /*
             * Court
             */

            if (courtSelect) {

                const courtName =
                    courtSelect.options[
                        courtSelect.selectedIndex
                    ]?.text || 'N/A';


                const summaryCourt =
                    document.getElementById(
                        'summaryCourtName'
                    );


                if (summaryCourt) {

                    summaryCourt.textContent =
                        courtName;

                }

            }


            /*
             * Date
             */

            if (bookingDateInput) {

                const dateValue =
                    bookingDateInput.value;


                const summaryDate =
                    document.getElementById(
                        'summaryDate'
                    );


                if (
                    dateValue &&
                    summaryDate
                ) {

                    const date =
                        new Date(
                            dateValue + 'T00:00:00'
                        );


                    summaryDate.textContent =
                        date.toLocaleDateString(
                            'en-US',
                            {
                                weekday: 'long',
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            }
                        );

                }

            }


            /*
             * Time
             */

            const selectedIds =
                getSelectedSlotIds();


            const firstId =
                selectedIds[0];

            const lastId =
                selectedIds[
                    selectedIds.length - 1
                ];


            const firstTime =
                slotDisplayTimes[firstId] || '';

            const lastTime =
                slotDisplayTimes[lastId] || '';


            const lastEndTime =
                lastTime
                    .split('-')[1]
                    ?.trim() || '';


            const summaryTime =
                document.getElementById(
                    'summaryTime'
                );


            if (summaryTime) {

                summaryTime.textContent =
                    `${firstTime} to ${lastEndTime}`;

            }


            /*
             * Duration
             */

            const summaryDuration =
                document.getElementById(
                    'summaryDuration'
                );


            if (summaryDuration) {

                summaryDuration.textContent =
                    `${selectedIds.length} hour(s)`;

            }


            /*
             * Show summary
             */

            bookingSummaryContainer.style.display =
                'block';

        }


        /*
         * =========================================================
         * VALIDATION MESSAGE
         * =========================================================
         */

        function clearValidationError() {

            if (!validationSummary) {
                return;
            }


            validationSummary.style.display =
                'none';


            validationSummary.innerHTML =
                '<strong>Please correct the following errors:</strong>';

        }


        function showValidationError(message) {

            if (!validationSummary) {
                return;
            }


            validationSummary.style.display =
                'block';


            validationSummary.innerHTML =
                `<strong>Error:</strong> ${message}`;

        }


        /*
         * =========================================================
         * TIMESLOT CLICK / CHANGE
         * =========================================================
         */

        checkboxes.forEach(function (checkbox) {

            checkbox.addEventListener(
                'change',
                function () {

                    clearValidationError();


                    /*
                     * If the user is unchecking a slot,
                     * allow it immediately.
                     */

                    if (!checkbox.checked) {

                        updateCardAppearance();

                        updateSummary();

                        return;

                    }


                    /*
                     * User is selecting a slot.
                     * Check continuity.
                     */

                    if (!areSlotsContiguous()) {

                        /*
                         * Undo the selection.
                         */

                        checkbox.checked =
                            false;


                        showValidationError(
                            'Time slots must be continuous (no gaps allowed).'
                        );


                        updateCardAppearance();

                        updateSummary();

                        return;

                    }


                    /*
                     * Valid selection.
                     */

                    updateCardAppearance();

                    updateSummary();

                }
            );

        });


        /*
         * =========================================================
         * COURT CHANGE
         * =========================================================
         */

        if (courtSelect) {

            courtSelect.addEventListener(
                'change',
                function () {

                    const selectedCourt =
                        this.value;


                    if (!selectedCourt) {

                        return;

                    }


                    const selectedDate =
                        bookingDateInput
                            ? bookingDateInput.value
                            : '';


                    if (selectedDate) {

                        window.location.href =
                            `/Booking?courtId=${selectedCourt}&date=${selectedDate}`;

                    }
                    else {

                        window.location.href =
                            `/Booking?courtId=${selectedCourt}`;

                    }

                }
            );

        }


        /*
         * =========================================================
         * DATE CHANGE
         * =========================================================
         */

        if (bookingDateInput) {

            bookingDateInput.addEventListener(
                'change',
                function () {

                    const selectedDate =
                        this.value;


                    if (!selectedDate) {

                        return;

                    }


                    if (
                        courtSelect &&
                        courtSelect.value
                    ) {

                        window.location.href =
                            `/Booking?courtId=${courtSelect.value}&date=${selectedDate}`;

                    }

                }
            );

        }


        /*
         * =========================================================
         * FORM SUBMISSION
         * =========================================================
         */

        if (form) {

            form.addEventListener(
                'submit',
                function (event) {

                    const selectedCount =
                        getSelectedSlotIds().length;


                    if (selectedCount === 0) {

                        event.preventDefault();


                        showValidationError(
                            'Please select at least one time slot.'
                        );


                        return false;

                    }


                    /*
                     * The server will perform the
                     * authoritative validation.
                     */

                    return true;

                }
            );

        }


        /*
         * =========================================================
         * INITIAL PAGE STATE
         * =========================================================
         */

        updateCardAppearance();

        updateSummary();

    });

</script>