@page "/Availability"
@model PickleBallBooking.Pages.Availability.IndexModel
@{
    ViewData["Title"] = "Court Availability";
}

<div class="container-xl px-2 px-md-3 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Court Availability</h1>
            <p class="text-muted small mb-0">Check live court schedules, see who is playing, and reserve your slot.</p>
        </div>
        <div>
            <a asp-page="/Booking/Index" class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i>Start New Booking
            </a>
        </div>
    </div>

    <!-- Date Selection Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-sm-auto">
                    <label asp-for="Date" class="visually-hidden">Date</label>
                    <input asp-for="Date" type="date" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-sm-auto d-flex flex-wrap gap-1">
                    <button type="submit" class="btn btn-primary btn-sm px-3">Go</button>
                    <a asp-page="Index" asp-route-Date="@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm" title="Previous Day">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                    <a asp-page="Index" asp-route-Date="@PickleBallBooking.Services.AppClock.TodayLocal.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm">
                        Today
                    </a>
                    <a asp-page="Index" asp-route-Date="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm" title="Next Day">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.IsPastDate)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4 py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <div>This date is in the past. Select today or an upcoming date to reserve a court.</div>
        </div>
    }

    @if (Model.Courts.Count == 0)
    {
        <div class="alert alert-info py-3 text-center">
            <i class="bi bi-info-circle me-1"></i> No active courts are currently configured.
        </div>
    }
    else if (Model.TimeSlotAvailabilities.Count == 0)
    {
        <div class="alert alert-info py-3 text-center">
            <i class="bi bi-info-circle me-1"></i> No active time slots are available for the selected day.
        </div>
    }
    else
    {
        <!-- Court Availability Summary Status Section -->
        <div class="mb-4">
            <h2 class="h5 fw-bold mb-2">Court Availability Summary</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2 g-md-3">
                @foreach (var availability in Model.CourtAvailabilities)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h3 class="h6 fw-bold mb-0 text-truncate me-2">@availability.Court.Name</h3>
                                    <span class="badge bg-@availability.StatusBadge-subtle text-@availability.StatusBadge border border-@availability.StatusBadge-subtle px-2 py-1 small">
                                        @availability.Status
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(availability.Court.Description))
                                {
                                    <p class="text-muted small text-truncate mb-2" style="font-size: 0.75rem;">@availability.Court.Description</p>
                                }

                                <div class="mb-2 mt-2">
                                    <div class="d-flex justify-content-between mb-1" style="font-size: 0.75rem;">
                                        <span class="text-muted">Available Slots</span>
                                        <span class="fw-semibold">@availability.AvailableSlots / @availability.TotalSlots</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-@availability.StatusBadge" role="progressbar" 
                                             style="width: @availability.AvailabilityPercentage%"
                                             aria-valuenow="@availability.AvailableSlots" 
                                             aria-valuemin="0" 
                                             aria-valuemax="@availability.TotalSlots">
                                        </div>
                                    </div>
                                </div>

                                <div class="small" style="font-size: 0.75rem;">
                                    @if (availability.AvailableSlots > 0)
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>@availability.AvailableSlots @(availability.AvailableSlots == 1 ? "slot" : "slots") open</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>Fully booked</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 7-Day Date Quick Selector Strip -->
        <div class="mb-3">
            <h2 class="h5 fw-bold mb-2">Available Time Slots for @Model.Date.ToString("dddd, MMMM d, yyyy")</h2>
            <div class="pb-date-strip">
                @foreach (var dateOption in Model.DateOptions)
                {
                    var isSelected = dateOption.IsSelected;
                    var btnClass = isSelected ? "btn-primary shadow-sm" : "btn-outline-secondary";

                    <a asp-page="Index"
                       asp-route-Date="@dateOption.Date.ToString("yyyy-MM-dd")"
                       class="btn @btnClass pb-date-btn"
                       aria-current="@(isSelected ? "date" : null)">
                        <strong class="small">@dateOption.DayLabel</strong>
                        <span style="font-size: 0.72rem;">@dateOption.DateLabel</span>
                    </a>
                }
            </div>
        </div>

        <!-- Filter & View Controls -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-light p-2 rounded-3 border">
            <div class="btn-group btn-group-sm" role="group" aria-label="Filter by time of day" id="timePeriodFilters">
                <button type="button" class="btn btn-outline-primary active" data-period="all">All Day</button>
                <button type="button" class="btn btn-outline-primary" data-period="morning"><i class="bi bi-sunrise me-1"></i>Morning</button>
                <button type="button" class="btn btn-outline-primary" data-period="afternoon"><i class="bi bi-sun me-1"></i>Afternoon</button>
                <button type="button" class="btn btn-outline-primary" data-period="evening"><i class="bi bi-moon-stars me-1"></i>Evening</button>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="onlyAvailableToggle" role="switch">
                <label class="form-check-label small fw-semibold" for="onlyAvailableToggle">Open slots only</label>
            </div>
        </div>

        <!-- Time Slots Grid (2 cards per row on mobile, 3 on tablet, 4 on desktop) -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2 g-md-3" id="slotsGrid">
            @foreach (var slot in Model.TimeSlotAvailabilities)
            {
                var hasAvailable = slot.HasAvailableSlots;

                <div class="col slot-col" data-period="@slot.TimePeriod" data-available="@(hasAvailable ? "true" : "false")">
                    @if (hasAvailable)
                    {
                        <a asp-page="/Booking/Index"
                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                           asp-route-startTime="@slot.StartTime.ToString("c")"
                           asp-route-endTime="@slot.EndTime.ToString("c")"
                           class="pb-avail-card available"
                           aria-label="Book time slot @slot.FormattedLabel">
                            <!-- Header: Time & Open Badge -->
                            <div class="mb-2 pb-2 border-bottom border-light-subtle">
                                <div class="pb-avail-time text-truncate">@slot.FormattedLabel</div>
                                <div class="pb-avail-status-line mt-1">
                                    <span class="pb-status-indicator open"></span>
                                    <span class="text-success">@slot.AvailableCourts.Count Court@(slot.AvailableCourts.Count > 1 ? "s" : "") Open</span>
                                </div>
                            </div>

                            <!-- Courts Breakdown & Booker Display -->
                            <div class="my-1 flex-grow-1">
                                @foreach (var court in Model.Courts)
                                {
                                    var isCourtAvailable = slot.AvailableCourts.Any(c => c.Id == court.Id);
                                    if (isCourtAvailable)
                                    {
                                        <div class="pb-court-row">
                                            <span class="text-truncate fw-medium">@court.Name:</span>
                                            <span class="pb-court-badge-avail flex-shrink-0">
                                                <i class="bi bi-circle-fill text-success" style="font-size: 0.45rem;"></i> Available
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        var booker = slot.GetBookerForCourt(court.Id);
                                        <div class="pb-court-row pb-court-booker-text text-truncate" title="@court.Name: Booked by @booker">
                                            <span class="text-truncate">
                                                @court.Name: <i class="bi bi-person-fill text-secondary"></i> <strong>@booker</strong>
                                            </span>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Footer: Price & Book Action -->
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-light-subtle">
                                @if (slot.Price.HasValue)
                                {
                                    <span class="pb-avail-price">@slot.Price.Value.ToString("C0")</span>
                                }
                                else
                                {
                                    <span class="small text-muted">-</span>
                                }
                                <span class="btn btn-sm btn-success pb-avail-btn shadow-sm">
                                    Book
                                </span>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="pb-avail-card booked">
                            <!-- Header: Time & Fully Booked Badge -->
                            <div class="mb-2 pb-2 border-bottom border-light-subtle">
                                <div class="pb-avail-time text-muted text-truncate">@slot.FormattedLabel</div>
                                <div class="pb-avail-status-line mt-1">
                                    <span class="pb-status-indicator full"></span>
                                    <span class="text-danger">Fully Booked</span>
                                </div>
                            </div>

                            <!-- Courts Breakdown & Booker Display -->
                            <div class="my-1 flex-grow-1">
                                @foreach (var court in Model.Courts)
                                {
                                    var booker = slot.GetBookerForCourt(court.Id);
                                    <div class="pb-court-row pb-court-booker-text text-truncate" title="@court.Name: Booked by @booker">
                                        <span class="text-truncate">
                                            @court.Name: <i class="bi bi-person-fill text-secondary"></i> <strong>@booker</strong>
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Footer: Unavailable Status -->
                            <div class="d-flex justify-content-end align-items-center mt-auto pt-2 border-top border-light-subtle">
                                <span class="pb-unavailable-pill">
                                    Unavailable
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Filter Empty State Alert -->
        <div id="noMatchingSlotsAlert" class="alert alert-info d-none text-center my-4 py-3">
            <i class="bi bi-info-circle me-1"></i> No time slots match your current filter settings.
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const periodButtons = document.querySelectorAll('#timePeriodFilters button');
        const availableToggle = document.getElementById('onlyAvailableToggle');
        const slotCols = document.querySelectorAll('.slot-col');
        const noSlotsAlert = document.getElementById('noMatchingSlotsAlert');

        let activePeriod = 'all';

        function applyFilters() {
            const onlyAvailable = availableToggle ? availableToggle.checked : false;
            let visibleCount = 0;

            slotCols.forEach(function (col) {
                const colPeriod = col.getAttribute('data-period');
                const isAvailable = col.getAttribute('data-available') === 'true';

                const matchesPeriod = (activePeriod === 'all' || colPeriod === activePeriod);
                const matchesAvailability = (!onlyAvailable || isAvailable);

                if (matchesPeriod && matchesAvailability) {
                    col.classList.remove('d-none');
                    visibleCount++;
                } else {
                    col.classList.add('d-none');
                }
            });

            if (noSlotsAlert) {
                if (visibleCount === 0) {
                    noSlotsAlert.classList.remove('d-none');
                } else {
                    noSlotsAlert.classList.add('d-none');
                }
            }
        }

        periodButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                periodButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activePeriod = this.getAttribute('data-period') || 'all';
                applyFilters();
            });
        });

        if (availableToggle) {
            availableToggle.addEventListener('change', applyFilters);
        }
    });
</script>
}
