@page "/Availability"
@model PickleBallBooking.Pages.Availability.IndexModel
@{
    ViewData["Title"] = "Court Availability";
}

<h1>Court Availability</h1>
<p class="text-muted">Choose a date to review the current booking status and available time ranges before starting a reservation.</p>

<form method="get" class="row row-cols-lg-auto g-2 align-items-end mb-4">
    <div class="col-12">
        <label asp-for="Date" class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Go</button>
        <a asp-page="Index" asp-route-Date="@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">&laquo; Previous Day</a>
        <a asp-page="Index" asp-route-Date="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Next Day &raquo;</a>
        <a asp-page="Index" asp-route-Date="@DateOnly.FromDateTime(DateTime.UtcNow.Date).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Today</a>
    </div>
</form>

@if (Model.IsPastDate)
{
    <div class="alert alert-warning">This date is in the past. Please choose today or a future date to book.</div>
}

@if (Model.Courts.Count == 0)
{
    <div class="alert alert-info">No active courts are currently available.</div>
}
else if (Model.TimeSlotAvailabilities.Count == 0)
{
    <div class="alert alert-info">No selectable time ranges are currently available.</div>
}
else
{
    <!-- Court Availability Status Section -->
    <div class="mb-5">
        <h3 class="mb-3">Court Availability Status</h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var availability in Model.CourtAvailabilities)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@availability.Court.Name</h5>
                                <span class="badge bg-@availability.StatusBadge">@availability.Status</span>
                            </div>
                            <p class="card-text text-muted small mb-3">@availability.Court.Description</p>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small">Available Slots</span>
                                    <strong>@availability.AvailableSlots/@availability.TotalSlots</strong>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: @availability.AvailabilityPercentage%"
                                         aria-valuenow="@availability.AvailableSlots" 
                                         aria-valuemin="0" 
                                         aria-valuemax="@availability.TotalSlots">
                                    </div>
                                </div>
                            </div>

                            <small class="text-muted">
                                @if (availability.AvailableSlots > 0)
                                {
                                    <span>✓ @availability.AvailableSlots @(availability.AvailableSlots == 1 ? "slot" : "slots") available</span>
                                }
                                else
                                {
                                    <span>✗ Fully booked</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Available Time Slots Section -->
    <div class="mb-4">
        <h3 class="mb-3">Available Time Slots for @Model.Date.ToString("dddd, MMMM d, yyyy")</h3>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var dateOption in Model.DateOptions)
            {
                var buttonClass = dateOption.IsSelected ? "btn btn-primary" : "btn btn-outline-primary";

                <a asp-page="Index"
                   asp-route-Date="@dateOption.Date.ToString("yyyy-MM-dd")"
                   class="@buttonClass">
                    <strong class="d-block">@dateOption.DayLabel</strong>
                    <span>@dateOption.DateLabel</span>
                </a>
            }
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var slot in Model.TimeSlotAvailabilities)
        {
            var hasAvailable = slot.HasAvailableSlots;
            var cardClass = hasAvailable ? "border-success" : "border-secondary bg-light";
            var badgeClass = hasAvailable ? "badge bg-success" : "badge bg-secondary";

            <div class="col">
                @if (hasAvailable)
                {
                    <a asp-page="/Booking/Index"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                       asp-route-startTime="@slot.StartTime.ToString("c")"
                       asp-route-endTime="@slot.EndTime.ToString("c")"
                       class="card text-decoration-none text-dark @cardClass h-100">
                        <div class="card-body">
                            <div class="mb-2">
                                <h5 class="card-title mb-1">@slot.FormattedLabel</h5>
                                <span class="@badgeClass">@slot.CourtStatusText</span>
                            </div>

                            <div class="mt-3 mb-2">
                                <small class="text-muted d-block mb-2"><strong>Available Courts:</strong></small>
                                <div class="available-courts">
                                    @foreach (var court in slot.AvailableCourts)
                                    {
                                        <span class="badge bg-info me-1">@court.Name</span>
                                    }
                                </div>
                            </div>

                            @if (slot.Price.HasValue)
                            {
                                <p class="card-text mb-0 fw-bold text-success mt-3">@slot.Price.Value.ToString("C2")</p>
                            }
                        </div>
                    </a>
                }
                else
                {
                    <div class="card @cardClass h-100">
                        <div class="card-body">
                            <div class="mb-2">
                                <h5 class="card-title mb-1">@slot.FormattedLabel</h5>
                                <span class="@badgeClass">Fully Booked</span>
                            </div>

                            @if (slot.BookedCourts.Count > 0)
                            {
                                <div class="mt-3">
                                    <small class="text-muted d-block mb-2"><strong>All Courts Booked:</strong></small>
                                    <div class="booked-courts">
                                        @foreach (var court in slot.BookedCourts)
                                        {
                                            <span class="badge bg-danger me-1">@court.Name</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
