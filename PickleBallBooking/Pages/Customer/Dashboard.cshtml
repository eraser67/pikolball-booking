@page
@model PickleBallBooking.Pages.Customer.DashboardModel
@using PickleBallBooking.Models
@{
    ViewData["Title"] = "Player Dashboard";
}

@functions {
    static string StatusBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "bg-success text-white",
        BookingStatus.Pending   => "bg-warning text-dark",
        BookingStatus.Cancelled => "bg-secondary text-white",
        _                       => "bg-light text-dark border"
    };

    static string StatusIcon(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "bi-check-circle-fill",
        BookingStatus.Pending   => "bi-clock-fill",
        BookingStatus.Cancelled => "bi-x-circle-fill",
        _                       => "bi-question-circle"
    };

    static string RsvpBadge(RsvpStatus s) => s switch
    {
        RsvpStatus.Confirmed  => "bg-success text-white",
        RsvpStatus.CheckedIn  => "bg-primary text-white",
        RsvpStatus.NoShow     => "bg-danger text-white",
        RsvpStatus.Waitlisted => "bg-warning text-dark",
        RsvpStatus.Cancelled  => "bg-secondary text-white",
        _                     => "bg-info text-dark"
    };
}

<div class="py-3 py-md-4">

    <!-- Flash Messages -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3 mb-md-4 border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3 mb-md-4 border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Welcome Hero -->
    <div class="card border-0 shadow-sm mb-3 mb-md-4 dashboard-hero rounded-3">
        <div class="card-body p-3 p-sm-4 p-md-4 p-lg-5">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl"
                             alt="@Model.DisplayName"
                             class="rounded-circle shadow-sm dashboard-avatar" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm dashboard-avatar-placeholder">
                            @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "P" : Model.DisplayName[..1].ToUpperInvariant())
                        </div>
                    }
                </div>
                <div class="col min-w-0">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h1 class="h4 h3-md fw-bold mb-0 text-truncate">Welcome back, @Model.DisplayName!</h1>
                        @if (!string.IsNullOrEmpty(Model.SkillLevelLabel))
                        {
                            <span class="badge bg-white text-dark shadow-sm border small">@Model.SkillLevelLabel</span>
                        }
                    </div>

                    @if (Model.AttendanceStats is not null && Model.AttendanceStats.TotalActivities > 0)
                    {
                        <div class="d-flex align-items-center gap-1 flex-wrap mt-1 mb-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle small" title="Attendance rate for activities">
                                <i class="bi bi-person-check me-1"></i>@Model.AttendanceStats.AttendanceRate% Attendance (@Model.AttendanceStats.CheckedInCount/@(Model.AttendanceStats.CheckedInCount + Model.AttendanceStats.NoShowCount))
                            </span>
                            @if (Model.AttendanceStats.NoShowCount > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small" title="No-show count">
                                    <i class="bi bi-x-circle me-1"></i>@Model.AttendanceStats.NoShowCount No-Show
                                </span>
                            }
                        </div>
                    }

                    <div class="text-muted small d-flex flex-wrap gap-x-3 gap-y-1 mt-1">
                        <span class="text-truncate d-inline-flex align-items-center"><i class="bi bi-envelope me-1 flex-shrink-0"></i>@Model.Email</span>
                        @if (!string.IsNullOrEmpty(Model.Mobile))
                        {
                            <span class="d-inline-flex align-items-center"><i class="bi bi-phone me-1 flex-shrink-0"></i>@Model.Mobile</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <span class="d-inline-flex align-items-center"><i class="bi bi-geo-alt me-1 flex-shrink-0"></i>@Model.Location</span>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-auto mt-2 mt-md-0 d-flex gap-2 flex-wrap">
                    <a asp-page="/Notifications" class="btn btn-outline-primary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
                        <i class="bi bi-bell me-1"></i>Notifications
                    </a>
                    <a asp-page="/Player/Profile" class="btn btn-outline-success btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
                        <i class="bi bi-trophy me-1"></i>My Stats
                    </a>
                    <a asp-page="/Customer/Profile" class="btn btn-outline-secondary btn-sm flex-fill flex-md-grow-0 d-flex align-items-center justify-content-center">
                        <i class="bi bi-pencil-square me-1"></i>Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Cards -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <a asp-page="/Booking/Index" class="card border-0 shadow-sm text-decoration-none text-dark h-100 p-2 p-sm-3 dashboard-card rounded-3">
                <div class="card-body p-1 p-sm-2 text-center">
                    <div class="icon-circle bg-success-subtle text-success mx-auto mb-2">
                        <i class="bi bi-calendar-plus" style="font-size:1.25rem;"></i>
                    </div>
                    <div class="fw-semibold small text-truncate">Book a Court</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-page="/Activities" class="card border-0 shadow-sm text-decoration-none text-dark h-100 p-2 p-sm-3 dashboard-card rounded-3">
                <div class="card-body p-1 p-sm-2 text-center">
                    <div class="icon-circle bg-success-subtle text-success mx-auto mb-2">
                        <i class="bi bi-calendar-event" style="font-size:1.25rem;"></i>
                    </div>
                    <div class="fw-semibold small text-truncate">Join Activities</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-page="/Activities/Leaderboard" class="card border-0 shadow-sm text-decoration-none text-dark h-100 p-2 p-sm-3 dashboard-card rounded-3">
                <div class="card-body p-1 p-sm-2 text-center">
                    <div class="icon-circle bg-warning-subtle text-warning mx-auto mb-2">
                        <i class="bi bi-trophy" style="font-size:1.25rem;"></i>
                    </div>
                    <div class="fw-semibold small text-truncate">Leaderboards</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-page="/Player/Profile" class="card border-0 shadow-sm text-decoration-none text-dark h-100 p-2 p-sm-3 dashboard-card rounded-3">
                <div class="card-body p-1 p-sm-2 text-center">
                    <div class="icon-circle bg-info-subtle text-info mx-auto mb-2">
                        <i class="bi bi-clock-history" style="font-size:1.25rem;"></i>
                    </div>
                    <div class="fw-semibold small text-truncate">Match History</div>
                </div>
            </a>
        </div>
    </div>

    @if (Model.MatchStats != null && Model.MatchStats.MatchesPlayed > 0)
    {
        <!-- Phase 43: Player Statistics & Match History Widget -->
        <div class="card border-0 shadow-sm rounded-4 mb-3 mb-md-4 overflow-hidden" style="background: linear-gradient(135deg, #064e3b 0%, #047857 100%);">
            <div class="card-body p-3 p-md-4 text-white">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 small">
                                <i class="bi bi-trophy-fill me-1"></i>Match Statistics
                            </span>
                            <span class="text-white-50 small">&bull; Finalized Matches</span>
                        </div>
                        <h4 class="h5 fw-bold mb-0">Your Competitive Record</h4>
                    </div>

                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="text-center px-2">
                            <div class="h4 fw-bold mb-0 text-white">@Model.MatchStats.MatchesPlayed</div>
                            <div class="text-white-50" style="font-size:0.7rem;">MATCHES</div>
                        </div>
                        <div class="text-center px-2 border-start border-white border-opacity-25">
                            <div class="h4 fw-bold mb-0 text-warning">@Model.MatchStats.Wins-@Model.MatchStats.Losses-@Model.MatchStats.Draws</div>
                            <div class="text-white-50" style="font-size:0.7rem;">W - L - D</div>
                        </div>
                        <div class="text-center px-2 border-start border-white border-opacity-25">
                            <div class="h4 fw-bold mb-0 text-white">@Model.MatchStats.WinPercentage.ToString("F1")%</div>
                            <div class="text-white-50" style="font-size:0.7rem;">WIN RATE</div>
                        </div>
                        <div class="text-center px-2 border-start border-white border-opacity-25">
                            <div class="h4 fw-bold mb-0 text-white">
                                @(Model.MatchStats.PointDifferential >= 0 ? "+" : "")@Model.MatchStats.PointDifferential
                            </div>
                            <div class="text-white-50" style="font-size:0.7rem;">DIFF</div>
                        </div>
                        <a asp-page="/Player/Profile" class="btn btn-light btn-sm fw-semibold rounded-pill px-3 shadow-sm ms-md-2">
                            Full History <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- My Activities / RSVPs (Phase 34 & 39) -->
    <div class="card border-0 shadow-sm mb-3 mb-md-4 rounded-3">
        <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h2 class="h6 fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-calendar-check text-success me-2"></i>My Activities &amp; RSVPs
                </h2>
                <a asp-page="/Activities" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus-circle me-1"></i>Find Activities
                </a>
            </div>
        </div>
        <div class="card-body px-3 px-md-4">
            @if (!Model.UserActivities.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-plus text-muted" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3 mb-2">You haven't joined any activities or open plays yet.</p>
                    <a asp-page="/Activities" class="btn btn-success btn-sm">
                        <i class="bi bi-search me-1"></i>Browse Available Activities
                    </a>
                </div>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold small text-muted">Activity</th>
                                <th class="fw-semibold small text-muted">Venue</th>
                                <th class="fw-semibold small text-muted">Date &amp; Time</th>
                                <th class="fw-semibold small text-muted">Courts</th>
                                <th class="fw-semibold small text-muted">Status</th>
                                <th class="fw-semibold small text-muted text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var act in Model.UserActivities)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@act.ActivityName</div>
                                        <div class="small text-muted">@act.Format &bull; @act.SkillLevel</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@act.OrganizationName</span>
                                    </td>
                                    <td class="small">
                                        <div><strong>@act.Date.ToString("ddd, MMM d, yyyy")</strong></div>
                                        <div class="text-muted">@PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)</div>
                                    </td>
                                    <td class="small">
                                        @if (!string.IsNullOrEmpty(act.AssignedCourtName))
                                        {
                                            <div>
                                                <span class="badge bg-success-subtle text-success border fw-semibold">
                                                    <i class="bi bi-grid-3x3 me-1"></i>@act.AssignedCourtName
                                                </span>
                                            </div>
                                            <span class="text-muted" style="font-size:0.75rem;">Allocated: @act.CourtNames</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@act.CourtNames</span>
                                        }
                                    </td>
                                    <td>
                                        @if (act.Status == RsvpStatus.CheckedIn)
                                        {
                                            <span class="badge bg-primary rounded-pill">
                                                <i class="bi bi-patch-check-fill me-1"></i>Checked In
                                            </span>
                                        }
                                        else if (act.Status == RsvpStatus.Confirmed)
                                        {
                                            <span class="badge bg-success rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Confirmed
                                            </span>
                                        }
                                        else if (act.Status == RsvpStatus.Waitlisted)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Waitlist #@act.WaitlistPosition
                                            </span>
                                        }
                                        else if (act.Status == RsvpStatus.NoShow)
                                        {
                                            <span class="badge bg-danger rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i>No-Show
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">@act.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end align-items-center">
                                            @if (act.Status is RsvpStatus.Confirmed or RsvpStatus.CheckedIn)
                                            {
                                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 btn-show-qr"
                                                        data-title="@act.ActivityName"
                                                        data-subtitle="@act.Date.ToString("ddd, MMM d, yyyy") &bull; @act.OrganizationName @(!string.IsNullOrEmpty(act.AssignedCourtName) ? $"&bull; <strong>Assigned Court: {act.AssignedCourtName}</strong>" : "")"
                                                        data-type="Activity Pass"
                                                        data-code="RSVP:@act.RsvpId"
                                                        title="Show Check-In QR Pass">
                                                    <i class="bi bi-qr-code me-1"></i>Pass
                                                </button>
                                            }
                                            @if (act.Status is RsvpStatus.Confirmed or RsvpStatus.Waitlisted)
                                            {
                                                <form method="post" asp-page-handler="CancelRsvp"
                                                      onsubmit="return confirm('Cancel your registration for @act.ActivityName? If confirmed, your spot will be given to the next waitlisted player.');">
                                                    <input type="hidden" name="activityId" value="@act.ActivityId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Cancel RSVP">
                                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-md-none d-flex flex-column gap-3">
                    @foreach (var act in Model.UserActivities)
                    {
                        <div class="card border rounded-3 shadow-none p-3 mobile-item-card">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="min-w-0">
                                    <h6 class="fw-bold mb-1 text-truncate">@act.ActivityName</h6>
                                    <span class="badge bg-light text-secondary border small">@act.Format &bull; @act.SkillLevel</span>
                                </div>
                                <div>
                                    @if (act.Status == RsvpStatus.CheckedIn)
                                    {
                                        <span class="badge bg-primary rounded-pill small">
                                            <i class="bi bi-patch-check-fill me-1"></i>Checked In
                                        </span>
                                    }
                                    else if (act.Status == RsvpStatus.Confirmed)
                                    {
                                        <span class="badge bg-success rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i>Confirmed
                                        </span>
                                    }
                                    else if (act.Status == RsvpStatus.Waitlisted)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill small">
                                            <i class="bi bi-hourglass-split me-1"></i>Waitlist #@act.WaitlistPosition
                                        </span>
                                    }
                                    else if (act.Status == RsvpStatus.NoShow)
                                    {
                                        <span class="badge bg-danger rounded-pill small">
                                            <i class="bi bi-x-circle-fill me-1"></i>No-Show
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill small">@act.Status</span>
                                    }
                                </div>
                            </div>

                            <div class="small text-muted mb-2 d-flex flex-column gap-1">
                                <div>
                                    <i class="bi bi-calendar3 me-1 text-success"></i>
                                    <strong>@act.Date.ToString("ddd, MMM d, yyyy")</strong>
                                    &bull; @PickleBallBooking.Services.AppClock.To12HourRange(act.StartTime, act.EndTime)
                                </div>
                                <div>
                                    <i class="bi bi-building me-1 text-muted"></i>@act.OrganizationName
                                </div>
                                @if (!string.IsNullOrEmpty(act.AssignedCourtName))
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-success-subtle text-success border fw-semibold">
                                            <i class="bi bi-grid-3x3 me-1"></i>Assigned Court: @act.AssignedCourtName
                                        </span>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(act.CourtNames))
                                {
                                    <div>
                                        <i class="bi bi-grid-3x3 me-1 text-muted"></i>Courts: @act.CourtNames
                                    </div>
                                }
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top">
                                @if (act.Status is RsvpStatus.Confirmed or RsvpStatus.CheckedIn)
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm flex-fill py-1 btn-show-qr d-flex align-items-center justify-content-center"
                                            data-title="@act.ActivityName"
                                            data-subtitle="@act.Date.ToString("ddd, MMM d, yyyy") &bull; @act.OrganizationName @(!string.IsNullOrEmpty(act.AssignedCourtName) ? $"&bull; <strong>Assigned Court: {act.AssignedCourtName}</strong>" : "")"
                                            data-type="Activity Pass"
                                            data-code="RSVP:@act.RsvpId">
                                        <i class="bi bi-qr-code me-1"></i>Show QR Pass
                                    </button>
                                }
                                @if (act.Status is RsvpStatus.Confirmed or RsvpStatus.Waitlisted)
                                {
                                    <form method="post" asp-page-handler="CancelRsvp" class="flex-shrink-0"
                                          onsubmit="return confirm('Cancel your registration for @act.ActivityName? If confirmed, your spot will be given to the next waitlisted player.');">
                                        <input type="hidden" name="activityId" value="@act.ActivityId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-3" title="Cancel RSVP">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-2 px-3 px-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h2 class="h6 fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-journal-text text-success me-2"></i>Recent Court Bookings
                </h2>
                <a asp-page="/Booking/Lookup" class="btn btn-sm btn-outline-secondary">
                    Look up a booking
                </a>
            </div>
        </div>
        <div class="card-body px-3 px-md-4">
            @if (!Model.RecentBookings.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-3 mb-2">No bookings found linked to your email address.</p>
                    <a asp-page="/Booking/Index" class="btn btn-success btn-sm">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Make Your First Booking
                    </a>
                </div>
            }
            else
            {
                <!-- Desktop Table View -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold small text-muted">Reference</th>
                                <th class="fw-semibold small text-muted">Court</th>
                                <th class="fw-semibold small text-muted">Date</th>
                                <th class="fw-semibold small text-muted">Time</th>
                                <th class="fw-semibold small text-muted">Status</th>
                                <th class="fw-semibold small text-muted text-end">Amount</th>
                                <th class="fw-semibold small text-muted text-end">Check-In</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td><span class="font-monospace small fw-semibold text-muted">@booking.Reference</span></td>
                                    <td class="fw-medium">@booking.CourtName</td>
                                    <td class="small">@booking.Date.ToString("MMM d, yyyy")</td>
                                    <td class="small text-muted">
                                        @booking.StartTime.ToString(@"hh\:mm") – @booking.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td>
                                        <span class="badge @StatusBadgeClass(booking.Status) rounded-pill">
                                            <i class="bi @StatusIcon(booking.Status) me-1"></i>@booking.Status
                                        </span>
                                        @if (booking.IsCheckedIn)
                                        {
                                            <span class="badge bg-primary rounded-pill ms-1" title="Checked in at @booking.CheckedInAt?.ToString("g")">
                                                <i class="bi bi-check-circle-fill me-1"></i>Checked In
                                            </span>
                                        }
                                        else if (booking.IsNoShow)
                                        {
                                            <span class="badge bg-danger rounded-pill ms-1">
                                                <i class="bi bi-x-circle-fill me-1"></i>No-Show
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">₱@booking.Price.ToString("N2")</td>
                                    <td class="text-end">
                                        @if (booking.Status == BookingStatus.Confirmed)
                                        {
                                            <button type="button" class="btn btn-outline-success btn-sm py-1 px-2 btn-show-qr"
                                                    data-title="Court Booking: @booking.CourtName"
                                                    data-subtitle="@booking.Date.ToString("ddd, MMM d, yyyy") (@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm"))"
                                                    data-type="Booking Pass"
                                                    data-code="BOOKING:@booking.Reference"
                                                    title="Show Check-In QR Pass">
                                                <i class="bi bi-qr-code me-1"></i>Pass
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-md-none d-flex flex-column gap-3">
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <div class="card border rounded-3 shadow-none p-3 mobile-item-card">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <h6 class="fw-bold mb-1">@booking.CourtName</h6>
                                    <span class="font-monospace small text-muted">@booking.Reference</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge @StatusBadgeClass(booking.Status) rounded-pill small">
                                        <i class="bi @StatusIcon(booking.Status) me-1"></i>@booking.Status
                                    </span>
                                    <div class="fw-bold small mt-1">₱@booking.Price.ToString("N2")</div>
                                </div>
                            </div>

                            <div class="small text-muted mb-2 d-flex flex-column gap-1">
                                <div>
                                    <i class="bi bi-calendar3 me-1 text-success"></i>
                                    <strong>@booking.Date.ToString("ddd, MMM d, yyyy")</strong>
                                </div>
                                <div>
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    @booking.StartTime.ToString(@"hh\:mm") – @booking.EndTime.ToString(@"hh\:mm")
                                </div>
                                @if (booking.IsCheckedIn)
                                {
                                    <div>
                                        <span class="badge bg-primary rounded-pill small">
                                            <i class="bi bi-patch-check-fill me-1"></i>Checked In
                                        </span>
                                    </div>
                                }
                                else if (booking.IsNoShow)
                                {
                                    <div>
                                        <span class="badge bg-danger rounded-pill small">
                                            <i class="bi bi-x-circle-fill me-1"></i>No-Show
                                        </span>
                                    </div>
                                }
                            </div>

                            @if (booking.Status == BookingStatus.Confirmed)
                            {
                                <div class="pt-2 border-top">
                                    <button type="button" class="btn btn-outline-success btn-sm w-100 py-1 btn-show-qr d-flex align-items-center justify-content-center"
                                            data-title="Court Booking: @booking.CourtName"
                                            data-subtitle="@booking.Date.ToString("ddd, MMM d, yyyy") (@booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm"))"
                                            data-type="Booking Pass"
                                            data-code="BOOKING:@booking.Reference">
                                        <i class="bi bi-qr-code me-1"></i>Show QR Pass
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>

<!-- Check-In QR Pass Modal -->
<div class="modal fade" id="qrPassModal" tabindex="-1" aria-labelledby="qrPassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-0 pb-0 px-3 px-sm-4 pt-3 pt-sm-4">
                <h5 class="modal-title fw-bold" id="qrPassModalLabel">
                    <i class="bi bi-qr-code-scan text-success me-2"></i>Check-In Pass
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3 p-sm-4">
                <span id="passTypeBadge" class="badge bg-success-subtle text-success border mb-2">Activity Pass</span>
                <h5 id="passTitle" class="fw-bold mb-1 px-2">Activity Name</h5>
                <p id="passSubtitle" class="text-muted small mb-3 px-2">Venue &amp; Date info</p>

                <div class="p-3 bg-light rounded-3 d-inline-block border mb-3 shadow-sm pass-qr-box">
                    <a id="passQrLink" href="#" target="_blank" rel="noopener noreferrer" title="Click to view full-size QR code" style="cursor: pointer;">
                        <img id="passQrImg" src="" alt="Check-In QR Code" class="img-fluid d-block mx-auto rounded-2" style="max-width:200px;width:100%;height:auto;aspect-ratio:1/1;" />
                        <span class="badge bg-dark bg-opacity-75 small mt-2 d-inline-block">
                            <i class="bi bi-arrows-fullscreen me-1"></i>Click to Enlarge
                        </span>
                    </a>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-1 d-block">Pass Code (or staff manual entry):</label>
                    <div class="input-group input-group-sm w-100 max-w-300 mx-auto">
                        <input type="text" id="passCodeText" class="form-control text-center font-monospace fw-bold" readonly />
                        <button class="btn btn-outline-secondary" type="button" id="btnCopyPassCode" title="Copy Code">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small mb-0 text-start rounded-3">
                    <i class="bi bi-info-circle me-1"></i> Present this QR code to the venue desk or event host upon arrival to complete your check-in.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-3 px-sm-4 pb-3 pb-sm-4">
                <button type="button" class="btn btn-secondary w-100 rounded-3 py-2" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const modalEl = document.getElementById('qrPassModal');
    if (!modalEl) return;
    const modal = new bootstrap.Modal(modalEl);

    document.querySelectorAll('.btn-show-qr').forEach(btn => {
        btn.addEventListener('click', function () {
            const title = this.getAttribute('data-title') || 'Pass';
            const subtitle = this.getAttribute('data-subtitle') || '';
            const code = this.getAttribute('data-code') || '';
            const type = this.getAttribute('data-type') || 'Pass';

            document.getElementById('passTitle').textContent = title;
            document.getElementById('passSubtitle').innerHTML = subtitle;
            document.getElementById('passTypeBadge').textContent = type;
            document.getElementById('passCodeText').value = code;

            const qrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=10&data=' + encodeURIComponent(code);
            document.getElementById('passQrImg').src = qrUrl;
            const passQrLink = document.getElementById('passQrLink');
            if (passQrLink) {
                passQrLink.href = qrUrl;
            }

            modal.show();
        });
    });

    const copyBtn = document.getElementById('btnCopyPassCode');
    if (copyBtn) {
        copyBtn.addEventListener('click', function () {
            const input = document.getElementById('passCodeText');
            input.select();
            navigator.clipboard.writeText(input.value);
            copyBtn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
            setTimeout(() => { copyBtn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
        });
    }
});
</script>
}

